        <template data-pems-template="lc-text-li"><li data-slot="text"></li></template>
        <template data-pems-template="lc-live"><div class="alert alert-warning lc-live" role="status"></div></template>
        <template data-pems-template="lc-live-line"><div data-slot="text"></div></template>
        <template data-pems-template="lc-chip"><span class="lc-chip" data-slot="root"><span data-slot="label"></span></span></template>
        <template data-pems-template="lc-empty"><li class="lc-empty" data-slot="text"></li></template>
        <template data-pems-template="lc-option"><li role="option" aria-selected="false" data-slot="root"><span data-slot="name"></span><small data-slot="sub"></small></li></template>
        <template data-pems-template="lc-menu-wait"><li class="px-3 py-2"></li></template>
        <template data-pems-template="lc-menu-note"><li><span class="dropdown-item-text small text-muted" data-slot="text"></span></li></template>
