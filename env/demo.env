# PEMS settings - demo
# Online demo on the company host (branch `demo`, deployed by .github/workflows/deploy-demo.yml). The hosting login cannot CREATE DATABASE.
# Loaded when PEMS_ENV=demo. Secrets are NOT here: they live in env/demo.secrets.env (git-ignored).
# Format: KEY=VALUE, '__' is the section separator (Ollama__Url = Ollama:Url). Real environment variables override this file.

# --- Hosting
AllowedHosts=*
Hosting__HstsMaxAgeDays=30

# --- Logging (Serilog)
Serilog__MinimumLevel=Information
Serilog__File__Path=logs/pems-.log
Serilog__File__RetainedFiles=30

# --- Database bootstrap (connection string is a secret: see the .secrets.env file)
Database__CreateIfMissing=false
Database__MigrateOnStartup=true
Database__MigrationCommandTimeoutMinutes=10
# Rollback point (SCRUM-280): COPY_ONLY backup before every update; the update stops if it fails. Directory = folder on the SQL Server machine, empty = instance default.
Database__BackupBeforeUpdate=false
Database__BackupDirectory=

# --- Local AI (Ollama) and OCR
Ollama__Url=http://ollama-not-available-in-demo.invalid:11434
Ollama__Model=qwen2.5:3b
Ollama__EmbeddingModel=nomic-embed-text
Ollama__TimeoutMinutes=1
OCR__TessDataPath=tessdata
OCR__Languages=fas+eng

# --- FTP storage defaults (user name and password are secrets)
Ftp__Host=
Ftp__Port=21
Ftp__BaseRemotePath=/
Ftp__UseFtps=false

# --- Uploads (SCRUM-202): one guard for every upload. MaxFileSizeMb = largest single file; MaxRequestSizeMb = whole request
# (Kestrel, IIS and the form reader follow it; it must be >= MaxFileSizeMb). On IIS also keep requestFiltering maxAllowedContentLength >= this.
# MalwareScan Mode: None (no scanner) or Command (run a scanner installed on this server; offline, no external call; a failed scan refuses the file).
# Command examples: ClamAV  Command=C:\Program Files\ClamAV\clamscan.exe  Arguments=--no-summary "{file}"
#                   Defender Command=C:\Program Files\Windows Defender\MpCmdRun.exe  Arguments=-Scan -ScanType 3 -File "{file}" -DisableRemediation
# QuarantineFolder: where the scanned copy is written for a moment (empty = system temp folder).
Uploads__MaxFileSizeMb=25
Uploads__MaxRequestSizeMb=100
Uploads__MalwareScan__Mode=None
Uploads__MalwareScan__Command=
Uploads__MalwareScan__Arguments=--no-summary "{file}"
Uploads__MalwareScan__TimeoutSeconds=60
Uploads__MalwareScan__QuarantineFolder=

# --- WebAuthn / passkeys (needs the real HTTPS domain)
Fido2__ServerDomain=demo.parmisata.ir
Fido2__ServerName=PEMS Demo
Fido2__Origins__0=https://demo.parmisata.ir
Fido2__TimestampDriftToleranceMs=300000

# --- Authentication
Authentication__Lockout__MaxFailedAccessAttempts=5
Authentication__Lockout__DefaultLockoutMinutes=10
Authentication__Password__RequiredLength=8
Authentication__Password__RequireDigit=true
Authentication__Password__RequireUppercase=false
Authentication__Password__RequireNonAlphanumeric=false
Authentication__Password__HistoryCount=5
Authentication__Cookie__Name=PEMS.Auth
Authentication__Cookie__ExpireHours=8
Authentication__Cookie__SlidingExpiration=true
Authentication__SecurityStampValidationMinutes=1

# --- Admin account recovery (SCRUM-355/356)
# Rate limit for the sign-in-free recovery pages, per client IP, POST only
Security__Recovery__RateLimit__PermitLimit=5
Security__Recovery__RateLimit__WindowMinutes=15
# Break-glass: placing pems-recovery.request in this folder (relative to the app folder, or absolute) opens /break-glass for WindowMinutes
Security__BreakGlass__RequestFolder=break-glass
Security__BreakGlass__WindowMinutes=15
# Comma-separated CIDR list allowed besides localhost (empty = localhost only), e.g. 10.20.0.0/16
Security__BreakGlass__ManagementNetworks=
# Vendor-signed recovery (off by default; the customer enables it explicitly). Public key = ECDSA P-256 SubjectPublicKeyInfo, Base64
Security__BreakGlass__VendorRecovery__Enabled=false
Security__BreakGlass__VendorRecovery__PublicKey=
Security__BreakGlass__VendorRecovery__MachineFingerprint=

# --- Language and culture
Localization__DefaultCulture=en
Localization__SupportedCultures__0=en
Localization__SupportedCultures__1=fa

# --- First administrator (the password is a secret)
Seed__Admin__UserName=admin
Seed__Admin__Email=admin@pems.local

# --- Features and policies
Features__DynamicSidebar__Enabled=false
Cmms__WorkRequest__EnforceSegregationOfDuties=true

# --- Letters
LetterReminders__Enabled=false
LetterReminders__RunAtLocalTime=07:30
LetterReminders__AutoArchiveAfterYears=0
Letterhead__CompanyName=PEMS Demo
Letterhead__Address=
Letterhead__Phone=
Letterhead__Website=

# --- Email (SCRUM-429): the organisation's own mail server for tender invitations; account in the secrets file.
# Enabled stays false until the mail server is set (demo always false). Security: Auto | None | StartTls | SslOnConnect.
Email__Enabled=false
Email__Host=
Email__Port=25
Email__Security=Auto
Email__FromAddress=
Email__FromName=PEMS
Email__TimeoutSeconds=30

# --- Licensing (docs/design/LICENSING_TECHNICAL_DESIGN.md). Enforce stays false until the licence rollout tasks; false means nothing is checked or blocked.
# SealDirectory 'auto' = %ProgramData%\PEMS\seal on Windows, /var/lib/pems/seal on Linux; Docker sets an explicit volume path.
Licensing__Enforce=false
Licensing__SealDirectory=auto
Licensing__PeriodicCheckHours=6
Licensing__HeartbeatHours=24
Licensing__ClockToleranceMinutes=5
Licensing__WarningDays=30
Licensing__RestoreGraceHours=72
Licensing__HostMachineIdPath=/host/etc/machine-id

# --- Definition store limits (SCRUM-434, design doc section 6)
Definitions__MaxPayloadBytes=1048576
Definitions__MaxInstancesPerPage=500
Definitions__MaxJsonDepth=32
# SCRUM-786: retired definition versions are kept forever (the only supported value); the storage report warns above this many MB
Definitions__RetainRetiredVersions=forever
Definitions__StorageWarnMb=1024
# SCRUM-788: milliseconds the smoke check after a publish may take; a failed or slow check publishes the previous version again
Definitions__SmokeTimeoutMs=3000
# SCRUM-808: definitions that need a second person to publish (kind:key or kind:*, comma separated); empty = none. A protected definition is not published by the person who made its draft.
Definitions__ProtectedDefinitions=
# SCRUM-577: milliseconds a stage of a page or form request may take before a warning with the trace id is logged
Definitions__Budgets__ResolveMs=30
Definitions__Budgets__AuthorizeMs=30
Definitions__Budgets__HydrateMs=250
Definitions__Budgets__EvaluateMs=100
Definitions__Budgets__RenderMs=400
# SCRUM-373: most violations one validation reports (the ASP.NET Core default)
Validation__MaxErrors=200

# SCRUM-470: true = every purchase-order line must be a catalogued part (no free-text lines)
Procurement__CatalogueOnlyLines=false
