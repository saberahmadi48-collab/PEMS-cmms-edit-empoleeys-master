@{
    var rows = Enumerable.Range(1, 1000).Select(i => "row" + i).ToList();
    var act = DataCell.Template(rows, @<text>@{ var r = item; }<pems-form asp-action="FormPost" method="post" class="d-inline"><input type="hidden" name="key" value="@r" /><pems-button type="submit" tone="neutral">@r.ToUpper()</pems-button></pems-form></text>);
}
<pems-data-table data="@(DataRows.Of(rows, c_ => c_.Add("Name", r => (object?)r).Add("Act", r => (object?)act(r))))" dense="true" />
