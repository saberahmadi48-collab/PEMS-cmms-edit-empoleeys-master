      "fa": "تأیید تگ"
    },
    "submitLabel": {
      "en": "Approve",
      "fa": "تأیید"
    },
    "actionKey": "ai-tag-approve",
    "columns": 2,
    "fields": [
      {
        "name": "extractedTagId",
        "label": {
          "en": "Extracted tag id",
          "fa": "شناسه تگ استخراج‌شده"
