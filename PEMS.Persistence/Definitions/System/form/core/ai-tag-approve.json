        "kind": "number",
        "required": true,
        "messages": {
          "required": {
            "en": "The tag is required.",
            "fa": "تگ الزامی است."
          }
        }
      },
      {
        "name": "attachmentId",
        "label": {
          "en": "File id",
          "fa": "شناسه فایل"
        },
        "kind": "number",
        "required": true,
        "messages": {
          "required": {
            "en": "The file is required.",
            "fa": "فایل الزامی است."
          }
        }
      },
      {
        "name": "equipmentId",
        "label": {
          "en": "Equipment",
          "fa": "تجهیز"
        },
        "kind": "select",
        "required": true,
        "span": 2,
        "optionsFrom": "ai-extraction-equipment-options",
        "messages": {
          "required": {
            "en": "Choose the equipment.",
            "fa": "تجهیز را انتخاب کنید."
          }
        }
      }
