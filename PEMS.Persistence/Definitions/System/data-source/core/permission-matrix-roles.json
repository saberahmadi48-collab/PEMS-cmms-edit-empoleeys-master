{
  "kind": "data-source",
  "key": "permission-matrix-roles",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Roles of the permission matrix",
    "fa": "نقش‌های ماتریس مجوز"
  },
  "description": {
    "en": "The roles whose permissions can be edited",
    "fa": "نقش‌هایی که مجوزهایشان قابل ویرایش است"
  },
  "payload": {
