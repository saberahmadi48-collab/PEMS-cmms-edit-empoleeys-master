      "tag": "div",
      "css": "vs-page",
      "children": [
        {
          "region": "header"
        },
        {
          "region": "messages"
        },
        {
          "region": "summary"
        },
        {
          "tag": "div",
          "css": "row g-3",
          "children": [
            {
              "tag": "main",
              "css": "col-lg-8",
              "children": [
                {
                  "region": "content",
                  "required": true
                }
              ]
            },
            {
              "tag": "aside",
              "css": "col-lg-4",
              "children": [
                {
                  "region": "side"
                },
                {
                  "region": "history"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
