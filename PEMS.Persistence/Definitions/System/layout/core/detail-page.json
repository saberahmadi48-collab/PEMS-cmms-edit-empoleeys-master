{
  "kind": "layout",
  "key": "detail-page",
  "appKey": "core",
  "version": 1,
  "title": {
    "fa": "صفحه جزئیات",
    "en": "Detail page"
  },
  "description": {
    "fa": "نمایش یک رکورد با خلاصه، بخش‌ها و تاریخچه",
    "en": "One record with summary, sections and history"
  },
  "payload": {
