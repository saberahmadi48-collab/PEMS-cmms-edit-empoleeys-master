{
  "kind": "action",
  "key": "finding-close",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Close a finding",
    "fa": "بستن یافته"
  },
  "description": {
    "en": "Close a finding",
    "fa": "بستن یافته"
  },
