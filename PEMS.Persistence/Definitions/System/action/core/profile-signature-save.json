{
  "kind": "action",
  "key": "profile-signature-save",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Save my signature",
    "fa": "ذخیره امضای من"
  },
  "description": {
    "en": "Save my signature",
    "fa": "ذخیره امضای من"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "MyProfile",
      "action": "SaveSignature",
      "args": {
        "userName": "context:userName",
        "signatureDataUrl": "field:signatureDataUrl"
      }
    },
    "success": {
      "en": "Signature saved.",
      "fa": "امضای دیجیتال ذخیره شد."
    }
  }
}