  "key": "moc-reject",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Reject MOC",
    "fa": "Reject MOC"
  },
  "description": {
    "en": "Reject MOC",
    "fa": "Reject MOC"
  },
  "payload": {
