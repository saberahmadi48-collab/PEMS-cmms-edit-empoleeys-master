{
  "kind": "action",
  "key": "help-standard-create",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Create a standard reference",
    "fa": "ایجاد مرجع استاندارد"
  },
  "description": {
    "en": "Create a standard reference",
    "fa": "ایجاد مرجع استاندارد"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Help",
      "action": "SaveStandard",
      "args": {
        "standardId": "literal:0",
        "dto": {
          "Identifier": "field:identifier",
          "IssuingOrganization": "field:issuingOrganization",
          "EditionOrYear": "field:editionOrYear",
          "OfficialReferenceUrl": "field:officialReferenceUrl",
          "RelatedModule": "field:relatedModule",
          "ApplicabilityStatus": "field:applicabilityStatus",
          "VerificationStatus": "field:verificationStatus",
          "PEMSImplementationStatus": "field:pEMSImplementationStatus",
          "EvidencePath": "field:evidencePath",
          "Notes": "field:notes",
          "Code": "field:code",
          "HelpCategoryId": "field:helpCategoryId",
          "DisplayOrder": "field:displayOrder",
          "IsPublished": "field:isPublished",
          "TitleEn": "field:titleEn",
          "SummaryEn": "field:summaryEn",
          "ContentEn": "field:contentEn",
          "TitleFa": "field:titleFa",
          "SummaryFa": "field:summaryFa",
          "ContentFa": "field:contentFa"
        },
        "relatedArticleIds": "field:relatedArticleIds"
      }
    },
    "success": {
      "en": "Standard reference created.",
      "fa": "مرجع استاندارد ایجاد شد."
    },
    "redirect": "/p/help-standards"
  }
}