{
  "kind": "action",
  "key": "mrs-import-commit-status",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Commit a whole match status",
    "fa": "تأیید یک وضعیت کامل"
  },
  "description": {
    "en": "Commit a whole match status",
    "fa": "تأیید یک وضعیت کامل"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "MrsImport",
      "action": "CommitByStatus",
      "args": {
        "batchId": "field:batchId",
        "matchStatus": "field:matchStatus",
        "employeeId": "context:employeeId"
      }
    },
    "success": {
      "en": "The rows of the status were committed.",
      "fa": "ردیف‌های این وضعیت تأیید شدند."
    },
    "redirect": "/p/mrs-import-review?batchId={batchId}"
  }
}