{
  "kind": "action",
  "key": "moc-record-implementation",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Record MOC implementation",
    "fa": "Record MOC implementation"
  },
  "description": {
    "en": "Record MOC implementation",
    "fa": "Record MOC implementation"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "MOC",
      "action": "RecordImplementation",
      "args": {
        "mocId": "field:mocId",
        "implementationPlan": "field:implementationPlan",
        "actorEmployeeId": "context:employeeId",
        "ipAddress": "context:ip",
        "userAgent": "context:userAgent"
      }
    },
    "success": {
      "en": "The implementation was recorded.",
      "fa": "اجرا ثبت شد."
    },
    "redirect": "/MOC/Details/{mocId}"
  }
}