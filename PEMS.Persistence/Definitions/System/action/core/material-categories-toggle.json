{
  "kind": "action",
  "key": "material-categories-toggle",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Activate or deactivate",
    "fa": "فعال یا غیرفعال کردن"
  },
  "description": {
    "en": "Activate or deactivate",
    "fa": "فعال یا غیرفعال کردن"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.toggle",
    "parameters": {
      "entity": "MaterialCategory",
      "property": "IsActive"
    },
    "success": {
      "en": "Status updated.",
      "fa": "وضعیت به‌روز شد."
    },
    "redirect": "/p/material-categories"
