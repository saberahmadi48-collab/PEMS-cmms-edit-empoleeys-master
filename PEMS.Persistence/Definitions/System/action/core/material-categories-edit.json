{
  "kind": "action",
  "key": "material-categories-edit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Edit material category",
    "fa": "ویرایش دسته‌بندی مواد"
  },
  "description": {
    "en": "Edit material category",
    "fa": "ویرایش دسته‌بندی مواد"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.update",
    "parameters": {
      "entity": "MaterialCategory",
      "map": {
        "name": "Name",
        "parentCategoryId": "ParentCategoryId",
        "description": "Description"
      },
      "required": [
        "Name"
      ],
      "unique": [
        {
          "fields": [
            "Code"
          ],
          "message": {
            "en": "This code already exists.",
            "fa": "این کد از قبل وجود دارد."
          }
        }
      ]
    },
    "success": {
      "en": "Material category saved.",
      "fa": "دسته‌بندی مواد ذخیره شد."
    },
    "redirect": "/p/material-categories"
  }
}