{
  "kind": "action",
  "key": "contract-approve-revision",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Approve contract value change",
    "fa": "تایید تغییر ارزش قرارداد"
  },
  "description": {
    "en": "Approve contract value change",
    "fa": "تایید تغییر ارزش قرارداد"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Contract",
      "action": "ApproveRevision",
      "args": {
        "contractRevisionId": "field:contractRevisionId",
        "actorEmployeeId": "context:employeeId",
        "actorRoles": "context:roles",
        "currentUserId": "context:userId",
        "ipAddress": "context:ip"
      }
    },
    "success": {
      "en": "The value change was approved.",
      "fa": "تغییر ارزش قرارداد تایید شد."
    },
    "redirect": "/Contract/Details/{contractId}"
  }
}