{
  "kind": "action",
  "key": "warehouses-create",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Create warehouse",
    "fa": "ایجاد انبار"
  },
  "description": {
    "en": "Create warehouse",
    "fa": "ایجاد انبار"
  },
  "payload": {
    "kind": "handler",
    "handler": "entity.create",
    "parameters": {
      "entity": "Warehouse",
      "map": {
        "code": "Code",
        "name": "Name",
        "description": "Description"
      },
      "required": [
        "Code",
        "Name"
      ],
      "defaults": {
        "IsActive": true,
        "CreatedDate": "$now"
      },
      "unique": [
        {
          "fields": [
            "Code"
          ],
          "message": {
            "en": "This code already exists.",
            "fa": "این کد از قبل وجود دارد."
          }
        }
      ]
    },
    "success": {
      "en": "Warehouse created.",
      "fa": "انبار ایجاد شد."
    },
    "redirect": "/p/warehouses"
  }
}