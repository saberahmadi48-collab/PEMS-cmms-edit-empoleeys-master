{
  "kind": "action",
  "key": "procurement-package-add-communication",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Add a clarification",
    "fa": "افزودن شفاف‌سازی"
  },
  "description": {
    "en": "Add a clarification",
    "fa": "افزودن شفاف‌سازی"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "ProcurementPackage",
      "action": "AddCommunication",
      "args": {
        "packageId": "field:packageId",
        "type": "field:type",
        "subject": "field:subject",
        "body": "field:body",
        "vendorId": "field:vendorId",
        "raisedByName": "context:userName"
      }
    },
    "success": {
      "en": "The clarification was added.",
      "fa": "شفاف‌سازی افزوده شد."
    },
    "redirect": "/p/procurement-package-details?id={packageId}"
  }
}