{
  "kind": "action",
  "key": "workflow-publish",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Publish a version",
    "fa": "انتشار نسخه"
  },
  "description": {
    "en": "Publish a version",
    "fa": "انتشار نسخه"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "WorkflowManagement",
      "action": "Publish",
      "args": {
        "versionId": "field:id"
      }
    },
    "success": {
      "en": "Version published.",
      "fa": "نسخه منتشر شد."
    },
    "redirect": "/p/workflow-management"
  }
}