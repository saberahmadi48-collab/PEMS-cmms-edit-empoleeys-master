    "parameters": {
      "model": "PurchaseOrder",
      "action": "Reject",
      "args": {
        "poId": "field:id",
        "reason": "field:reason"
      }
    },
    "success": {
      "en": "The order was rejected.",
      "fa": "سفارش رد شد."
    },
    "redirect": "/p/purchase-order-details?id={id}"
  }
}