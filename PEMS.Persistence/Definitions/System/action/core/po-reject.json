{
  "kind": "action",
  "key": "po-reject",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Reject the order",
    "fa": "رد سفارش"
  },
  "description": {
    "en": "Reject the order",
    "fa": "رد سفارش"
  },
  "payload": {
    "kind": "handler",
