{
  "kind": "action",
  "key": "pc-admin-save-settings",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Save the part number settings",
    "fa": "ذخیره‌ی تنظیمات شماره‌ی قطعه"
  },
  "description": {
    "en": "Save the part number settings",
    "fa": "ذخیره‌ی تنظیمات شماره‌ی قطعه"
  },
  "payload": {
    "kind": "handler",
