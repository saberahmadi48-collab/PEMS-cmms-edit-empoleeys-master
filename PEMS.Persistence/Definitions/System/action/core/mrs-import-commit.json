{
  "kind": "action",
  "key": "mrs-import-commit",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Commit rows",
    "fa": "تأیید ردیف‌ها"
  },
  "description": {
    "en": "Commit rows",
    "fa": "تأیید ردیف‌ها"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "MrsImport",
      "action": "Commit",
      "args": {
        "batchId": "field:batchId",
        "rowIds": "field:rowIds",
        "employeeId": "context:employeeId"
      }
    },
    "success": {
      "en": "The rows were committed.",
      "fa": "ردیف‌ها تأیید شدند."
    },
    "redirect": "/p/mrs-import-review?batchId={batchId}"
  }
}