    "parameters": {
      "model": "PurchaseOrder",
      "action": "RemoveLine",
      "args": {
        "lineId": "field:lineId"
      }
    },
    "success": {
      "en": "The line was removed.",
      "fa": "قلم حذف شد."
    },
    "redirect": "/p/purchase-order-details?id={id}"
  }
}