{
  "kind": "action",
  "key": "po-remove-line",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Remove a line",
    "fa": "حذف قلم"
  },
  "description": {
    "en": "Remove a line",
    "fa": "حذف قلم"
  },
  "payload": {
    "kind": "handler",
