{
  "kind": "action",
  "key": "workflow-clone",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Clone a version",
    "fa": "ایجاد پیش‌نویس"
  },
  "description": {
    "en": "Clone a version",
    "fa": "ایجاد پیش‌نویس"
