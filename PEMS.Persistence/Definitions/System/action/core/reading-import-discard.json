{
  "kind": "action",
  "key": "reading-import-discard",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Discard the batch",
    "fa": "دور ریختن دسته"
  },
  "description": {
    "en": "Discard the batch",
    "fa": "دور ریختن دسته"
  },
  "payload": {
    "kind": "handler",
