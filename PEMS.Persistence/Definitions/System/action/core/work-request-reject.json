{
  "kind": "action",
  "key": "work-request-reject",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Reject the request",
    "fa": "رد درخواست"
  },
  "description": {
    "en": "Reject the request",
    "fa": "رد درخواست"
  },
