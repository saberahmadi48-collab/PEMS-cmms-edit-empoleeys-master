{
  "kind": "action",
  "key": "permit-return-for-rework",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Return permit for rework",
    "fa": "بازگرداندن مجوز برای اصلاح"
  },
  "description": {
    "en": "Return permit for rework",
    "fa": "بازگرداندن مجوز برای اصلاح"
  },
  "payload": {
    "kind": "handler",
    "handler": "operation.invoke",
    "parameters": {
      "model": "Permit",
      "action": "ReturnForRework",
      "args": {
        "permitId": "field:id",
        "comment": "field:comment",
        "actorEmployeeId": "context:employeeId",
        "actorRoles": "context:roles",
        "ipAddress": "context:ip",
        "userAgent": "context:userAgent"
      }
    },
    "success": {
      "en": "The permit was returned for rework.",
      "fa": "Permit برای اصلاح بازگردانده شد."
    },
    "redirect": "/Permit/Details/{id}"
  }
}