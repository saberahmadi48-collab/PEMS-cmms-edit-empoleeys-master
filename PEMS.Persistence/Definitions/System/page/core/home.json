          "id": "chart-status",
          "component": "def:entity-chart",
          "options": {
            "url": "/d/home-documents-by-status",
            "labelField": "name",
            "series": [
              {
                "field": "number",
                "name": {
                  "en": "Documents",
                  "fa": "مدارک"
                }
              }
            ],
            "kind": "donut",
            "ariaLabel": {
              "en": "Documents by status",
              "fa": "مدارک بر اساس وضعیت"
            },
            "emptyText": {
              "en": "No documents to chart yet.",
              "fa": "هنوز مدرکی برای نمودار نیست."
            }
          }
        },
        {
          "id": "h-disciplines",
          "component": "content-blocks",
          "options": {
            "id": "h-disciplines",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Discipline Performance",
                  "fa": "عملکرد دیسیپلین‌ها"
                }
              }
            ]
          }
        },
        {
          "id": "disciplines",
          "component": "data-grid",
          "options": {
            "id": "home-disciplines",
            "url": "/d/home-disciplines",
            "idField": "discipline",
            "pageSize": 10,
            "height": 360,
            "columns": [
              {
                "key": "discipline",
                "header": {
                  "en": "Discipline",
                  "fa": "دیسیپلین"
                },
                "width": 240
              },
              {
                "key": "total",
                "header": {
                  "en": "Documents",
                  "fa": "مدارک"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "approved",
                "header": {
                  "en": "Approved",
                  "fa": "تأییدشده"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "pending",
                "header": {
                  "en": "Pending Approval",
                  "fa": "در انتظار تأیید"
                },
                "width": 140,
                "type": "number"
              },
              {
                "key": "approvedPercent",
                "header": {
                  "en": "Approved %",
                  "fa": "درصد تأیید"
                },
                "width": 120,
                "type": "number"
              }
            ]
          }
        },
        {
          "id": "h-widgets",
          "component": "content-blocks",
          "options": {
            "id": "h-widgets",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "My Dashboard",
                  "fa": "داشبورد من"
                }
              }
            ]
          }
        },
        {
          "id": "customize",
          "component": "content-blocks",
          "options": {
            "id": "customize",
            "blocks": [
              {
                "type": "link",
                "href": "/p/dashboard-settings",
                "text": {
                  "en": "Customize",
                  "fa": "شخصی‌سازی"
                }
              }
            ]
          }
        },
        {
          "id": "widgets",
          "component": "data-grid",
          "options": {
            "id": "home-widgets",
            "url": "/d/home-widgets",
            "idField": "title",
            "pageSize": 10,
            "height": 320,
            "columns": [
              {
