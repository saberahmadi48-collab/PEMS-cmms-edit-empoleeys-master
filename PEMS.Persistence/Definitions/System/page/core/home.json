          }
        },
        {
          "id": "t-contracts",
          "component": "kpi-tile",
          "options": {
            "label": {
              "en": "Active Contracts",
              "fa": "قراردادهای فعال"
            },
            "icon": "bi-file-earmark-ruled"
          },
          "bindings": {
            "record": {
              "source": "/d/home-kpis",
              "first": true,
              "map": {
                "value": "activeContracts"
              }
            }
          }
        },
        {
          "id": "t-work-orders",
          "component": "kpi-tile",
          "options": {
            "label": {
              "en": "Open Work Orders (CMMS)",
              "fa": "دستورکارهای باز (CMMS)"
            },
            "icon": "bi-clipboard-check"
          },
          "bindings": {
            "record": {
              "source": "/d/home-kpis",
              "first": true,
              "map": {
                "value": "openWorkOrders"
              }
            }
