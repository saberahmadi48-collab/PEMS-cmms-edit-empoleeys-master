{
  "kind": "page",
  "key": "home",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Dashboard",
    "fa": "داشبورد"
  },
  "description": {
    "en": "Home dashboard: counts, my work, documents by status, discipline performance and my widgets (page definition)",
    "fa": "داشبورد اصلی: شمارنده‌ها، کارهای من، مدارک بر اساس وضعیت، عملکرد دیسیپلین‌ها و ویجت‌های من (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "home",
    "regions": {
      "content": [
        {
          "id": "h-attention",
          "component": "content-blocks",
          "options": {
            "id": "h-attention",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "What requires your attention",
                  "fa": "موارد نیازمند توجه شما"
                }
              }
            ]
          }
        },
        {
          "id": "attention",
          "component": "data-grid",
          "options": {
            "id": "home-attention",
            "url": "/d/home-attention",
            "idField": "name",
            "pageSize": 10,
            "height": 280,
            "columns": [
              {
                "key": "name",
                "header": {
                  "en": "Item",
                  "fa": "مورد"
                },
                "width": 420
              },
              {
                "key": "count",
                "header": {
                  "en": "Count",
                  "fa": "تعداد"
                },
                "width": 120
              },
              {
                "key": "_actions",
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                },
                "type": "actions",
                "width": 110,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "open",
                    "label": {
                      "en": "Open",
                      "fa": "باز کردن"
                    },
                    "url": "{raw.url}",
                    "method": "get"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "t-projects",
          "component": "kpi-tile",
          "options": {
            "label": {
              "en": "Active Projects",
              "fa": "پروژه‌های فعال"
            },
            "icon": "bi-kanban",
            "tone": "primary"
          },
          "bindings": {
            "record": {
              "source": "/d/home-kpis",
              "first": true,
              "map": {
                "value": "projects"
              }
            }
          }
        },
        {
          "id": "t-documents",
          "component": "kpi-tile",
          "options": {
            "label": {
              "en": "Engineering Documents",
              "fa": "مدارک مهندسی"
            },
            "icon": "bi-file-earmark-text"
          },
          "bindings": {
            "record": {
              "source": "/d/home-kpis",
              "first": true,
              "map": {
                "value": "documents"
              }
            }
          }
        },
        {
          "id": "t-pending",
          "component": "kpi-tile",
          "options": {
            "label": {
              "en": "Pending Approval",
              "fa": "در انتظار تأیید"
            },
            "icon": "bi-hourglass-split",
            "tone": "warning"
          },
          "bindings": {
            "record": {
              "source": "/d/home-kpis",
              "first": true,
              "map": {
                "value": "pendingApproval"
              }
            }
          }
        },
        {
          "id": "t-rejected",
          "component": "kpi-tile",
          "options": {
            "label": {
              "en": "Rejected Documents",
              "fa": "مدارک ردشده"
            },
            "icon": "bi-x-circle",
            "tone": "danger"
