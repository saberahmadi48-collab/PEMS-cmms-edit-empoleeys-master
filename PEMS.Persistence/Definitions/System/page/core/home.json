            "icon": "bi-send"
          },
          "bindings": {
            "record": {
              "source": "/d/home-kpis",
              "first": true,
              "map": {
                "value": "transmittals"
              }
            }
          }
        },
        {
          "id": "h-status",
          "component": "content-blocks",
          "options": {
            "id": "h-status",
            "blocks": [
              {
                "type": "heading",
                "level": 6,
                "text": {
                  "en": "Documents by Status",
                  "fa": "مدارک بر اساس وضعیت"
                }
              }
            ]
          }
        },
