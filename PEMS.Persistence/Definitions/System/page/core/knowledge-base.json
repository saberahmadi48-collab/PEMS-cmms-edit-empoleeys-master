    "args": {
      "id": "knowledge-base",
      "url": "/d/knowledge-base-grid",
      "idField": "sourceId",
      "columns": [
        {
          "key": "similarityScore",
          "header": {
            "en": "Relevance",
            "fa": "ارتباط"
          },
          "width": 120,
          "type": "number"
        },
        {
          "key": "sourceType",
          "header": {
            "en": "Source",
            "fa": "منبع"
          },
          "width": 180
        },
        {
          "key": "sourceId",
          "header": {
            "en": "Id",
            "fa": "شناسه"
          },
          "width": 100,
          "type": "number"
        },
        {
          "key": "content",
          "header": {
            "en": "Content",
            "fa": "محتوا"
          },
          "width": 640
