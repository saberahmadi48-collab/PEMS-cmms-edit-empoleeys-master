{
  "kind": "page",
  "key": "knowledge-base",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Knowledge base semantic search",
    "fa": "جستجوی معنایی پایگاه دانش"
  },
  "description": {
    "en": "Semantic search over the AI summaries of the system (page definition)",
    "fa": "جستجوی معنایی روی خلاصه‌های هوش مصنوعی سیستم (تعریف صفحه)"
  },
  "payload": {
    "layout": "list-page",
    "route": "knowledge-base",
