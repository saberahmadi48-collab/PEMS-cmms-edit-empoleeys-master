{
  "kind": "page",
  "key": "qualifications",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Qualifications",
    "fa": "صلاحیت‌ها"
  },
  "description": {
    "en": "Qualifications list (page definition)",
    "fa": "فهرست صلاحیت‌ها (تعریف صفحه)"
  },
  "payload": {
    "layout": "list-page",
    "route": "qualifications",
    "template": "entity-list",
    "args": {
      "id": "qualifications",
      "url": "/d/qualifications-grid",
      "idField": "qualificationId",
      "viewsKey": "qualifications",
      "columns": [
        {
          "key": "name",
          "header": {
            "en": "Name",
            "fa": "نام"
          },
          "width": 260
        },
        {
          "key": "discipline",
          "header": {
            "en": "Discipline",
            "fa": "دیسیپلین"
          },
          "width": 180
        },
        {
          "key": "description",
          "header": {
            "en": "Description",
            "fa": "توضیحات"
          },
          "width": 320
        },
        {
          "key": "isActive",
          "header": {
            "en": "Active",
            "fa": "فعال"
          },
          "width": 100,
          "type": "bool"
        },
        {
          "key": "_actions",
          "header": {
            "en": "Actions",
            "fa": "عملیات"
          },
          "type": "actions",
          "width": 280,
          "sortable": false,
          "filterable": false,
          "actions": [
            {
              "key": "edit",
              "label": {
                "en": "Edit",
                "fa": "ویرایش"
              },
              "url": "/f/qualifications-edit/{id}",
              "method": "get"
            },
            {
              "key": "toggle",
              "label": {
                "en": "Activate / deactivate",
                "fa": "فعال / غیرفعال"
              },
              "url": "/a/qualifications-toggle",
              "method": "post",
              "confirm": {
                "en": "Change the status?",
                "fa": "وضعیت تغییر کند؟"
              }
            }
          ]
        }
      ],
      "newUrl": "/f/qualifications-create",
      "newLabel": {
        "en": "New qualification",
        "fa": "صلاحیت جدید"
      }
    }
  }
}