              "url": "/a/uoms-toggle",
              "method": "post",
              "confirm": {
                "en": "Change the status?",
                "fa": "وضعیت تغییر کند؟"
              }
            }
          ]
        }
      ],
      "newUrl": "/f/uoms-create",
