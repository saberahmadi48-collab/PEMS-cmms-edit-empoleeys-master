          },
          "width": 140
        },
        {
          "key": "name",
          "header": {
            "en": "Name",
            "fa": "نام"
          },
          "width": 240
        },
        {
          "key": "description",
          "header": {
            "en": "Description",
            "fa": "توضیحات"
          },
          "width": 300
        },
        {
          "key": "conversionFactor",
          "header": {
            "en": "Conversion factor",
            "fa": "ضریب تبدیل"
          },
          "width": 140,
          "type": "number"
