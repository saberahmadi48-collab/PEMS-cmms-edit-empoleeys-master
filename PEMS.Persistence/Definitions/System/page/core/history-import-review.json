{
  "kind": "page",
  "key": "history-import-review",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Review: Maintenance History Import",
    "fa": "بررسی: ورود سوابق نگهداری"
  },
  "description": {
    "en": "One staged batch with its rows and the commit and discard commands (page definition)",
    "fa": "یک دسته با ردیف‌ها و دستورهای تأیید و دور ریختن (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "history-import-review",
    "regions": {
      "content": [
        {
          "id": "filters",
          "component": "page-filters",
          "options": {
            "id": "history-import-filters",
            "resetUrl": "/p/history-import-review?batchId={{params.batchId}}",
            "fields": [
              {
                "name": "status",
                "label": {
                  "en": "Row status",
                  "fa": "وضعیت ردیف"
                },
                "kind": "select",
                "value": "{{params.status}}",
                "options": [
                  {
                    "value": "New",
                    "label": {
                      "en": "New",
                      "fa": "جدید"
                    }
                  },
                  {
                    "value": "Duplicate",
                    "label": {
                      "en": "Duplicate",
                      "fa": "تکراری"
                    }
                  },
                  {
                    "value": "UnresolvedEquipment",
                    "label": {
                      "en": "UnresolvedEquipment",
                      "fa": "تجهیز نامشخص"
                    }
                  },
                  {
                    "value": "ConflictEquipment",
                    "label": {
                      "en": "ConflictEquipment",
                      "fa": "تجهیز متعارض"
                    }
                  },
                  {
                    "value": "ValidationError",
                    "label": {
                      "en": "ValidationError",
                      "fa": "خطای اعتبارسنجی"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "actions",
          "component": "content-blocks",
          "options": {
            "id": "actions",
            "blocks": [
              {
                "type": "link",
                "href": "/f/history-import-commit?batchId={{params.batchId}}",
                "text": {
                  "en": "Commit the batch",
                  "fa": "تأیید دسته"
                }
              },
              {
                "type": "link",
                "href": "/f/history-import-discard?batchId={{params.batchId}}",
                "text": {
                  "en": "Discard the batch",
                  "fa": "دور ریختن دسته"
                }
              },
              {
                "type": "link",
                "href": "/p/history-import",
                "text": {
                  "en": "Back to the batches",
                  "fa": "بازگشت به دسته‌ها"
                }
              }
            ]
          }
        },
        {
          "id": "batch",
          "component": "data-grid",
          "options": {
            "id": "batch",
            "url": "/d/history-import-batch?f.batchId={{params.batchId}}",
            "idField": "batchId",
            "columns": [
              {
                "key": "fileName",
                "header": {
                  "en": "File",
                  "fa": "فایل"
                },
                "width": 260
              },
              {
                "key": "importDate",
                "header": {
                  "en": "Imported",
                  "fa": "تاریخ"
                },
                "width": 140,
                "type": "date"
              },
              {
                "key": "status",
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                },
                "width": 110
              },
              {
                "key": "importedBy",
                "header": {
                  "en": "By",
                  "fa": "توسط"
                },
                "width": 160
              },
              {
                "key": "totalRows",
                "header": {
                  "en": "Rows",
                  "fa": "ردیف"
                },
                "width": 80,
                "type": "number"
              },
              {
                "key": "newCount",
                "header": {
                  "en": "New",
                  "fa": "جدید"
                },
                "width": 80,
                "type": "number"
              },
              {
                "key": "duplicateCount",
                "header": {
                  "en": "Duplicate",
                  "fa": "تکراری"
                },
                "width": 90,
                "type": "number"
              },
              {
                "key": "unresolvedCount",
                "header": {
                  "en": "Unresolved",
                  "fa": "نامشخص"
                },
                "width": 100,
                "type": "number"
              },
              {
                "key": "conflictCount",
                "header": {
                  "en": "Conflict",
                  "fa": "متعارض"
                },
                "width": 90,
                "type": "number"
              },
              {
                "key": "validationErrorCount",
                "header": {
                  "en": "Errors",
                  "fa": "خطا"
                },
                "width": 80,
                "type": "number"
              }
            ],
            "pageSize": 5,
            "height": 160
          }
        },
        {
          "id": "rows",
          "component": "data-grid",
          "options": {
            "id": "rows",
            "url": "/d/history-import-rows?f.batchId={{params.batchId}}&f.status={{params.status|url}}",
            "idField": "rowId",
            "columns": [
              {
                "key": "rowNumber",
                "header": {
                  "en": "Row",
                  "fa": "ردیف"
                },
                "width": 70,
                "type": "number"
              },
              {
                "key": "equipmentTag",
                "header": {
                  "en": "Equipment",
                  "fa": "تجهیز"
                },
                "width": 140
              },
              {
                "key": "equipmentDescription",
                "header": {
                  "en": "Description",
                  "fa": "شرح تجهیز"
                },
                "width": 220
              },
              {
                "key": "executionDate",
                "header": {
                  "en": "Executed",
                  "fa": "تاریخ اجرا"
                },
                "width": 130,
                "type": "date"
              },
              {
                "key": "workOrderNumber",
                "header": {
                  "en": "Work order",
                  "fa": "دستورکار"
                },
                "width": 130
              },
              {
                "key": "actionTaken",
                "header": {
                  "en": "Action taken",
                  "fa": "اقدام"
                },
                "width": 220
              },
              {
                "key": "technician",
                "header": {
                  "en": "Technician",
                  "fa": "تکنسین"
                },
                "width": 140
              },
              {
                "key": "includeInCommit",
                "header": {
                  "en": "Included",
                  "fa": "شامل"
                },
                "width": 90,
                "type": "bool"
              },
              {
                "key": "status",
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                },
                "width": 130
              },
              {
                "key": "validationStatus",
                "header": {
                  "en": "Validation",
                  "fa": "اعتبارسنجی"
                },
                "width": 110
              },
              {
                "key": "validationMessage",
                "header": {
                  "en": "Message",
                  "fa": "پیام"
                },
                "width": 280
              },
              {
                "key": "_actions",
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                },
                "type": "actions",
                "width": 160,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "toggle",
                    "label": {
                      "en": "Include / exclude",
                      "fa": "شمول / حذف"
                    },
                    "url": "/f/history-import-toggle-row?rowId={id}&batchId={{params.batchId}}&include={raw.includeInCommit}",
                    "method": "get"
                  }
                ]
              }
            ],
            "pageSize": 50,
            "height": 560
          }
        }
      ]
    },
    "permission": "MaintenanceHistoryImport.View"
  }
}