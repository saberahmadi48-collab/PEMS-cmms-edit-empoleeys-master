{
  "kind": "page",
  "key": "contract-details",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Contract",
    "fa": "قرارداد"
  },
  "description": {
    "en": "One contract with its reviews, revisions, documents, NTPs and kick-off meetings, and the workflow commands (page definition)",
    "fa": "یک قرارداد با بررسی‌ها، بازنگری‌ها، اسناد، NTP و جلسه‌ی Kick-off و دستورهای گردش کار (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "contract-details",
    "regions": {
      "content": [
        {
          "id": "record",
          "component": "record-view",
          "options": {
            "id": "contract-record",
            "fields": [
              {
                "key": "contractNo",
                "label": {
                  "en": "Contract",
                  "fa": "قرارداد"
                }
              },
              {
                "key": "status",
                "label": {
                  "en": "Status",
                  "fa": "وضعیت"
                }
              },
              {
                "key": "project",
                "label": {
                  "en": "Project",
                  "fa": "پروژه"
                }
              },
              {
                "key": "vendor",
                "label": {
                  "en": "Vendor",
                  "fa": "فروشنده"
                }
              },
              {
                "key": "scopeOfWork",
                "label": {
                  "en": "Scope of work",
                  "fa": "محدوده"
                },
                "wide": true
              },
              {
                "key": "contractValue",
                "label": {
                  "en": "Value",
                  "fa": "مبلغ"
                }
              },
              {
                "key": "currency",
                "label": {
                  "en": "Currency",
                  "fa": "ارز"
                }
              },
              {
                "key": "startDate",
                "label": {
                  "en": "Start",
                  "fa": "شروع"
                },
                "type": "date"
              },
              {
                "key": "endDate",
                "label": {
                  "en": "End",
                  "fa": "پایان"
                },
                "type": "date"
              },
              {
                "key": "purchaseOrdersCount",
                "label": {
                  "en": "Purchase orders",
                  "fa": "سفارش‌های خرید"
                }
              },
              {
                "key": "requiresInspection",
                "label": {
                  "en": "Requires inspection",
                  "fa": "نیازمند بازرسی"
                }
              },
              {
                "key": "tenderNumber",
                "label": {
                  "en": "Originating tender",
                  "fa": "مناقصه‌ی مبدأ"
                }
              },
              {
                "key": "packageNumber",
                "label": {
                  "en": "Package",
                  "fa": "پکیج"
                }
              }
            ]
          },
          "bindings": {
            "record": {
              "source": "/d/contract-head",
              "idField": "contractId",
              "id": "{{params.id}}"
            }
          }
        },
        {
          "id": "actions",
          "component": "content-blocks",
          "options": {
            "id": "actions",
            "blocks": [
              {
                "type": "link",
                "href": "/f/contract-submit-for-review?contractId={{params.id}}",
                "text": {
                  "en": "Submit for review",
                  "fa": "ارسال برای بررسی"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-record-discipline-review?contractId={{params.id}}",
                "text": {
                  "en": "Record a discipline review",
                  "fa": "ثبت بررسی دیسیپلین"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-approve?contractId={{params.id}}",
                "text": {
                  "en": "Approve",
                  "fa": "تأیید"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-reject?contractId={{params.id}}",
                "text": {
                  "en": "Reject",
                  "fa": "رد"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-sign?contractId={{params.id}}",
                "text": {
                  "en": "Sign",
                  "fa": "امضا"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-mark-effective?contractId={{params.id}}",
                "text": {
                  "en": "Mark effective",
                  "fa": "اجراپذیر کردن"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-request-revision?contractId={{params.id}}",
                "text": {
                  "en": "Request a revision",
                  "fa": "درخواست بازنگری"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-complete?contractId={{params.id}}",
                "text": {
                  "en": "Complete",
                  "fa": "تکمیل"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-terminate?contractId={{params.id}}",
                "text": {
                  "en": "Terminate",
                  "fa": "فسخ"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-add-document?contractId={{params.id}}",
                "text": {
                  "en": "Add a document",
                  "fa": "افزودن سند"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-issue-ntp?contractId={{params.id}}",
                "text": {
                  "en": "Issue the NTP",
                  "fa": "صدور NTP"
                }
              },
              {
                "type": "link",
                "href": "/f/contract-schedule-kickoff?contractId={{params.id}}",
                "text": {
                  "en": "Schedule the kick-off",
                  "fa": "برنامه‌ریزی Kick-off"
                }
              },
              {
                "type": "link",
                "href": "/p/contracts",
                "text": {
                  "en": "Back to the list",
                  "fa": "بازگشت به فهرست"
                }
              }
            ]
          }
        },
        {
          "id": "reviews",
          "component": "def:related-table",
          "options": {
            "id": "reviews",
            "title": {
              "en": "Discipline reviews",
              "fa": "بررسی دیسیپلین‌ها"
            },
            "url": "/d/contract-reviews?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "disciplineRole",
                "header": {
                  "en": "Discipline",
                  "fa": "دیسیپلین"
                },
                "width": 180
              },
              {
                "key": "isRequired",
                "header": {
                  "en": "Required",
                  "fa": "الزامی"
                },
                "width": 90,
                "type": "bool"
              },
              {
                "key": "reviewer",
                "header": {
                  "en": "Reviewer",
                  "fa": "بررسی‌کننده"
                },
                "width": 180
              },
              {
                "key": "decision",
                "header": {
                  "en": "Decision",
                  "fa": "تصمیم"
                },
                "width": 110
              },
              {
                "key": "comment",
                "header": {
                  "en": "Comment",
                  "fa": "توضیح"
                },
