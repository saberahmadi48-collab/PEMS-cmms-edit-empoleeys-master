            "title": {
              "en": "NTPs",
              "fa": "NTPها"
            },
            "url": "/d/contract-ntps?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "ntpNumber",
                "header": {
                  "en": "NTP",
                  "fa": "NTP"
                },
                "width": 140
              },
              {
                "key": "issuedDate",
                "header": {
                  "en": "Issued",
