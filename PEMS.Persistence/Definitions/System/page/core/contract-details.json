              "fa": "بازنگری‌ها"
            },
            "url": "/d/contract-revisions?f.id={{params.id|url}}",
            "idField": "id",
            "columns": [
              {
                "key": "revisionNo",
                "header": {
                  "en": "No",
                  "fa": "شماره"
                },
                "width": 70,
                "type": "number"
              },
              {
                "key": "changeType",
                "header": {
                  "en": "Type",
                  "fa": "نوع"
                },
                "width": 110
              },
              {
                "key": "previousValue",
                "header": {
                  "en": "Previous",
                  "fa": "قبلی"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "newValue",
                "header": {
                  "en": "New",
                  "fa": "جدید"
                },
                "width": 110,
                "type": "number"
              },
              {
                "key": "reason",
                "header": {
                  "en": "Reason",
                  "fa": "دلیل"
                },
                "width": 240
              },
              {
                "key": "requestedBy",
                "header": {
                  "en": "Requested by",
                  "fa": "درخواست"
                },
                "width": 160
              },
              {
                "key": "approvedBy",
                "header": {
                  "en": "Approved by",
                  "fa": "تأیید"
                },
                "width": 160
              },
              {
                "key": "status",
                "header": {
                  "en": "Status",
                  "fa": "وضعیت"
                },
                "width": 100
              },
              {
                "key": "_actions",
                "header": {
                  "en": "Actions",
                  "fa": "عملیات"
                },
                "type": "actions",
                "width": 120,
                "sortable": false,
                "filterable": false,
                "actions": [
                  {
                    "key": "approve",
                    "label": {
                      "en": "Approve",
                      "fa": "تأیید"
                    },
                    "url": "/f/contract-approve-revision?contractId={{params.id}}&contractRevisionId={id}",
                    "method": "get"
                  }
                ]
              }
            ]
          }
        },
        {
