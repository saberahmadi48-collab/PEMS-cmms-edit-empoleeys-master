{
  "kind": "page",
  "key": "departments",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Departments",
    "fa": "دپارتمان‌ها"
  },
  "description": {
    "en": "Departments list (page definition)",
    "fa": "فهرست دپارتمان‌ها (تعریف صفحه)"
  },
  "payload": {
    "layout": "list-page",
    "route": "departments",
    "template": "entity-list",
    "args": {
      "id": "departments",
      "url": "/d/departments-grid",
      "idField": "departmentId",
      "viewsKey": "departments",
      "columns": [
        {
          "key": "code",
          "header": {
            "en": "Code",
            "fa": "کد"
          },
          "width": 140
        },
        {
          "key": "name",
          "header": {
            "en": "Name",
            "fa": "نام"
          },
          "width": 260
        },
        {
          "key": "description",
          "header": {
            "en": "Description",
            "fa": "توضیحات"
          },
          "width": 320
        },
        {
          "key": "employees",
          "header": {
            "en": "Active employees",
            "fa": "کارکنان فعال"
          },
          "width": 140,
          "type": "number"
        },
        {
          "key": "isActive",
          "header": {
            "en": "Active",
            "fa": "فعال"
          },
          "width": 100,
          "type": "bool"
        },
        {
          "key": "_actions",
          "header": {
            "en": "Actions",
            "fa": "عملیات"
          },
          "type": "actions",
          "width": 280,
          "sortable": false,
          "filterable": false,
          "actions": [
            {
              "key": "edit",
              "label": {
                "en": "Edit",
                "fa": "ویرایش"
              },
              "url": "/f/departments-edit/{id}",
              "method": "get"
            },
            {
              "key": "toggle",
              "label": {
                "en": "Activate / deactivate",
                "fa": "فعال / غیرفعال"
              },
              "url": "/a/departments-toggle",
              "method": "post",
              "confirm": {
                "en": "Change the status?",
                "fa": "وضعیت تغییر کند؟"
              }
            }
          ]
        }
      ],
      "newUrl": "/f/departments-create",
      "newLabel": {
        "en": "New department",
        "fa": "دپارتمان جدید"
      }
    },
    "regions": {
      "toolbar": [
        {
          "id": "import",
          "component": "button",
          "options": {
            "label": {
              "en": "Import",
              "fa": "ایمپورت"
            },
            "tone": "neutral",
            "href": "/f/departments-import"
          }
        },
        {
          "id": "export",
          "component": "action-button",
          "options": {
            "action": "departments-export",
            "label": {
              "en": "Export",
              "fa": "خروجی"
            },
            "tone": "neutral",
            "icon": "bi-download"
          }
        }
      ]
    }
  }
}