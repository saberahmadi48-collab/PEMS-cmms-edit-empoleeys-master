{
  "kind": "page",
  "key": "engineering-dashboard",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Engineering Dashboard",
    "fa": "داشبورد مهندسی"
  },
  "description": {
    "en": "Engineering documents: summary, quality, revision pressure and risk (page definition)",
    "fa": "مدارک مهندسی: خلاصه، کیفیت، فشار بازنگری و ریسک (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "engineering-dashboard",
    "regions": {
      "content": [
        {
          "id": "filters",
          "component": "page-filters",
          "options": {
            "id": "eng-dash-filters",
            "resetUrl": "/p/engineering-dashboard",
            "fields": [
              {
                "name": "projectId",
                "label": {
                  "en": "Project",
                  "fa": "پروژه"
                },
                "kind": "select",
                "value": "{{params.projectId}}",
                "options": []
              },
              {
                "name": "disciplineId",
                "label": {
                  "en": "Discipline",
                  "fa": "دیسیپلین"
                },
                "kind": "select",
                "value": "{{params.disciplineId}}",
                "options": []
              },
              {
                "name": "minRevisionCount",
                "label": {
                  "en": "Min revision count",
                  "fa": "حداقل تعداد بازنگری"
                },
                "kind": "text",
                "value": "{{params.minRevisionCount}}"
              }
            ]
          },
          "bindings": {
            "filterOptions": [
              {
                "field": "projectId",
                "source": "/d/eng-dash-projects",
                "valueField": "value",
                "labelField": "label"
              },
              {
                "field": "disciplineId",
                "source": "/d/eng-dash-disciplines",
                "valueField": "value",
                "labelField": "label"
              }
            ]
          }
        },
