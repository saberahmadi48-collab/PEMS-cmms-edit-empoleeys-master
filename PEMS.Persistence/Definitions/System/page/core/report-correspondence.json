{
  "kind": "page",
  "key": "report-correspondence",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Correspondence reports",
    "fa": "گزارش‌های مکاتبات"
  },
  "description": {
    "en": "Letters, referrals and senders (page definition)",
    "fa": "نامه‌ها، ارجاع‌ها و فرستندگان (تعریف صفحه)"
  },
  "payload": {
    "layout": "detail-page",
    "route": "report-correspondence",
    "regions": {
      "content": [
        {
          "id": "filters",
          "component": "page-filters",
          "options": {
            "id": "report-correspondence-filters",
            "resetUrl": "/p/report-correspondence",
            "fields": [
              {
                "name": "projectId",
                "label": {
                  "en": "Project",
                  "fa": "پروژه"
                },
                "kind": "select",
                "value": "{{params.projectId}}"
              },
              {
                "name": "disciplineId",
                "label": {
                  "en": "Discipline",
                  "fa": "دیسیپلین"
                },
                "kind": "select",
                "value": "{{params.disciplineId}}"
              },
              {
                "name": "fromDate",
                "label": {
                  "en": "From",
                  "fa": "از تاریخ"
                },
                "kind": "date",
                "value": "{{params.fromDate}}"
              },
              {
                "name": "toDate",
                "label": {
                  "en": "To",
                  "fa": "تا تاریخ"
                },
                "kind": "date",
                "value": "{{params.toDate}}"
              }
            ]
          },
          "bindings": {
            "filterOptions": [
              {
                "field": "projectId",
                "source": "/d/report-projects",
                "valueField": "value",
                "labelField": "label"
              },
              {
                "field": "disciplineId",
                "source": "/d/report-disciplines",
                "valueField": "value",
                "labelField": "label"
              }
            ]
          }
        },
        {
          "id": "chart-volume-by-month",
          "component": "def:entity-chart",
          "options": {
            "url": "/d/report-correspondence-chart-volume-by-month?f.projectId={{params.projectId|url}}&f.disciplineId={{params.disciplineId|url}}&f.fromDate={{params.fromDate|url}}&f.toDate={{params.toDate|url}}",
            "labelField": "name",
            "series": [
              {
                "field": "number",
                "name": {
                  "en": "Incoming",
                  "fa": "ورودی"
                }
              },
              {
                "field": "number2",
                "name": {
                  "en": "Outgoing",
                  "fa": "خروجی"
                }
              }
            ],
            "kind": "bar",
            "ariaLabel": {
              "en": "Volume by month",
              "fa": "حجم به تفکیک ماه"
            }
          }
        },
        {
          "id": "chart-by-discipline",
          "component": "def:entity-chart",
          "options": {
            "url": "/d/report-correspondence-chart-by-discipline?f.projectId={{params.projectId|url}}&f.disciplineId={{params.disciplineId|url}}&f.fromDate={{params.fromDate|url}}&f.toDate={{params.toDate|url}}",
            "labelField": "name",
            "series": [
              {
                "field": "number",
                "name": {
                  "en": "Count",
                  "fa": "تعداد"
                }
              }
            ],
            "kind": "hbar",
            "ariaLabel": {
              "en": "By discipline",
              "fa": "بر اساس دیسیپلین"
            }
          }
        },
        {
          "id": "chart-by-status",
          "component": "def:entity-chart",
          "options": {
            "url": "/d/report-correspondence-chart-by-status?f.projectId={{params.projectId|url}}&f.disciplineId={{params.disciplineId|url}}&f.fromDate={{params.fromDate|url}}&f.toDate={{params.toDate|url}}",
            "labelField": "name",
            "series": [
              {
                "field": "number",
                "name": {
                  "en": "Count",
                  "fa": "تعداد"
                }
              }
            ],
            "kind": "donut",
            "ariaLabel": {
              "en": "By status",
              "fa": "بر اساس وضعیت"
            }
          }
        },
        {
          "id": "report-correspondence-rows",
          "component": "data-grid",
          "options": {
            "id": "report-correspondence-rows",
            "url": "/d/report-correspondence-grid?f.projectId={{params.projectId|url}}&f.disciplineId={{params.disciplineId|url}}&f.fromDate={{params.fromDate|url}}&f.toDate={{params.toDate|url}}",
            "idField": "name",
            "columns": [
              {
                "key": "section",
                "header": {
                  "en": "Section",
                  "fa": "بخش"
                },
                "width": 260
              },
              {
                "key": "name",
                "header": {
                  "en": "Name",
                  "fa": "نام"
                },
                "width": 320
              },
              {
                "key": "value",
                "header": {
                  "en": "Value",
                  "fa": "مقدار"
                },
                "width": 220
              }
            ],
            "pageSize": 50,
            "height": 520
          }
        }
      ]
    }
  }
}