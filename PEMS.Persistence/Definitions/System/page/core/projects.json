{
  "kind": "page",
  "key": "projects",
  "appKey": "core",
  "version": 1,
  "title": {
    "en": "Projects",
    "fa": "پروژه‌ها"
  },
  "description": {
    "en": "Projects list (page definition)",
    "fa": "فهرست پروژه‌ها (تعریف صفحه)"
  },
  "payload": {
    "layout": "list-page",
    "route": "projects",
    "template": "entity-list",
    "args": {
      "id": "projects",
      "url": "/d/projects-grid",
      "idField": "projectId",
      "viewsKey": "projects",
      "columns": [
        {
          "key": "projectCode",
          "header": {
            "en": "Project code",
            "fa": "کد پروژه"
          },
          "width": 140
        },
        {
          "key": "projectName",
          "header": {
            "en": "Project name",
            "fa": "نام پروژه"
          },
          "width": 260
        },
        {
          "key": "clientName",
          "header": {
            "en": "Client",
            "fa": "کارفرما"
          },
          "width": 200
        },
        {
          "key": "location",
          "header": {
            "en": "Location",
            "fa": "محل"
          },
          "width": 180
        },
        {
          "key": "startDate",
          "header": {
            "en": "Start date",
            "fa": "تاریخ شروع"
          },
          "width": 130,
          "type": "date"
        },
        {
          "key": "endDate",
          "header": {
            "en": "End date",
            "fa": "تاریخ پایان"
          },
          "width": 130,
          "type": "date"
        },
        {
          "key": "status",
          "header": {
            "en": "Status",
            "fa": "وضعیت"
          },
          "width": 120
        },
        {
          "key": "isActive",
          "header": {
            "en": "Active",
            "fa": "فعال"
          },
          "width": 100,
          "type": "bool"
        },
        {
          "key": "_actions",
          "header": {
            "en": "Actions",
            "fa": "عملیات"
          },
          "type": "actions",
          "width": 280,
          "sortable": false,
          "filterable": false,
          "actions": [
            {
              "key": "edit",
              "label": {
                "en": "Edit",
                "fa": "ویرایش"
              },
              "url": "/f/projects-edit/{id}",
              "method": "get"
            },
            {
              "key": "toggle",
              "label": {
                "en": "Activate / deactivate",
                "fa": "فعال / غیرفعال"
              },
              "url": "/a/projects-toggle",
              "method": "post",
              "confirm": {
                "en": "Change the status?",
                "fa": "وضعیت تغییر کند؟"
              }
            }
          ]
        }
      ],
      "newUrl": "/f/projects-create",
      "newLabel": {
        "en": "New project",
        "fa": "پروژه جدید"
      }
    }
  }
}