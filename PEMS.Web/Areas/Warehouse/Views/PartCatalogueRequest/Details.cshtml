@model PEMS.Application.Interfaces.PartCatalogueDetailsDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Areas.Warehouse.Models
@inject IStringLocalizer<SharedResource> Localizer
@{
    var d = Model;
    var f = d.Form;
    var a = d.Actions;
    string L(string key) => Localizer["Pc_F_" + key].Value;
    string Label(string key) => d.Labels.TryGetValue(key, out var v) ? v : "";
    string YesNo(bool v) => v ? Localizer["Pc_Yes"].Value : Localizer["Pc_No"].Value;
    var rowVersion = d.RowVersion is { Length: > 0 } ? Convert.ToBase64String(d.RowVersion) : null;
    var warningTemp = TempData["Warning"] as string;
    const string FftName = "FREE FORMAT TEXT";
    var fft = f.Attributes.FirstOrDefault(x => string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase))?.Value?.Trim();

    string StatusPill(string status) => status switch
    {
        "Draft" => "vs-pill--neutral",
        "InApproval" => "vs-pill--info",
        "Returned" => "vs-pill--warning",
        "OrgResolution" => "vs-pill--warning",
        "Completed" => "vs-pill--success",
        _ => "vs-pill--danger"
    };
    string StepPill(string status) => status switch
    {
        "Approved" => "vs-pill--success",
        "Active" => "vs-pill--info",
        "Skipped" => "vs-pill--neutral",
        _ => "vs-pill--neutral"
    };
    string SkipText(string? reason)
    {
        if (string.IsNullOrEmpty(reason)) return "";
        var key = "Pc_Skip_" + reason.Replace(':', '_');
        var t = Localizer[key];
        return t.ResourceNotFound ? reason : t.Value;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pems-part-catalogue.css" asp-append-version="true" />
}

<div class="vs-page pc-page">
    <div class="vs-doc-head">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h2 class="pems-page-title mb-0">@(string.IsNullOrEmpty(d.RequestNumber) ? "#" + d.Id : d.RequestNumber)</h2>
            <span class="vs-pill vs-pill--info">@Localizer["Pc_Type_" + d.RequestType]</span>
            <span class="vs-pill vs-pill--icon @StatusPill(d.Status)">@Localizer["Pc_Status_" + d.Status]</span>
            @if (f.Urgent) { <span class="vs-pill vs-pill--danger vs-pill--icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Pc_Urgent"]</span> }
            @if (!string.IsNullOrEmpty(d.AssignedPartNumber)) { <span class="vs-pill vs-pill--success">@Localizer["Pc_Col_PartNo"]: @d.AssignedPartNumber</span> }
        </div>
        <div class="small text-muted mt-1">
            @L("Requester"): @d.RequesterName · @Localizer["Pc_Col_Created"]: @d.CreatedDate.ToString("yyyy-MM-dd")
            @if (d.SubmittedDate.HasValue) { <text> · @Localizer["Pc_Col_Submitted"]: @d.SubmittedDate.Value.ToString("yyyy-MM-dd")</text> }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(warningTemp)) { <div class="alert alert-warning small" role="status">@warningTemp</div> }

    <div class="vs-toolbar">
        <a asp-action="Index" class="vs-btn vs-btn--sm"><i class="bi bi-arrow-left"></i> @Localizer["Pc_Btn_Back"]</a>
        @if (a.CanEdit) { <a asp-action="Edit" asp-route-id="@d.Id" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-pencil"></i> @Localizer["Pc_Btn_Edit"]</a> }
        <div class="vs-toolbar__end">
            <a asp-action="ExportXlsx" asp-route-id="@d.Id" class="vs-btn vs-btn--sm"><i class="bi bi-file-earmark-excel"></i> @Localizer["Pc_Btn_Export_Xlsx"]</a>
            <a asp-action="ExportPdf" asp-route-id="@d.Id" class="vs-btn vs-btn--sm"><i class="bi bi-file-earmark-pdf"></i> @Localizer["Pc_Btn_Export_Pdf"]</a>
        </div>
    </div>

    @* ---------------------------------------------------- Organization Resolution Required *@
    @if (a.IsOrganizationBlocked)
    {
        <section class="vs-panel pc-card border-warning" role="alert">
            <h2 class="vs-section__title"><i class="bi bi-diagram-3"></i> @Localizer["Pc_Org_Blocked_Title"]</h2>
            <p class="mb-1">@Localizer["Pc_Org_Blocked_Body"]</p>
            @if (!string.IsNullOrEmpty(a.OrganizationBlockReason))
            {
                <p class="small text-muted mb-2"><strong>@a.OrganizationBlockReason</strong> — @Localizer["Org_Issue_" + a.OrganizationBlockReason]</p>
            }
            @if (a.CanRetryRouting)
            {
                <form asp-action="RetryRouting" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@d.Id" />
                    @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
                    <button type="submit" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-arrow-repeat"></i> @Localizer["Pc_Btn_RetryRouting"]</button>
                </form>
            }
            <div class="form-text">@Localizer["Pc_Org_Blocked_Hint"]</div>
        </section>
    }

    @* ---------------------------------------------------- اقدام گام جاری *@
    @if (a.CanApprove || a.CanReturn || a.CanCancel && d.Status == "InApproval")
    {
        <section class="vs-panel pc-card pc-action-panel">
            <h2 class="vs-section__title"><i class="bi bi-check2-square"></i> @Localizer["Pc_Det_ActionPanel"]
                @if (!string.IsNullOrEmpty(a.ActiveStepKey)) { <span class="vs-pill vs-pill--info ms-2">@Localizer["Pc_Step_" + a.ActiveStepKey]</span> }
            </h2>
            @if (a.IsAdminOverride) { <div class="alert alert-warning small py-1">@Localizer["Pc_Det_AdminOverride"]</div> }

            <form asp-action="Execute" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@d.Id" />
                @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
                @if (a.RequiresPartNumber)
                {
                    <div class="col-md-3">
                        <label class="form-label" for="pc_partNumber">@L("PartNumber") <span class="pc-req" aria-hidden="true">*</span></label>
                        <input id="pc_partNumber" name="partNumber" class="form-control form-control-sm" maxlength="50" autocomplete="off" />
                        <div class="form-text">@Localizer["Pc_Hint_PartNumber"]</div>
                    </div>
                }
                <div class="col">
                    <label class="form-label" for="pc_comment">@L("Comment")</label>
                    <input id="pc_comment" name="comment" class="form-control form-control-sm" maxlength="2000" />
                    <div class="form-text">@Localizer["Pc_Hint_CommentRequired"]</div>
                </div>
                <div class="col-auto d-flex gap-2">
                    @if (a.CanApprove) { <button type="submit" name="action" value="Approve" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-check-lg"></i> @Localizer["Pc_Btn_Approve"]</button> }
                    @if (a.CanReturn) { <button type="submit" name="action" value="Return" class="vs-btn vs-btn--sm"><i class="bi bi-arrow-return-left"></i> @Localizer["Pc_Btn_Return"]</button> }
                    @if (a.CanCancel) { <button type="submit" name="action" value="Cancel" class="vs-btn vs-btn--sm vs-btn--danger" onclick="return confirm(this.dataset.confirm);" data-confirm="@Localizer["Pc_Confirm_Cancel"]"><i class="bi bi-x-circle"></i> @Localizer["Pc_Btn_Cancel"]</button> }
                </div>
            </form>
        </section>
    }
    else if (a.CanCancel)
    {
        <form asp-action="Execute" method="post" class="mb-3" onsubmit="return confirm(this.dataset.confirm);" data-confirm="@Localizer["Pc_Confirm_Cancel"]">
            <input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="action" value="Cancel" />
            @if (rowVersion != null) { <input type="hidden" name="rowVersion" value="@rowVersion" /> }
            <button type="submit" class="vs-btn vs-btn--sm vs-btn--danger"><i class="bi bi-x-circle"></i> @Localizer["Pc_Btn_Cancel"]</button>
        </form>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-card-checklist"></i> @Localizer["Pc_Sec_PartInfo"]</h2>
                <dl class="pc-dl">
                    <dt>@L("SectionId")</dt><dd>@Label("SectionId")</dd>
                    <dt>@L("TechnicalClassId")</dt><dd>@Label("TechnicalClassId")</dd>
                    @* تعریف (Definition) کلاس فنی فقط برای راهنمایی هنگام تکمیل پیش‌نویس است؛ پس از ثبت (در جریان تأیید/برگشتی/تکمیل/لغو) نمایش داده نمی‌شود. *@
                    @if (d.Status == "Draft" && !string.IsNullOrEmpty(d.TechnicalClassLongDescription)) { <dt></dt><dd class="small text-muted">@d.TechnicalClassLongDescription</dd> }
                    <dt>@L("AssetType")</dt><dd>@Localizer["Pc_Asset_" + f.AssetType]</dd>
                    <dt>@L("CommodityGroup1Id")</dt><dd>@Label("CommodityGroup1Id")</dd>
                    <dt>@L("CommodityGroup2Id")</dt><dd>@Label("CommodityGroup2Id")</dd>
                    <dt>@L("ProductFamilyId")</dt><dd>@Label("ProductFamilyId")</dd>
                    <dt>@L("UnitOfMeasureId")</dt><dd>@Label("UnitOfMeasureId")</dd>
                    <dt>@L("ManufacturerId")</dt><dd>@Label("ManufacturerId") @if (f.IsNewManufacturer) { <span class="vs-pill vs-pill--warning">@L("IsNewManufacturer")</span> }</dd>
                    <dt>@L("ManufacturerPartNumber")</dt><dd>@f.ManufacturerPartNumber</dd>
                    <dt>@L("SupplierId")</dt><dd>@Label("SupplierId") @f.SupplierPartNumber</dd>
                    <dt>@L("PartPrice")</dt><dd>@(f.PartPrice.HasValue ? f.PartPrice.Value.ToString("N2") + " " + Label("CurrencyId") : "")</dd>
                    <dt>@L("TypeDesignationId")</dt><dd>@Label("TypeDesignationId")</dd>
                    <dt>@L("IsCritical")</dt><dd>@YesNo(d.IsCritical)</dd>
                    <dt>@L("IsCapital")</dt><dd>@YesNo(d.IsCapital)</dd>
                    <dt>@L("SparePartSerialNo")</dt><dd>@f.SparePartSerialNo</dd>
                    <dt>@L("EquipmentSerialNo")</dt><dd>@f.EquipmentSerialNo</dd>
                    <dt>@L("ManufacturerDrawingNo")</dt><dd>@f.ManufacturerDrawingNo</dd>
                    <dt>@L("DocumentNo")</dt><dd>@f.DocumentNo</dd>
                    @if (d.RequestType == "Change")
                    {
                        <dt>@L("IsRd")</dt><dd>@YesNo(f.IsRd)</dd>
                        <dt>@L("ExistingPartNumber")</dt><dd>@f.ExistingPartNumber</dd>
                        <dt>@L("ChangesMatchInventory")</dt><dd>@(f.ChangesMatchInventory.HasValue ? YesNo(f.ChangesMatchInventory.Value) : "")</dd>
                    }
                </dl>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><i class="bi bi-box-seam"></i> @Localizer["Pc_Sec_Planning"]</h2>
                <dl class="pc-dl">
                    <dt>@L("PlanningMethodId")</dt><dd>@Label("PlanningMethodId")</dd>
                    <dt>@L("MinimumStock")</dt><dd>@f.MinimumStock</dd>
                    <dt>@L("MaxConsumptionRate")</dt><dd>@f.MaxConsumptionRate</dd>
                    <dt>@L("FirstPurchaseQuantity")</dt><dd>@f.FirstPurchaseQuantity</dd>
                    <dt>@L("PrimaryIssuedRequired")</dt><dd>@YesNo(f.PrimaryIssuedRequired)</dd>
                    <dt>@L("IssuedQty")</dt><dd>@f.IssuedQty</dd>
                    <dt>@L("StockGradeId")</dt><dd>@Label("StockGradeId")</dd>
                    <dt>@L("WantedReceiptDate")</dt><dd>@f.WantedReceiptDate?.ToString("yyyy-MM-dd")</dd>
                    <dt>@L("StorageVolume")</dt><dd>@f.StorageVolume</dd>
                </dl>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><i class="bi bi-diagram-3"></i> @L("Attributes")</h2>
                <dl class="pc-dl">
                    <dt>@FftName</dt><dd class="pc-fft-view">@fft</dd>
                    @foreach (var at in f.Attributes.Where(x => !string.Equals(x.Name, FftName, StringComparison.OrdinalIgnoreCase)))
                    { <dt>@at.Name</dt><dd>@at.Value</dd> }
                </dl>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-signpost-split"></i> @Localizer["Pc_Det_Route"]</h2>
                @if (!d.Steps.Any()) { <div class="text-muted small">@Localizer["Pc_Det_NoRoute"]</div> }
                <ol class="pc-route list-unstyled mb-0">
                    @foreach (var st in d.Steps)
                    {
                        <li class="pc-route-step @("pc-step-" + st.Status.ToLowerInvariant())">
                            <span class="vs-pill vs-pill--icon @StepPill(st.Status)">@Localizer["Pc_StepStatus_" + st.Status]</span>
                            <strong>@Localizer["Pc_Step_" + st.StepKey]</strong>
                            @if (!string.IsNullOrEmpty(st.AssignedName)) { <div class="small text-muted">@st.AssignedName</div> }
                            @if (st.Status == "Skipped") { <div class="small text-muted">@SkipText(st.SkipReason)</div> }
                            @if (st.DecidedDate.HasValue) { <div class="small text-muted vs-num">@st.DecidedDate.Value.ToString("yyyy-MM-dd HH:mm")</div> }
                        </li>
                    }
                </ol>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><i class="bi bi-gear-wide-connected"></i> @Localizer["Pc_Sec_Equipment"]</h2>
                @if (!d.Equipment.Any()) { <div class="text-muted small">@Localizer["Pc_Empty_Equipment"]</div> }
                <ul class="list-unstyled small mb-0">
                    @foreach (var q in d.Equipment) { <li>@q.Text <span class="text-muted">× @q.InstalledQuantity.ToString("0.####")</span></li> }
                </ul>
            </section>

            <section class="vs-panel pc-card mt-3">
                <h2 class="vs-section__title"><i class="bi bi-paperclip"></i> @L("Attachments")</h2>
                @if (!d.Attachments.Any()) { <div class="text-muted small">@Localizer["Pc_Empty_Attachments"]</div> }
                <ul class="list-unstyled small mb-0">
                    @foreach (var at in d.Attachments)
                    {
                        <li class="d-flex justify-content-between gap-2 border-bottom py-1">
                            <a asp-action="Download" asp-route-id="@d.Id" asp-route-attachmentId="@at.Id" class="text-truncate">@at.FileName</a>
                            <span class="text-muted">@Localizer["Pc_Kind_" + at.Kind]</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <div class="col-12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-clock-history"></i> @Localizer["Pc_Det_History"]</h2>
                <div class="pc-table-scroll">
                    <table class="table table-sm table-enterprise vs-dense mb-0">
                        <thead><tr><th>@Localizer["Pc_Col_Date"]</th><th>@Localizer["Pc_Col_Stage"]</th><th>@Localizer["Pc_Col_Action"]</th><th>@Localizer["Pc_Col_Person"]</th><th>@L("Comment")</th></tr></thead>
                        <tbody>
                        @foreach (var h in d.Approvals)
                        {
                            <tr>
                                <td class="vs-num text-nowrap">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(string.IsNullOrEmpty(h.StepKey) ? "" : Localizer["Pc_Step_" + h.StepKey].Value)</td>
                                <td>@Localizer["Pc_Action_" + h.Action]</td>
                                <td>@h.ActorName</td>
                                <td>@h.Comment</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if (!d.Approvals.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_History"]</div> }
                </div>
            </section>
        </div>

        <div class="col-12">
            <section class="vs-panel pc-card">
                <h2 class="vs-section__title"><i class="bi bi-chat-left-text"></i> @L("Notes")</h2>
                <div class="pc-table-scroll mb-2">
                    <table class="table table-sm table-enterprise vs-dense mb-0">
                        <thead><tr><th>@Localizer["Pc_Col_Date"]</th><th>@Localizer["Pc_Col_Person"]</th><th>@Localizer["Pc_Col_Stage"]</th><th>@L("Text")</th></tr></thead>
                        <tbody>
                        @foreach (var n in d.Notes)
                        {
                            <tr><td class="vs-num text-nowrap">@n.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td><td>@n.AuthorName</td><td>@(string.IsNullOrEmpty(n.StepKey) ? "" : Localizer["Pc_Step_" + n.StepKey].Value)</td><td>@n.Text</td></tr>
                        }
                        </tbody>
                    </table>
                    @if (!d.Notes.Any()) { <div class="vs-empty py-2">@Localizer["Pc_Empty_Notes"]</div> }
                </div>
                @if (d.Status is "InApproval" or "Draft" or "Returned")
                {
                    <form asp-action="AddNote" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@d.Id" />
                        <input name="text" class="form-control form-control-sm" maxlength="2000" placeholder="@Localizer["Pc_Hint_NoteReply"]" aria-label="@L("Notes")" />
                        <button type="submit" class="vs-btn vs-btn--sm"><i class="bi bi-plus-lg"></i> @Localizer["Pc_Btn_AddNote"]</button>
                    </form>
                }
            </section>
        </div>
    </div>
</div>
