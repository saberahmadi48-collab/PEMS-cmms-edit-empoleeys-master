@model IReadOnlyList<PEMS.Domain.Entities.AuditLog>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{ ViewData["HidePageTitle"] = true; }

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-clock-history"></i> @Localizer["Change History"]</h5>
        <a asp-action="Edit" asp-route-id="@ViewBag.HelpArticleId" class="btn btn-sm btn-outline-secondary">Back to article</a>
    </div>
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">No recorded changes yet.</p>
    }
    else
    {
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["When"]</th><th>@Localizer["Action"]</th><th>By</th><th>@Localizer["Changed Fields"]</th></tr></thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                        <td class="small">@(log.UserName ?? "—")</td>
                        <td class="small"><pre class="mb-0 small">@log.ChangedFieldsSummary</pre></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
