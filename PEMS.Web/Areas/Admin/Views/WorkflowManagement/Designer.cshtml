@model PEMS.Application.DTOs.WorkflowDesignerModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Application.DTOs
@inject IStringLocalizer<SharedResource> Localizer
@{
    var perms = (Dictionary<string, bool>)ViewBag.Perms;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var selStage = (int?)ViewBag.SelectedStage;
    var selTr = (int?)ViewBag.SelectedTransition;
    var addStage = (bool)ViewBag.AddStage;
    var addTr = (bool)ViewBag.AddTransition;
    var edit = Model.CanEditStructure && perms["Edit"];
    var validation = ViewBag.Validation as List<PEMS.Web.Areas.Admin.Controllers.WorkflowManagementController.ValidationRow>;
    var g = Model.Graph;
    var stageById = Model.Stages.ToDictionary(s => s.StageId);
    string SName(int? id) => id.HasValue && stageById.TryGetValue(id.Value, out var s) ? (fa && !string.IsNullOrWhiteSpace(s.NameFa) ? s.NameFa! : s.Name) : "—";
    string Trunc(string s, int n) => s.Length <= n ? s : s[..(n - 1)] + "…";
    string Fmt(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    string EdgeLabel(WorkflowGraphEdge e) => fa && !string.IsNullOrWhiteSpace(e.LabelFa) ? e.LabelFa! : (!string.IsNullOrWhiteSpace(e.Label) ? e.Label! : e.ActionType);
    var stageObj = selStage.HasValue ? Model.Stages.FirstOrDefault(s => s.StageId == selStage) : null;
    var trObj = selTr.HasValue ? Model.Transitions.FirstOrDefault(t => t.TransitionId == selTr) : null;
    string StatusBadge(string s) => s switch { "Published" => "bg-success", "Validated" => "bg-info text-dark", "Draft" => "bg-warning text-dark", "Retired" => "bg-secondary", _ => "bg-light text-dark border" };
    var displayName = fa && !string.IsNullOrWhiteSpace(Model.DefinitionNameFa) ? Model.DefinitionNameFa : Model.DefinitionName;
    var employeeMap = Model.Employees;
}
<style>
    .wf-canvas { overflow: auto; border: 1px solid var(--pems-surface-border, #dee2e6); border-radius: 8px; background: var(--pems-surface, #fff); }
    .wf-canvas svg { display: block; max-width: none; }
    .wf-canvas a { text-decoration: none; }
    .wf-node rect { fill: var(--bs-body-bg, #fff); stroke: #6c7a8d; stroke-width: 1.2; rx: 6; }
    .wf-node:hover rect, .wf-node:focus rect { stroke: #0d6efd; stroke-width: 2; }
    .wf-node.sel rect { stroke: #0d6efd; stroke-width: 2.6; fill: var(--bs-primary-bg-subtle, #eef4ff); }
    .wf-node.start rect { stroke: #198754; }
    .wf-node text { font-size: 12.5px; fill: var(--bs-body-color, #1f2d3d); pointer-events: none; }
    .wf-node .sub { font-size: 10.5px; fill: #6c7a8d; }
    .wf-edge path { fill: none; stroke: #6c7a8d; stroke-width: 1.6; }
    .wf-edge.back path { stroke: #d98c2b; stroke-dasharray: 5 3; }
    .wf-edge.terminal path { stroke: #b23b3b; }
    .wf-edge.start path { stroke: #198754; }
    .wf-edge text { font-size: 10.5px; fill: var(--bs-secondary-color, #44515f); paint-order: stroke; stroke: var(--bs-body-bg, #fff); stroke-width: 3px; }
    .wf-edge:hover path, .wf-edge.sel path { stroke: #0d6efd; stroke-width: 2.8; }
    .wf-edge.sel text { fill: #0d6efd; font-weight: 600; }
    .wf-panel label { font-size: .78rem; }
</style>
<div class="admin-page-shell">
    <div class="content-card mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="fw-semibold">@displayName</span> · <span class="badge @StatusBadge(Model.Status)">v@(Model.VersionNumber) @Localizer[Model.Status]</span>
                @if (!string.IsNullOrEmpty(Model.LastEditor) && Model.CanEditStructure) { <span class="small text-muted ms-2">@Localizer["Last editor"]: @Model.LastEditor</span> }
                @if (Model.RunningInstances > 0) { <span class="small text-muted ms-2">@Localizer["Running instances"]: @Model.RunningInstances</span> }
            </div>
            <div class="d-flex gap-1 flex-wrap">
                <a asp-action="Details" asp-route-id="@Model.DefinitionId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> @Localizer["Back"]</a>
                @if (Model.CanEditStructure && perms["Validate"])
                {
                    <form asp-action="Validate" method="post" class="d-inline"><input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><button class="btn btn-sm btn-outline-primary"><i class="bi bi-check2-square"></i> @Localizer["Validate"]</button></form>
                }
                @if (Model.CanEditStructure && perms["Publish"])
                {
                    <form asp-action="Publish" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Publish this version? Published versions are immutable."]');">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="definitionId" value="@Model.DefinitionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <button class="btn btn-sm btn-pems-solid" disabled="@(Model.Status != "Validated")" title="@(Model.Status != "Validated" ? Localizer["Validate the draft first."] : "")"><i class="bi bi-rocket-takeoff"></i> @Localizer["Publish"]</button>
                    </form>
                }
                @if (Model.CanEditStructure && perms["Edit"])
                {
                    <form asp-action="DiscardDraft" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Discard this draft? Its structure is kept for audit but it can no longer be edited."]');">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="definitionId" value="@Model.DefinitionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-octagon"></i> @Localizer["Discard draft"]</button>
                    </form>
                }
            </div>
        </div>
        @if (!Model.CanEditStructure)
        {
            <div class="alert alert-secondary small mt-2 mb-0">
                <i class="bi bi-lock"></i>
                @if (!Model.DefinitionEditable) { @Localizer["View only:"] <span> @Model.DefinitionEditableReason</span> }
                else { @Localizer["This version is {0} and immutable. To change the workflow, clone a published version into a draft.", Localizer[Model.Status].Value] }
            </div>
        }
        else
        {
            <div class="small text-muted mt-2"><i class="bi bi-people"></i> @Localizer["Four-eyes control: the last editor of this draft cannot publish it."]</div>
        }
    </div>

    @if (validation != null && validation.Count > 0)
    {
        <div class="content-card mb-3">
            <h6 class="mb-2">@Localizer["Validation"]: <span class="text-danger">@validation.Count(v => v.Severity == "Error") @Localizer["errors"]</span>, <span class="text-warning">@validation.Count(v => v.Severity == "Warning") @Localizer["warnings"]</span></h6>
            <ul class="list-unstyled small mb-0">
                @foreach (var v in validation)
                {
                    <li class="mb-1"><span class="badge @(v.Severity == "Error" ? "bg-danger" : "bg-warning text-dark")">@v.Severity</span> <code>@v.Code</code> @v.Message
                        @if (v.StageId.HasValue) { <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-stage="@v.StageId">@Localizer["Stage"]: @SName(v.StageId)</a> }
                        @if (v.TransitionId.HasValue) { <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-transition="@v.TransitionId">@Localizer["Transition"] #@v.TransitionId</a> }
                    </li>
                }
            </ul>
        </div>
    }

    <div class="row g-3">
        <div class="col-xl-8">
            <div class="content-card">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <h6 class="mb-0">@Localizer["Workflow graph"] <span class="small text-muted">(@Model.Stages.Count @Localizer["stage(s)"], @Model.Transitions.Count @Localizer["transition(s)"])</span></h6>
                    <div class="small text-muted">
                        <span style="color:#198754">▬</span> @Localizer["Start"] &nbsp; <span style="color:#6c7a8d">▬</span> @Localizer["forward"] &nbsp; <span style="color:#d98c2b">┅</span> @Localizer["return"] &nbsp; <span style="color:#b23b3b">▬</span> @Localizer["End"]
                    </div>
                </div>
                <div class="wf-canvas" dir="ltr" id="wfCanvas" role="img" aria-label="@Localizer["Workflow graph"]">
                    <svg id="wfSvg" width="@Fmt(g.Width)" height="@Fmt(g.Height)" viewBox="0 0 @Fmt(g.Width) @Fmt(g.Height)" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <marker id="wfArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" fill="#6c7a8d" /></marker>
                        </defs>
                        @foreach (var e in g.Edges)
                        {
                            var cls = "wf-edge " + e.Kind.ToLowerInvariant() + (selTr == e.TransitionId ? " sel" : "");
                            <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-transition="@e.TransitionId" class="@cls" aria-label="@EdgeLabel(e)">
                                <title>@EdgeLabel(e) (@e.ActionType)@(string.IsNullOrEmpty(e.RequiredPermission) ? "" : " · " + e.RequiredPermission)</title>
                                <path d="@e.Path" marker-end="url(#wfArrow)" />
                                <path d="@e.Path" stroke="transparent" stroke-width="12" marker-end="" />
                                <text x="@Fmt(e.LabelX)" y="@Fmt(e.LabelY)">@Trunc(EdgeLabel(e), 22)</text>
                            </a>
                        }
                        @foreach (var n in g.Nodes)
                        {
                            var nm = fa && !string.IsNullOrWhiteSpace(n.NameFa) ? n.NameFa! : n.Name;
                            <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-stage="@n.StageId" class="wf-node@(selStage == n.StageId ? " sel" : "")@(n.IsStart ? " start" : "")" aria-label="@nm">
                                <title>@nm@(string.IsNullOrEmpty(n.BusinessStatus) ? "" : " · " + n.BusinessStatus)</title>
                                <rect x="@Fmt(n.X)" y="@Fmt(n.Y)" width="@Fmt(n.W)" height="@Fmt(n.H)" />
                                <text x="@Fmt(n.X + n.W / 2)" y="@Fmt(n.Y + 21)" text-anchor="middle">@Trunc(nm, 25)</text>
                                <text class="sub" x="@Fmt(n.X + n.W / 2)" y="@Fmt(n.Y + 38)" text-anchor="middle">@(string.IsNullOrEmpty(n.BusinessStatus) ? "" : n.BusinessStatus)</text>
                            </a>
                        }
                    </svg>
                </div>
                @if (g.Nodes.Count == 0) { <p class="small text-muted mt-2 mb-0">@Localizer["This version has no stages yet."]</p> }
            </div>

            <div class="content-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">@Localizer["Stages"]</h6>
                    @if (edit) { <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-addStage="true" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> @Localizer["Add stage"]</a> }
                </div>
                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                    <thead><tr><th>#</th><th>@Localizer["Name"]</th><th>@Localizer["Persian name"]</th><th>@Localizer["Business status"]</th><th>@Localizer["Responsible role"]</th><th>@Localizer["Responsible employee"]</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Stages)
                    {
                        <tr class="@(selStage == s.StageId ? "table-primary" : "")">
                            <td>@s.StageOrder</td>
                            <td><a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-stage="@s.StageId">@s.Name</a></td>
                            <td dir="rtl">@s.NameFa</td><td>@s.BusinessStatus</td><td class="small text-break" style="min-width:170px;max-width:300px">@s.ResponsibleRole</td>
                            <td class="small">@(s.ResponsibleEmployeeId.HasValue ? (employeeMap.FirstOrDefault(e => e.Id == s.ResponsibleEmployeeId).Name ?? "#" + s.ResponsibleEmployeeId) : "")</td>
                        </tr>
                    }
                    </tbody></table></div>
            </div>

            <div class="content-card mt-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="mb-0">@Localizer["Transitions"]</h6>
                    @if (edit) { <a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-addTransition="true" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> @Localizer["Add transition"]</a> }
                </div>
                <div class="table-responsive"><table class="table table-sm align-middle mb-0">
                    <thead><tr><th>@Localizer["From"]</th><th>@Localizer["To"]</th><th>@Localizer["Action"]</th><th>@Localizer["Label"]</th><th>@Localizer["Required permission"]</th></tr></thead>
                    <tbody>
                    @foreach (var t in Model.Transitions)
                    {
                        <tr class="@(selTr == t.TransitionId ? "table-primary" : "")">
                            <td>@(t.FromStageId.HasValue ? SName(t.FromStageId) : Localizer["(start)"].Value)</td>
                            <td>@(t.ToStageId.HasValue ? SName(t.ToStageId) : Localizer["(end)"].Value)</td>
                            <td><a asp-action="Designer" asp-route-versionId="@Model.VersionId" asp-route-transition="@t.TransitionId">@t.ActionType</a></td>
                            <td class="small">@(fa && !string.IsNullOrWhiteSpace(t.LabelFa) ? t.LabelFa : t.Label)</td>
                            <td class="small">@t.RequiredPermission</td>
                        </tr>
                    }
                    </tbody></table></div>
            </div>
        </div>

        <div class="col-xl-4">
            @{
                var stageForm = stageObj ?? (addStage ? new WorkflowStageEditModel { StageOrder = 0 } : null);
                var trForm = trObj ?? (addTr ? new WorkflowTransitionEditModel { Priority = 1, ActionType = "Approve" } : null);
            }
            @if (stageForm != null)
            {
                <div class="content-card wf-panel">
                    <h6>@(stageForm.StageId == 0 ? Localizer["Add stage"] : Localizer["Stage"])</h6>
                    <form asp-action="SaveStage" method="post" class="row g-2">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="stage.StageId" value="@stageForm.StageId" />
                        <fieldset class="row g-2 m-0 p-0 border-0" disabled="@(!edit)">
                            <div class="col-12"><label>@Localizer["Name"]</label><input name="stage.Name" class="form-control form-control-sm" value="@stageForm.Name" required maxlength="200" /></div>
                            <div class="col-12"><label>@Localizer["Persian name"]</label><input name="stage.NameFa" class="form-control form-control-sm" dir="rtl" value="@stageForm.NameFa" maxlength="200" /></div>
                            <div class="col-6"><label>@Localizer["Business status"]</label><input name="stage.BusinessStatus" class="form-control form-control-sm" value="@stageForm.BusinessStatus" maxlength="50" /></div>
                            <div class="col-6"><label>@Localizer["Order"]</label><input name="stage.StageOrder" type="number" class="form-control form-control-sm" value="@stageForm.StageOrder" /></div>
                            <div class="col-12"><label>@Localizer["Responsible role"]</label>
                                <input name="stage.ResponsibleRole" class="form-control form-control-sm" list="wfRoles" value="@stageForm.ResponsibleRole" placeholder="@Localizer["Role name or Permission:Resource.Action"]" />
                                <datalist id="wfRoles">@foreach (var r in Model.Roles) { <option value="@r"></option> }@foreach (var p in Model.Permissions) { <option value="Permission:@p"></option> }</datalist></div>
                            <div class="col-12"><label>@Localizer["Responsible employee"]</label>
                                <select name="stage.ResponsibleEmployeeId" class="form-select form-select-sm"><option value="">—</option>
                                    @foreach (var e in Model.Employees) { <option value="@e.Id" selected="@(stageForm.ResponsibleEmployeeId == e.Id)">@e.Name</option> }
                                </select></div>
                            <div class="col-6"><label>@Localizer["Stage type"]</label>
                                <select name="stage.StageType" class="form-select form-select-sm">@foreach (var o in new[] { "Sequential", "Parallel" }) { <option value="@o" selected="@(stageForm.StageType == o)">@o</option> }</select></div>
                            <div class="col-6"><label>@Localizer["Approval strategy"]</label>
                                <select name="stage.ApprovalStrategy" class="form-select form-select-sm">@foreach (var o in new[] { "AllApprovalsRequired", "MandatoryRolesOnly", "MinimumCount", "FirstResponse" }) { <option value="@o" selected="@(stageForm.ApprovalStrategy == o)">@o</option> }</select></div>
                            <div class="col-6"><label>@Localizer["Minimum approvals"]</label><input name="stage.MinimumApprovalCount" type="number" min="1" class="form-control form-control-sm" value="@stageForm.MinimumApprovalCount" /></div>
                            <div class="col-6"><label>@Localizer["Timeout (hours)"]</label><input name="stage.TimeoutHours" type="number" min="1" class="form-control form-control-sm" value="@stageForm.TimeoutHours" /></div>
                            <div class="col-12"><div class="form-check"><input type="checkbox" class="form-check-input" name="stage.IsMandatory" value="true" checked="@stageForm.IsMandatory" id="stMand" /><input type="hidden" name="stage.IsMandatory" value="false" /><label class="form-check-label" for="stMand">@Localizer["Mandatory"]</label></div></div>
                            <div class="col-12"><label>@Localizer["Description"]</label><input name="stage.Description" class="form-control form-control-sm" value="@stageForm.Description" /></div>
                        </fieldset>
                        @if (edit) { <div class="col-12"><button class="btn btn-sm btn-pems-solid">@Localizer["Save stage"]</button></div> }
                    </form>
                    @if (edit && stageForm.StageId != 0)
                    {
                        <form asp-action="DeleteStage" method="post" class="mt-2" onsubmit="return confirm('@Localizer["Remove this stage and its transitions?"]');">
                            <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="stageId" value="@stageForm.StageId" />
                            <button class="btn btn-sm btn-outline-danger">@Localizer["Remove stage"]</button>
                        </form>
                    }
                </div>
            }
            else if (trForm != null)
            {
                <div class="content-card wf-panel">
                    <h6>@(trForm.TransitionId == 0 ? Localizer["Add transition"] : Localizer["Transition"])</h6>
                    <form asp-action="SaveTransition" method="post" class="row g-2">
                        <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="transition.TransitionId" value="@trForm.TransitionId" />
                        <fieldset class="row g-2 m-0 p-0 border-0" disabled="@(!edit)">
                            <div class="col-6"><label>@Localizer["From"]</label>
                                <select name="transition.FromStageId" class="form-select form-select-sm"><option value="">@Localizer["(start)"]</option>@foreach (var s in Model.Stages) { <option value="@s.StageId" selected="@(trForm.FromStageId == s.StageId)">@s.Name</option> }</select></div>
                            <div class="col-6"><label>@Localizer["To"]</label>
                                <select name="transition.ToStageId" class="form-select form-select-sm"><option value="">@Localizer["(end)"]</option>@foreach (var s in Model.Stages) { <option value="@s.StageId" selected="@(trForm.ToStageId == s.StageId)">@s.Name</option> }</select></div>
                            <div class="col-6"><label>@Localizer["Action"]</label>
                                <input name="transition.ActionType" class="form-control form-control-sm" list="wfActions" value="@trForm.ActionType" required maxlength="100" />
                                <datalist id="wfActions">@foreach (var a in Model.ActionTypes) { <option value="@a"></option> }</datalist></div>
                            <div class="col-6"><label>@Localizer["Priority"]</label><input name="transition.Priority" type="number" class="form-control form-control-sm" value="@trForm.Priority" /></div>
                            <div class="col-12"><label>@Localizer["Label"]</label><input name="transition.Label" class="form-control form-control-sm" value="@trForm.Label" maxlength="100" /></div>
                            <div class="col-12"><label>@Localizer["Persian label"]</label><input name="transition.LabelFa" class="form-control form-control-sm" dir="rtl" value="@trForm.LabelFa" maxlength="100" /></div>
                            <div class="col-12"><label>@Localizer["Required permission"]</label>
                                <input name="transition.RequiredPermission" class="form-control form-control-sm" list="wfPerms" value="@trForm.RequiredPermission" placeholder="Resource.Action" />
                                <datalist id="wfPerms">@foreach (var p in Model.Permissions) { <option value="@p"></option> }</datalist></div>
                            <div class="col-12"><label>@Localizer["Condition"]</label><input name="transition.ConditionExpression" class="form-control form-control-sm" value="@trForm.ConditionExpression" /></div>
                            <div class="col-12"><div class="form-check"><input type="checkbox" class="form-check-input" name="transition.ForbidInitiator" value="true" checked="@trForm.ForbidInitiator" id="trForbid" /><input type="hidden" name="transition.ForbidInitiator" value="false" /><label class="form-check-label" for="trForbid">@Localizer["Initiator cannot perform this action"]</label></div></div>
                        </fieldset>
                        @if (edit) { <div class="col-12"><button class="btn btn-sm btn-pems-solid">@Localizer["Save transition"]</button></div> }
                    </form>
                    @if (edit && trForm.TransitionId != 0)
                    {
                        <form asp-action="DeleteTransition" method="post" class="mt-2" onsubmit="return confirm('@Localizer["Remove this transition?"]');">
                            <input type="hidden" name="versionId" value="@Model.VersionId" /><input type="hidden" name="rowVersion" value="@Model.RowVersion" /><input type="hidden" name="transitionId" value="@trForm.TransitionId" />
                            <button class="btn btn-sm btn-outline-danger">@Localizer["Remove transition"]</button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="content-card">
                    <p class="small text-muted mb-0"><i class="bi bi-cursor"></i> @Localizer["Select a stage or a transition in the graph or the tables to inspect or edit it."]</p>
                </div>
            }
            <div class="content-card mt-3">
                <h6>@Localizer["Recent changes"]</h6>
                <ul class="list-unstyled small mb-0" style="max-height:260px;overflow:auto">
                    @foreach (var a in Model.Audit) { <li class="mb-1"><span class="text-muted">@a.Timestamp.ToString("MM-dd HH:mm")</span> · @a.Action · @a.Actor @if (!string.IsNullOrEmpty(a.Details)) { <span class="text-muted">· @a.Details</span> }</li> }
                </ul>
            </div>
        </div>
    </div>
</div>
