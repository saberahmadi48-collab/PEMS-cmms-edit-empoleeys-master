@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var equipments = (IEnumerable<dynamic>)ViewBag.Equipments;
}

<pems-page-shell kind="workspace">


<pems-content-card css="pems-s-3f7efa5f">
    <pems-form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="3"><pems-label>@Localizer["Vc_SeqNo"]</pems-label><pems-input name="SequenceNo" type="number" value="1" /></pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Vs_Project"]</pems-label>
                <pems-select name="ProjectId" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3">
                <pems-label>@Localizer["Vendor"]</pems-label>
                <pems-select name="VendorId" required>
                    @foreach (var v in vendors) { <option value="@v.VendorId">@v.Name</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-label>@Localizer["Vc_DisciplineCode"]</pems-label><pems-input name="DisciplineCodeRaw" placeholder="ME / EL / IN / PI / PM / HV / HS" /></pems-col>
            <pems-col md="4">
                <pems-label>@Localizer["Vc_RelatedEquipment"] <span class="text-muted small">@Localizer["Vd_Optional"]</span></pems-label>
                <pems-select name="EquipmentId">
                    <option value="">@Localizer["Vc_None"]</option>
                    @foreach (var eq in equipments) { <option value="@eq.EquipmentId">@eq.TagNumber</option> }
                </pems-select>
            </pems-col>
            <pems-col md="3"><pems-label>@Localizer["Vc_DocType"]</pems-label><pems-input name="DocumentTypeCode" placeholder="DWG / DSH / PRC ..." required /></pems-col>
            <pems-col md="5"><pems-label>@Localizer["Vc_DocNumber"]</pems-label><pems-input name="DocumentNumber" required /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Vc_MrNumber"]</pems-label><pems-input name="MRNumber" /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Vd_MaterialCode"] <span class="text-muted small">@Localizer["Vc_MaterialCodeHint"]</span></pems-label><pems-input name="MaterialCode" placeholder="e.g. 0611" /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Vd_TypologyCode"] <span class="text-muted small">@Localizer["Vc_TypologyHint"]</span></pems-label><pems-input name="TypologyCode" placeholder="e.g. GS, LG, IS ..." /></pems-col>
            <pems-col span="12"><pems-label>@Localizer["Vc_DocDescription"]</pems-label><pems-input name="DocumentDescription" /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Vc_ResponsibleParty"]</pems-label><pems-input name="ResponsiblePartyCode" placeholder="PJPC-Eng / QC / Procurement ..." /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Vs_Class"]</pems-label><pems-input name="DocumentClass" type="number" min="1" max="3" /></pems-col>
            <pems-col md="4"><pems-label>@Localizer["Vc_PlannedIssue"]</pems-label><pems-date name="PlannedFirstIssueDate" /></pems-col>
        </pems-row>
        <pems-action-bar css="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["Save"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </pems-action-bar>
    </pems-form>
</pems-content-card>

</pems-page-shell>

@{ ViewData["Title"] = Localizer["Vs_ManualEntry"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
