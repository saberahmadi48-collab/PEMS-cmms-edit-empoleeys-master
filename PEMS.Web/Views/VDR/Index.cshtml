@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.VDRListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var dash = (PEMS.Application.DTOs.VDRDashboardDto)ViewBag.Dashboard;
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;

    // تعداد فیلترهای فعال برای نشان کنار آیکون فیلتر
    var activeFilters = (ViewBag.SelectedProjectId != null ? 1 : 0)
        + (ViewBag.SelectedVendorId != null ? 1 : 0)
        + (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus) ? 1 : 0);
}

@{ ViewData["Title"] = Localizer["Vs_VdrRegisterHeading"].Value; ViewData["HidePageTitle"] = true; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<div class="vs-page">

    <div class="vs-header">
        <div>
            <h1 class="vs-title">@Localizer["Vs_VdrRegisterHeading"]</h1>
            <p class="small text-muted mb-0">@Localizer["Vs_VdrSubtitle"]</p>
        </div>
        <div class="vs-actions d-flex align-items-center gap-2">
            @if (activeFilters > 0)
            {
                <a asp-action="Index" class="small">@Localizer["Reset"]</a>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary position-relative" data-bs-toggle="collapse" data-bs-target="#vdrFilterPanel"
                    aria-expanded="@(activeFilters > 0 ? "true" : "false")" aria-controls="vdrFilterPanel" title="@Localizer["Vs_FilterToggle"]">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span class="visually-hidden">@Localizer["Vs_FilterToggle"]</span>
                @if (activeFilters > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">@activeFilters<span class="visually-hidden"> @Localizer["Vs_ActiveFilters"]</span></span>
                }
            </button>
            <a asp-action="Create" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["Vs_NewVendorDocument"]</a>
        </div>
    </div>

    <div class="collapse @(activeFilters > 0 ? "show" : "")" id="vdrFilterPanel">
        <form method="get" class="vs-filters mb-3">
            <div>
                <label for="vdrFltProject">@Localizer["Vs_Project"]</label>
                <select id="vdrFltProject" name="projectId" class="form-select form-select-sm">
                    <option value="">@Localizer["All"]</option>
                    @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
                </select>
            </div>
            <div>
                <label for="vdrFltVendor">@Localizer["Vendor"]</label>
                <select id="vdrFltVendor" name="vendorId" class="form-select form-select-sm">
                    <option value="">@Localizer["All"]</option>
                    @foreach (var v in vendors) { <option value="@v.VendorId" selected="@(v.VendorId == (int?)ViewBag.SelectedVendorId)">@v.Name</option> }
                </select>
            </div>
            <div>
                <label for="vdrFltStatus">@Localizer["Status"]</label>
                <select id="vdrFltStatus" name="status" class="form-select form-select-sm">
                    <option value="">@Localizer["All"]</option>
                    @foreach (var s in new[] { "Planned", "Submitted", "UnderReview", "PendingResubmission", "Closed" })
                    { <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@VdrUi.Loc(Localizer, "St_", s)</option> }
                </select>
            </div>
            <div class="vs-filters__end">
                <button type="submit" class="vs-btn vs-btn--primary vs-btn--sm"><i class="bi bi-funnel" aria-hidden="true"></i> @Localizer["Filter"]</button>
                <a asp-action="Index" class="vs-btn vs-btn--danger vs-btn--sm" title="@Localizer["Reset"]"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Reset"]</span></a>
            </div>
        </form>
    </div>

    @* the register is the primary working surface *@
    <div>
        <div class="vs-panel">
            <div class="vs-panel__head">
                <h3 class="vs-panel__title"><i class="bi bi-table"></i> @Localizer["Vs_RegisterTitle"]</h3>
                <button type="button" class="vs-btn vs-btn--sm" onclick="PemsDataGrid.resetColumns('VDR')">
                    <i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]
                </button>
            </div>
            <div class="table-responsive pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
                <table class="table table-enterprise pems-grid-table mb-0" data-grid-key="VDR">
                    <thead>
                        <tr>
                            <th data-col-key="docNo" data-resizable="true" data-min-width="110" data-max-width="220" style="width:150px">@Localizer["Vs_DocNo"]</th>
                            <th data-col-key="description" data-resizable="true" data-min-width="180" data-max-width="500" style="width:280px">@Localizer["Vs_Description"]</th>
                            <th data-col-key="type" data-resizable="true" data-min-width="80" data-max-width="180" style="width:110px">@Localizer["Type"]</th>
                            <th data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="240" style="width:160px">@Localizer["Vendor"]</th>
                            <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="260" style="width:170px">@Localizer["Vs_Project"]</th>
                            <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Vs_Discipline"]</th>
                            <th data-col-key="rev" data-resizable="true" data-min-width="60" data-max-width="110" style="width:80px">@Localizer["Vs_Rev"]</th>
                            <th data-col-key="latestCategory" data-resizable="true" data-min-width="90" data-max-width="180" style="width:130px">@Localizer["Vs_LatestCategory"]</th>
                            <th data-col-key="status" data-resizable="true" data-min-width="110" data-max-width="220" style="width:150px">@Localizer["Status"]</th>
                            <th data-col-key="actions" data-resizable="false" style="width:70px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.Items)
                        {
                            <tr class="@(i.IsOverdue ? "table-danger" : "")">
                                <td class="vs-mono" title="@i.DocumentNumber">@i.DocumentNumber</td>
                                <td class="vs-cell-strong" title="@i.DocumentDescription">@i.DocumentDescription</td>
                                <td title="@i.DocumentTypeCode">@i.DocumentTypeCode</td>
                                <td title="@i.VendorName">@i.VendorName</td>
                                <td title="@i.ProjectName">@i.ProjectName</td>
                                <td title="@i.DisciplineName">@(string.IsNullOrEmpty(i.DisciplineName) ? "—" : i.DisciplineName)</td>
                                <td>@i.LatestRevisionNo</td>
                                <td title="@i.LatestReviewCategory">@i.LatestReviewCategory</td>
                                <td>
                                    <span class="vs-pill @VdrUi.WorkflowTone(i.WorkflowStatus)">@VdrUi.Loc(Localizer, "St_", i.WorkflowStatus)</span>
                                    @if (i.IsOverdue) { <span class="vs-pill vs-pill--danger">@Localizer["Vs_Overdue"]</span> }
                                </td>
                                <td><a asp-action="Details" asp-route-id="@i.VDRItemId" class="vs-icon-btn" title="@Localizer["Vs_View"]"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.Items.Any()) { <div class="vs-empty"><i class="bi bi-inbox"></i>@Localizer["Vs_NoVdrItems"]</div> }
            </div>
            <div class="vs-panel__foot">
                @{
                    var vdrQsParts = new List<string>();
                    if (ViewBag.SelectedProjectId != null) vdrQsParts.Add($"projectId={ViewBag.SelectedProjectId}");
                    if (ViewBag.SelectedVendorId != null) vdrQsParts.Add($"vendorId={ViewBag.SelectedVendorId}");
                    if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) vdrQsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
                }
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "VDR",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", vdrQsParts)
                })
            </div>
        </div>

    </div>

    @if (dash.TopDelayedVendors.Any())
    {
        <details class="vs-panel vs-collapse">
            <summary class="vs-panel__head"><span class="vs-panel__title"><i class="bi bi-shield-exclamation"></i> @Localizer["Vs_VendorDelayRisk"] <span class="vs-cell-sub">(@dash.TopDelayedVendors.Count)</span></span></summary>
            <ul class="vs-list">
                @foreach (var v in dash.TopDelayedVendors)
                {
                    <li>
                        <div>
                            <div class="vs-cell-strong">@v.VendorName</div>
                            <div class="vs-cell-sub">@Localizer["Vs_OverdueItems"]: @v.OverdueCount &middot; @Localizer["Vs_AvgDelay"]: @v.AverageDelayDays</div>
                        </div>
                        <span class="vs-pill @VdrUi.RiskTone(v.RiskLevel)">@VdrUi.Loc(Localizer, "St_", v.RiskLevel)</span>
                    </li>
                }
            </ul>
        </details>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('VDR');
        });
    </script>
}
