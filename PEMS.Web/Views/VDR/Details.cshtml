@model PEMS.Application.DTOs.VDRItemDto
@using PEMS.Web.Models
@using PEMS.Web.Helpers
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var relatedLetters = (List<PEMS.Application.DTOs.RelatedLetterDto>)(ViewBag.RelatedLetters ?? new List<PEMS.Application.DTOs.RelatedLetterDto>());
    var workflowHistory = (IReadOnlyList<PEMS.WorkflowPlatform.Dtos.WorkflowHistoryDto>)(ViewBag.WorkflowHistory ?? new List<PEMS.WorkflowPlatform.Dtos.WorkflowHistoryDto>());

    // طبق «PEMS Phase 2C-3»: منطق تعیین مرحله عیناً همان منطق قبلی _VdrWorkflowStagesDiagram
    // است - فقط جابه‌جا شده به این‌جا، بدون هیچ تغییر رفتاری.
    var wfStatus = Model.WorkflowStatus ?? "Planned";
    var wfStageName = (string?)ViewBag.CurrentStageName;
    var wfStageOrder = new[] { "Planned", "Check", "DisciplineReview", "LeadReview", "ReturnToVendor", "Closed" };
    var wfStageLabels = new Dictionary<string, string>
    {
        ["Planned"] = Localizer["Vd_Stage_Planned"].Value, ["Check"] = Localizer["Vd_Stage_Check"].Value, ["DisciplineReview"] = Localizer["Vd_Stage_DisciplineReview"].Value,
        ["LeadReview"] = Localizer["Vd_Stage_LeadReview"].Value, ["ReturnToVendor"] = Localizer["Vd_Stage_ReturnToVendor"].Value, ["Closed"] = Localizer["Vd_Stage_Closed"].Value
    };
    var wfStageIcons = new Dictionary<string, string>
    {
        ["Planned"] = "bi-hourglass", ["Check"] = "bi-send", ["DisciplineReview"] = "bi-diagram-3",
        ["LeadReview"] = "bi-clipboard-check", ["ReturnToVendor"] = "bi-reply", ["Closed"] = "bi-check2-circle"
    };
    var wfStageRoles = new Dictionary<string, string>
    {
        ["Planned"] = Localizer["Vd_Role_Vendor"].Value, ["Check"] = Localizer["Vd_Role_Vendor"].Value, ["DisciplineReview"] = Localizer["Vd_Role_Disciplines"].Value,
        ["LeadReview"] = Localizer["Vd_Role_Lead"].Value, ["ReturnToVendor"] = Localizer["Vd_Role_DocControl"].Value, ["Closed"] = "—"
    };
    var wfIsPendingResubmission = wfStatus == "PendingResubmission";
    // تب پیش‌فرض: گردش‌کار (شروع یا ادامه‌ی چرخه‌ی بازبینی)؛ مدرک بسته‌شده با نمای کلی باز می‌شود
    var vdrDefaultTab = wfStatus == "Closed" ? "overview" : "workflow";
    // شماره‌ی بازنگری بعدی را سیستم پیشنهاد می‌کند (آخرین + ۱)؛ همین مقدار با فرم ارسال می‌شود
    var nextRevisionNo = (Model.LatestRevisionNo ?? -1) + 1;

    int wfCurrentIndex;
    if (!string.IsNullOrEmpty(wfStageName) && Array.IndexOf(wfStageOrder, wfStageName) >= 0)
        wfCurrentIndex = Array.IndexOf(wfStageOrder, wfStageName);
    else if (wfStatus == "Closed")
        wfCurrentIndex = wfStageOrder.Length - 1;
    else if (wfIsPendingResubmission)
        wfCurrentIndex = Array.IndexOf(wfStageOrder, "LeadReview");
    else
        wfCurrentIndex = 0;

    var wfStageDiagramModel = new StageDiagramViewModel
    {
        Stages = wfStageOrder.Select((key, i) =>
        {
            var isBranchedRange = wfIsPendingResubmission && i >= wfCurrentIndex && key != "Planned" && key != "Check";
            var state = isBranchedRange
                ? (i == wfCurrentIndex ? StageItemState.Rejected : StageItemState.Pending)
                : i < wfCurrentIndex ? StageItemState.Done
                : i == wfCurrentIndex ? StageItemState.Current
                : StageItemState.Pending;

            return new StageDiagramItem
            {
                Label = wfStageLabels[key],
                IconCssClass = wfStageIcons[key],
                RoleLabel = wfStageRoles[key],
                State = state
            };
        }).ToList()
    };
}

@{ ViewData["Title"] = Model.DocumentNumber; ViewData["HidePageTitle"] = true; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<div class="vs-page">

<nav aria-label="@Localizer["Vd_Breadcrumb"]" class="small text-muted mb-2">
    <a asp-action="Index">VDR</a> / <a asp-controller="Vendor" asp-action="Details" asp-route-id="@Model.VendorId">@Model.VendorName</a> / <span>@Model.DocumentNumber</span>
</nav>

<div class="vs-doc-head">
    <div class="vs-doc-identity">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="vs-doc-number vs-num">@Model.DocumentNumber</h1>
            <span class="vs-pill @VdrUi.WorkflowTone(Model.WorkflowStatus)">@VdrUi.Loc(Localizer, "St_", Model.WorkflowStatus)</span>
            @if (Model.IsOverdue) { <span class="vs-pill vs-pill--danger">@Localizer["Vs_Overdue"]</span> }
            <span class="vs-pill vs-pill--current">@Localizer["Vd_Rev"] <span class="vs-num">@(Model.LatestRevisionNo ?? 0)</span></span>
        </div>
        <div class="vs-doc-meta">@Localizer["Vd_VendorLabel"] <a asp-controller="Vendor" asp-action="Details" asp-route-id="@Model.VendorId">@Model.VendorName</a> &middot; @Model.ProjectName@(string.IsNullOrEmpty(Model.DisciplineCodeRaw) ? "" : " · " + Model.DisciplineCodeRaw)</div>
    </div>
    <div class="vs-doc-actions">
        <a asp-action="Index" class="vs-btn"><i class="bi bi-arrow-left" aria-hidden="true"></i> @Localizer["Vs_Back"]</a>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="vdrTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(vdrDefaultTab == "overview" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">
            <i class="bi bi-info-circle"></i> @Localizer["Vs_TabOverview"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(vdrDefaultTab == "workflow" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tab-workflow" type="button">
            <i class="bi bi-signpost-split"></i> @Localizer["Vs_TabWorkflow"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-submissions" type="button">
            <i class="bi bi-clock-history"></i> @Localizer["Vs_TabSubmissions"] <span class="badge bg-secondary">@Model.Submissions.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comments" type="button">
            <i class="bi bi-chat-square-text"></i> @Localizer["Vs_TabComments"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-correspondence" type="button">
            <i class="bi bi-envelope-paper"></i> @Localizer["Vs_TabCorrespondence"]
            @if (relatedLetters.Any()) { <span class="badge bg-secondary">@relatedLetters.Count</span> }
        </button>
    </li>
</ul>

<div class="tab-content">

@* ===================== Overview ===================== *@
<div class="tab-pane fade @(vdrDefaultTab == "overview" ? "show active" : "")" id="tab-overview" role="tabpanel">
<div class="vs-panel">
    <div class="vs-panel__body">
        <div class="vs-info">
            <div><p class="vs-info__label">@Localizer["Vs_Type"]</p><p class="vs-info__value">@Model.DocumentTypeCode</p></div>
            <div><p class="vs-info__label">@Localizer["Vs_Po"]</p><p class="vs-info__value">@Model.PoNumber</p></div>
            <div>
                <p class="vs-info__label">@Localizer["Vs_Equipment"]</p>
                <p class="vs-info__value">
                    @if (Model.EquipmentId.HasValue)
                    { <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">@Model.EquipmentTagNumber</a> }
                    else
                    { <span class="text-muted">-</span> }
                </p>
            </div>
            <div><p class="vs-info__label">@Localizer["Vs_Discipline"]</p><p class="vs-info__value">@Model.DisciplineCodeRaw @(Model.IsMultiDiscipline ? Localizer["Vs_MultiDiscipline"].Value : "")</p></div>
            <div><p class="vs-info__label">@Localizer["Vs_Class"]</p><p class="vs-info__value">@Model.DocumentClass</p></div>
            <div><p class="vs-info__label">@Localizer["Vs_PlannedFirstIssue"]</p><p class="vs-info__value">@(Model.PlannedFirstIssueDate?.ToString("yyyy-MM-dd"))</p></div>
            <div class="vs-info__wide"><p class="vs-info__label">@Localizer["Vs_Description"]</p><p class="vs-info__value">@Model.DocumentDescription</p></div>
        </div>
    </div>
</div>

@* طبق «VENDOR DOCUMENTATION MANAGEMENT PROCEDURE» بخش ۴.۳.۱: شماره‌ی رسمی مدرک به فرمت
   CONTRACTOR. هر فیلد مرجع خالی این‌جا پر می‌شود و همزمان روی Vendor/Project/VDR Item ذخیره
   می‌شود - دفعه‌ی بعد از قبل پرشده می‌آید. *@
<div class="content-card mb-3">
    <h6 class="mb-2">@Localizer["Vd_OfficialNoTitle"]</h6>
    <p class="text-muted small mb-3">
        @Localizer["Vd_OfficialNoHint"]
    </p>
    <form asp-action="GenerateContractorNumber" method="post">
        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">@Localizer["Vd_VendorCode"]</label><input name="vendorCode" class="form-control" placeholder="e.g. FSK" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Vd_PlantCode"]</label><input name="plantCode" class="form-control" placeholder="e.g. J" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Vd_UnitCode"]</label><input name="unitCode" class="form-control" placeholder="e.g. 85" /></div>
            <div class="col-md-3"><label class="form-label">@Localizer["Vd_MaterialCode"]</label><input name="materialCode" class="form-control" value="@Model.MaterialCode" placeholder="e.g. 0611" /></div>
        </div>
        <button type="submit" class="btn btn-outline-primary btn-sm mt-3">
            <i class="bi bi-hash"></i> @Localizer["Vd_GenOfficial"]
        </button>
    </form>
</div>

@* طبق بخش ۴.۳.۲ همان سند: شماره‌ی موازی به فرمت SUB-CONTRACTOR/Vendor *@
<div class="content-card mb-3">
    <h6 class="mb-2">@Localizer["Vd_VendorNoTitle"]</h6>
    <p class="text-muted small mb-3">
        @Localizer["Vd_VendorNoHint"]
        @if (!string.IsNullOrWhiteSpace(Model.VendorFormatDocumentNumber))
        {
            <span>@Localizer["Vd_Current"] <strong>@Model.VendorFormatDocumentNumber</strong></span>
        }
    </p>
    <form asp-action="GenerateVendorNumber" method="post">
        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">@Localizer["Vd_JobNumber"]</label><input name="jobNumber" class="form-control" placeholder="e.g. 3863" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["Vd_UnitCode"]</label><input name="unitCode" class="form-control" placeholder="e.g. 85" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["Vd_TypologyCode"]</label><input name="typologyCode" class="form-control" value="@Model.TypologyCode" placeholder="e.g. GS, LG, IS ..." /></div>
        </div>
        <button type="submit" class="btn btn-outline-primary btn-sm mt-3">
            <i class="bi bi-hash"></i> @Localizer["Vd_GenVendor"]
        </button>
    </form>
</div>
</div>

@* ===================== Submissions ===================== *@
<div class="tab-pane fade" id="tab-submissions" role="tabpanel">
<div class="content-card mb-3">
    <h6 class="mb-3">@Localizer["Vd_SubHistory"]</h6>
    <table class="table table-enterprise">
        <thead>
            <tr><th>@Localizer["Vd_Rev"]</th><th>@Localizer["Vd_VendorTransmittal"]</th><th>@Localizer["Vd_ClientTransmittal"]</th><th>@Localizer["Vd_VendorIssued"]</th><th>@Localizer["Vd_Poi"]</th><th>@Localizer["Vd_Sla"]</th><th>@Localizer["Vd_Ftp"]</th><th>@Localizer["Vd_CommentSheet"]</th><th>@Localizer["Vd_CommentDate"]</th><th>@Localizer["Vd_Category"]</th><th>@Localizer["Vd_Resubmit"]</th><th>@Localizer["Vd_CommentFile"]</th><th>@Localizer["Vd_ReplyFile"]</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Submissions)
            {
                <tr>
                    <td>@s.RevisionNo</td>
                    <td>@s.VendorTransmittalNo</td>
                    <td>
                        @if (s.ClientTransmittalId.HasValue)
                        {
                            <a asp-controller="Transmittal" asp-action="Details" asp-route-id="@s.ClientTransmittalId">@s.ClientTransmittalNo</a>
                        }
                        else
                        {
                            @s.ClientTransmittalNo
                        }
                    </td>
                    <td>@(s.VendorActualIssuedDate?.ToString("yyyy-MM-dd"))</td>
                    <td>@s.PurposeOfIssueCode</td>
                    <td>
                        @if (s.ClientCommentDate == null && s.ContractorCommentDueDate.HasValue)
                        {
                            <span class="badge @(s.IsContractorCommentOverdue ? "bg-danger" : "bg-info text-dark")">
                                @Localizer["Vd_ContractorDue"] @s.ContractorCommentDueDate.Value.ToString("yyyy-MM-dd")@(s.IsContractorCommentOverdue ? " " + Localizer["Vd_OverdueParen"].Value : "")
                            </span>
                        }
                        else if (s.ReplySheetDate == null && s.VendorReturnDueDate.HasValue)
                        {
                            <span class="badge @(s.IsVendorReturnOverdue ? "bg-danger" : "bg-info text-dark")">
                                @Localizer["Vd_ReturnDue"] @s.VendorReturnDueDate.Value.ToString("yyyy-MM-dd")@(s.IsVendorReturnOverdue ? " " + Localizer["Vd_OverdueParen"].Value : "")
                            </span>
                        }
                    </td>
                    <td>
                        @if (s.FtpUploadedDate.HasValue)
                        {
                            <span class="badge bg-success" title="@s.FtpRemotePath"><i class="bi bi-check-circle"></i> @s.FtpUploadedDate.Value.ToString("yyyy-MM-dd")</span>
                        }
                        else
                        {
                            <form asp-action="UploadToFtp" method="post" enctype="multipart/form-data" class="d-flex gap-1">
                                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                                <input type="hidden" name="submissionId" value="@s.VDRSubmissionId" />
                                <input type="file" name="file" class="form-control form-control-sm" style="max-width:120px;" required />
                                <button class="btn btn-sm btn-outline-primary" title="@Localizer["Vd_UploadFtp"]"><i class="bi bi-cloud-upload"></i></button>
                            </form>
                        }
                    </td>
                    <td>@s.ClientCommentSheetNo</td>
                    <td>@(s.ClientCommentDate?.ToString("yyyy-MM-dd"))</td>
                    <td><span class="badge bg-secondary">@s.ReviewCategory</span></td>
                    <td>@(s.RequiresResubmission ? Localizer["Vd_Yes"].Value : "")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(s.CommentSheetFilePath))
                        {
                            <a href="@Url.Action("Download", "Files", new { id = s.CommentSheetAttachmentId })" target="_blank" class="btn btn-sm btn-outline-secondary" title="@s.CommentSheetFileName"><i class="bi bi-file-earmark-text"></i></a>
                        }
                        else
                        {
                            <form asp-action="UploadCommentSheet" method="post" enctype="multipart/form-data" class="d-flex gap-1">
                                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                                <input type="hidden" name="submissionId" value="@s.VDRSubmissionId" />
                                <input type="file" name="file" class="form-control form-control-sm" style="max-width:120px;" required />
                                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-upload"></i></button>
                            </form>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(s.ReplySheetFilePath))
                        {
                            <a href="@Url.Action("Download", "Files", new { id = s.ReplySheetAttachmentId })" target="_blank" class="btn btn-sm btn-outline-secondary" title="@s.ReplySheetFileName"><i class="bi bi-file-earmark-text"></i></a>
                        }
                        else
                        {
                            <form asp-action="UploadReplySheet" method="post" enctype="multipart/form-data" class="d-flex gap-1">
                                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                                <input type="hidden" name="submissionId" value="@s.VDRSubmissionId" />
                                <input type="file" name="file" class="form-control form-control-sm" style="max-width:120px;" required />
                                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-upload"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Submissions.Any()) { <p class="text-muted">@Localizer["Vd_NoSubmissions"]</p> }
</div>
</div>

@* ===================== Comments (شامل PDF Viewer) ===================== *@
<div class="tab-pane fade" id="tab-comments" role="tabpanel">

@{
    var comments = (List<PEMS.Application.DTOs.VDRCommentDto>)ViewBag.Comments;
    var latestSubmissionWithFile = Model.Submissions.OrderByDescending(s => s.RevisionNo)
        .FirstOrDefault(s => !string.IsNullOrEmpty(s.MainFilePath) && s.MainFilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase));
}

@if (latestSubmissionWithFile != null)
{
    <div class="content-card mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0"><i class="bi bi-file-earmark-pdf"></i> @Localizer["Vd_DocViewer"] <span class="text-muted small">@Localizer["Vd_PinHint"]</span></h6>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="pdfPrevPage"><i class="bi bi-chevron-left"></i></button>
                <span class="small" id="pdfPageLabel">@Localizer["Vd_Page"] - / -</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="pdfNextPage"><i class="bi bi-chevron-right"></i></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="pdfZoomOut"><i class="bi bi-zoom-out"></i></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="pdfZoomIn"><i class="bi bi-zoom-in"></i></button>
            </div>
        </div>
        <div id="pdfCanvasWrapper" style="position:relative; border:1px solid var(--pems-surface-border,#dee2e6); overflow:auto; max-height:75vh; text-align:center; cursor:crosshair;">
            <canvas id="pdfCanvas"></canvas>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.min.js"></script>
    <script>
        (function () {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.worker.min.js';

            var pdfUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Download", "Files", new { id = latestSubmissionWithFile.AttachmentId })));
            var wrapper = document.getElementById('pdfCanvasWrapper');
            var canvas = document.getElementById('pdfCanvas');
            var ctx = canvas.getContext('2d');
            var pdfDoc = null, currentPage = 1, scale = 1.2;
            var T = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { page = Localizer["Vd_Page"].Value, pinned = Localizer["Vd_PinnedOnPage"].Value, pdfError = Localizer["Vd_PdfError"].Value }, new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping }));

            // پین‌های کامنت موجود، فقط برای همان چرخه‌ی ارسال فعلی (@latestSubmissionWithFile.VDRSubmissionId)
            var pins = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(comments
                .Where(c => c.VDRSubmissionId == latestSubmissionWithFile.VDRSubmissionId && c.PageNumber.HasValue)
                .Select(c => new { c.CommentNo, c.PageNumber, c.PinX, c.PinY, c.CommentText }),
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            function renderPage(num) {
                pdfDoc.getPage(num).then(function (page) {
                    var viewport = page.getViewport({ scale: scale });
                    canvas.width = viewport.width;
                    canvas.height = viewport.height;

                    page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function () {
                        document.getElementById('pdfPageLabel').textContent = T.page + ' ' + num + ' / ' + pdfDoc.numPages;
                        renderPins(num, viewport.width, viewport.height);
                    });
                });
            }

            function renderPins(pageNum, width, height) {
                wrapper.querySelectorAll('.pdf-pin').forEach(function (el) { el.remove(); });

                pins.filter(function (p) { return p.pageNumber === pageNum; }).forEach(function (p) {
                    var pin = document.createElement('div');
                    pin.className = 'pdf-pin';
                    pin.title = p.commentNo + ': ' + p.commentText;
                    pin.style.cssText = 'position:absolute;width:22px;height:22px;border-radius:50% 50% 50% 0;' +
                        'background:#ef4444;border:2px solid #fff;transform:translate(-50%,-100%) rotate(-45deg);' +
                        'left:' + (p.pinX / 100 * width) + 'px;top:' + (p.pinY / 100 * height) + 'px;cursor:pointer;';
                    wrapper.appendChild(pin);
                });
            }

            pdfjsLib.getDocument(pdfUrl).promise.then(function (doc) {
                pdfDoc = doc;
                renderPage(currentPage);
            }).catch(function () {
                wrapper.innerHTML = '<p class="text-muted py-4"></p>'; wrapper.firstChild.textContent = T.pdfError;
            });

            document.getElementById('pdfPrevPage').addEventListener('click', function () {
                if (currentPage > 1) { currentPage--; renderPage(currentPage); }
            });
            document.getElementById('pdfNextPage').addEventListener('click', function () {
                if (pdfDoc && currentPage < pdfDoc.numPages) { currentPage++; renderPage(currentPage); }
            });
            document.getElementById('pdfZoomIn').addEventListener('click', function () { scale += 0.2; renderPage(currentPage); });
            document.getElementById('pdfZoomOut').addEventListener('click', function () { if (scale > 0.4) { scale -= 0.2; renderPage(currentPage); } });

            canvas.addEventListener('click', function (e) {
                var rect = canvas.getBoundingClientRect();
                var xPct = ((e.clientX - rect.left) / rect.width) * 100;
                var yPct = ((e.clientY - rect.top) / rect.height) * 100;

                document.getElementById('pinPageNumber').value = currentPage;
                document.getElementById('pinX').value = xPct.toFixed(2);
                document.getElementById('pinY').value = yPct.toFixed(2);
                document.getElementById('pinLocationLabel').textContent = T.pinned + ' ' + currentPage;

                var modal = new bootstrap.Modal(document.getElementById('addCommentModal'));
                modal.show();
            });

            document.getElementById('addCommentModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('pinPageNumber').value = '';
                document.getElementById('pinX').value = '';
                document.getElementById('pinY').value = '';
                document.getElementById('pinLocationLabel').textContent = '';
            });
        })();
    </script>
}

<div class="content-card mb-3">
    <h6 class="mb-3">@Localizer["Vd_CommentMgmt"] <span class="text-muted small">@Localizer["Vd_ActionIndependent"]</span></h6>

    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Vd_No"]</th><th>@Localizer["Vd_Rev"]</th><th>@Localizer["Vd_Category"]</th><th>@Localizer["Vd_SheetZone"]</th><th>@Localizer["Vd_Comment"]</th><th>@Localizer["Vd_RaisedBy"]</th><th>@Localizer["Vd_Raised"]</th><th>@Localizer["Vd_ActionStatus"]</th><th>@Localizer["Vd_Response"]</th></tr></thead>
        <tbody>
            @foreach (var c in comments)
            {
                <tr>
                    <td><strong>@c.CommentNo</strong></td>
                    <td>@c.RevisionNo</td>
                    <td>
                        @if (!string.IsNullOrEmpty(c.Category)) { <span class="badge bg-secondary">@VdrUi.Loc(Localizer, "Vd_Cat_", c.Category)</span> }
                        @if (!string.IsNullOrEmpty(c.Severity)) { <span class="badge bg-dark">@VdrUi.Loc(Localizer, "Vd_Sev_", c.Severity)</span> }
                    </td>
                    <td class="small">@c.Sheet @c.Zone</td>
                    <td class="small">
                        @c.CommentText
                        @if (!string.IsNullOrEmpty(c.AttachmentFilePath))
                        {
                            <div><a href="@Url.Action("Download", "Files", new { id = c.AttachmentId })" target="_blank"><i class="bi bi-paperclip"></i> @c.AttachmentFileName</a></div>
                        }
                        @if (!string.IsNullOrEmpty(c.RequiredAction))
                        {
                            <div class="text-muted">@Localizer["Vd_Required"] @c.RequiredAction</div>
                        }
                    </td>
                    <td>@c.RaisedByName</td>
                    <td>@c.RaisedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            var ab = c.ActionStatus switch
                            {
                                "Closed" => "bg-success",
                                "Verified" => "bg-info text-dark",
                                "VendorResponsePending" => "bg-warning text-dark",
                                "NoActionRequired" => "bg-secondary",
                                _ => "bg-danger"
                            };
                        }
                        <span class="vs-pill @VdrUi.CommentActionTone(c.ActionStatus)">@VdrUi.Loc(Localizer, "St_", c.ActionStatus)</span>
                        <form asp-action="SetCommentAction" method="post" class="d-inline">
                            <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                            <input type="hidden" name="commentId" value="@c.VDRCommentId" />
                            <select name="actionStatus" class="form-select form-select-sm mt-1" style="width:170px;" onchange="this.form.submit()">
                                @foreach (var s in new[] { "OpenComment", "VendorResponsePending", "Verified", "Closed", "NoActionRequired" })
                                { <option value="@s" selected="@(s == c.ActionStatus)">@VdrUi.Loc(Localizer, "St_", s)</option> }
                            </select>
                        </form>
                    </td>
                    <td class="small">
                        @c.ResponseText
                        @if (!string.IsNullOrEmpty(c.ReplyAttachmentFilePath))
                        {
                            <div><a href="@Url.Action("Download", "Files", new { id = c.ReplyAttachmentId })" target="_blank"><i class="bi bi-paperclip"></i> @c.ReplyAttachmentFileName</a></div>
                        }
                        @if (string.IsNullOrEmpty(c.ResponseText) && string.IsNullOrEmpty(c.ReplyAttachmentFilePath))
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary mt-1" data-bs-toggle="modal" data-bs-target="#replyModal_@c.VDRCommentId">
                                <i class="bi bi-reply"></i> @Localizer["Vd_Reply"]
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!comments.Any()) { <p class="text-muted">@Localizer["Vd_NoComments"]</p> }

    @if (Model.Submissions.Any())
    {
        <button type="button" class="btn btn-sm btn-pems-solid" data-bs-toggle="modal" data-bs-target="#addCommentModal">
            <i class="bi bi-plus-lg"></i> @Localizer["Vd_AddComment"]
        </button>
    }
</div>
</div>
@* پایان تب Comments - مدال‌های زیر مستقل از تب فعال همیشه در دسترس‌اند *@

@* طبق درخواست: افزودن کامنت به‌صورت Popup تا کاربر از صفحه‌ی اصلی خارج نشود *@
<div class="modal fade" id="addCommentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddComment" method="post" enctype="multipart/form-data">
                <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                <input type="hidden" name="pageNumber" id="pinPageNumber" value="" />
                <input type="hidden" name="pinX" id="pinX" value="" />
                <input type="hidden" name="pinY" id="pinY" value="" />
                <div class="modal-header"><h6 class="modal-title">@Localizer["Vd_AddComment"]</h6></div>
                <div class="modal-body">
                    <div id="pinLocationLabel" class="small text-primary mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small">@Localizer["Vd_Revision"]</label>
                            <select name="vdrSubmissionId" class="form-select form-select-sm">
                                @foreach (var s in Model.Submissions)
                                { <option value="@s.VDRSubmissionId">@Localizer["Vd_Rev"] @s.RevisionNo</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label small">@Localizer["Vd_RaisedBy"]</label><input name="raisedByName" class="form-control form-control-sm" /></div>
                        <div class="col-md-4">
                            <label class="form-label small">@Localizer["Vd_Category"]</label>
                            <select name="category" class="form-select form-select-sm">
                                <option value="">@Localizer["Vd_Select"]</option>
                                @foreach (var cat in new[] { "Technical", "Safety", "Constructability", "Documentation", "Specification", "Calculation", "Typographical", "Clarification" })
                                { <option value="@cat">@Localizer["Vd_Cat_" + cat]</option> }
                            </select>
                        </div>
                        <div class="col-md-3"><label class="form-label small">@Localizer["Vd_Sheet"]</label><input name="sheet" class="form-control form-control-sm" placeholder="e.g. Sheet 4" /></div>
                        <div class="col-md-3"><label class="form-label small">@Localizer["Vd_Zone"]</label><input name="zone" class="form-control form-control-sm" placeholder="e.g. Grid B3" /></div>
                        <div class="col-md-3"><label class="form-label small">@Localizer["Vd_Reference"]</label><input name="reference" class="form-control form-control-sm" placeholder="e.g. Note 12" /></div>
                        <div class="col-md-3">
                            <label class="form-label small">@Localizer["Vd_Severity"]</label>
                            <select name="severity" class="form-select form-select-sm">
                                <option value="">@Localizer["Vd_Select"]</option>
                                @foreach (var sev in new[] { "Low", "Medium", "High", "Critical" })
                                { <option value="@sev">@Localizer["Vd_Sev_" + sev]</option> }
                            </select>
                        </div>
                        <div class="col-12"><label class="form-label small">@Localizer["Vd_Comment"]</label><textarea name="commentText" class="form-control form-control-sm" rows="3" required></textarea></div>
                        <div class="col-md-6"><label class="form-label small">@Localizer["Vd_RequiredAction"]</label><input name="requiredAction" class="form-control form-control-sm" placeholder="e.g. Revise Drawing" /></div>
                        <div class="col-md-6"><label class="form-label small">@Localizer["Vd_DueDate"]</label><input name="dueDate" type="date" class="form-control form-control-sm" /></div>
                        <div class="col-12"><label class="form-label small">@Localizer["Vd_Attachment"] <span class="text-muted">@Localizer["Vd_Optional"]</span></label><input type="file" name="attachment" class="form-control form-control-sm" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Vd_Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Vd_SaveComment"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* طبق درخواست: پاسخ به کامنت هم Popup است و می‌تواند خودِ فایل را پیوست کند تا کاربر همه‌چیز
   را دستی تایپ نکند *@
@foreach (var c in comments)
{
    <div class="modal fade" id="replyModal_@c.VDRCommentId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="RecordCommentResponse" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                    <input type="hidden" name="commentId" value="@c.VDRCommentId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["Vd_ReplyTo"] @c.CommentNo</h6></div>
                    <div class="modal-body">
                        <p class="small text-muted">@c.CommentText</p>
                        <div class="mb-2">
                            <label class="form-label small">@Localizer["Vd_VendorReply"] <span class="text-muted">@Localizer["Vd_OptionalIfFile"]</span></label>
                            <textarea name="responseText" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">@Localizer["Vd_OrAttachReply"]</label>
                            <input type="file" name="replyAttachment" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Vd_Cancel"]</button>
                        <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["Vd_SaveReply"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ===================== Workflow (اکشن‌ها + تاریخچه‌ی واقعی) ===================== *@
<div class="tab-pane fade @(vdrDefaultTab == "workflow" ? "show active" : "")" id="tab-workflow" role="tabpanel">
<section class="vs-panel mb-3" aria-labelledby="vdrStagesTitle">
    <div class="vs-panel__body">
        <h2 id="vdrStagesTitle" class="vs-section__title">@Localizer["Vd_ReviewStages"]</h2>
        <div class="vs-tracker">
            @foreach (var st in wfStageDiagramModel.Stages)
            {
                var cls = st.State switch { StageItemState.Done => "vs-step--done", StageItemState.Current => "vs-step--current", StageItemState.Rejected => "vs-step--rejected", _ => "" };
                <div class="vs-step @cls" aria-current="@(st.State == StageItemState.Current ? "step" : null)">
                    <div class="vs-step__dot"><i class="bi @(st.State == StageItemState.Done ? "bi-check-lg" : st.IconCssClass)" aria-hidden="true"></i></div>
                    <div class="vs-step__label">@st.Label</div>
                    <div class="vs-step__meta">@st.RoleLabel</div>
                </div>
            }
        </div>
    </div>
</section>

    @{
        var workflowRunning = (bool)(ViewBag.WorkflowRunning ?? false);
        var currentStageName = (string?)ViewBag.CurrentStageName;
    }


@if (!workflowRunning)
{
    var allDisciplinesForStart = ((IEnumerable<PEMS.Domain.Entities.Discipline>)ViewBag.AllDisciplines).ToList();

    @* طبق «VENDOR DOCUMENTATION MANAGEMENT PROCEDURE» بخش ۴.۶.۱ - همین لیست POI در EngineeringDocuments/Edit.cshtml (فیلد IssuePurpose) هم تکرار شده؛ اگر این‌جا تغییر کرد آن‌جا را هم به‌روزرسانی کنید. *@
    <form asp-action="SubmitForReview" method="post" id="vdrStartForm">
        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
        <input type="hidden" name="revisionNo" value="@nextRevisionNo" />
        <div class="row g-3 align-items-start">
            <div class="col-lg-8">
                <section class="vs-panel mb-3" aria-labelledby="vdrStep1Title">
                    <div class="vs-panel__body">
                        <div class="d-flex justify-content-between align-items-baseline gap-2 flex-wrap">
                            <h2 id="vdrStep1Title" class="vs-section__title mb-1">@Localizer["Vd_Step1Title"]</h2>
                            <span class="small text-muted">@Localizer["Vd_Step1Of"]</span>
                        </div>
                        <p class="small text-muted">@Localizer["Vd_Step1Hint"]</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="vdrTransmittal">@Localizer["Vd_VendorTransmittalReq"] <span class="text-danger" aria-hidden="true">*</span></label>
                                <input id="vdrTransmittal" name="vendorTransmittalNo" class="form-control" required autocomplete="off" aria-describedby="vdrTransmittalHelp" />
                                <div id="vdrTransmittalHelp" class="form-text">@Localizer["Vd_TransmittalHelp"]</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="vdrIssuedDate">@Localizer["Vd_VendorIssuedDate"]</label>
                                <input id="vdrIssuedDate" name="vendorActualIssuedDate" type="date" class="form-control" aria-describedby="vdrIssuedHelp" />
                                <div id="vdrIssuedHelp" class="form-text">@Localizer["Vd_IssuedDateHelp"]</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="vdrPoi">@Localizer["Vd_PoiFull"]</label>
                                <select id="vdrPoi" name="purposeOfIssueCode" class="form-select" aria-describedby="vdrPoiHelp">
                                    <option value="">@Localizer["Vd_SelectPurpose"]</option>
                                    <option value="IFA">@Localizer["Vd_PoiOpt_IFA"]</option>
                                    <option value="IFR">@Localizer["Vd_PoiOpt_IFR"]</option>
                                    <option value="IFI">@Localizer["Vd_PoiOpt_IFI"]</option>
                                    <option value="FI">@Localizer["Vd_PoiOpt_FI"]</option>
                                    <option value="AB">AB @Localizer["Vd_LegacyTag"]</option>
                                    <option value="AFD">AFD @Localizer["Vd_LegacyTag"]</option>
                                </select>
                                <div id="vdrPoiHelp" class="form-text">@Localizer["Vd_PoiHelp"]</div>
                            </div>
                            <div class="col-md-6">
                                <span class="form-label d-block" id="vdrRevLabel">@Localizer["Vd_Rev"]</span>
                                <div class="form-control bg-body-secondary" aria-labelledby="vdrRevLabel" aria-describedby="vdrRevHelp">@nextRevisionNo</div>
                                <div id="vdrRevHelp" class="form-text">@Localizer["Vd_SystemSetRev"]</div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="vs-panel mb-3" aria-labelledby="vdrStep2Title">
                    <div class="vs-panel__body">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <div>
                                <h2 id="vdrStep2Title" class="vs-section__title mb-1">@Localizer["Vd_Step2Title"] <span class="fw-normal text-muted small">(@Localizer["Vd_Optional"])</span></h2>
                                <p class="small text-muted mb-0" id="vdrDiscSummary" aria-live="polite" data-none="@Localizer["Vd_NoDiscSelected"]" data-some="@Localizer["Vd_DiscSelected"]">@Localizer["Vd_NoDiscSelected"]</p>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#vdrDiscPicker" aria-expanded="false" aria-controls="vdrDiscPicker">@Localizer["Vd_ChooseDisciplines"]</button>
                        </div>
                        <div class="collapse mt-3" id="vdrDiscPicker">
                            <div class="small fw-bold mb-2">@Localizer["Vd_ReviewDisciplines"]</div>
                            <div class="row">
                                @foreach (var d in allDisciplinesForStart)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="disciplineIds" value="@d.DisciplineId" id="vdrDisc_@d.DisciplineId" data-name="@d.Name">
                                            <label class="form-check-label small" for="vdrDisc_@d.DisciplineId">@d.Name</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <section class="vs-panel" aria-labelledby="vdrSummaryTitle">
                    <div class="vs-panel__body">
                        <h2 id="vdrSummaryTitle" class="vs-section__title">@Localizer["Vd_ReviewSummary"]</h2>
                        <dl class="small mb-3">
                            <dt class="text-muted fw-normal">@Localizer["Vd_Reviewers"]</dt>
                            <dd class="mb-2">@Localizer["Vd_Role_Lead"], @Localizer["Vd_Role_DocControl"]</dd>
                            <dt class="text-muted fw-normal">@Localizer["Vd_Step2Title"]</dt>
                            <dd class="mb-0" id="vdrSummaryDisc" data-none="@Localizer["Vd_None"]">@Localizer["Vd_None"]</dd>
                        </dl>
                        <button type="submit" class="btn btn-pems-solid w-100" id="vdrStartBtn" aria-describedby="vdrWhyDisabled"><i class="bi bi-play-fill" aria-hidden="true"></i> @Localizer["Vd_StartReview"]</button>
                        <p id="vdrWhyDisabled" class="small text-warning-emphasis mt-2 mb-0" hidden>@Localizer["Vd_EnterTransmittalToEnable"]</p>
                    </div>
                </section>
            </div>
        </div>
    </form>
}
else
{
<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-signpost-split"></i> @Localizer["Vd_ReviewWorkflow"]</h6>

    @if (Model.Submissions.Any())
    {
        <p class="text-muted small">@Localizer["Vd_AlreadyRecorded"] @string.Join(", ", Model.Submissions.OrderBy(s => s.RevisionNo).Select(s => Localizer["Vd_Rev"].Value + " " + s.RevisionNo))</p>
    }

    @if (currentStageName == "DisciplineReview")
    {
        var reviewStatus = (IEnumerable<PEMS.Application.Interfaces.VdrReviewStatusItemDto>)ViewBag.ReviewStatus;
        var myDisciplineId = ViewBag.MyDisciplineId as int?;
        var myPending = reviewStatus.FirstOrDefault(x => x.DisciplineId == myDisciplineId && x.Status == "Pending");

        <h6 class="small fw-bold">@Localizer["Vd_ParallelReview"]</h6>
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var r in reviewStatus)
            {
                var badgeClass = r.Status switch { "Approve" => "bg-success", "Comment" => "bg-warning text-dark", "Reject" => "bg-danger", _ => "bg-secondary" };
                <span class="badge @badgeClass">@r.DisciplineName: @VdrUi.Loc(Localizer, "St_", r.Status)</span>
            }
        </div>

        @if (myPending != null)
        {
            <div class="d-flex gap-2">
                <form asp-action="DisciplineRespond" method="post" class="d-inline">
                    <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                    <input type="hidden" name="decision" value="Approve" />
                    <button class="btn btn-success btn-sm">@Localizer["Vd_Approve"]</button>
                </form>
                <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#vdrCommentModal">@Localizer["Vd_CommentBtn"]</button>
                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#vdrRejectModal">@Localizer["Vd_RejectBtn"]</button>
            </div>

            <div class="modal fade" id="vdrCommentModal" tabindex="-1">
                <div class="modal-dialog"><div class="modal-content">
                    <form asp-action="DisciplineRespond" method="post">
                        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                        <input type="hidden" name="decision" value="Comment" />
                        <div class="modal-header"><h6 class="modal-title">@Localizer["Vd_RecordComment"]</h6></div>
                        <div class="modal-body"><textarea name="comment" class="form-control form-control-sm" rows="3" required></textarea></div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Vd_Cancel"]</button>
                            <button type="submit" class="btn btn-warning btn-sm">@Localizer["Vd_Submit"]</button>
                        </div>
                    </form>
                </div></div>
            </div>
            <div class="modal fade" id="vdrRejectModal" tabindex="-1">
                <div class="modal-dialog"><div class="modal-content">
                    <form asp-action="DisciplineRespond" method="post">
                        <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
                        <input type="hidden" name="decision" value="Reject" />
                        <div class="modal-header"><h6 class="modal-title">@Localizer["Vd_RejectTitle"]</h6></div>
                        <div class="modal-body"><textarea name="comment" class="form-control form-control-sm" rows="3" required></textarea></div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Vd_Cancel"]</button>
                            <button type="submit" class="btn btn-danger btn-sm">@Localizer["Vd_RejectBtn"]</button>
                        </div>
                    </form>
                </div></div>
            </div>
        }
        else
        {
            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> @Localizer["Vd_WaitingOthers"]</span>
        }
    }
    else if (currentStageName == "LeadReview")
    {
        <h6 class="small fw-bold">@Localizer["Vd_FinalDecision"]</h6>
        <form asp-action="LeadReview" method="post" class="row g-2">
            <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
            <div class="col-md-3">
                <label class="form-label small">@Localizer["Vd_ReviewCategory"]</label>
                <select name="reviewCategory" class="form-select form-select-sm" required>
                    <option value="AP">@Localizer["Vd_Cat_AP"]</option>
                    <option value="NC">@Localizer["Vd_Cat_NC"]</option>
                    <option value="AC">@Localizer["Vd_Cat_AC"]</option>
                    <option value="CO">@Localizer["Vd_Cat_CO"]</option>
                    <option value="RE">@Localizer["Vd_Cat_RE"]</option>
                </select>
            </div>
            <div class="col-md-3"><label class="form-label small">@Localizer["Vd_CommentSheetNo"]</label><input name="clientCommentSheetNo" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small">@Localizer["Vd_CommentDate"]</label><input name="clientCommentDate" type="date" class="form-control form-control-sm" /></div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-pems-solid w-100">@Localizer["Vd_RecordFinal"]</button>
            </div>
        </form>
    }
    else if (currentStageName == "ReturnToVendor")
    {
        <h6 class="small fw-bold">@Localizer["Vd_FormalReturn"]</h6>
        <p class="text-muted small">@Localizer["Vd_ReturnHint"]</p>
        <form asp-action="ReturnToVendor" method="post" class="row g-2">
            <input type="hidden" name="vdrItemId" value="@Model.VDRItemId" />
            <div class="col-md-4"><label class="form-label small">@Localizer["Vd_ReplySheetNo"]</label><input name="replySheetNo" class="form-control form-control-sm" /></div>
            <div class="col-md-4"><label class="form-label small">@Localizer["Vd_ClientTransmittalNo"]</label><input name="clientTransmittalNo" class="form-control form-control-sm" /></div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-send"></i> @Localizer["Vd_ReturnToVendor"]</button>
            </div>
        </form>
    }
</div>
}


@* تاریخچه‌ی واقعی گردش‌کار از موتور عمومی (نه فقط رشته‌ی خلاصه‌ی وضعیت) *@
<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-clock-history"></i> @Localizer["Vd_WorkflowHistory"]</h6>
    @if (workflowHistory.Any())
    {
        <table class="table table-enterprise mb-0">
            <thead><tr><th>@Localizer["Vd_From"]</th><th>@Localizer["Vd_To"]</th><th>@Localizer["Vd_Action"]</th><th>@Localizer["Vd_Decision"]</th><th>@Localizer["Vd_Comment"]</th><th>@Localizer["Vd_Date"]</th></tr></thead>
            <tbody>
                @foreach (var h in workflowHistory.OrderByDescending(x => x.ActionDate))
                {
                    <tr>
                        <td class="small">@VdrUi.Loc(Localizer, "Vd_Stage_", h.FromStageName)</td>
                        <td class="small">@VdrUi.Loc(Localizer, "Vd_Stage_", h.ToStageName)</td>
                        <td><span class="badge bg-secondary">@h.ActionType</span></td>
                        <td class="small">@h.Decision</td>
                        <td class="small">@h.Comment</td>
                        <td class="small text-muted">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted text-center py-4 mb-0">@Localizer["Vd_NoWorkflowYet"]</p>
    }
</div>
</div>

@* ===================== Correspondence ===================== *@
<div class="tab-pane fade" id="tab-correspondence" role="tabpanel">
<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-envelope-paper"></i> @Localizer["Vd_RelatedCorr"]</h6>
    @if (relatedLetters.Any())
    {
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Vd_Type"]</th><th>@Localizer["Vd_LetterNo"]</th><th>@Localizer["Vd_Subject"]</th><th>@Localizer["Vd_Date"]</th><th>@Localizer["Vd_Status"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var l in relatedLetters)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@l.LetterType</span></td>
                        <td>@l.LetterNumber</td>
                        <td>@l.Subject</td>
                        <td class="small text-muted">@l.LetterDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge bg-info text-dark">@l.Status</span></td>
                        <td><a asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted text-center py-4 mb-0">@Localizer["Vd_NoCorr"]</p>
    }
</div>
</div>

</div>
@* پایان tab-content *@

</div>
@* پایان vs-page *@

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('vdrStartForm');
            if (!form) return;

            // دکمه‌ی شروع تا ورود شماره‌ی ترنسمیتال غیرفعال است و دلیلش دیده می‌شود (بدون JS دکمه فعال می‌ماند و سرور خودش اعتبارسنجی می‌کند)
            var input = document.getElementById('vdrTransmittal');
            var button = document.getElementById('vdrStartBtn');
            var why = document.getElementById('vdrWhyDisabled');
            function syncStart() {
                var ok = input.value.trim().length > 0;
                button.disabled = !ok;
                why.hidden = ok;
            }
            input.addEventListener('input', syncStart);
            syncStart();

            var boxes = Array.prototype.slice.call(form.querySelectorAll('input[name="disciplineIds"]'));
            var summary = document.getElementById('vdrDiscSummary');
            var side = document.getElementById('vdrSummaryDisc');
            function syncDisciplines() {
                var names = boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.getAttribute('data-name'); });
                if (!names.length) {
                    summary.textContent = summary.getAttribute('data-none');
                    side.textContent = side.getAttribute('data-none');
                } else {
                    summary.textContent = summary.getAttribute('data-some').replace('{0}', names.length).replace('{1}', names.join(', '));
                    side.textContent = names.join(', ');
                }
            }
            boxes.forEach(function (b) { b.addEventListener('change', syncDisciplines); });
            syncDisciplines();
        })();
    </script>
}
