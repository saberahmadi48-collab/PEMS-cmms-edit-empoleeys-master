@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var order = ViewBag.Order;
}
<div class="content-card" style="max-width:640px;">
    <h5 class="mb-1">New Production Run</h5>
    <div class="text-muted mb-3">Order: @order.OrderNumber - @order.MaterialItem.MaterialCode</div>
    <form asp-action="Create" method="post">
        <input type="hidden" name="productionOrderId" value="@order.ProductionOrderId" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Operator (optional)</label>
                <select name="operatorEmployeeId" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var emp in ViewBag.Employees)
                    {
                        <option value="@emp.EmployeeId">@emp.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Shift (optional)</label>
                <select name="shiftDefinitionId" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var s in ViewBag.Shifts)
                    {
                        <option value="@s.ShiftDefinitionId">@s.Code - @s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Equipment (optional)"]</label>
                <input type="number" name="equipmentId" class="form-control" placeholder="@Localizer["Equipment ID"]" />
            </div>
            <div class="col-12">
                <label class="form-label">@Localizer["Notes"]</label>
                <textarea name="notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-pems-solid"><i class="bi bi-check-lg"></i> Create Run</button>
            <a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@order.ProductionOrderId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
