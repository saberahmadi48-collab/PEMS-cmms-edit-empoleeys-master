@model PEMS.Application.DTOs.RcmFmeaCoverageMatrixDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var rows = Model.Classes.Where(x => x.EquipmentCount > 0).ToList();

    string ReadinessText(string? s) => VdrUi.Loc(Localizer, "Rf_Rd_", s);
    string ReadinessTone(string? s) => s switch
    {
        "READY" => "vs-pill--success",
        "PARTIALLY_READY" => "vs-pill--warning",
        _ => "vs-pill--neutral"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2b: built from the PEMS.UI list-page component. The coverage counts are the KPI row (shown first on
   this page: open="true" until the viewer hides it), the "Class first" note is the heading tooltip and each equipment class row
   opens its detail. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Rf_Title"]" heading-title="@Localizer["Rf_Hint"]" total="@rows.Count">
            <pems-list-tools>
                <pems-list-kpi-toggle target="rfKpis" storage-key="pems.rcmFmea.kpis" open="true" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="rfKpis" open="true">
            <span class="vs-chip">@Localizer["Rf_ClassesWithEquipment"] <strong>@Model.ClassesWithEquipment</strong></span>
            <span class="vs-chip"><pems-icon name="bi-check-circle" aria-hidden="true" /> @Localizer["Rf_FmeaReady"] <strong>@Model.ClassesFmeaReady</strong></span>
            <span class="vs-chip">@Localizer["Rf_FmeaPartial"] <strong>@Model.ClassesFmeaPartiallyReady</strong></span>
            <span class="vs-chip"><pems-icon name="bi-check-circle" aria-hidden="true" /> @Localizer["Rf_RcmReady"] <strong>@Model.ClassesRcmReady</strong></span>
            <span class="vs-chip">@Localizer["Rf_RcmPartial"] <strong>@Model.ClassesRcmPartiallyReady</strong></span>
            <span class="vs-chip">@Localizer["Rf_Approved"] <strong>@Model.TotalApprovedFMEAs / @Model.TotalApprovedRCMs</strong></span>
        </pems-list-kpis>

        <pems-list-grid>
            <pems-list-table empty="@(!rows.Any())" empty-text="@Localizer["Rf_Empty"]">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header>@Localizer["Rcm_EquipmentClass"]</pems-table-header>
                        <pems-table-header class="text-end">@Localizer["Equipment"]</pems-table-header>
                        <pems-table-header class="text-end vs-hide-md">@Localizer["Rf_FuncReq"]</pems-table-header>
                        <pems-table-header class="text-end">@Localizer["Cm_FailureModes"]</pems-table-header>
                        <pems-table-header class="text-end vs-hide-md">@Localizer["Rf_Causes"]</pems-table-header>
                        <pems-table-header class="text-end vs-hide-md">@Localizer["Rf_Effects"]</pems-table-header>
                        <pems-table-header class="text-end vs-hide-md">@Localizer["Rf_Consequences"]</pems-table-header>
                        <pems-table-header class="text-end vs-hide-md">@Localizer["Rf_StrategyTypes"]</pems-table-header>
                        <pems-table-header>@Localizer["Rf_Fmea"]</pems-table-header>
                        <pems-table-header>@Localizer["Rf_Rcm"]</pems-table-header>
                        <pems-table-header class="pems-w-60"><span class="visually-hidden">@Localizer["Ed_Actions"]</span></pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var c in rows)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell><pems-link asp-action="ClassDetail" asp-route-id="@c.EquipmentClassId" class="lp-subject">@c.Name</pems-link> <span class="vs-num text-muted small">@c.Code</span></pems-table-cell>
                            <pems-table-cell class="text-end"><span class="vs-num">@c.EquipmentCount.ToString("N0")</span></pems-table-cell>
                            <pems-table-cell class="text-end vs-hide-md"><span class="vs-num">@c.FunctionalRequirementCount</span></pems-table-cell>
                            <pems-table-cell class="text-end"><span class="vs-num">@c.FailureModeCount</span></pems-table-cell>
                            <pems-table-cell class="text-end vs-hide-md"><span class="vs-num">@c.FailureCauseCount</span></pems-table-cell>
                            <pems-table-cell class="text-end vs-hide-md"><span class="vs-num">@c.FailureEffectCount</span></pems-table-cell>
                            <pems-table-cell class="text-end vs-hide-md"><span class="vs-num">@c.FailureConsequenceCount</span></pems-table-cell>
                            <pems-table-cell class="text-end vs-hide-md"><span class="vs-num">@c.StrategyTypeCount</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @ReadinessTone(c.FMEAReadiness)">@ReadinessText(c.FMEAReadiness)</span> <span class="small text-muted">@string.Format(Localizer["Rf_ApprovedCount"].Value, c.ApprovedFMEACount)</span></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @ReadinessTone(c.RCMReadiness)">@ReadinessText(c.RCMReadiness)</span> <span class="small text-muted">@string.Format(Localizer["Rf_ApprovedCount"].Value, c.ApprovedRCMCount)</span></pems-table-cell>
                            <pems-table-cell class="text-end">
                                <pems-link asp-action="ClassDetail" asp-route-id="@c.EquipmentClassId" class="lp-act lp-act--always" title="@Localizer["Lp_Details"]" aria-label="@Localizer["Lp_Details"]"><pems-icon name="bi-box-arrow-up-right" aria-hidden="true" /></pems-link>
                            </pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
