@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}

<div class="content-card" style="max-width:700px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">@Localizer["Title"]</label><input name="title" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Date & Time"]</label><input name="meetingDate" type="datetime-local" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Location"]</label><input name="location" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">@Localizer["Organizer"]</label><input name="organizerName" class="form-control" /></div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Related Project"]</label>
                <select name="projectId" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-12"><label class="form-label">@Localizer["Agenda"]</label><textarea name="agenda" class="form-control" rows="4"></textarea></div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
