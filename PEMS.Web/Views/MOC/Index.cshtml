@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.MOCListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-action="Raise" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> New MOC</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold">@Model.TotalCount</div>
            <div class="text-muted small">@Localizer["کل"]</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-warning">@ViewBag.OpenCount</div>
            <div class="text-muted small">@Localizer["باز / در جریان"]</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-danger">@ViewBag.HighRiskOpenCount</div>
            <div class="text-muted small"><i class="bi bi-exclamation-triangle"></i> @Localizer["ریسک بالا - باز"]</div>
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-2">
            <select name="riskLevel" class="form-select form-select-sm">
                <option value="">All Risk Levels</option>
                @foreach (var r in new[] { "Low", "Medium", "High" })
                {
                    <option value="@r" selected="@(r == (string?)ViewBag.SelectedRiskLevel)">@r</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in new[] { "PendingRiskAssessment", "PendingApproval", "PendingSeniorApproval", "Approved", "PendingClosure", "Closed", "Rejected" })
                {
                    <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> @Localizer["Filter"]</button>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('MOC')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]
        </button>
    </div>
    <div class="pems-grid-scroll">
        <table class="table table-enterprise mb-0 pems-grid-table" data-grid-key="MOC">
            <thead>
                <tr>
                    <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["Number"]</th>
                    <th data-col-key="title" data-resizable="true" data-min-width="180" data-max-width="500" style="width:320px">@Localizer["Title"]</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Discipline"]</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="90" data-max-width="200" style="width:130px">@Localizer["Type"]</th>
                    <th data-col-key="risk" data-resizable="true" data-min-width="70" data-max-width="140" style="width:100px">@Localizer["Risk"]</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="110" data-max-width="220" style="width:150px">@Localizer["Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@m.MOCId">@m.MOCNumber</a></td>
                        <td class="small" title="@m.Title">@m.Title</td>
                        <td class="small" title="@m.DisciplineName">@m.DisciplineName</td>
                        <td class="small">@m.ChangeType</td>
                        <td><span class="badge @(m.RiskLevel == "High" ? "bg-danger" : m.RiskLevel == "Medium" ? "bg-warning text-dark" : "bg-secondary")">@m.RiskLevel</span></td>
                        <td><span class="badge @(m.Status == "Closed" ? "bg-success" : m.Status == "Rejected" ? "bg-dark" : "bg-info text-dark")">@m.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["موردی یافت نشد."]</p> }
    </div>

    @{
        var mocQsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedRiskLevel)) mocQsParts.Add($"riskLevel={Uri.EscapeDataString((string)ViewBag.SelectedRiskLevel)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) mocQsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (ViewBag.SelectedProjectId != null) mocQsParts.Add($"projectId={ViewBag.SelectedProjectId}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "MOC",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", mocQsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('MOC');
        });
    </script>
}
