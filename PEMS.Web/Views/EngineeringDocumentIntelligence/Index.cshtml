@model List<PEMS.Application.DTOs.DocumentIntelligenceDetailDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var dash = (PEMS.Application.DTOs.DocumentIntelligenceDashboardDto)ViewBag.Dashboard;
}


<pems-row gap="3" css="mb-3">
    <pems-col md="3" sm="6">
        <pems-kpi-tile icon="bi-file-earmark-text" color="slate" label="Total Documents">@dash.TotalDocuments</pems-kpi-tile>
    </pems-col>
    <pems-col md="3" sm="6">
        <pems-kpi-tile icon="bi-robot" color="amber" label="Pending AI Classification Review">@dash.PendingClassificationReview</pems-kpi-tile>
    </pems-col>
    <pems-col md="3" sm="6">
        <pems-kpi-tile icon="bi-tags" color="purple" label="Pending Tag Links">@dash.PendingTagLinkReview</pems-kpi-tile>
    </pems-col>
    <pems-col md="3" sm="6">
        <pems-kpi-tile icon="bi-chat-dots" color="red" label="Open Comments">@dash.OpenComments</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-content-card css="mb-3">
    <pems-heading level="6" class="mb-3">Documents by Workflow Stage</pems-heading>
    <pems-flex wrap="true" gap="2">
        @foreach (var s in new[] { "Uploaded", "AIProcessing", "Classified", "DisciplineAssigned", "UnderReview", "CommentOpen", "Revision", "Approved", "KnowledgeBase" })
        {
            var count = dash.ByStage.TryGetValue(s, out var c) ? c : 0;
            <pems-badge tone="neutral" css="p-2">@s: @count</pems-badge>
        }
    </pems-flex>
</pems-content-card>

<pems-content-card>
    <pems-text class="text-muted">
        مدارکی که تحلیل AI روی آن‌ها کامل شده و منتظر بازبینی مهندسی هستند (Discipline, Vendor, MR,
        Revision, Tag های پیشنهادی).
    </pems-text>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["Doc No"])?.ToString() ?? ""), d => (object?)(d.DocumentNo)).Add(((Localizer["Title"])?.ToString() ?? ""), d => (object?)(d.Title)).Add(((Localizer["Stage"])?.ToString() ?? ""), d => (object?)(DataCell.Badge("info", d.AIWorkflowStage))).Add("Pending Classifications", d => (object?)(DataCell.Badge("warning", (d.Classifications.Count(c => c.ReviewStatus == "Draft"))))).Add(((Localizer["Pending Tags"])?.ToString() ?? ""), d => (object?)(DataCell.Badge("warning", (d.TagLinks.Count(t => t.IsAIProposed && t.ReviewStatus == "Draft"))))).Add("", d => (object?)(DataCell.ButtonLink(Url.Action("Review", null, new { id = d.DocumentId }), "primary", "small", false, null, "Review")))))" />
        @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">No documents pending AI classification review.</pems-text> }
    </pems-table-scroll>
</pems-content-card>
