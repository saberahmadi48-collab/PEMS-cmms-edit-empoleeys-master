@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "New Criticality Assessment";
    int? preselectedEquipmentId = ViewBag.PreselectedEquipmentId;
    string? preselectedLabel = ViewBag.PreselectedEquipmentLabel;
}

@await Html.PartialAsync("_PageHeader")

<pems-flex justify="end" align="center" css="mb-2">
    <pems-link asp-action="Index" class="small">← Assessment Queue</pems-link>
</pems-flex>

@if (TempData["Error"] != null) { <pems-alert tone="danger" css="py-2 px-3 small">@TempData["Error"]</pems-alert> }

<pems-content-card css="pems-s-cd90f7a7">
    <pems-form asp-action="Create" method="post">
        <pems-form-group css="mb-3">
            <pems-label css="small">@Localizer["Equipment"]</pems-label>
            @if (preselectedEquipmentId.HasValue)
            {
                <input type="hidden" name="equipmentId" value="@preselectedEquipmentId" />
                <pems-input scale="small" value="@preselectedLabel" disabled />
            }
            else
            {
                <pems-input scale="small" type="number" name="equipmentId" required placeholder="@Localizer["Equipment ID"]" />
                <pems-help-text>از صفحه‌ی جزئیات تجهیز یا Activation Backlog وارد شوید تا از قبل انتخاب شود.</pems-help-text>
            }
        </pems-form-group>
        <pems-form-group css="mb-3">
            <pems-label css="small">Rationale (optional)</pems-label>
            <pems-textarea scale="small" name="rationale" rows="2"></pems-textarea>
        </pems-form-group>
        <pems-button tone="primary" size="small" type="submit">Create Draft</pems-button>
    </pems-form>
</pems-content-card>
