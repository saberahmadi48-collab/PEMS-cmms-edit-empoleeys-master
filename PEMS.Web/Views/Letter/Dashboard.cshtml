@model PEMS.Application.DTOs.LetterWorkspaceDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    bool canReview = ViewBag.CanReview == true;
    int total = Math.Max(1, Model.TotalActive);

    // یک کاشی عددی: شمارنده + برچسب (+ پیوند به فهرست فیلترشده). وضعیت «هشدار» با آیکون و متن هم نمایش داده می‌شود، نه فقط رنگ.
    async Task Tile(string labelKey, int value, string icon, string? href = null, bool warn = false)
    {
        var inner = $"<i class=\"bi {icon}\" aria-hidden=\"true\"></i> <span class=\"vs-tile__label\">{System.Net.WebUtility.HtmlEncode(Localizer[labelKey].Value)}</span> <strong class=\"vs-tile__value\">{value}</strong>"
            + (warn && value > 0 ? $" <span class=\"badge bg-danger\"><i class=\"bi bi-exclamation-triangle\" aria-hidden=\"true\"></i> {System.Net.WebUtility.HtmlEncode(Localizer["Lt_Dash_NeedsAction"].Value)}</span>" : "");
        if (href != null)
        {
            <pems-link class="vs-chip text-decoration-none" href="@href">@Html.Raw(inner)</pems-link>
        }
        else
        {
            <span class="vs-chip">@Html.Raw(inner)</span>
        }
    }

    async Task BarRow(string label, int value, string? href = null)
    {
        var pct = (int)Math.Round(100.0 * value / total);
        <pems-table-row>
            <pems-table-header scope="row" class="fw-normal">@if (href != null) { <pems-link href="@href">@label</pems-link> } else { @label }</pems-table-header>
            <pems-table-cell class="pems-s-a9c5e7e4">
                <pems-progress value="@pct" label="@label: @value (@pct%)"></pems-progress>
            </pems-table-cell>
            <pems-table-cell class="text-end"><strong>@value</strong> <span class="text-muted small">(@pct%)</span></pems-table-cell>
        </pems-table-row>
    }
}

<pems-flex wrap="true" justify="between" align="center" gap="2" css="mb-3">
    <pems-text class="text-muted small mb-0">@Localizer["Lt_Dash_Scope"]</pems-text>
    <pems-flex wrap="true" gap="2">
        @if (ViewBag.CanRunReminders == true)
        {
            <pems-form asp-action="SendReminders" method="post" data-pems-confirm="@Localizer["Lt_RemindersConfirm"]">
                <pems-button tone="neutral" size="small" outline="true" type="submit"><pems-icon name="bi-bell" aria-hidden="true" /> @Localizer["Lt_RemindersRun"]</pems-button>
            </pems-form>
        }
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-left-short" aria-hidden="true" /> @Localizer["Correspondence"]</pems-button>
    </pems-flex>
</pems-flex>

<section aria-label="@Localizer["Lt_Dash_Summary"]" class="vs-chips mb-3">
    @{
        await Tile("Lt_Dash_TotalActive", Model.TotalActive, "bi-envelope", Url.Action("Index"));
        await Tile("Lt_Dash_Open", Model.OpenLetters, "bi-envelope-open");
        if (canReview) { await Tile("Lt_Dash_AwaitingApproval", Model.AwaitingApproval, "bi-patch-check", Url.Action("Index", new { status = "PendingApproval" }), warn: false); }
        await Tile("Lt_Dash_MyDrafts", Model.MyDrafts, "bi-pencil-square", Url.Action("Index", new { status = "Draft" }));
        await Tile("Lt_Dash_MyReturned", Model.MyReturnedForRevision, "bi-arrow-counterclockwise", Url.Action("Index", new { status = "ReturnedForRevision" }), warn: true);
        await Tile("Lt_Dash_MyReferrals", Model.MyOpenReferrals, "bi-person-check", Url.Action("MyReferrals"));
        await Tile("Lt_Dash_OpenReferrals", Model.OpenReferrals, "bi-signpost-split", Url.Action("Index", new { hasReferrals = true }));
        await Tile("Lt_Dash_OverdueReferrals", Model.OverdueReferrals, "bi-clock-history", Url.Action("Index", new { overdueReferral = true }), warn: true);
        await Tile("Lt_Dash_OverdueResponses", Model.OverdueResponses, "bi-reply", Url.Action("Index", new { overdueResponse = true }), warn: true);
        await Tile("Lt_Dash_Received30", Model.ReceivedLast30Days, "bi-inbox-fill");
        await Tile("Lt_Dash_Issued30", Model.IssuedLast30Days, "bi-send-fill");
    }
</section>

<pems-row gap="3">
    <pems-col lg="6">
        <pems-content-card css="h-100">
            <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Dash_NeedsAttention"]</pems-heading>
            @if (!Model.NeedsAttention.Any())
            {
                <pems-text class="text-muted mb-0"><pems-icon name="bi-check-circle" aria-hidden="true" /> @Localizer["Lt_Dash_NothingOverdue"]</pems-text>
            }
            else
            {
                <pems-table-scroll>
                    @{
                        var rows_44 = Model.NeedsAttention;
                        var cell_44_2 = DataCell.Template(rows_44, @<text>
                                        <pems-icon css="@(item.Reason == "OverdueReferral" ? "bi-signpost-split" : "bi-reply")" aria-hidden="true" />
                                        @Localizer[item.Reason == "OverdueReferral" ? "Lt_Dash_ReasonReferral" : "Lt_Dash_ReasonResponse"]
                                    </text>);
                        var cell_44_3 = DataCell.Template(rows_44, @<text><pems-icon name="bi-exclamation-triangle" aria-hidden="true" /> @item.DaysOverdue <span class="text-muted fw-normal">(@PemsDates.Date(item.DueDate))</span></text>);
                    }
                    <pems-data-table data="@(DataRows.Of(rows_44, c_ => c_.Add(((Localizer["Letter No"])?.ToString() ?? ""), item => (object?)(item.LetterNumber), css: "small").Add(((Localizer["Subject"])?.ToString() ?? ""), item => (object?)(DataCell.Link(Url.Action("Details", null, new { id = item.LetterId }), item.Subject))).Add(((Localizer["Lt_Dash_Reason"])?.ToString() ?? ""), item => (object?)cell_44_2(item), css: "small").Add(((Localizer["Lt_Dash_DaysOverdue"])?.ToString() ?? ""), item => (object?)cell_44_3(item), css: "small pems-due-overdue")))" css="mb-0" />
                </pems-table-scroll>
            }
        </pems-content-card>
    </pems-col>

    <pems-col lg="6">
        <pems-content-card css="h-100">
            <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Dash_Aging"]</pems-heading>
            <pems-text class="text-muted small">@Localizer["Lt_Dash_AgingNote"]</pems-text>
            <pems-table scale="small" css="mb-0">
                <pems-table-body>
                    @foreach (var b in Model.Aging) { await BarRow(Localizer["Lt_Dash_Age_" + b.Key].Value, b.Count); }
                </pems-table-body>
            </pems-table>
        </pems-content-card>
    </pems-col>

    <pems-col lg="4">
        <pems-content-card css="h-100">
            <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Dash_ByStatus"]</pems-heading>
            <pems-table scale="small" css="mb-0"><pems-table-body>
                @foreach (var kv in Model.ByStatus.OrderByDescending(x => x.Value)) { await BarRow(kv.Key, kv.Value, Url.Action("Index", new { status = kv.Key })); }
            </pems-table-body></pems-table>
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="h-100">
            <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Dash_ByType"]</pems-heading>
            <pems-table scale="small" css="mb-0"><pems-table-body>
                @foreach (var kv in Model.ByType.OrderByDescending(x => x.Value)) { await BarRow(kv.Key, kv.Value, Url.Action("Index", new { letterType = kv.Key })); }
            </pems-table-body></pems-table>
        </pems-content-card>
    </pems-col>
    <pems-col lg="4">
        <pems-content-card css="h-100">
            <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Dash_ByPriority"]</pems-heading>
            <pems-table scale="small" css="mb-0"><pems-table-body>
                @foreach (var kv in Model.ByPriority.OrderByDescending(x => x.Value)) { await BarRow(Localizer["Lt_P_" + kv.Key].Value, kv.Value, Url.Action("Index", new { priority = kv.Key })); }
            </pems-table-body></pems-table>
        </pems-content-card>
    </pems-col>
</pems-row>

@section Styles {
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}
