@model PEMS.Application.DTOs.LetterDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var l = Model.Letter;
    var departments = (IEnumerable<dynamic>)ViewBag.Departments;
    var allTags = (List<PEMS.Application.DTOs.TagDto>)ViewBag.AllTags;
    var timeline = (List<PEMS.Application.DTOs.LetterTimelineEventDto>)ViewBag.Timeline;
    var thread = (List<PEMS.Application.DTOs.ThreadMessageDto>)ViewBag.Thread;
    bool canEditReturned = ViewBag.CanEditReturned;
    bool canEditDraft = ViewBag.CanEditDraft;
    bool canReview = ViewBag.CanReview;
    bool canEditNow = canEditReturned || canEditDraft;
    bool canManageResponse = ViewBag.CanManageResponse == true;
    bool isAuthor = ViewBag.IsAuthor == true;
    bool isAdmin = ViewBag.IsAdmin == true;
    bool canArchive = ViewBag.CanArchive == true;
    bool canAudit = ViewBag.CanAudit == true;
    bool isFormal = l.LetterType == "Internal" || l.LetterType == "Outgoing";

    string statusBadgeClass = PEMS.Web.Helpers.LetterStatusBadge.CssClass(l.Status);
}

<style>
    .letter-header .meta-item { color: var(--pems-muted, #6c757d); }
    .letter-header .meta-item strong { color: inherit; font-weight: 600; }
    .thread-message { border-inline-start: 3px solid var(--bs-border-color, #dee2e6); padding-inline-start: .75rem; }
    .thread-message.current { border-inline-start-color: var(--bs-primary, #0d6efd); }
    .thread-message .msg-summary { cursor: pointer; }
    .section-title { font-size: .85rem; text-transform: uppercase; letter-spacing: .03em; color: var(--pems-muted, #6c757d); }
</style>

<div class="content-card mb-3 letter-header">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <h5 class="mb-0">@l.LetterNumber</h5>
                <span class="badge @statusBadgeClass">@l.Status</span>
                <span class="badge bg-light text-dark border">@l.LetterType</span>
                @if (l.ConfidentialityLevel != "Public" && l.ConfidentialityLevel != "Internal")
                { <span class="badge bg-dark"><i class="bi bi-lock-fill"></i> @l.ConfidentialityLevel</span> }
                @if (l.RevisionCount > 0)
                { <span class="badge bg-light text-dark border">Rev. @l.RevisionCount</span> }
            </div>
            <h6 class="mt-2 mb-1">@l.Subject</h6>
            <div class="d-flex flex-wrap gap-3 small meta-item">
                <span><strong>@(l.LetterType == "Incoming" ? "From" : "To"):</strong> @(l.LetterType == "Incoming" ? l.Sender : l.Receiver)</span>
                <span><strong>Date:</strong> @l.LetterDate.ToString("yyyy-MM-dd")</span>
                <span><strong>@Localizer["Priority:"]</strong> @l.Priority</span>
                @if (!string.IsNullOrEmpty(l.Category)) { <span><strong>@Localizer["Lc_Category"]:</strong> @Localizer["Lc_Cat_" + l.Category]</span> }
                @if (!string.IsNullOrEmpty(l.ReferenceNumber)) { <span><strong>@Localizer["Lc_Reference"]:</strong> @l.ReferenceNumber</span> }
                @if (!string.IsNullOrEmpty(l.ProjectName)) { <span><strong>@Localizer["Project:"]</strong> @l.ProjectName</span> }
                @if (!string.IsNullOrEmpty(l.DisciplineName)) { <span><strong>@Localizer["Discipline:"]</strong> @l.DisciplineName</span> }
                @if (l.ResponseRequired && l.ResponseDueDate.HasValue)
                {
                    <span>
                        <strong>@Localizer["Lt_ResponseDueDate"]:</strong> @l.ResponseDueDate.Value.ToString("yyyy-MM-dd")
                        @if (l.ResponseAnswered) { <span class="badge bg-success"><i class="bi bi-check-circle" aria-hidden="true"></i> @Localizer["Lt_ResponseAnswered"]</span> }
                        else if (l.ResponseOverdue) { <span class="badge bg-danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @Localizer["Lt_Overdue"]</span> }
                        else { <span class="badge bg-secondary"><i class="bi bi-hourglass-split" aria-hidden="true"></i> @Localizer["Lt_ResponsePending"]</span> }
                    </span>
                }
            </div>
            @if (canManageResponse)
            {
                <details class="mt-2 small">
                    <summary>@Localizer["Lt_ResponseEdit"]</summary>
                    <form asp-action="SetResponseDue" method="post" class="d-flex flex-wrap align-items-end gap-2 mt-2">
                        <input type="hidden" name="letterId" value="@l.LetterId" />
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="responseRequired" value="true" id="detResponseRequired" checked="@l.ResponseRequired" />
                            <label class="form-check-label" for="detResponseRequired">@Localizer["Lt_ResponseRequired"]</label>
                        </div>
                        <div>
                            <label class="form-label mb-1" for="detResponseDue">@Localizer["Lt_ResponseDueDate"]</label>
                            <input type="date" name="responseDueDate" id="detResponseDue" class="form-control form-control-sm"
                                   value="@(l.ResponseDueDate?.ToString("yyyy-MM-dd"))" min="@l.LetterDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["Save"]</button>
                    </form>
                </details>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            @* طبق بند ۳۳: بدون دکمه‌ی وضعیت آزاد - فقط اقدامات کسب‌وکاری نام‌گذاری‌شده، هرکدام
               فقط زمانی نمایش داده می‌شوند که واقعاً از وضعیت فعلی مجاز باشند (سرویس هم دوباره
               اعتبارسنجی می‌کند - این‌جا فقط UX است) *@
            @if (isFormal && (l.Status == "Draft" || l.Status == "ReturnedForRevision") && isAuthor)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-controller="LetterCompose" asp-action="Compose" asp-route-id="@l.LetterId"><i class="bi bi-pencil-square" aria-hidden="true"></i> @Localizer["Lc_EditInComposer"]</a>
            }
            @if (l.Status == "Approved" && l.LetterType == "Internal" && isAuthor)
            {
                <form asp-controller="LetterCompose" asp-action="Send" method="post" onsubmit="return confirm('@Localizer["Lc_ConfirmSend"]');">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-send-check" aria-hidden="true"></i> @Localizer["Lt_Send"]</button>
                </form>
            }
            @if (canArchive && (l.Status is "Sent" or "Closed" or "Issued" or "Acknowledged" or "Registered"))
            {
                <form asp-controller="LetterCompose" asp-action="Archive" method="post" onsubmit="return confirm('@Localizer["Lc_ConfirmArchive"]');">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-archive" aria-hidden="true"></i> @Localizer["Lc_Archive"]</button>
                </form>
            }
            @if (l.Status == "Draft" && canEditDraft)
            {
                <form asp-action="SubmitForReview" method="post" onsubmit="return confirm('Submit this draft for review?');">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-send"></i> @Localizer["Submit for Review"]</button>
                </form>
            }
            @if (l.Status == "ReturnedForRevision" && canEditReturned)
            {
                <button type="button" class="btn btn-pems-solid btn-sm" onclick="toggleBodyEdit()"><i class="bi bi-pencil-square"></i> Edit &amp; Resubmit</button>
            }
            @if (l.Status == "PendingApproval" && canReview)
            {
                <form asp-action="Approve" method="post" class="d-inline" onsubmit="return confirm('Approve this letter?');">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @Localizer["Approve"]</button>
                </form>
                <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#returnModal"><i class="bi bi-arrow-return-left"></i> Return</button>
                <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal"><i class="bi bi-x-lg"></i> @Localizer["Reject"]</button>
            }
            @if (l.Status == "Approved" && canReview && l.LetterType != "Internal")
            {
                <form asp-action="Issue" method="post" onsubmit="return confirm('Issue this letter?');">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-send-check"></i> Issue</button>
                </form>
            }
            @if (l.Status == "Issued" && canReview)
            {
                <form asp-action="Close" method="post" onsubmit="return confirm('Close this letter?');">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-archive"></i> Close</button>
                </form>
            }

            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-action="Reply" asp-route-id="@l.LetterId"><i class="bi bi-reply-fill me-1"></i> Reply</a></li>
                    <li><a class="dropdown-item" asp-action="ExportPdf" asp-route-id="@l.LetterId"><i class="bi bi-file-earmark-pdf me-1"></i> Export PDF</a></li>
                    @if (canAudit)
                    {
                        <li><a class="dropdown-item" asp-controller="LetterCompose" asp-action="History" asp-route-id="@l.LetterId"><i class="bi bi-clock-history me-1" aria-hidden="true"></i> @Localizer["Lc_HistoryTitle"]</a></li>
                    }
                    @if (string.IsNullOrEmpty(l.SignedByName))
                    {
                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#signModal"><i class="bi bi-pen me-1"></i> Sign / Acknowledge</a></li>
                    }
                    <li><a class="dropdown-item" href="#" data-bs-toggle="collapse" data-bs-target="#addTagCollapse"><i class="bi bi-tag me-1"></i> Manage Tags</a></li>
                </ul>
            </div>
        </div>
    </div>

    @if (l.Tags.Any())
    {
        <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
            @foreach (var tag in l.Tags)
            {
                <span class="badge bg-@tag.Color">
                    @tag.Name
                    <form asp-action="DetachTag" method="post" class="d-inline">
                        <input type="hidden" name="letterId" value="@l.LetterId" />
                        <input type="hidden" name="tagId" value="@tag.TagId" />
                        <button type="submit" class="btn-close btn-close-white btn-sm" style="font-size:8px;" title="Remove tag"></button>
                    </form>
                </span>
            }
        </div>
    }

    <div class="collapse mt-2" id="addTagCollapse">
        <div class="d-flex flex-wrap gap-2">
            <form asp-action="AttachTag" method="post" class="d-flex gap-1">
                <input type="hidden" name="letterId" value="@l.LetterId" />
                <select name="tagId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- existing tag --</option>
                    @foreach (var t in allTags.Where(t => !l.Tags.Any(lt => lt.TagId == t.TagId)))
                    { <option value="@t.TagId">@t.Name</option> }
                </select>
            </form>
            <form asp-action="AttachTag" method="post" class="d-flex gap-1">
                <input type="hidden" name="letterId" value="@l.LetterId" />
                <input name="newTagName" class="form-control form-control-sm" placeholder="New tag..." />
                <select name="newTagColor" class="form-select form-select-sm" style="width:90px;">
                    @foreach (var c in new[] { "secondary", "primary", "success", "danger", "warning", "info", "dark" })
                    { <option value="@c">@c</option> }
                </select>
                <button class="btn btn-sm btn-pems-solid">+</button>
            </form>
        </div>
    </div>

    @if (l.Status == "ReturnedForRevision" && !string.IsNullOrEmpty(l.ReturnReason))
    {
        <div class="alert alert-warning mt-3 mb-0 py-2 small">
            <i class="bi bi-arrow-return-left"></i> Returned for revision by <strong>@l.ReturnedByName</strong>
            on @l.ReturnedDate?.ToString("yyyy-MM-dd HH:mm") &mdash; <em>@l.ReturnReason</em>
        </div>
    }
    @if (l.Status == "Rejected" && !string.IsNullOrEmpty(l.RejectReason))
    {
        <div class="alert alert-danger mt-3 mb-0 py-2 small">
            <i class="bi bi-x-circle"></i> Rejected by <strong>@l.RejectedByName</strong>
            on @l.RejectedDate?.ToString("yyyy-MM-dd HH:mm") &mdash; <em>@l.RejectReason</em>
        </div>
    }
</div>

@if (Model.ApprovalSteps.Any())
{
    <div class="content-card mb-3" id="approvalChain">
        <div class="section-title mb-2">@Localizer["Lc_ApprovalChain"]</div>
        <ol class="list-unstyled mb-0">
            @foreach (var step in Model.ApprovalSteps.OrderBy(x => x.StepOrder))
            {
                var stepBadge = step.Status switch { "Approved" => "bg-success", "Rejected" => "bg-danger", "Returned" => "bg-warning text-dark", _ => step.IsCurrent ? "bg-primary" : "bg-secondary" };
                <li class="d-flex flex-wrap align-items-center gap-2 py-1 @(step.IsCurrent ? "fw-semibold" : "")">
                    <span class="badge rounded-pill bg-light text-dark border">@step.StepOrder</span>
                    <span>@step.ApproverName</span>
                    <span class="badge @stepBadge">@(step.IsCurrent ? Localizer["Lc_StepCurrent"].Value : step.Status)</span>
                    @if (step.DecidedDate.HasValue) { <small class="text-muted">@step.DecidedDate.Value.ToString("yyyy-MM-dd HH:mm")</small> }
                    @if (!string.IsNullOrWhiteSpace(step.Comment)) { <small class="text-muted">&mdash; @step.Comment</small> }
                    @if (isAdmin && step.Status == "Pending" && l.Status == "PendingApproval")
                    {
                        <form asp-controller="LetterCompose" asp-action="ReassignApprover" method="post" class="d-flex gap-1 ms-auto">
                            <input type="hidden" name="letterId" value="@l.LetterId" />
                            <input type="hidden" name="stepOrder" value="@step.StepOrder" />
                            <label class="visually-hidden" for="reassign@(step.StepOrder)">@Localizer["Lc_Reassign"]</label>
                            <select name="newApproverUserId" id="reassign@(step.StepOrder)" class="form-select form-select-sm" required>
                                <option value="">@Localizer["Lc_Reassign"]</option>
                                @foreach (var opt in (IEnumerable<PEMS.Application.DTOs.ApproverOptionDto>)(ViewBag.ApproverOptions ?? new List<PEMS.Application.DTOs.ApproverOptionDto>()))
                                {
                                    <option value="@opt.UserId">@opt.FullName</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary" type="submit">@Localizer["Lc_Reassign"]</button>
                        </form>
                    }
                </li>
            }
        </ol>
    </div>
}

@* طبق بند ۱۴-۲۰: مکالمه/زنجیره‌ی پاسخ - محتوای رسمی به‌طور پیش‌فرض فقط-خواندنی؛ ویرایش فقط
   در حالت‌های مجاز و فقط توسط نویسنده‌ی اصلی، به‌صورت یک فرم صریح و مجزا (نه دکمه‌ی همیشه-حاضر) *@
<div class="content-card mb-3">
    <div class="section-title mb-2">@Localizer["Message"]</div>

    @if (thread != null && thread.Count > 1)
    {
        for (int i = 0; i < thread.Count; i++)
        {
            var msg = thread[i];
            var isCurrent = msg.LetterId == l.LetterId;
            <div class="thread-message mb-2 @(isCurrent ? "current" : "")">
                @if (isCurrent)
                {
                    <div class="small text-muted mb-1"><strong>@msg.SenderOrRegisteredByName</strong> &middot; @msg.LetterNumber &middot; @msg.LetterDate.ToString("yyyy-MM-dd")</div>
                }
                else
                {
                    <div class="msg-summary small text-muted" data-bs-toggle="collapse" data-bs-target="#threadMsg@(i)">
                        <i class="bi bi-chevron-right"></i> <strong>@msg.SenderOrRegisteredByName</strong> &middot; @msg.LetterNumber &middot; @msg.LetterDate.ToString("yyyy-MM-dd") &mdash; @msg.Subject
                    </div>
                    <div class="collapse" id="threadMsg@(i)">
                        <div class="border rounded p-2 mt-1 small">@Html.Raw(msg.Body)</div>
                    </div>
                }
            </div>
        }
    }

    @{
        // طبق بند ۱۴: Body پیش‌فرض فقط-خواندنی است. استثنای تنها Draft: چون این نامه هنوز اصلاً
        // منتشر نشده (هیچ‌کس دیگری آن را ندیده)، فرم ویرایش مستقیماً نمایش داده می‌شود؛ برای
        // ReturnedForRevision (که قبلاً یک‌بار برای بازبینی دیده شده) پیش‌فرض فقط-خواندنی است و
        // ویرایش فقط با کلیک صریح دکمه‌ی «Edit & Resubmit» در هدر باز می‌شود.
        bool showEditFormByDefault = l.Status == "Draft" && canEditDraft;
    }

    <div id="bodyViewMode" class="@(showEditFormByDefault ? "d-none" : "")">
        <div class="border rounded p-2">@Html.Raw(Model.Body)</div>
    </div>

    @if (canEditNow)
    {
        var editAction = l.Status == "Draft" ? "SaveDraft" : "Resubmit";
        var submitLabel = l.Status == "Draft" ? "Save Draft" : "Save & Resubmit for Review";

        @* طبق بند ۱۷: حالت ویرایش کنترل‌شده - قبل از فرم ویرایش، شماره‌ی رویژن و نسخه‌ای که بازبین
           واقعاً دیده (Snapshot) قابل‌مشاهده است تا نویسنده دقیقاً بداند از چه نسخه‌ای اصلاح می‌کند *@
        @if (l.Status == "ReturnedForRevision")
        {
            var latestReturnReview = Model.Reviews.FirstOrDefault(r => r.Decision == "ReturnedForRevision");
            <div class="d-flex align-items-center justify-content-between mt-2">
                <span class="badge bg-light text-dark border">Revision @(l.RevisionCount + 1)</span>
                @if (latestReturnReview?.PreviousBodySnapshot != null)
                {
                    <button type="button" class="btn btn-sm btn-link p-0" data-bs-toggle="collapse" data-bs-target="#previousVersionPanel">
                        <i class="bi bi-clock-history"></i> View previous version (as reviewed)
                    </button>
                }
            </div>
            @if (latestReturnReview?.PreviousBodySnapshot != null)
            {
                <div class="collapse mt-2" id="previousVersionPanel">
                    <div class="border rounded p-2 bg-light">
                        <div class="small text-muted mb-1">Subject: @latestReturnReview.PreviousSubjectSnapshot</div>
                        <div class="small">@Html.Raw(latestReturnReview.PreviousBodySnapshot)</div>
                    </div>
                </div>
            }
        }

        <form id="bodyEditForm" asp-action="@editAction" method="post" class="mt-2 @(showEditFormByDefault ? "" : "d-none")">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(l.RowVersion ?? Array.Empty<byte>())" id="rowVersionB64" />
            <div class="mb-2">
                <label class="form-label small">@Localizer["Subject"]</label>
                <input type="text" name="subject" class="form-control" value="@l.Subject" required />
            </div>
            <textarea name="body" id="letterBodyEditEditor" class="form-control">@Html.Raw(Model.Body)</textarea>
            <div class="mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-pems-solid">@submitLabel</button>
                @if (!showEditFormByDefault)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleBodyEdit()">@Localizer["Cancel"]</button>
                }
            </div>
        </form>

        @await Html.PartialAsync("_RichTextEditorScripts", "letterBodyEditEditor")
    }

    <script>
        function toggleBodyEdit() {
            document.getElementById('bodyViewMode').classList.toggle('d-none');
            document.getElementById('bodyEditForm').classList.toggle('d-none');
        }
    </script>
</div>

@* طبق بند ۷/۱۲: بخش Review کاملاً جدا از Referral - «آیا نامه می‌تواند جلو برود» *@
@if (Model.Reviews.Any())
{
    <div class="content-card mb-3">
        <div class="section-title mb-2">Review Decisions</div>
        <ul class="list-unstyled mb-0">
            @foreach (var rv in Model.Reviews)
            {
                var decColor = rv.Decision switch { "Approved" => "success", "Rejected" => "danger", _ => "warning" };
                <li class="d-flex gap-2 pb-2 small">
                    <span class="badge bg-@decColor" style="height:fit-content;">@rv.Decision</span>
                    <div>
                        <div>by <strong>@rv.ReviewerName</strong> &middot; @rv.CreatedDate.ToString("yyyy-MM-dd HH:mm")</div>
                        @if (!string.IsNullOrEmpty(rv.Comment)) { <div class="text-muted">@rv.Comment</div> }
                    </div>
                </li>
            }
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(l.SignedByName))
{
    <div class="alert alert-success py-2 small mb-3">
        <i class="bi bi-patch-check-fill"></i> Electronically acknowledged by <strong>@l.SignedByName</strong> on @l.SignedDate?.ToString("yyyy-MM-dd HH:mm")
    </div>
}

@if ((l.RelatedDocumentId.HasValue || l.RelatedMRId.HasValue))
{
    <div class="content-card mb-3">
        <div class="section-title mb-2">Related Records</div>
        <div class="d-flex flex-wrap gap-3 small">
            @if (l.RelatedDocumentId.HasValue)
            {
                <a asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@l.RelatedDocumentId"><i class="bi bi-file-earmark-text"></i> @l.RelatedDocumentNo</a>
            }
            @if (l.RelatedMRId.HasValue)
            {
                <a asp-controller="MaterialRequisition" asp-action="Details" asp-route-id="@l.RelatedMRId"><i class="bi bi-cart"></i> @l.RelatedMRNumber</a>
            }
        </div>
    </div>
}

<div class="accordion mb-3" id="letterAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accRecipients">
                <i class="bi bi-people me-2"></i> Recipients (@Model.Recipients.Count)
            </button>
        </h2>
        <div id="accRecipients" class="accordion-collapse collapse" data-bs-parent="#letterAccordion">
            <div class="accordion-body">
                @if (Model.Recipients.Any())
                {
                    <table class="table table-sm table-enterprise mb-2">
                        <thead><tr><th>@Localizer["Type"]</th><th>@Localizer["Name"]</th><th>@Localizer["Read"]</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Recipients)
                            {
                                <tr>
                                    <td><span class="badge @(r.RecipientType == "To" ? "bg-primary" : "bg-secondary")">@(r.RecipientType == "To" ? "To" : "Cc")</span></td>
                                    <td>@r.DisplayName</td>
                                    <td>
                                        @if (r.IsRead)
                                        { <span class="text-success small"><i class="bi bi-check2-all"></i> @r.ReadDate?.ToString("yyyy-MM-dd")</span> }
                                        else
                                        {
                                            <form asp-action="MarkRecipientRead" method="post" class="d-inline">
                                                <input type="hidden" name="letterId" value="@l.LetterId" />
                                                <input type="hidden" name="letterRecipientId" value="@r.LetterRecipientId" />
                                                <button class="btn btn-sm btn-outline-secondary">@Localizer["Mark Read"]</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                { <p class="text-muted small">No additional recipients yet.</p> }

                <form asp-action="AddRecipient" method="post" class="row g-2 mt-1 add-recipient-form">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <div class="col-md-3">
                        <select name="recipientType" class="form-select form-select-sm">
                            <option value="To">To</option>
                            <option value="Cc">Cc</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select name="employeeId" class="form-select form-select-sm employee-picker">
                            <option value="">@Localizer["-- Employee --"]</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="departmentId" class="form-select form-select-sm">
                            <option value="">@Localizer["-- or Department --"]</option>
                            @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> @Localizer["Add"]</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accAttachments">
                <i class="bi bi-paperclip me-2"></i> Attachments (@Model.Attachments.Count)
            </button>
        </h2>
        <div id="accAttachments" class="accordion-collapse collapse" data-bs-parent="#letterAccordion">
            <div class="accordion-body">
                @if (Model.Attachments.Any())
                {
                    <ul class="list-unstyled mb-2">
                        @foreach (var a in Model.Attachments)
                        {
                            <li class="mb-1"><a href="@Url.Action("Download", "Files", new { id = a.AttachmentId })" target="_blank"><i class="bi bi-file-earmark"></i> @a.FileName</a></li>
                        }
                    </ul>
                }
                else
                { <p class="text-muted small">No attachments yet.</p> }

                <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <input type="file" name="file" class="form-control form-control-sm" required />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-upload"></i> @Localizer["Upload"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accReferrals">
                <i class="bi bi-signpost-split me-2"></i> Referrals (@Model.Referrals.Count)
            </button>
        </h2>
        <div id="accReferrals" class="accordion-collapse collapse" data-bs-parent="#letterAccordion">
            <div class="accordion-body">
                @if (Model.Referrals.Any())
                {
                    <table class="table table-sm table-enterprise mb-2">
                        <thead><tr><th>Referred To</th><th>@Localizer["Instructions"]</th><th>@Localizer["Due"]</th><th>@Localizer["Status"]</th><th>@Localizer["Read"]</th><th>By / When</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Referrals)
                            {
                                <tr class="@(r.IsOverdue ? "table-danger" : "")">
                                    <td>@(r.ReferredToEmployeeName ?? r.ReferredToDepartmentName)</td>
                                    <td class="small">@r.Instructions</td>
                                    <td>@(r.DueDate?.ToString("yyyy-MM-dd"))</td>
                                    <td>
                                        @{
                                            var sb = r.Status switch { "Completed" => "bg-success", "InProgress" => "bg-info text-dark", _ => "bg-warning text-dark" };
                                        }
                                        <span class="badge @sb">@r.Status</span>
                                        @if (r.IsOverdue) { <span class="badge bg-danger">@Localizer["Overdue"]</span> }
                                    </td>
                                    <td>
                                        @if (r.IsRead)
                                        { <span class="text-success"><i class="bi bi-check2-all"></i> @Localizer["Read"]</span> }
                                        else
                                        {
                                            <form asp-action="MarkReferralRead" method="post" class="d-inline">
                                                <input type="hidden" name="referralId" value="@r.LetterReferralId" />
                                                <input type="hidden" name="letterId" value="@l.LetterId" />
                                                <button class="btn btn-sm btn-outline-secondary">@Localizer["Mark Read"]</button>
                                            </form>
                                        }
                                    </td>
                                    <td class="small text-muted">@r.ReferredByName<br />@r.ReferredDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (r.Status != "Completed")
                                        {
                                            <form asp-action="CompleteReferral" method="post" class="d-flex gap-1">
                                                <input type="hidden" name="referralId" value="@r.LetterReferralId" />
                                                <input type="hidden" name="letterId" value="@l.LetterId" />
                                                <input name="responseNote" class="form-control form-control-sm" placeholder="@Localizer["Response"]" />
                                                <button class="btn btn-sm btn-success">Done</button>
                                            </form>
                                        }
                                        else
                                        { @r.ResponseNote }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                { <p class="text-muted small">No referrals yet.</p> }

                <form asp-action="Refer" method="post" class="row g-2">
                    <input type="hidden" name="letterId" value="@l.LetterId" />
                    <div class="col-md-3">
                        <select name="referredToEmployeeId" class="form-select form-select-sm employee-picker">
                            <option value="">@Localizer["-- Employee --"]</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="referredToDepartmentId" class="form-select form-select-sm">
                            <option value="">@Localizer["-- or Department --"]</option>
                            @foreach (var d in departments) { <option value="@d.DepartmentId">@d.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-3"><input name="instructions" class="form-control form-control-sm" placeholder="@Localizer["Instructions"]" /></div>
                    <div class="col-md-2"><input name="dueDate" type="date" class="form-control form-control-sm" /></div>
                    <div class="col-md-1"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-send"></i></button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accTimeline">
                <i class="bi bi-diagram-3 me-2"></i> Activity Timeline
            </button>
        </h2>
        <div id="accTimeline" class="accordion-collapse collapse" data-bs-parent="#letterAccordion">
            <div class="accordion-body">
                @if (timeline != null && timeline.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var ev in timeline)
                        {
                            <li class="d-flex gap-2 pb-2 small">
                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-@ev.Color text-white flex-shrink-0" style="width:24px;height:24px;">
                                    <i class="bi @ev.Icon" style="font-size:12px;"></i>
                                </span>
                                <div>
                                    <div>@ev.Description</div>
                                    <div class="text-muted">
                                        @ev.EventDate.ToString("yyyy-MM-dd HH:mm")
                                        @if (!string.IsNullOrEmpty(ev.ActorName)) { <span>&middot; by @ev.ActorName</span> }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                { <p class="text-muted text-center py-2 small">No activity yet.</p> }
            </div>
        </div>
    </div>
</div>

@* مودال‌های Return/Reject/Sign - این‌ها Bootstrap استاندارد هستند (همون کتابخانه‌ای که Dropdown
   بالا هم استفاده می‌کند)، نه یک کتابخانه‌ی جدید *@
<div class="modal fade" id="returnModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="ReturnForRevision" method="post" class="modal-content">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <div class="modal-header"><h6 class="modal-title">@Localizer["Return for Revision"]</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label small">@Localizer["Reason (required)"]</label>
                <textarea name="reason" class="form-control" rows="3" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-warning btn-sm">@Localizer["Return for Revision"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Reject" method="post" class="modal-content">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <div class="modal-header"><h6 class="modal-title">Reject Letter</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label small">@Localizer["Reason (required)"]</label>
                <textarea name="reason" class="form-control" rows="3" required></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-danger btn-sm">@Localizer["Reject"]</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="signModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Sign" method="post" class="modal-content">
            <input type="hidden" name="letterId" value="@l.LetterId" />
            <div class="modal-header"><h6 class="modal-title">Sign / Acknowledge</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <label class="form-label small">Type your full name to sign</label>
                <input name="signedByName" class="form-control" required />
                <div class="form-text small">Lightweight electronic acknowledgment (typed name + timestamp), not a PKI digital signature.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                <button type="submit" class="btn btn-pems-solid btn-sm">Sign</button>
            </div>
        </form>
    </div>
</div>

@* طبق بند ۲۶: Employee فقط زمانی که کاربر واقعاً یکی از این دو Select را باز می‌کند، به‌صورت
   یک‌باره (نه برای هر Select جدا) از GetEmployeesForPicker بارگذاری می‌شود - نه هنگام بارگذاری صفحه *@
<script>
    (function () {
        var loaded = false;
        var pickers = document.querySelectorAll('.employee-picker');

        function loadEmployeesOnce() {
            if (loaded) return;
            loaded = true;
            fetch('/Letter/GetEmployeesForPicker')
                .then(function (r) { return r.json(); })
                .then(function (list) {
                    pickers.forEach(function (sel) {
                        list.forEach(function (e) {
                            var opt = document.createElement('option');
                            opt.value = e.employeeId;
                            opt.textContent = e.name;
                            sel.appendChild(opt);
                        });
                    });
                });
        }

        pickers.forEach(function (sel) {
            sel.addEventListener('focus', loadEmployeesOnce, { once: true });
        });
    })();
</script>

<script>
    // the list's "Refer" row action lands here (Details#accReferrals): open the referrals section and scroll to it
    document.addEventListener('DOMContentLoaded', function () {
        if (location.hash === '#accReferrals') {
            var el = document.getElementById('accReferrals');
            if (el && window.bootstrap) {
                window.bootstrap.Collapse.getOrCreateInstance(el, { toggle: false }).show();
                el.scrollIntoView({ block: 'center' });
            }
        }
    });
</script>
