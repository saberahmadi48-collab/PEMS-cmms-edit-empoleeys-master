@model List<PEMS.Application.DTOs.MDRImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}


<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center">
        <div>
            <strong>Discipline not showing after import?</strong>
            <pems-text class="text-muted small mb-0">
                Older imports may have failed to match discipline codes (e.g. "ME" vs "MECH"). This
                re-checks previously imported documents with the improved matching and fills in the
                discipline where it can now be recognized - no need to re-import anything.
            </pems-text>
        </div>
        <pems-form asp-action="RematchDisciplines" method="post">
            <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-arrow-repeat" /> Fix Discipline Matching</pems-button>
        </pems-form>
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="center">
        <div>
            <strong>Dashboard counts not matching the register?</strong>
            <pems-text class="text-muted small mb-0">
                Older imports could set a status like "Under Review" or "Revise &amp; Resubmit" that the
                dashboard and workflow don't recognize. This corrects those to the real workflow statuses
                (Submitted / Rejected) so counts line up everywhere.
            </pems-text>
        </div>
        <pems-form asp-action="FixLegacyStatuses" method="post">
            <pems-button tone="primary" size="small" outline="true" type="submit"><pems-icon name="bi-speedometer2" /> Fix Status Values</pems-button>
        </pems-form>
    </pems-flex>
</pems-content-card>

<pems-content-card css="mb-3 pems-s-bcaa1805">
    <pems-text class="text-muted">
        فایل اکسل MDR (Master/Engineering Document Register) سازمان را آپلود کنید. سیستم همه‌ی
        شیت‌های داده‌ای (رجیستر اصلی، Freezed Docs، Not Issued Docs) را می‌خواند و شیت‌های خلاصه/گزارش
        را نادیده می‌گیرد. هیچ داده‌ای تا تایید شما در صفحه‌ی بعد وارد جداول اصلی نمی‌شود.
    </pems-text>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="5">
            <pems-label css="small">@Localizer["Project"]</pems-label>
            <pems-select name="projectId" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="5">
            <pems-label css="small">MDR Excel File</pems-label>
            <pems-uploader name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-3">@Localizer["Recent Import Batches"]</pems-heading>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["File"])?.ToString() ?? ""), b => (object?)(b.FileName)).Add(((Localizer["Project"])?.ToString() ?? ""), b => (object?)(b.ProjectName)).Add(((Localizer["Date"])?.ToString() ?? ""), b => (object?)((PemsDates.DateTime(b.ImportDate)))).Add(((Localizer["Total"])?.ToString() ?? ""), b => (object?)(b.RowsTotal)).Add(((Localizer["Valid"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("success", b.RowsValid))).Add(((Localizer["Warning"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("warning", b.RowsWarning))).Add("Error", b => (object?)(DataCell.Badge("danger", b.RowsError))).Add(((Localizer["Duplicate"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("neutral", b.RowsDuplicate))).Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)(DataCell.Badge(b.Status == "Committed" ? "success" : "neutral", b.Status))).Add("", b => (object?)((b.Status == "Staged" ? (object?)DataCell.ButtonLink(Url.Action("Review", null, new { batchId = b.MDRImportBatchId }), "primary", "small", true, null, "Review") : null)))))" />
    </pems-table-scroll>
    @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">No MDR imports yet.</pems-text> }
</pems-content-card>
