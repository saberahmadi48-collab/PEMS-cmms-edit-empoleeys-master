@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["Back to Dashboard"]</pems-button>
</pems-flex>

<pems-row gap="3" css="mb-3">
    <pems-col md="4">
        <pems-kpi-tile label="@Localizer["کل NCR های ثبت‌شده"]">@ViewBag.TotalNCRs</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        <pems-kpi-tile tone="success" label="@Localizer["درصد بسته‌شده در ۱۴ روز"]">@ViewBag.ClosedOnTimeRate%</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        @{
            var bySeverity = (IEnumerable<dynamic>)ViewBag.BySeverity;
            var criticalCount = bySeverity.FirstOrDefault(x => x.Severity == "Critical")?.Count ?? 0;
        }
        <pems-kpi-tile tone="danger" label="@Localizer["NCR بحرانی (کل تاریخچه)"]">@criticalCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="7">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">@Localizer["نرخ NCR به تفکیک دیسیپلین"]</pems-heading>
            <pems-data-table data="@(DataRows.Of((IEnumerable<dynamic>)ViewBag.ByDiscipline, c_ => c_.Add(((Localizer["دیسیپلین"])?.ToString() ?? ""), d => (object?)(d.Discipline)).Add(((Localizer["کل"])?.ToString() ?? ""), d => (object?)(d.Total)).Add(((Localizer["باز"])?.ToString() ?? ""), d => (object?)(d.Open > 0 ? (object)@d.Open : "0")).Add(((Localizer["بحرانی"])?.ToString() ?? ""), d => (object?)(d.Critical > 0 ? (object)@d.Critical : "0")).Add(((Localizer["میانگین روز تا بستن"])?.ToString() ?? ""), d => (object?)(Math.Round((double)d.AvgDaysToClose, 1)))))" css="mb-0" />
        </pems-content-card>
    </pems-col>

    <pems-col md="5">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">@Localizer["نرخ NCR به تفکیک شدت"]</pems-heading>
            <pems-bullet-list class="list-unstyled mb-0">
                @foreach (var s in (IEnumerable<dynamic>)ViewBag.BySeverity)
                {
                    var badgeClass = s.Severity == "Critical" ? "danger" : s.Severity == "Major" ? "warning" : "neutral";
                    <pems-flex as="li" justify="between" css="border-bottom py-1">
                        <pems-badge tone="@badgeClass">@s.Severity</pems-badge>
                        <strong>@s.Count</strong>
                    </pems-flex>
                }
            </pems-bullet-list>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mt-3">
    <pems-heading level="6" class="mb-3">@Localizer["روند ماهانه NCR (۱۲ ماه اخیر)"]</pems-heading>
    @{
        var byMonth = (IEnumerable<dynamic>)ViewBag.ByMonth;
        var maxCount = byMonth.Any() ? (int)byMonth.Max(x => (int)x.Count) : 1;
        if (maxCount == 0) maxCount = 1;
    }
    @if (byMonth.Any())
    {
        <pems-flex align="end" gap="2" css="pems-s-a2ed4726">
            @foreach (var m in byMonth)
            {
                var heightPct = (int)((double)((int)m.Count) / maxCount * 100);
                <pems-flex dir="column" align="center" css="pems-s-97445a8d">
                    <div class="bg-primary pems-bar pems-h-pct-@Math.Clamp(heightPct, 0, 100)" title="@m.Count"></div>
                    <div class="text-muted small mt-1 pems-s-3e8135c8">@m.Month</div>
                </pems-flex>
            }
        </pems-flex>
    }
    else
    {
        <pems-text class="text-muted small mb-0">@Localizer["داده‌ای برای ۱۲ ماه اخیر نیست."]</pems-text>
    }
</pems-content-card>
