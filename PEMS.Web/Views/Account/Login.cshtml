@model PEMS.Web.Models.Account.LoginViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<h2>Welcome back</h2>
<p class="subtitle">Sign in to access the Engineering Command Center</p>

<div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

<form asp-controller="Account" asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="mb-3">
        <label asp-for="UserName" class="form-label">@Localizer["Username"]</label>
        <input asp-for="UserName" class="form-control" placeholder="e.g. admin" autofocus />
        <span asp-validation-for="UserName" class="text-danger small"></span>
    </div>

    <div class="mb-2">
        <label asp-for="Password" class="form-label">@Localizer["Password"]</label>
        <input asp-for="Password" class="form-control" placeholder="Enter Your Password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="form-check mb-3 mt-2">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label small">Remember Me</label>
    </div>

    <button type="submit" class="btn btn-pems" id="loginSubmitBtn">
        <span id="loginSubmitLabel">Sign In</span>
    </button>

    <div class="auth-links">
        <a asp-action="ForgotPassword">Forgot Password?</a>
        <span class="text-muted">PEMS v1.0</span>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // طبق «PEMS Premium Three-Theme UI/UX Redesign» (بند ۲۳/۲۸): نمونه‌ی محدود و کم‌ریسک
        // از سیستم Loading تازه - فقط روی همین فرم، بدون دست‌زدن به رفتار Submit یا اعتبارسنجی
        // موجود (طبق بند ۹ (touch/loading-buttons) اسکیل ui-ux-pro-max: دکمه باید حین کار
        // async غیرفعال شود و بازخورد بدهد).
        (function () {
            var form = document.querySelector('form[action*="Login"], form');
            var btn = document.getElementById('loginSubmitBtn');
            var label = document.getElementById('loginSubmitLabel');
            if (!form || !btn || !label) return;
            form.addEventListener('submit', function () {
                if (!form.checkValidity || form.checkValidity()) {
                    btn.disabled = true;
                    label.innerHTML = '<span class="pems-inline-progress" style="color:#fff"><span class="pems-dot"></span><span class="pems-dot"></span><span class="pems-dot"></span></span> Signing in…';
                }
            });
        })();
    </script>
}
