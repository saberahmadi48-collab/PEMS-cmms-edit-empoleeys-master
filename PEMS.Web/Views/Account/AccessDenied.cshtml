@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="text-center">
    <div class="pems-s-73ec564c">
        <pems-icon name="bi-shield-lock-fill" />
    </div>
    <pems-heading level="2" class="mt-2">@Localizer["Access Denied"]</pems-heading>
    <pems-text class="subtitle">
        You don't have permission to view this page.
        If you believe this is a mistake, contact your System Administrator.
    </pems-text>

    <pems-button as="a" tone="none" css="btn-pems" asp-controller="Home" asp-action="Index">@Localizer["Back to Dashboard"]</pems-button>
</div>
