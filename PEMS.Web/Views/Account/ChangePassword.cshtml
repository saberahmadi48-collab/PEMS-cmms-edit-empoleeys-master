@model PEMS.Web.Models.Account.ChangePasswordViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Change Password";
    Layout = "_AuthLayout";
}

<pems-heading level="2">@Localizer["تغییر رمز عبور"]</pems-heading>
<pems-text class="subtitle">@Localizer["Your password is temporary. Set a new password before continuing."]</pems-text>

<pems-validation-summary css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-validation-summary>

@if (TempData["Message"] != null)
{
    <pems-alert tone="success" css="py-2 px-3 small">@TempData["Message"]</pems-alert>
}

<pems-form asp-controller="Account" asp-action="ChangePassword" method="post">
    <pems-form-group css="mb-3">
        <pems-label asp-for="CurrentPassword">@Localizer["رمز فعلی"]</pems-label>
        <pems-input asp-for="CurrentPassword" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </pems-form-group>

    <pems-form-group css="mb-3">
        <pems-label asp-for="NewPassword">@Localizer["رمز جدید"]</pems-label>
        <pems-input asp-for="NewPassword" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </pems-form-group>

    <pems-form-group css="mb-3">
        <pems-label asp-for="ConfirmPassword">@Localizer["تکرار رمز جدید"]</pems-label>
        <pems-input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </pems-form-group>

    <pems-button tone="none" css="btn-pems" type="submit">@Localizer["تغییر رمز"]</pems-button>
</pems-form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
