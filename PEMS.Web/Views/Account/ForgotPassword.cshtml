@model PEMS.Web.Models.Account.ForgotPasswordViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
    bool submitted = ViewBag.Submitted == true;
}

<pems-heading level="2">@Localizer["Forgot Password"]</pems-heading>
<pems-text class="subtitle">Enter your email and the System Administrator will assist you</pems-text>

@if (submitted)
{
    <pems-alert tone="success" css="small">
        If this email exists in our system, a system administrator has been notified.
        Please contact your <strong>System Admin</strong> to reset your password.
    </pems-alert>
}
else
{
    <pems-form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <pems-form-group css="mb-3">
            <pems-label asp-for="Email">@Localizer["Email"]</pems-label>
            <pems-input asp-for="Email" placeholder="you@company.com" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </pems-form-group>

        <pems-button tone="none" css="btn-pems" type="submit">@Localizer["Send Request"]</pems-button>
    </pems-form>
}

<div class="auth-links">
    <pems-link asp-action="Login">&larr; Back to Login</pems-link>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
