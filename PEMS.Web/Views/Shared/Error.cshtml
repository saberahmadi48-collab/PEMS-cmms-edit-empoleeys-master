@model ErrorViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Error_Title"].Value;
}

<div class="content-card" style="max-width:640px;margin:2rem auto;">
    <h4 class="text-danger"><i class="bi bi-exclamation-octagon"></i> @Localizer["Error_Title"]</h4>
    <p>@Localizer["Error_Message"]</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">@Localizer["Error_RequestId"]: <code>@Model.RequestId</code></p>
    }
    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">@Localizer["Rcm_Back"]</a>
    <a href="/" class="btn btn-pems-solid btn-sm">@Localizer["Error_Home"]</a>
</div>
