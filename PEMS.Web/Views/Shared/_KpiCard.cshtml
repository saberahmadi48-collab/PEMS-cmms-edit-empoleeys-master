@model PEMS.Web.Models.KpiCardViewModel

@if (!string.IsNullOrEmpty(Model.Url))
{
    <a href="@Model.Url" class="kpi-card kpi-link text-decoration-none" title="@Model.Hint">
        <div class="kpi-icon @Model.ColorClass"><i class="bi @Model.IconClass"></i></div>
        <div>
            <div class="kpi-value">@Model.DisplayCount</div>
            <div class="kpi-label">@Model.Title</div>
        </div>
    </a>
}
else
{
    <div class="kpi-card" title="@Model.Hint">
        <div class="kpi-icon @Model.ColorClass"><i class="bi @Model.IconClass"></i></div>
        <div>
            <div class="kpi-value">@Model.DisplayCount</div>
            <div class="kpi-label">@Model.Title</div>
        </div>
    </div>
}