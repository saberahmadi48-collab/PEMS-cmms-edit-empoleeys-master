@model PEMS.Web.Models.BarcodePanelViewModel
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@* طبق «PEMS — Enterprise Barcode System» بند «UI»: یک پارتیال مشترک برای تب Barcode - روی هر
   صفحه‌ی Details موجودی که ازش استفاده کند (Equipment/MaterialItem/...) بدون تکرار کد. *@

<pems-content-card>
    @if (Model.ActiveBarcode == null)
    {
        <pems-text class="text-muted small">No active barcode for this record yet.</pems-text>
        @if (Model.CanManage)
        {
            <pems-button as="a" tone="primary" size="small" href="/f/barcode-generate?targetType=@Model.TargetType&targetId=@Model.TargetId"><pems-icon name="bi-upc-scan" /> Generate Barcode</pems-button>
        }
    }
    else
    {
        var b = Model.ActiveBarcode;
        <pems-row gap="3" css="align-items-center">
            <pems-col md="3" css="text-center">
                <img class="pems-maxw-100pct" src="/x/barcode-svg?id=@b.BarcodeIdentityId" alt="barcode" />
                <div class="small mt-1" dir="ltr"><code>@b.Code</code></div>
            </pems-col>
            <pems-col md="9">
                <pems-row gap="2" css="small mb-2">
                    <pems-col md="3"><strong>@Localizer["Symbology"]</strong><div>@b.Symbology</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Status"]</strong><div><pems-badge tone="@(b.Status == "Active" ? "success" : "neutral")">@b.Status</pems-badge></div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Prints"]</strong><div>@b.PrintCount</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Created"]</strong><div>@PemsDates.Date(b.CreatedDate)</div></pems-col>
                </pems-row>

                @if (Model.CanManage)
                {
                    <pems-flex wrap="true" gap="2">
                        <pems-button as="a" tone="primary" size="small" outline="true" href="/f/barcode-print?id=@b.BarcodeIdentityId"><pems-icon name="bi-printer" /> Print Label</pems-button>
                        <pems-button as="a" tone="neutral" size="small" outline="true" href="/f/barcode-disable?id=@b.BarcodeIdentityId">Disable</pems-button>
                        <pems-button as="a" tone="danger" size="small" outline="true" href="/f/barcode-revoke?id=@b.BarcodeIdentityId">@Localizer["Revoke"]</pems-button>
                        <pems-button as="a" tone="warning" size="small" outline="true" href="/f/barcode-replace?id=@b.BarcodeIdentityId">Replace</pems-button>
                    </pems-flex>
                }
            </pems-col>
        </pems-row>
    }
</pems-content-card>
