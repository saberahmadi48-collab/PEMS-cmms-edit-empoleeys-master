@model PEMS.Application.DTOs.RelationshipGapReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <pems-heading level="5" class="mb-0"><pems-icon name="bi-clipboard-x" /> @Localizer["گزارش تحلیل شکاف - رابطه‌های ناقص تجهیزات"]</pems-heading>
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["بازگشت به Explorer"]</pems-button>
</pems-flex>

<pems-text class="text-muted small">
    این گزارش برعکس Explorer عمل می‌کنه: به‌جای کاوش از یک تجهیز مشخص، همه‌ی تجهیزات رو بررسی
    می‌کنه و نشون می‌ده کدوم‌ها هنوز به مدرک مهندسی، VDR، MR یا WorkOrder وصل نشدن - برای
    برنامه‌ریزی و پیگیری شکاف‌های داده.
</pems-text>

<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <pems-kpi-tile label="@Localizer["کل تجهیزات"]">@Model.TotalEquipmentCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="success" label="@Localizer["کاملاً وصل (هر ۴ نوع رابطه)"]">@Model.FullyLinkedCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="warning" label="@Localizer["ناقص (بعضی روابط)"]">@Model.PartiallyLinkedCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="danger" label="@Localizer["کاملاً بدون رابطه"]">@Model.UnlinkedCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-content-card>
    <pems-data-table data="@(DataRows.Of(Model.Items, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), item => (object?)(DataCell.Span(null, item.TagNumber).WithTag("strong"))).Add(((Localizer["Name"])?.ToString() ?? ""), item => (object?)(item.Name), css: "small").Add(((Localizer["Area"])?.ToString() ?? ""), item => (object?)(item.Area), css: "small").Add(((Localizer["Discipline"])?.ToString() ?? ""), item => (object?)(item.DisciplineName), css: "small").Add(((Localizer["مدارک"])?.ToString() ?? ""), item => (object?)((item.HasDocuments ? "✅" : "❌")), css: "text-center", headerCss: "text-center").Add(((Localizer["VDR"])?.ToString() ?? ""), item => (object?)((item.HasVdrItems ? "✅" : "❌")), css: "text-center", headerCss: "text-center").Add("MR", item => (object?)((item.HasMR ? "✅" : "❌")), css: "text-center", headerCss: "text-center").Add("WorkOrder", item => (object?)((item.HasWorkOrders ? "✅" : "❌")), css: "text-center", headerCss: "text-center").Add("", item => (object?)(DataCell.ButtonLink(Url.Action("Equipment", null, new { id = item.EquipmentId }), "primary", "small", true, null, DataCell.Icon("bi-diagram-3"))))))" css="mb-0" />
    @if (!Model.Items.Any())
    {
        <pems-text class="text-muted text-center py-4 mb-0">همه‌ی تجهیزات کاملاً وصل هستن - عالیه!</pems-text>
    }
</pems-content-card>
