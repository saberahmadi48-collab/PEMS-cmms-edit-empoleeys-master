@model PEMS.Application.DTOs.RelationshipExplorationDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="mb-3">
    <pems-flex justify="between" align="start" wrap="true" gap="2">
        <pems-text class="text-muted mb-0">
            از یک شماره تگ تجهیز (مثل P-101 یا 80-P-6005)، شماره مدرک، یا نام Vendor شروع کنید تا کل زنجیره‌ی
            روابط مهندسی مرتبط (مدارک، P&amp;ID، Vendor، قرارداد، PO، MR/MRQ، نگهداری و تعمیرات) نمایش داده شود.
        </pems-text>
        <pems-flex gap="2">
            <pems-button tone="warning" size="small" outline="true" css="text-nowrap" as="a" asp-action="BulkSuggestions">
                <pems-icon name="bi-check2-all" /> @Localizer["تایید دسته‌جمعی اتصال‌ها"]
            </pems-button>
            <pems-button tone="neutral" size="small" outline="true" css="text-nowrap" as="a" asp-action="GapReport">
                <pems-icon name="bi-clipboard-x" /> @Localizer["گزارش تجهیزات ناقص"]
            </pems-button>
        </pems-flex>
    </pems-flex>
    <pems-form class="mt-2" asp-action="Search" method="get"><pems-flex gap="2">
        <pems-input type="text" name="q" value="@ViewBag.Query" placeholder="e.g. P-101, or a vendor name, or a document number" />
        <pems-button tone="primary"><pems-icon name="bi-diagram-3" /> @Localizer["Explore"]</pems-button>
    </pems-flex></pems-form>
</pems-content-card>

@if (TempData["Error"] != null)
{
    <pems-content-card css="mb-3 border-danger">
        <pems-text class="text-danger mb-2"><pems-icon name="bi-exclamation-triangle" /> @TempData["Error"]</pems-text>
        @if (TempData["ConflictEquipmentId"] != null)
        {
            <pems-form asp-action="ConfirmSuggestedLink" method="post" class="d-inline">
                <input type="hidden" name="equipmentId" value="@TempData["ConflictEquipmentId"]" />
                <input type="hidden" name="targetType" value="@TempData["ConflictTargetType"]" />
                <input type="hidden" name="targetId" value="@TempData["ConflictTargetId"]" />
                <input type="hidden" name="force" value="true" />
                <pems-button tone="danger" size="small" type="submit" data-pems-confirm="مطمئنی؟ رابطه‌ی قبلی جایگزین می‌شه.">
                    <pems-icon name="bi-exclamation-octagon" /> بله، جایگزین کن (Force)
                </pems-button>
            </pems-form>
        }
    </pems-content-card>
}

@if (Model == null)
{
    @if (!string.IsNullOrEmpty((string?)ViewBag.Query))
    {
        <pems-content-card><pems-text class="text-muted text-center py-4">No equipment, document, or vendor matched "@ViewBag.Query".</pems-text></pems-content-card>
    }
}
else
{
    <pems-content-card css="mb-3">
        <pems-flex justify="between" align="center" wrap="true" gap="2">
            <pems-heading level="5" class="mb-0"><pems-icon name="bi-bullseye" /> @Model.RootType: @Model.RootLabel</pems-heading>
            <pems-flex align="center" gap="2">
                @if (!string.IsNullOrWhiteSpace(Model.RootArea))
                {
                    <pems-badge tone="neutral"><pems-icon name="bi-geo-alt" /> @Model.RootArea</pems-badge>
                }
                @if (Model.RootType == "Equipment")
                {
                    <pems-badge tone="@(Model.RootIsActive ? "success" : "neutral")">@(Model.RootIsActive ? "Active" : "Inactive")</pems-badge>
                }
            </pems-flex>
        </pems-flex>

        @if (Model.PIDDocument != null)
        {
            <div class="mt-2">
                <span class="text-muted small">P&amp;ID:</span>
                <pems-link asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@Model.PIDDocument.NodeId" class="fw-bold">
                    @Model.PIDDocument.Label <pems-icon name="bi-box-arrow-up-right" css="small" />
                </pems-link>
                <span class="text-muted small">@Model.PIDDocument.SubLabel</span>
            </div>
        }
    </pems-content-card>

    @if (Model.RootType == "Equipment" && Model.SuggestedLinks.Any())
    {
        <pems-content-card css="mb-3 border-warning">
            <pems-heading level="6" class="mb-3"><pems-icon name="bi-lightbulb" /> پیشنهادهای اتصال (تاییدنشده)</pems-heading>
            <pems-text class="text-muted small">
                این‌ها از روی شماره‌ی MRQ/PO خام ثبت‌شده روی تجهیز، با داده‌ی <strong>@Localizer["موجود"]</strong>
                (نه ساخته‌شده) منطبق شده‌اند. تا تایید نکنی، هیچ رابطه‌ی رسمی برقرار نمی‌شه.
            </pems-text>
            <pems-bullet-list class="list-unstyled mb-0">
                @foreach (var suggestion in Model.SuggestedLinks)
                {
                    <pems-flex as="li" justify="between" align="center" css="border-bottom py-2">
                        <span>
                            <pems-badge tone="warning"><pems-icon name="bi-robot" /> @Localizer["پیشنهاد"]</pems-badge>
                            @suggestion.Label
                            <span class="text-muted small">@suggestion.SubLabel</span>
                        </span>
                        <pems-form asp-action="ConfirmSuggestedLink" method="post" class="d-inline">
                            <input type="hidden" name="equipmentId" value="@Model.RootId" />
                            <input type="hidden" name="targetType" value="@suggestion.NodeType" />
                            <input type="hidden" name="targetId" value="@suggestion.NodeId" />
                            <pems-button tone="success" size="small" type="submit"><pems-icon name="bi-check-lg" /> تایید اتصال</pems-button>
                        </pems-form>
                    </pems-flex>
                }
            </pems-bullet-list>
        </pems-content-card>
    }

    <pems-row gap="3">
        @{
            var sections = new (string Title, string Icon, List<PEMS.Application.DTOs.RelationshipNodeDto> Items, string? Controller, string? Action)[]
            {
                ("Engineering Documents", "bi-file-earmark-text", Model.Documents, "EngineeringDocuments", "Details"),
                ("Vendor Documents (VDR)", "bi-journal-check", Model.VendorDocuments, "VDR", "Details"),
                ("Related Equipment", "bi-gear", Model.Equipment, "Equipment", "Details"),
                ("Vendors", "bi-building", Model.Vendors, "Vendor", "Details"),
                ("Contracts", "bi-file-earmark-ruled", Model.Contracts, "Contract", "Details"),
                ("Procurement Packages", "bi-box-seam", Model.ProcurementPackages, "ProcurementPackage", "Details"),
                ("Purchase Orders", "bi-receipt", Model.PurchaseOrders, null, null),
                ("Tenders", "bi-clipboard-check", Model.Tenders, "Tender", "Details"),
                ("Bids", "bi-cash-coin", Model.Bids, null, null),
                ("Notice to Proceed (NTP)", "bi-flag", Model.ContractNTPs, null, null),
                ("Kick-off Meetings", "bi-people", Model.KickoffMeetings, "Meeting", "Details"),
                ("Inspection / ITP", "bi-clipboard-data", Model.InspectionTestPlans, "QC", "ItpDetails"),
                ("Material Requisitions", "bi-cart-check", Model.MaterialRequisitions, "MaterialRequisition", "Details"),
                ("Quotations (MRQ)", "bi-file-earmark-spreadsheet", Model.Quotations, null, null),
                ("Maintenance / Work Orders", "bi-tools", Model.WorkOrders, null, null),
                ("NCR", "bi-exclamation-triangle", Model.NonConformanceReports, "QC", "NcrDetails"),
                ("MOC", "bi-arrow-repeat", Model.MOCs, "MOC", "Details"),
                ("TQ / TSR / RFI", "bi-question-circle", Model.TechnicalQueries, "TechnicalQuery", "Details"),
            };
        }

        @foreach (var s in sections)
        {
            <pems-col md="6">
                <pems-content-card css="h-100">
                    <pems-heading level="6" class="mb-3"><pems-icon css="@s.Icon" /> @s.Title <pems-badge tone="neutral">@s.Items.Count</pems-badge></pems-heading>
                    @if (s.Items.Any())
                    {
                        <pems-bullet-list class="list-unstyled mb-0">
                            @foreach (var item in s.Items)
                            {
                                <pems-flex as="li" justify="between" align="start" css="mb-1 border-bottom pb-1">
                                    <span>
                                        @if (s.Controller != null)
                                        {
                                            <pems-link asp-controller="@s.Controller" asp-action="@s.Action" asp-route-id="@item.NodeId">@item.Label</pems-link>
                                        }
                                        else
                                        {
                                            @item.Label
                                        }

                                        @if (item.Priority == "High" || item.Priority == "Urgent")
                                        {
                                            <pems-badge tone="danger" css="ms-1">@item.Priority</pems-badge>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(item.Priority))
                                        {
                                            <pems-badge tone="none" css="bg-light text-dark ms-1">@item.Priority</pems-badge>
                                        }

                                        @if (item.DelayDays.HasValue && item.DelayDays > 0)
                                        {
                                            <pems-badge tone="danger" css="ms-1" title="@Localizer["روزهای تاخیر"]"><pems-icon name="bi-clock-history" /> @item.DelayDays روز تاخیر</pems-badge>
                                        }
                                        else if (item.PlannedOrDueDate.HasValue)
                                        {
                                            <span class="text-muted small ms-1">(@PemsDates.Date(item.PlannedOrDueDate.Value))</span>
                                        }
                                    </span>
                                    <span class="text-end">
                                        <span class="text-muted small d-block">@item.SubLabel</span>
                                        <pems-flex as="span" justify="end" gap="1">
                                            @if (!item.IsConfirmed)
                                            {
                                                <pems-badge tone="warning" title="فقط طبق تطبیق متنی - رابطه‌ی رسمی/تاییدشده نیست">
                                                    <pems-icon name="bi-question-circle" /> احتمالی
                                                </pems-badge>
                                            }
                                            @if (item.IsAIProposed)
                                            {
                                                <pems-badge tone="info" title="AI-detected, not from a direct database link">
                                                    <pems-icon name="bi-robot" /> AI
                                                </pems-badge>
                                            }
                                        </pems-flex>
                                    </span>
                                </pems-flex>
                            }
                        </pems-bullet-list>
                    }
                    else
                    {
                        <pems-text class="text-muted small mb-0">@Localizer["None found."]</pems-text>
                    }
                </pems-content-card>
            </pems-col>
        }
    </pems-row>
}
