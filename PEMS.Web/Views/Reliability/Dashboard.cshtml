@model List<PEMS.Application.DTOs.EquipmentReliabilityDto>
@using PEMS.Application.DTOs
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var classReliability = (List<EquipmentClassReliabilityDto>)ViewBag.ClassReliability;
    var badActors = (List<BadActorDto>)ViewBag.BadActors;
    var pareto = (List<FailureParetoItemDto>)ViewBag.FailureModePareto;
    var pmCompliance = (PmComplianceDto)ViewBag.PmCompliance;
    var breakdown = (MaintenanceTypeBreakdownDto)ViewBag.MaintenanceTypeBreakdown;
    var repeatFailures = (List<RepeatFailureGroupDto>)ViewBag.RepeatFailures;
    var criticalityMatrix = (List<CriticalityMatrixRowDto>)ViewBag.CriticalityFailureMatrix;
    var criticalityMaintenanceMatrix = (List<CriticalityFailureMaintenanceRowDto>)ViewBag.CriticalityFailureMaintenanceMatrix;
    var dataQuality = (ReliabilityDataQualityDto)ViewBag.DataQuality;
    var conditionMonitoring = (ConditionMonitoringFoundationStatusDto)ViewBag.ConditionMonitoring;
    var predictive = (PredictiveMaintenanceReadinessDto)ViewBag.Predictive;

    string StatusBadge(string status) => status switch
    {
        "READY" => "success",
        "PARTIAL" => "warning",
        "INSUFFICIENT_DATA" => "warning",
        "NOT_READY" => "neutral",
        _ => "light"
    };

    var totalEquipmentWithFailures = Model.Count;
}

<pems-flex justify="end" align="center" css="mb-2">
    <div>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">Fleet Reliability</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Intelligence">@Localizer["Maintenance Intelligence"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="PredictiveMaintenance">@Localizer["Predictive"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ConditionMonitoring">@Localizer["Condition Monitoring"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="CBMDashboard">@Localizer["CBM Dashboard"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="AiInsights">@Localizer["AI Insights"]</pems-button>
    </div>
</pems-flex>
<pems-text class="text-muted small">
    طبق «PEMS Phase 9» بند ۲۰/۳۱: هیچ درصد/KPI جعلی این‌جا نمایش داده نمی‌شود - هرجا داده کافی
    نیست، N/A یا وضعیت صریح (NOT_READY/INSUFFICIENT_DATA) نشان داده می‌شود.
</pems-text>

@* ===================== Executive Reliability ===================== *@
<pems-heading level="6" class="mt-4">Executive Reliability</pems-heading>
<pems-row gap="3" css="mb-3">
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@totalEquipmentWithFailures</pems-metric>
            <div class="text-muted small">@Localizer["Equipment with Failure History"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@(pmCompliance.CompliancePercent.HasValue ? $"{pmCompliance.CompliancePercent.Value:N1}%" : "N/A")</pems-metric>
            <div class="text-muted small">@Localizer["PM Compliance"]</div>
            <pems-badge tone="@StatusBadge(pmCompliance.DataStatus)">@pmCompliance.DataStatus</pems-badge>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@(breakdown.Items.FirstOrDefault(x => x.TypeName == "Corrective")?.Percent is { } cp ? $"{cp:N1}%" : "N/A")</pems-metric>
            <div class="text-muted small">Corrective Ratio</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@(breakdown.EmergencyWorkRatioPercent.HasValue ? $"{breakdown.EmergencyWorkRatioPercent.Value:N1}%" : "N/A")</pems-metric>
            <div class="text-muted small">Emergency Ratio</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@repeatFailures.Count</pems-metric>
            <div class="text-muted small">@Localizer["Repeat Failure Groups"]</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="2">
        <pems-content-card css="h-100 text-center">
            <pems-metric>@badActors.Count</pems-metric>
            <div class="text-muted small">Bad Actors (top list)</div>
        </pems-content-card>
    </pems-col>
</pems-row>

@* ===================== Criticality ===================== *@
<pems-heading level="6" class="mt-4">@Localizer["Criticality"]</pems-heading>
<pems-content-card css="mb-3">
    <div class="table-scroll-area pems-s-0ddf068b">
    @{
        var rows_23 = criticalityMatrix;
        var cell_23_0 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@row.CriticalityClass</text>);
        var cell_23_1 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@row.EquipmentCount</text>);
        var cell_23_2 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@row.FailureCount</text>);
        var cell_23_3 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@row.RepeatFailureGroupCount</text>);
        var cell_23_4 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@(row.PmCompliancePercent.HasValue ? $"{row.PmCompliancePercent.Value:N1}%" : "N/A")</text>);
        var cell_23_5 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@(m2 != null ? $"{m2.StrategyCoveragePercent:N0}%" : "N/A")</text>);
        var cell_23_6 = DataCell.Template(rows_23, @<text>@{ var row = item; var m2 = criticalityMaintenanceMatrix.FirstOrDefault(x => x.CriticalityClass == row.CriticalityClass); }@(m2?.RcmClassCoveragePercent.HasValue == true ? $"{m2.RcmClassCoveragePercent.Value:N0}%" : "N/A")</text>);
    }
    <pems-data-table data="@(DataRows.Of(rows_23, c_ => c_.Add(((Localizer["Class"])?.ToString() ?? ""), row => (object?)cell_23_0(row), css: "fw-bold").Add(((Localizer["Equipment"])?.ToString() ?? ""), row => (object?)cell_23_1(row), css: "text-end", headerCss: "text-end").Add(((Localizer["Failures"])?.ToString() ?? ""), row => (object?)cell_23_2(row), css: "text-end", headerCss: "text-end").Add(((Localizer["Repeat"])?.ToString() ?? ""), row => (object?)cell_23_3(row), css: "text-end", headerCss: "text-end").Add(((Localizer["PM Compliance"])?.ToString() ?? ""), row => (object?)cell_23_4(row), css: "text-end", headerCss: "text-end").Add(((Localizer["Strategy Coverage"])?.ToString() ?? ""), row => (object?)cell_23_5(row), css: "text-end", headerCss: "text-end").Add("RCM Class Coverage", row => (object?)cell_23_6(row), css: "text-end", headerCss: "text-end")))" dense="true" css="mb-0" />
    </div>
    <pems-link asp-action="Intelligence" class="small">See full Criticality × Failure × Maintenance matrix with findings →</pems-link>
</pems-content-card>

@* ===================== Maintenance / Failure ===================== *@
<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-2">Top Failure Modes (Pareto)</pems-heading>
            <pems-data-table data="@(DataRows.Of(pareto, c_ => c_.Add("", p => (object?)(p.Key)).Add("", p => (object?)(p.Count), css: "text-end").Add("", p => (object?)(DataCell.Group((p.CumulativePercent.ToString("N0")), "%")), css: "text-end small text-muted")))" header="false" dense="true" css="mb-0" />
            @if (!pareto.Any()) { <pems-text class="text-muted text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</pems-text> }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-2">@Localizer["Bad Actors"]</pems-heading>
            <pems-data-table data="@(DataRows.Of(badActors, c_ => c_.Add("", b => (object?)(DataCell.Link(Url.Action("EquipmentProfile", null, new { id = b.EquipmentId }), b.TagNumber))).Add("", b => (object?)(DataCell.Group(b.FailureCount, " failures")), css: "text-end").Add("", b => (object?)(DataCell.Group((b.TotalDowntimeHours.ToString("N0")), "h")), css: "text-end small text-muted")))" header="false" dense="true" css="mb-0" />
            @if (!badActors.Any()) { <pems-text class="text-muted text-center py-3 mb-0">@Localizer["داده‌ای موجود نیست."]</pems-text> }
        </pems-content-card>
    </pems-col>
</pems-row>

@* ===================== RCM/FMEA + Predictive/Condition ===================== *@
<pems-row gap="3">
    <pems-col md="4">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-2">Reliability Data Quality</pems-heading>
            <div class="small">Equipment Reliability Coverage: @dataQuality.EquipmentReliabilityCoveragePercent.ToString("N1")%</div>
            <div class="small">Failure Taxonomy Coverage: @dataQuality.FailureTaxonomyCoveragePercent.ToString("N1")%</div>
            <div class="small">Repair Data Coverage: @dataQuality.RepairDataCoveragePercent.ToString("N1")%</div>
            <div class="small">Maintenance Strategy Coverage: @dataQuality.MaintenanceStrategyCoveragePercent.ToString("N1")%</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-2">Predictive Maintenance</pems-heading>
            <div>Engine: <pems-badge tone="@StatusBadge(predictive.EngineStatus)">@predictive.EngineStatus</pems-badge></div>
            <div>Production Model: <pems-badge tone="@StatusBadge(predictive.ProductionModelStatus)">@predictive.ProductionModelStatus</pems-badge></div>
            <div class="small text-muted mt-1">@predictive.Reason</div>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-2">@Localizer["Condition Monitoring"]</pems-heading>
            <div>Foundation: <pems-badge tone="@StatusBadge(conditionMonitoring.FoundationStatus)">@conditionMonitoring.FoundationStatus</pems-badge></div>
            <div>Live Telemetry: <pems-badge tone="@StatusBadge(conditionMonitoring.LiveTelemetryStatus)">@conditionMonitoring.LiveTelemetryStatus</pems-badge></div>
            <div class="small text-muted mt-1">@conditionMonitoring.MonitoringPointCount points, @conditionMonitoring.ReadingCount readings</div>
        </pems-content-card>
    </pems-col>
</pems-row>
