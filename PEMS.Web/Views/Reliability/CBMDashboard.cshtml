@model PEMS.Application.DTOs.CbmDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string EvalBadge(string status) => status switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Normal" => "bg-success",
        "RequiresEngineeringReview" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}

<pems-flex justify="end" align="center" gap="2" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index">@Localizer["← Reliability"]</pems-button>
</pems-flex>
<pems-text class="text-muted small">
    طبق «PEMS — Equipment Passport Audit & CBM» فاز ۱ ممیزی §3.8: این داشبورد فقط تجمیع
    (Aggregation) روی داده‌ی واقعی موجود است - هیچ KPI جعلی/شبیه‌سازی‌شده این‌جا نمایش داده نمی‌شود.
</pems-text>

<pems-row gap="3" css="mb-3">
    <pems-col md="3">
        <pems-kpi-tile label="@Localizer["Monitoring Points"]" sub="@Model.PointsWithEvaluationProfile @Localizer["با پروفایل ارزیابی"] · @Model.PointsWithCbmStrategy @Localizer["با استراتژی CBM"]">@Model.TotalActivePoints</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="danger" label="@Localizer["Critical"] / @Localizer["Alarm"]" sub="@Model.WarningCount @Localizer["Warning"] · @Model.RequiresEngineeringReviewCount @Localizer["Mark for Engineering Review"]">@(Model.CriticalCount + Model.AlarmCount)</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile label="@Localizer["Open Findings"]" sub="@Model.LinkedFindingCount @Localizer["Linked"]">@Model.OpenFindingCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="3">
        <pems-kpi-tile tone="@(Model.OverdueCbmPlanCount > 0 ? "danger" : "")" label="@Localizer["Overdue"] CBM" sub="@Model.DueSoonCbmPlanCount @Localizer["Due Soon"]">@Model.OverdueCbmPlanCount</pems-kpi-tile>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="6">
        <pems-content-card>
            <pems-heading level="6" class="mb-2">@Localizer["Needs Attention"]</pems-heading>
            @if (Model.AttentionPoints.Count == 0)
            {
                <pems-text class="text-muted small mb-0">@Localizer["هیچ نقطه‌ی پایشی در حال حاضر نیاز به توجه ندارد."]</pems-text>
            }
            else
            {
                var rows_72 = Model.AttentionPoints;
                var cell_72_2 = DataCell.Template(rows_72, @<text>@{ var p = item; }<pems-badge tone="none" css="@EvalBadge(p.EvaluationStatus)">@p.EvaluationStatus</pems-badge></text>);
                <pems-data-table data="@(DataRows.Of(rows_72, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), p => (object?)(DataCell.Link(Url.Action("Details", "Equipment", new { id = p.EquipmentId }), p.EquipmentTagNumber))).Add(((Localizer["Variable"])?.ToString() ?? ""), p => (object?)(DataCell.Group(p.VariableType, " — ", p.Tag)), css: "small").Add(((Localizer["Evaluation"])?.ToString() ?? ""), p => (object?)cell_72_2(p)).Add(((Localizer["Last Reading"])?.ToString() ?? ""), p => (object?)((PemsDates.Date(p.LastReadingDate) ?? "-")), css: "small")))" dense="true" enterprise="false" />
                @if (Model.AttentionPointsTruncated)
                {
                    <div class="small text-muted">@Localizer["فهرست به بالاترین ۵۰ مورد محدود شده است."]</div>
                }
            }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card>
            <pems-heading level="6" class="mb-2">@Localizer["Overdue CBM Plans"]</pems-heading>
            @if (Model.OverdueCbmPlans.Count == 0)
            {
                <pems-text class="text-muted small mb-0">@Localizer["هیچ طرح CBM معوقی وجود ندارد."]</pems-text>
            }
            else
            {
                <pems-data-table data="@(DataRows.Of(Model.OverdueCbmPlans, c_ => c_.Add(((Localizer["Tag"])?.ToString() ?? ""), o => (object?)(DataCell.Link(Url.Action("Details", "Equipment", new { id = o.EquipmentId }), o.EquipmentTagNumber))).Add(((Localizer["Variable"])?.ToString() ?? ""), o => (object?)(DataCell.Group(o.VariableType, " — ", o.Tag)), css: "small").Add(((Localizer["Next Due"])?.ToString() ?? ""), o => (object?)((PemsDates.Date(o.NextDueDate))), css: "small").Add(((Localizer["Overdue"])?.ToString() ?? ""), o => (object?)(DataCell.Badge("danger", DataCell.Group(o.DaysOverdue, " ", Localizer["روز"]))))))" dense="true" enterprise="false" />
                @if (Model.OverdueCbmPlansTruncated)
                {
                    <div class="small text-muted">@Localizer["فهرست به بالاترین ۵۰ مورد محدود شده است."]</div>
                }
            }
        </pems-content-card>
    </pems-col>
</pems-row>
