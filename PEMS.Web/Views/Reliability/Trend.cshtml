@model PEMS.Application.DTOs.ConditionMonitoringTrendDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var selectedRange = (string)ViewBag.SelectedRange;
    var equipmentId = (int?)ViewBag.EquipmentId;

    string EvalBadge(string status) => status switch
    {
        "Critical" => "bg-dark",
        "Alarm" => "bg-danger",
        "Warning" => "bg-warning text-dark",
        "Normal" => "bg-success",
        _ => "bg-secondary"
    };
}

<pems-flex justify="between" align="center" css="mb-3">
    <pems-heading level="5" class="mb-0"><pems-icon name="bi-graph-up" /> @Model.VariableType — @Model.Tag</pems-heading>
    <pems-flex gap="2">
        <pems-button as="a" tone="neutral" size="small" outline="true" asp-action="ExportTrend" asp-route-pointId="@Model.ConditionMonitoringPointId" asp-route-range="@selectedRange" asp-route-from="@(selectedRange == "custom" ? PemsDates.Date(Model.FromDate) : null)" asp-route-to="@(selectedRange == "custom" ? PemsDates.Date(Model.ToDate) : null)"><pems-icon name="bi-download" /> @Localizer["Export"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="ConditionMonitoring" asp-route-equipmentId="@equipmentId">← @Localizer["Condition Monitoring"]</pems-button>
    </pems-flex>
</pems-flex>

<pems-content-card css="mb-3">
    <pems-form method="get"><pems-flex wrap="true" gap="2" align="end">
        <input type="hidden" name="pointId" value="@Model.ConditionMonitoringPointId" />
        <div>
            <pems-label css="small mb-0">@Localizer["Range"]</pems-label>
            <pems-select scale="small" name="range" data-pems-change="submit-form">
                @foreach (var r in new[] { "7", "30", "90", "365" })
                {
                    <option value="@r" selected="@(r == selectedRange)">@Localizer["Last"] @r @Localizer["days"]</option>
                }
                <option value="custom" selected="@(selectedRange == "custom")">@Localizer["Custom"]</option>
            </pems-select>
        </div>
        @if (selectedRange == "custom")
        {
            <div><pems-label css="small mb-0">@Localizer["From"]</pems-label><pems-date name="from" value="@PemsDates.Date(Model.FromDate)" scale="small" /></div>
            <div><pems-label css="small mb-0">@Localizer["To"]</pems-label><pems-date name="to" value="@PemsDates.Date(Model.ToDate)" scale="small" /></div>
            <pems-button tone="primary" size="small" outline="true" type="submit">@Localizer["Apply"]</pems-button>
        }
    </pems-flex></pems-form>
    <div class="small text-muted mt-2">
        @PemsDates.Date(Model.FromDate) → @PemsDates.Date(Model.ToDate) · @Model.TotalInRange readings in range
        @if (Model.Truncated)
        {
            <pems-badge tone="warning">Truncated — showing first @Model.Points.Count of @Model.TotalInRange; narrow the range to see all</pems-badge>
        }
    </div>
</pems-content-card>

@if (Model.Points.Any())
{
    @* SCRUM-337 C2: the shared chart host (Bklit line), not Chart.js *@
    var trend = BkChartSpec.Line($"{Model.VariableType} — {Model.Tag}", Localizer["هیچ قرائتی در این بازه ثبت نشده."], Model.Points.Select(p => p.ReadingDate), 2,
        BkSeries.Of($"{Model.VariableType} ({Model.Unit})", Model.Points.Select(p => p.Value), BkChartSpec.Primary));
    <pems-content-card css="mb-3">
        <pems-chart spec="@trend" />
    </pems-content-card>
}

<pems-content-card>
    @{
        var rows_77 = Model.Points.AsEnumerable().Reverse();
        var cell_77_2 = DataCell.Template(rows_77, @<text>@{ var pt = item; }<pems-badge tone="none" css="@EvalBadge(pt.EvaluationStatus)">@pt.EvaluationStatus</pems-badge></text>);
    }
    <pems-data-table data="@(DataRows.Of(rows_77, c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), pt => (object?)((PemsDates.DateTime(pt.ReadingDate))), css: "small").Add(((Localizer["Value"])?.ToString() ?? ""), pt => (object?)(DataCell.Group(pt.Value, " ", Model.Unit)), css: "text-end", headerCss: "text-end").Add(((Localizer["Evaluation"])?.ToString() ?? ""), pt => (object?)cell_77_2(pt)), rowClass: pt => (pt.IsAlarm ? "table-danger" : "")))" dense="true" />
    @if (!Model.Points.Any()) { <pems-text class="text-muted text-center py-4">@Localizer["هیچ قرائتی در این بازه ثبت نشده."]</pems-text> }
</pems-content-card>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    @if (Model.Points.Any())
    {
        <partial name="_BkChartScripts" />
    }
}
