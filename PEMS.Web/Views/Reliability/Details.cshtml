@model PEMS.Application.DTOs.EquipmentReliabilityDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="between" align="center" css="mb-3">
    <pems-heading level="5" class="mb-0"><pems-icon name="bi-graph-up-arrow" /> Reliability — @Model.TagNumber</pems-heading>
    <div>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="EquipmentProfile" asp-route-id="@Model.EquipmentId"><pems-icon name="bi-person-badge" /> Intelligence Profile</pems-button>
        <pems-button tone="primary" size="small" outline="true" as="a" asp-action="Ram" asp-route-id="@Model.EquipmentId"><pems-icon name="bi-graph-up" /> @Localizer["RAM / Weibull"]</pems-button>
        <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="Index"><pems-icon name="bi-arrow-right" /> Back</pems-button>
    </div>
</pems-flex>

<pems-row gap="3" css="mb-3">
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["MTBF"]">@(Model.MTBFHours.HasValue ? $"{Model.MTBFHours.Value:N1} h" : "")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["MTTR"]">@(Model.MTTRHours.HasValue ? $"{Model.MTTRHours.Value:N1} h" : "")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["Availability"]">@(Model.AvailabilityPercent.HasValue ? $"{Model.AvailabilityPercent.Value:N1}%" : "")</pems-kpi-tile></pems-col>
    <pems-col md="3"><pems-kpi-tile compact label="@Localizer["Failure Count"]">@Model.FailureCount</pems-kpi-tile></pems-col>
</pems-row>

<pems-content-card>
    <pems-heading level="6" class="mb-2"><pems-icon name="bi-clock-history" /> Failure History</pems-heading>
    <pems-data-table data="@(DataRows.Of(Model.FailureHistory.OrderByDescending(x => x.FailureDate), c_ => c_.Add(((Localizer["Date"])?.ToString() ?? ""), f => (object?)((PemsDates.Date(f.FailureDate))), css: "small").Add(((Localizer["Mode"])?.ToString() ?? ""), f => (object?)(f.FailureMode), css: "small").Add(((Localizer["Cause"])?.ToString() ?? ""), f => (object?)(f.FailureCause), css: "small").Add(((Localizer["Effect"])?.ToString() ?? ""), f => (object?)(f.FailureEffect), css: "small").Add(((Localizer["Root Cause"])?.ToString() ?? ""), f => (object?)(f.RootCause), css: "small").Add(((Localizer["Corrective Action"])?.ToString() ?? ""), f => (object?)(f.CorrectiveAction), css: "small").Add(((Localizer["Downtime"])?.ToString() ?? ""), f => (object?)((f.DowntimeHours.HasValue ? $"{f.DowntimeHours.Value:N1} h" : "-")), css: "small").Add(((Localizer["Work Order"])?.ToString() ?? ""), f => (object?)((f.WorkOrderId.HasValue ? (object?)DataCell.Link(Url.Action("Details", "WorkOrder", new { id = f.WorkOrderId }), f.WorkOrderNumber) : null)), css: "small")))" css="mb-0" />
</pems-content-card>
