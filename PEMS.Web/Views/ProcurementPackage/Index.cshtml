@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ProcurementPackageDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer


<div class="content-card">
    <p class="text-muted">
        MR، MRQ، Vendor Inquiry، Technical Clarification و تاریخچه‌ی تایید همه زیر یک Procurement
        Package یکپارچه مدیریت می‌شوند - طبق جریان: MR &rarr; Vendor Inquiry &rarr; Technical
        Clarification &rarr; MRQ &rarr; Response &rarr; Approval &rarr; Closeout.
    </p>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex gap-2">
            <a asp-controller="MaterialRequisition" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-cart-check"></i> All MRs <span class="text-muted small">@Localizer["(legacy view)"]</span>
            </a>
            <a asp-controller="MaterialRequisition" asp-action="Quotations" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-file-earmark-spreadsheet"></i> All MRQs <span class="text-muted small">@Localizer["(legacy view)"]</span>
            </a>
        </div>
        <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#createPackageModal">
            <i class="bi bi-plus-lg"></i> New Package
        </button>
    </div>
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('ProcurementPackage')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="ProcurementPackage">
            <thead>
                <tr>
                    <th data-col-key="packageNo" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px">Package No</th>
                    <th data-col-key="title" data-resizable="true" data-min-width="140" data-max-width="320" style="width:200px">@Localizer["Title"]</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Project"]</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="90" data-max-width="200" style="width:120px">@Localizer["Discipline"]</th>
                    <th data-col-key="stage" data-resizable="true" data-min-width="80" data-max-width="160" style="width:110px">@Localizer["Stage"]</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="80" data-max-width="160" style="width:110px">@Localizer["Status"]</th>
                    <th data-col-key="mrs" data-resizable="true" data-min-width="60" data-max-width="100" style="width:70px">@Localizer["MRs"]</th>
                    <th data-col-key="mrqs" data-resizable="true" data-min-width="60" data-max-width="100" style="width:70px">@Localizer["MRQs"]</th>
                    <th data-col-key="openComms" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">Open Comms</th>
                    <th data-col-key="actions" data-resizable="false" style="width:60px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td>@p.PackageNumber</td>
                        <td>@p.Title</td>
                        <td>@p.ProjectName</td>
                        <td>@p.DisciplineName</td>
                        <td><span class="badge bg-info text-dark">@p.Stage</span></td>
                        <td><span class="badge @(p.Status == "Closed" ? "bg-success" : p.Status == "Open" ? "bg-secondary" : "bg-warning text-dark")">@p.Status</span></td>
                        <td><span class="badge bg-secondary">@p.MRCount</span></td>
                        <td><span class="badge bg-secondary">@p.MRQCount</span></td>
                        <td>
                            @if (p.OpenCommunicationsCount > 0)
                            { <span class="badge bg-danger">@p.OpenCommunicationsCount</span> }
                            else
                            { <span class="badge bg-success">0</span> }
                        </td>
                        <td><a asp-action="Details" asp-route-id="@p.ProcurementPackageId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4">No procurement packages yet.</p> }
    </div>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "ProcurementPackage",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = ""
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('ProcurementPackage');
        });
    </script>
}

<div class="modal fade" id="createPackageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="ProcurementPackage" asp-action="Create" method="post">
                <div class="modal-header"><h6 class="modal-title">New Procurement Package</h6></div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6"><label class="form-label">@Localizer["Package Number"]</label><input name="packageNumber" class="form-control" placeholder="e.g. PP-2026-001" required /></div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Project"]</label>
                            <select name="projectId" class="form-select" required>
                                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Localizer["Discipline"]</label>
                            <select name="disciplineId" class="form-select">
                                <option value="">@Localizer["-- None --"]</option>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-6"><label class="form-label">@Localizer["Title"]</label><input name="title" class="form-control" required /></div>
                        <div class="col-12"><label class="form-label">@Localizer["Description"]</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
