@model List<PEMS.Application.DTOs.VDRImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}


<pems-page-shell kind="workspace">

<div class="vs-stepper">
    <div class="vs-stepper__item vs-stepper__item--active"><span class="vs-stepper__num">1</span>@Localizer["Vs_StepUpload"]</div>
    <div class="vs-stepper__item "><span class="vs-stepper__num">2</span>@Localizer["Vs_StepReview"]</div>
    <div class="vs-stepper__item "><span class="vs-stepper__num">3</span>@Localizer["Vs_StepCommit"]</div>
</div>

<pems-content-card css="mb-3 pems-s-bcaa1805">
    <pems-text class="text-muted small">@Localizer["Vs_ImportSub"]</pems-text>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="5">
            <pems-label css="small">@Localizer["Vs_Project"]</pems-label>
            <pems-select name="projectId" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="5">
            <pems-label css="small">@Localizer["Vs_ExcelFile"]</pems-label>
            <pems-uploader name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Vs_Upload"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-3">@Localizer["Vs_RecentImports"]</pems-heading>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["Vs_File"])?.ToString() ?? ""), b => (object?)(b.FileName)).Add(((Localizer["Vs_Project"])?.ToString() ?? ""), b => (object?)(b.ProjectName)).Add(((Localizer["Vs_Date"])?.ToString() ?? ""), b => (object?)((PemsDates.DateTime(b.ImportDate)))).Add(((Localizer["Total"])?.ToString() ?? ""), b => (object?)(b.RowsTotal)).Add(((Localizer["Vs_Valid"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("success", b.RowsValid))).Add(((Localizer["Vs_Warning"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("warning", b.RowsWarning))).Add(((Localizer["Vs_Error"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("danger", b.RowsError))).Add(((Localizer["Vs_Duplicate"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("neutral", b.RowsDuplicate))).Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)(DataCell.Badge(b.Status == "Committed" ? "success" : "neutral", b.Status))).Add("", b => (object?)((b.Status == "Staged" ? (object?)DataCell.ButtonLink(Url.Action("Review", null, new { batchId = b.VDRImportBatchId }), "primary", "small", true, null, "Review") : null)))))" />
    </pems-table-scroll>
    @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">@Localizer["Vs_NoImports"]</pems-text> }
</pems-content-card>

</pems-page-shell>

@{ ViewData["Title"] = Localizer["Vs_ImportTitle"].Value; }
@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}
