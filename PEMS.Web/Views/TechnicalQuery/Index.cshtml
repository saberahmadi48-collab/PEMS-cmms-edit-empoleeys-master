@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.TechnicalQueryListItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<div class="d-flex justify-content-end align-items-center mb-2">
    <a asp-action="Raise" class="btn btn-pems-solid btn-sm"><i class="bi bi-plus-lg"></i> @Localizer["New"]</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold">@Model.TotalCount</div>
            <div class="text-muted small">@Localizer["کل"]</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-warning">@ViewBag.OpenCount</div>
            <div class="text-muted small">@Localizer["باز / در جریان"]</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="content-card text-center">
            <div class="fs-3 fw-bold text-danger">@ViewBag.OverdueCount</div>
            <div class="text-muted small"><i class="bi bi-clock-history"></i> @Localizer["از مهلت گذشته"]</div>
        </div>
    </div>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-2">
            <select name="queryType" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="TQ" selected="@("TQ" == (string?)ViewBag.SelectedQueryType)">TQ</option>
                <option value="TSR" selected="@("TSR" == (string?)ViewBag.SelectedQueryType)">TSR</option>
                <option value="RFI" selected="@("RFI" == (string?)ViewBag.SelectedQueryType)">RFI</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm">
                <option value="">@Localizer["All statuses"]</option>
                @foreach (var s in new[] { "Open", "PendingConfirmation", "Reopened", "Closed" })
                {
                    <option value="@s" selected="@(s == (string?)ViewBag.SelectedStatus)">@s</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in (IEnumerable<dynamic>)ViewBag.Projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> @Localizer["Filter"]</button>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('TechnicalQuery')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["ResetColumns"]
        </button>
    </div>
    <div class="pems-grid-scroll">
        <table class="table table-enterprise mb-0 pems-grid-table" data-grid-key="TechnicalQuery">
            <thead>
                <tr>
                    <th data-col-key="number" data-resizable="true" data-min-width="100" data-max-width="200" style="width:130px">@Localizer["Number"]</th>
                    <th data-col-key="type" data-resizable="true" data-min-width="70" data-max-width="140" style="width:90px">@Localizer["Type"]</th>
                    <th data-col-key="subject" data-resizable="true" data-min-width="180" data-max-width="500" style="width:320px">@Localizer["Subject"]</th>
                    <th data-col-key="discipline" data-resizable="true" data-min-width="100" data-max-width="220" style="width:150px">@Localizer["Discipline"]</th>
                    <th data-col-key="priority" data-resizable="true" data-min-width="80" data-max-width="150" style="width:100px">@Localizer["Priority"]</th>
                    <th data-col-key="due" data-resizable="true" data-min-width="110" data-max-width="220" style="width:150px">@Localizer["Due"]</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="100" data-max-width="200" style="width:140px">@Localizer["Status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@t.TechnicalQueryId">@t.QueryNumber</a></td>
                        <td><span class="badge bg-secondary">@t.QueryType</span></td>
                        <td class="small" title="@t.Subject">@t.Subject</td>
                        <td class="small" title="@t.DisciplineName">@t.DisciplineName</td>
                        <td>
                            <span class="badge @(t.Priority is "High" or "Urgent" ? "bg-danger" : "bg-light text-dark")">@t.Priority</span>
                        </td>
                        <td class="small">
                            @(t.RequiredResponseDate?.ToString("yyyy-MM-dd"))
                            @if (t.IsOverdue) { <span class="badge bg-danger ms-1">@Localizer["Overdue"]</span> }
                        </td>
                        <td><span class="badge @(t.Status == "Closed" ? "bg-success" : t.Status == "PendingConfirmation" ? "bg-info text-dark" : "bg-warning text-dark")">@t.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any()) { <p class="text-muted text-center py-4 mb-0">@Localizer["موردی یافت نشد."]</p> }
    </div>

    @{
        var tqQsParts = new List<string>();
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedQueryType)) tqQsParts.Add($"queryType={Uri.EscapeDataString((string)ViewBag.SelectedQueryType)}");
        if (!string.IsNullOrEmpty((string?)ViewBag.SelectedStatus)) tqQsParts.Add($"status={Uri.EscapeDataString((string)ViewBag.SelectedStatus)}");
        if (ViewBag.SelectedProjectId != null) tqQsParts.Add($"projectId={ViewBag.SelectedProjectId}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "TechnicalQuery",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = string.Join("&", tqQsParts)
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('TechnicalQuery');
        });
    </script>
}
