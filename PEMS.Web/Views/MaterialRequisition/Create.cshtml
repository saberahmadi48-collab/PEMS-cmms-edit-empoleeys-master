@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var engineers = (IEnumerable<dynamic>)ViewBag.Engineers;
}

<div class="content-card" style="max-width:800px;">
    <form asp-action="Create" method="post" id="mrForm">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@Localizer["MR Number"]</label>
                <input name="mrNumber" class="form-control" placeholder="e.g. MR-2026-001" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Project"]</label>
                <select name="projectId" class="form-select" required>
                    @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Discipline"]</label>
                <select name="disciplineId" class="form-select" required>
                    @foreach (var d in disciplines) { <option value="@d.DisciplineId">@d.Name</option> }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Equipment Tag (optional)</label>
                <input name="equipmentTagNumber" class="form-control" placeholder="e.g. P-101A" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Required Date"]</label>
                <input name="requiredDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Responsible Engineer</label>
                <select name="responsibleEngineerId" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var e in engineers) { <option value="@e.EmployeeId">@e.Name</option> }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">@Localizer["Description"]</label>
                <textarea name="description" class="form-control" rows="2" required></textarea>
            </div>
        </div>

        <hr class="my-3" />

        <label class="form-label d-block">@Localizer["Items"]</label>
        <div id="itemsContainer">
            <div class="row g-2 mb-2 item-row">
                <div class="col-md-4"><input name="itemDescriptions" class="form-control form-control-sm" placeholder="Item description" /></div>
                <div class="col-md-2"><input name="itemParts" class="form-control form-control-sm" placeholder="@Localizer["Part No"]" /></div>
                <div class="col-md-2"><input name="itemQty" type="number" step="0.01" class="form-control form-control-sm" value="1" /></div>
                <div class="col-md-2"><input name="itemUnits" class="form-control form-control-sm" placeholder="@Localizer["Unit"]" /></div>
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="addItemBtn"><i class="bi bi-plus"></i> Add Item</button>

        <div class="mt-4">
            <button type="submit" class="btn btn-pems-solid">Save MR</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('addItemBtn').addEventListener('click', function () {
            var container = document.getElementById('itemsContainer');
            var row = container.querySelector('.item-row').cloneNode(true);
            row.querySelectorAll('input').forEach(i => i.value = i.type === 'number' ? '1' : '');
            container.appendChild(row);
        });
    </script>
}
