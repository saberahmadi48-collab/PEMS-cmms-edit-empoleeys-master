    @if (!requiredSkills.Any()) { <p class="text-muted small">@Localizer["مهارت موردنیازی ثبت نشده."]</p> }

    @if (Ctl(WoSection.RequiredSkills))
    {
    <form asp-action="AddRequiredSkill" method="post" class="row g-2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        <div class="col-md-4">
            <select name="skillId" class="form-select form-select-sm" required>
                @foreach (var s in allSkillsForWO) { <option value="@s.SkillId">@s.Name</option> }
