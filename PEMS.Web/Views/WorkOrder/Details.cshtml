        <div class="col-md-6">
            <select name="materialItemId" id="requiredMaterialSelect" class="form-select form-select-sm" required>
                @foreach (var m in materialItems) { <option value="@m.MaterialItemId">@m.MaterialCode - @m.Description</option> }
