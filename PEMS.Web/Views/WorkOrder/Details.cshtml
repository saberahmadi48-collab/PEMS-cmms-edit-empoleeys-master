    {
        <p class="small text-muted mb-2">
            <i class="bi bi-hourglass-split"></i> Planned: <strong>@totalPlannedHours h</strong>
            &middot; Actual: <strong>@totalActualHours h</strong>
        </p>
    }
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var rs in requiredSkills)
        {
