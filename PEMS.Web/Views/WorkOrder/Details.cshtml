        <div class="col-md-3">
            <select name="minimumProficiencyLevel" class="form-select form-select-sm">
                <option value="">@Localizer["حداقل سطح (اختیاری)"]</option>
                <option value="Basic">@Localizer["Basic"]</option>
                <option value="Intermediate">@Localizer["Intermediate"]</option>
                <option value="Advanced">@Localizer["Advanced"]</option>
                <option value="Expert">@Localizer["Expert"]</option>
            </select>
        </div>
        <div class="col-md-2"><input name="plannedHours" type="number" step="0.5" class="form-control form-control-sm" placeholder="@Localizer["Planned h"]" /></div>
        <div class="col-md-3"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> @Localizer["Add"]</button></div>
    </form>
    }
    else
    {
        <p class="text-muted small mb-0"><i class="bi bi-lock"></i> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }
</div>

<div class="content-card mt-3">
    @{ var requiredMaterials = (List<PEMS.Domain.Entities.WorkOrderMaterial>)ViewBag.RequiredMaterials; }
    <h6 class="mb-3"><i class="bi bi-box-seam"></i> @Localizer["Required Materials"]</h6>
    <table class="table table-enterprise table-sm">
        <thead><tr><th>@Localizer["Material"]</th><th>@Localizer["Required Qty"]</th><th></th></tr></thead>
