@model PEMS.Domain.Entities.WorkOrder
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Models
@using PEMS.WorkflowPlatform.Interfaces
@using PEMS.Application.Common
@using PEMS.Application.Interfaces
@inject IStringLocalizer<SharedResource> Localizer
@{
    var sparesUsed = (List<PEMS.Domain.Entities.MaintenanceSpareUsage>)ViewBag.SparesUsed;
    var materialItems = (IEnumerable<dynamic>)ViewBag.MaterialItems;
    var requiredSkills = (List<PEMS.Domain.Entities.RequiredSkill>)(ViewBag.RequiredSkills ?? new List<PEMS.Domain.Entities.RequiredSkill>());
    var allSkillsForWO = (IEnumerable<dynamic>)(ViewBag.AllSkills ?? new List<object>());
    var tasks = (List<PEMS.Domain.Entities.WorkOrderTask>)(ViewBag.Tasks ?? new List<PEMS.Domain.Entities.WorkOrderTask>());
    var nextStatus = (string?)ViewBag.NextStatus;

    string statusClass = Model.Status switch
    {
        "Closed" or "Completed" => "bg-success",
        "InProgress" => "bg-warning text-dark",
        "Assigned" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    var hasPendingReview = (bool)(ViewBag.HasPendingReview ?? false);

    // Phase 3B: Work Order حاکمیتی → ساختار/اقدام‌ها/شرکت‌کنندگان/تاریخچه از مدل خواندنی مرکزی. Legacy (بدون Instance) → مسیر قدیمی.
    var wf = ViewBag.Workflow as WorkflowRuntimeViewModel;
    var isLegacy = wf == null;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
    var employeeNames = (Dictionary<int, string>?)ViewBag.EmployeeNames ?? new Dictionary<int, string>();
    string StageName(WorkflowStageView st) => fa && !string.IsNullOrWhiteSpace(st.NameFa) ? st.NameFa! : st.Name;
    string ActionLabel(WorkflowAvailableAction a) => (fa && !string.IsNullOrWhiteSpace(a.LabelFa)) ? a.LabelFa! : (!string.IsNullOrWhiteSpace(a.Label) ? a.Label! : a.ActionType);
    string StageByName(string? n) => string.IsNullOrEmpty(n) ? "-" : (fa ? (wf?.Stages.FirstOrDefault(x => x.Name == n)?.NameFa ?? n) : n);
    string Who(int? id) => id.HasValue && employeeNames.TryGetValue(id.Value, out var nm) ? nm : (id.HasValue ? "#" + id.Value : "-");
    string ActionText(string a) { var t = Localizer[a]; return t.ResourceNotFound ? a : t.Value; }
    string Participant(WorkflowParticipantView pt) => (pt.Role ?? "").Contains("Permission:")
        ? Localizer["Permission"] + ": \u2066" + (pt.Role ?? "").Replace("Permission:", "").Replace(",", " / ") + "\u2069" : (pt.Role ?? "");
    var diagram = new StageDiagramViewModel();
    if (wf != null)
        foreach (var st in wf.Stages.OrderBy(x => x.Order))
            diagram.Stages.Add(new StageDiagramItem
            {
                Label = StageName(st), IconCssClass = "bi-circle",
                RoleLabel = st.Status == "Current" ? string.Join(", ", st.Participants.Where(x => x.Status == "Pending").Select(Participant).Distinct()) : null,
                State = st.Status switch { "Current" => StageItemState.Current, "Completed" or "Skipped" => StageItemState.Done, "Rejected" or "Cancelled" => StageItemState.Rejected, _ => StageItemState.Pending }
            });
    var actions = wf?.AvailableActions ?? new List<WorkflowAvailableAction>();

    // H25/H26: ماتریس واحد «بخش × فاز × مجوز» (همان که POSTها اعمال می‌کنند). بدون آن (دروازه پیکربندی نشده) همه‌ی کنترل‌های جهشی Fail-Closed پنهان‌اند.
    var failureModeOptions = (List<PEMS.Application.DTOs.FailureOption>)(ViewBag.FailureModeOptions ?? new List<PEMS.Application.DTOs.FailureOption>());
    var failureCauseOptions = (List<PEMS.Application.DTOs.FailureOption>)(ViewBag.FailureCauseOptions ?? new List<PEMS.Application.DTOs.FailureOption>());
    // B12: دکمه‌های مسیر Legacy فقط برای دارندگان همان مجوزی نشان داده می‌شوند که کنترلر اعمال می‌کند (Edit برای پیشروی/توقف، Approve برای رد/لغو)
    var canEditWo = (bool)(ViewBag.CanEditWorkOrder ?? false);
    var canApproveWo = (bool)(ViewBag.CanApproveWorkOrder ?? false);
    var secPage = ViewBag.Sections as WoSectionPage;
    bool Ctl(WoSection s) => secPage != null && secPage.Controls(s);
    SectionAccess Acc(WoSection s) => secPage?.AccessOf(s) ?? SectionAccess.Hidden;
    bool hasMaterialItems = (bool)(ViewBag.HasMaterialItems ?? true);
    var laborEntries = (List<PEMS.Domain.Entities.WorkOrderLabor>)ViewBag.LaborEntries;
    var totalLaborCost = (decimal)ViewBag.TotalLaborCost;
    var spareCost = (decimal)ViewBag.SpareCost;
    var materialMasterUrl = Url.Action("Index", "MaterialItem", new { area = "Warehouse" });
}

@if (wf != null)
{
    <div class="content-card mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="mb-0">@Localizer["Workflow"] <span class="text-muted small">@wf.WorkflowName · @Localizer["Version"] @wf.VersionNumber · @Localizer[wf.Status]</span></h6>
            @foreach (var w in wf.Warnings) { <span class="small text-warning"><i class="bi bi-exclamation-triangle"></i> @w</span> }
        </div>
        <partial name="_PemsStageDiagram" model="diagram" />
    </div>
}
else
{
<div class="content-card mb-3">
    <partial name="_WorkOrderStagesDiagram" model="@(( Model.Status, hasPendingReview ))" />
</div>
}

@if (ViewBag.EquipmentIdentity is PEMS.Application.DTOs.EquipmentIdentityDto eqIdentity)
{
    <partial name="_EquipmentIdentity" model="eqIdentity" />
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h5 class="mb-1">@Model.WorkOrderNumber</h5>
            <span class="badge @statusClass">@Model.Status</span>
            <span class="badge @(Model.Priority == "Critical" ? "bg-danger" : "bg-secondary")">@Model.Priority</span>
            <span class="badge bg-secondary">@Model.WorkOrderType</span>
        </div>
        @if (isLegacy)
        {
        <div>
            @if (nextStatus != null && canEditWo)
            {
                @if (nextStatus == "Completed")
                {
                    <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#completeFailureModal">
                        Advance to Completed
                    </button>

                    <div class="modal fade" id="completeFailureModal" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form asp-action="AdvanceStatus" method="post">
                                <input type="hidden" name="id" value="@Model.WorkOrderId" />
                                <div class="modal-header"><h6 class="modal-title"><i class="bi bi-clipboard-data"></i> ثبت اطلاعات تکمیل</h6></div>
                                <div class="modal-body">
                                    @if (Model.WorkOrderType is "Corrective" or "Emergency")
                                    {
                                        <p class="text-muted small">برای کار اصلاحی/اضطراری، ثبت این اطلاعات برای تحلیل قابلیت‌اطمینان لازمه (ISO 14224).</p>
                                        <div class="mb-2">
                                            <label class="form-label small">حالت خرابی (Failure Mode)</label>
                                            <select name="failureModeCode" class="form-select form-select-sm">
                                                <option value="">@Localizer["-- انتخاب --"]</option>
                                                @foreach (var fm in failureModeOptions) { <option value="@fm.Code" selected="@string.Equals(fm.Code, Model.FailureModeCode, StringComparison.OrdinalIgnoreCase)">@fm.Code - @fm.Name</option> }
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">علت خرابی (Failure Cause)</label>
                                            <select name="failureCauseCode" class="form-select form-select-sm">
                                                <option value="">@Localizer["-- انتخاب --"]</option>
                                                @foreach (var fc in failureCauseOptions) { <option value="@fc.Code" selected="@string.Equals(fc.Code, Model.FailureCauseCode, StringComparison.OrdinalIgnoreCase)">@fc.Code - @fc.Name</option> }
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">اثر خرابی (Failure Effect)</label>
                                            <select name="failureEffect" class="form-select form-select-sm">
                                                <option value="">@Localizer["-- انتخاب --"]</option>
                                                <option>Unplanned Shutdown</option><option>Production Loss</option><option>Safety Impact</option>
                                                <option>Environmental Impact</option><option>Quality Impact</option><option>No Impact</option>
                                                <option>@Localizer["Other"]</option>
                                            </select>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">ریشه‌ی مشکل (Root Cause)</label>
                                            <textarea name="rootCause" class="form-control form-control-sm" rows="2"></textarea>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">اقدام اصلاحی (Corrective Action)</label>
                                            <textarea name="correctiveAction" class="form-control form-control-sm" rows="2"></textarea>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small">Downtime واقعی (ساعت)</label>
                                            <input name="downtimeHours" type="number" step="0.1" value="@Model.DowntimeHours" class="form-control form-control-sm" />
                                        </div>
                                        <hr />
                                    }
                                    <div class="mb-2">
                                        <label class="form-label small">هزینه پیمانکار (Contractor Cost)</label>
                                        <input name="contractorCost" type="number" step="0.01" class="form-control form-control-sm" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">نام پیمانکار (Contractor Name)</label>
                                        <input name="contractorName" class="form-control form-control-sm" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">دلیل / یادداشت این تغییر وضعیت (اختیاری)</label>
                                        <input name="reason" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                                    <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ثبت و تکمیل"]</button>
                                </div>
                            </form>
                        </div></div>
                    </div>
                }
                else
                {
                    <form asp-action="AdvanceStatus" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.WorkOrderId" />
                        @if (nextStatus == "Assigned")
                        {
                            <select name="assignedTeamId" class="form-select form-select-sm d-inline-block" style="width:200px;" required>
                                <option value="">گروه کاری...</option>
                                @foreach (var c in (IEnumerable<dynamic>)ViewBag.Teams) { <option value="@c.TeamId">@c.Name</option> }
                            </select>
                        }
                        <input name="reason" class="form-control form-control-sm d-inline-block" style="width:180px;" placeholder="@Localizer["دلیل (اختیاری)"]" />
                        <button type="submit" class="btn btn-pems-solid btn-sm">Advance to @nextStatus</button>
                    </form>
                }
            }
            else if (Model.Status != "OnHold")
            {
                <span class="badge bg-success"><i class="bi bi-check2-circle"></i> Final Status</span>
            }

            @* طبق CMMS Production Baseline v1 بند ۹.۲: مسیرهای انشعابی OnHold/Cancelled/Rejected -
               مستقل از nextStatus خطی، چون این وضعیت‌ها در StatusFlow اصلی نیستند. *@
            @if (canEditWo && Model.Status is "Assigned" or "InProgress")
            {
                <form asp-action="Hold" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <input name="reason" required class="form-control form-control-sm d-inline-block" style="width:160px;" placeholder="@Localizer["Reason (required)"]" />
                    <button type="submit" data-legacy="hold" class="btn btn-outline-warning btn-sm"><i class="bi bi-pause-circle"></i> @Localizer["Hold"]</button>
                </form>
            }
            @if (canEditWo && Model.Status == "OnHold")
            {
                <form asp-action="Resume" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <button type="submit" class="btn btn-pems-solid btn-sm"><i class="bi bi-play-circle"></i> Resume</button>
                </form>
            }
            @if (canApproveWo && Model.Status == "Open")
            {
                <form asp-action="Reject" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <input name="reason" required class="form-control form-control-sm d-inline-block" style="width:160px;" placeholder="@Localizer["Reason (required)"]" />
                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('این WorkOrder رد شود؟');">@Localizer["Reject"]</button>
                </form>
            }
            @if (canApproveWo && Model.Status is "Open" or "Assigned" or "InProgress" or "OnHold")
            {
                <form asp-action="Cancel" method="post" class="d-inline ms-1">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <input name="reason" required class="form-control form-control-sm d-inline-block" style="width:160px;" placeholder="@Localizer["Reason (required)"]" />
                    <button type="submit" data-legacy="cancel" class="btn btn-outline-secondary btn-sm" onclick="return confirm('این WorkOrder لغو شود؟');">@Localizer["Cancel"]</button>
                </form>
            }
        </div>
        }
    </div>

    @if (!isLegacy)
    {
        <div class="small mt-2 d-flex flex-wrap gap-3">
            <span><strong>@Localizer["Originating Discipline"]:</strong> <bdi>@(Model.OriginatingOrganization) / @(ViewBag.OriginatingDisciplineName ?? "-")</bdi></span>
            <span><strong>@Localizer["Responsible Maintenance Discipline"]:</strong> <bdi>@(ViewBag.ResponsibleDisciplineName != null ? Model.ResponsibleOrganization + " / " + ViewBag.ResponsibleDisciplineName : "-")</bdi></span>
        </div>
    }

    @if (Model.SourceWorkRequestId.HasValue)
    {
        <div class="small text-muted mt-1">
            <i class="bi bi-clipboard-plus"></i> Source: <a asp-controller="WorkRequest" asp-action="Details" asp-route-id="@Model.SourceWorkRequestId">Work Request</a>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.FailureModeCode) || !string.IsNullOrWhiteSpace(Model.RootCause))
    {
        <div class="alert alert-secondary small mt-2 mb-0">
            <strong><i class="bi bi-clipboard-data"></i> Failure Analysis:</strong>
            @Model.FailureModeCode / @Model.FailureCauseCode
            @if (Model.DowntimeHours.HasValue) { <span> — Downtime: @Model.DowntimeHours ساعت</span> }
            @if (!string.IsNullOrWhiteSpace(Model.RootCause)) { <div>Root Cause: @Model.RootCause</div> }
        </div>
    }

    <div class="row g-3 mt-2">
        <div class="col-md-3"><strong>@Localizer["Equipment:"]</strong> <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">@Model.Equipment?.TagNumber</a></div>
        <div class="col-md-3">
            <strong>Assigned:</strong>
            @if (Model.AssignedTeam != null)
            {
                <span>@Model.AssignedTeam.Name</span>
            }
            @if (Model.AssignedEmployee != null)
            {
                <span class="text-muted">(@Model.AssignedEmployee.FirstName @Model.AssignedEmployee.LastName)</span>
            }
            @if (Model.AssignedTeam == null && Model.AssignedEmployee == null && !string.IsNullOrEmpty(Model.AssignedTo))
            {
                <span class="text-muted">@Model.AssignedTo</span>
            }
        </div>
        <div class="col-md-3">
            <strong>@Localizer["Planned"]:</strong>
            @if (Model.PlannedStart.HasValue && Model.PlannedFinish.HasValue)
            {
                <span dir="ltr">@Model.PlannedStart.Value.ToString("yyyy-MM-dd HH:mm") &rarr; @Model.PlannedFinish.Value.ToString("HH:mm")</span>
            }
            else
            {
                <span class="text-muted">@Localizer["Unscheduled"]</span>
            }
        </div>
        <div class="col-md-3"><strong>Started:</strong> @(Model.StartDate?.ToString("yyyy-MM-dd"))</div>
        <div class="col-md-3"><strong>Completed:</strong> @(Model.CompletionDate?.ToString("yyyy-MM-dd"))</div>
        @if (Model.MaintenancePlan != null)
        {
            <div class="col-12"><strong>From Plan:</strong> @Model.MaintenancePlan.PlanNumber - @Model.MaintenancePlan.Title</div>
        }
        <div class="col-12"><strong>@Localizer["Description:"]</strong><p class="mb-0">@Model.Description</p></div>
    </div>
</div>

@if (!isLegacy)
{
    <div class="content-card mb-3">
        <h6 class="mb-3">@Localizer["Actions"]</h6>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            @if (actions.Count > 0)
            {
                <form asp-action="WorkflowAction" method="post" class="d-flex flex-column gap-2 w-100">
                    <input type="hidden" name="id" value="@Model.WorkOrderId" />
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="text" name="comment" class="form-control form-control-sm" placeholder="@Localizer["Comment (required for Reject / Cancel / Hold / Return)"]" style="width:300px;" />
                        @foreach (var a in actions)
                        {
                            var cls = a.ActionType == "Approve" ? "btn-pems-solid" : a.ActionType is "Reject" or "Cancel" ? "btn-outline-danger" : "btn-outline-primary";
                            var needsReason = WorkflowActionRules.ActionRequiresReason(a.ActionType);
                            <button type="submit" name="actionType" value="@a.ActionType" class="btn btn-sm @cls" disabled="@(!a.IsAllowed)" title="@(a.IsAllowed ? "" : a.DeniedReason)"
                                    onclick="@(needsReason ? "var c=this.form.comment;if(!c.value.trim()){c.classList.add('is-invalid');c.focus();return false;}" + (a.ActionType is "Reject" or "Cancel" ? "return confirm('" + Localizer["Are you sure?"] + "');" : "") : "")">
                                @ActionLabel(a)@if (!string.IsNullOrWhiteSpace(a.ToStageName)) { <span class="opacity-75"> → @StageByName(a.ToStageName)</span> }
                            </button>
                        }
                    </div>
                    @if (Model.Status == "InProgress")
                    {
                        @* داده‌های تکمیل (قواعد دامنه‌ی Work Order؛ اعتبارسنجی نهایی سمت سرور) *@
                        <details class="small">
                            <summary>@Localizer["Completion data"]</summary>
                            <div class="row g-2 mt-1">
                                @if (Model.WorkOrderType is "Corrective" or "Emergency")
                                {
                                    <div class="col-md-3"><label class="form-label small">@Localizer["Failure Mode"]</label>
                                        @if (failureModeOptions.Count > 0)
                                        {
                                            <select name="failureModeCode" class="form-select form-select-sm">
                                                <option value="">--</option>
                                                @foreach (var fm in failureModeOptions) { <option value="@fm.Code" selected="@string.Equals(fm.Code, Model.FailureModeCode, StringComparison.OrdinalIgnoreCase)">@fm.Code - @fm.Name</option> }
                                            </select>
                                        }
                                        else { <input name="failureModeCode" value="@Model.FailureModeCode" class="form-control form-control-sm" /> }
                                    </div>
                                    <div class="col-md-3"><label class="form-label small">@Localizer["Failure Cause"]</label>
                                        @if (failureCauseOptions.Count > 0)
                                        {
                                            <select name="failureCauseCode" class="form-select form-select-sm">
                                                <option value="">--</option>
                                                @foreach (var fc in failureCauseOptions) { <option value="@fc.Code" selected="@string.Equals(fc.Code, Model.FailureCauseCode, StringComparison.OrdinalIgnoreCase)">@fc.Code - @fc.Name</option> }
                                            </select>
                                        }
                                        else { <input name="failureCauseCode" value="@Model.FailureCauseCode" class="form-control form-control-sm" /> }
                                    </div>
                                    <div class="col-md-3"><label class="form-label small">@Localizer["Root Cause"]</label><input name="rootCause" class="form-control form-control-sm" /></div>
                                    <div class="col-md-3"><label class="form-label small">@Localizer["Downtime Hours"]</label><input name="downtimeHours" type="number" step="0.1" class="form-control form-control-sm" /></div>
                                    <div class="col-md-6"><label class="form-label small">@Localizer["Failure Effect"]</label><input name="failureEffect" value="@Model.FailureEffect" class="form-control form-control-sm" /></div>
                                    <div class="col-md-6"><label class="form-label small">@Localizer["Corrective Action"]</label><input name="correctiveAction" class="form-control form-control-sm" /></div>
                                }
                                <div class="col-md-6"><label class="form-label small">@Localizer["Contractor"]</label><input name="contractorName" class="form-control form-control-sm" /></div>
                                <div class="col-md-6"><label class="form-label small">@Localizer["Contractor Cost"]</label><input name="contractorCost" type="number" step="0.01" class="form-control form-control-sm" /></div>
                            </div>
                        </details>
                    }
                </form>
                @foreach (var denied in actions.Where(a => !a.IsAllowed && !string.IsNullOrWhiteSpace(a.DeniedReason)))
                {
                    <div class="small text-muted w-100"><i class="bi bi-lock"></i> @ActionLabel(denied): @denied.DeniedReason</div>
                }
            }
            else
            {
                <span class="text-muted small">@Localizer["No further actions available."]</span>
            }
        </div>

        @if (Ctl(WoSection.ResponsibleDiscipline) || Ctl(WoSection.ExecutorAssignment) || Ctl(WoSection.Schedule))
        {
            @* برنامه‌ریزی/تخصیص: داده‌های دامنه‌ی Work Order؛ فقط وقتی ماتریس بخش + مجوز اجازه می‌دهد رندر می‌شود (سمت سرور هم همین اعمال می‌شود) *@
            <hr class="my-3" />
            <div class="row g-2">
                @if (Ctl(WoSection.ResponsibleDiscipline))
                {
                <div class="col-md-6">
                    <form asp-action="SetPlanning" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                        <input type="hidden" name="id" value="@Model.WorkOrderId" />
                        <div><label class="form-label small mb-1">@Localizer["Responsible Maintenance Discipline"]</label>
                            <select name="responsibleDisciplineId" class="form-select form-select-sm" required>
                                <option value="">--</option>
                                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines) { <option value="@d.DisciplineId" selected="@(Model.ResponsibleDisciplineId == (int)d.DisciplineId)">@d.Name</option> }
                            </select></div>
                        <button type="submit" class="btn btn-outline-primary btn-sm">@Localizer["Save"]</button>
                    </form>
                </div>
                }
                @if (Ctl(WoSection.ExecutorAssignment))
                {
                    @if (!((IEnumerable<dynamic>)ViewBag.Teams).Any())
                    {
                        <div class="col-12">
                            <div class="alert alert-info small py-2 mb-0">
                                <i class="bi bi-info-circle"></i> @Localizer["No teams exist for the responsible discipline yet; assign an individual executor or create a team first."]
                                <a asp-controller="Team" asp-action="Index" class="alert-link">@Localizer["Go to Teams"]</a>
                            </div>
                        </div>
                    }
                    <div class="col-md-6">
                        <form asp-action="AssignExecutor" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                            <input type="hidden" name="id" value="@Model.WorkOrderId" />
                            <div><label class="form-label small mb-1">@Localizer["Team"]</label>
                                <select name="teamId" class="form-select form-select-sm"><option value="">--</option>
                                    @foreach (var c in (IEnumerable<dynamic>)ViewBag.Teams) { <option value="@c.TeamId">@c.Name</option> }
                                </select></div>
                            <div><label class="form-label small mb-1">@Localizer["Executor"]</label>
                                <select name="employeeId" class="form-select form-select-sm"><option value="">--</option>
                                    @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
                                </select></div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">@Localizer["Assign"]</button>
                        </form>
                    </div>
                }
                @if (Ctl(WoSection.Schedule))
                {
                    <div class="col-md-6">
                        @* طبق «PEMS — Work Request/Work Order Scheduling & Maintenance Calendar»: زمان‌بندی مستقل از
                           تخصیص تیم/کارمند است (ترتیب الزامی نیست) - همان مرحله/مجوز، فرم جدا. *@
                        <form asp-action="SetSchedule" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                            <input type="hidden" name="id" value="@Model.WorkOrderId" />
                            <div><label class="form-label small mb-1">@Localizer["Planned Start"]</label>
                                <input type="datetime-local" name="plannedStart" class="form-control form-control-sm"
                                       value="@(Model.PlannedStart?.ToString("yyyy-MM-ddTHH:mm"))" required /></div>
                            <div><label class="form-label small mb-1">@Localizer["Planned Finish"]</label>
                                <input type="datetime-local" name="plannedFinish" class="form-control form-control-sm"
                                       value="@(Model.PlannedFinish?.ToString("yyyy-MM-ddTHH:mm"))" required /></div>
                            <button type="submit" class="btn btn-outline-primary btn-sm">@Localizer["Save Schedule"]</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    <div class="content-card mb-3">
        <h6 class="mb-3">@Localizer["Workflow History"]</h6>
        <div class="table-responsive">
        <table class="table table-enterprise table-sm mb-0">
            <thead><tr><th>@Localizer["Date"]</th><th>@Localizer["Action"]</th><th>@Localizer["From"]</th><th>@Localizer["To"]</th><th>@Localizer["By"]</th><th>@Localizer["Reason"]</th></tr></thead>
            <tbody>
                @foreach (var h in wf!.HistorySummary.OrderByDescending(x => x.ActionDate))
                {
                    <tr>
                        <td class="small"><bdi dir="ltr">@h.ActionDate.ToString("yyyy-MM-dd HH:mm")</bdi></td>
                        <td class="small">@ActionText(h.ActionType)</td>
                        <td class="small">@StageByName(h.FromStageName)</td>
                        <td class="small">@StageByName(h.ToStageName)</td>
                        <td class="small">@Who(h.UserId)</td>
                        <td class="small text-muted">@h.Comment</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@{
    var reviewStatus = (IEnumerable<PEMS.Application.Interfaces.VdrReviewStatusItemDto>)(ViewBag.ReviewStatus ?? new List<PEMS.Application.Interfaces.VdrReviewStatusItemDto>());
    var findings = (List<PEMS.Domain.Entities.WorkOrderDisciplineFinding>)(ViewBag.Findings ?? new List<PEMS.Domain.Entities.WorkOrderDisciplineFinding>());
    var myDisciplineId = ViewBag.MyDisciplineId as int?;
    var statusHistory = (List<PEMS.Domain.Entities.WorkOrderStatusHistory>)(ViewBag.StatusHistory ?? new List<PEMS.Domain.Entities.WorkOrderStatusHistory>());
}

@if (statusHistory.Any())
{
    <div class="content-card mb-3">
        <h6 class="mb-3"><i class="bi bi-clock-history"></i> @(isLegacy ? Localizer["Status History"] : Localizer["Business Audit"])</h6>
        <ul class="list-unstyled mb-0">
            @foreach (var h in statusHistory)
            {
                <li class="d-flex justify-content-between border-bottom py-2 small">
                    <span><span class="badge bg-secondary">@h.FromStatus</span> → <span class="badge bg-secondary">@h.ToStatus</span>
                        @if (!string.IsNullOrWhiteSpace(h.Reason)) { <span class="text-muted"> — @h.Reason</span> }
                    </span>
                    <span class="text-muted">
                        @(h.ChangedBy != null ? $"{h.ChangedBy.FirstName} {h.ChangedBy.LastName}" : "-")
                        · @h.ChangedDate.ToString("yyyy-MM-dd HH:mm")
                    </span>
                </li>
            }
        </ul>
    </div>
}

<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-people"></i> @Localizer["بازبینی چند-دیسیپلینه"]</h6>
    <p class="text-muted small">
        طبق رویه‌ی استاندارد هماهنگی چند-تخصصی (Multi-Craft Coordination، EN 13460): اگه این
        کار نیاز به تایید/یافته‌ی چند دیسیپلین تعمیراتی داره (مثلاً برق + مکانیک + ابزاردقیق)،
        این‌جا ارجاع بده. تا همه پاسخ ندن، WorkOrder نمی‌تونه Completed بشه.
    </p>

    @if (!hasPendingReview && !Ctl(WoSection.DisciplineReview))
    {
        <p class="text-muted small mb-2"><i class="bi bi-lock"></i> @Localizer["Requesting a multi-discipline review is not available at this stage or with your permissions."]</p>
    }
    else if (!hasPendingReview)
    {
        <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#requestReviewModal">
            <i class="bi bi-send"></i> @Localizer["درخواست بازبینی چند-دیسیپلینه"]
        </button>

        <div class="modal fade" id="requestReviewModal" tabindex="-1">
            <div class="modal-dialog"><div class="modal-content">
                <form asp-action="RequestDisciplineReview" method="post">
                    <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                    <div class="modal-header"><h6 class="modal-title">@Localizer["انتخاب دیسیپلین‌ها"]</h6></div>
                    <div class="modal-body">
                        @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="disciplineIds" value="@d.DisciplineId" id="woDisc_@d.DisciplineId">
                                <label class="form-check-label small" for="woDisc_@d.DisciplineId">@d.Name</label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                        <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["شروع بازبینی"]</button>
                    </div>
                </form>
            </div></div>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var r in reviewStatus)
            {
                var badgeClass = r.Status switch { "Approve" => "bg-success", "Comment" => "bg-warning text-dark", "Reject" => "bg-danger", _ => "bg-secondary" };
                <span class="badge @badgeClass">@r.DisciplineName: @r.Status</span>
            }
        </div>

        var myPending = reviewStatus.FirstOrDefault(x => x.DisciplineId == myDisciplineId && x.Status == "Pending");
        @if (myPending != null)
        {
            <button type="button" class="btn btn-pems-solid btn-sm" data-bs-toggle="modal" data-bs-target="#respondReviewModal">
                <i class="bi bi-reply"></i> ثبت نظر دیسیپلین من
            </button>

            <div class="modal fade" id="respondReviewModal" tabindex="-1">
                <div class="modal-dialog"><div class="modal-content">
                    <form asp-action="RespondDisciplineReview" method="post">
                        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                        <div class="modal-header"><h6 class="modal-title">@Localizer["ثبت نظر / یافته"]</h6></div>
                        <div class="modal-body">
                            <div class="mb-2">
                                <label class="form-label small">@Localizer["تصمیم"]</label>
                                <select name="decision" class="form-select form-select-sm" required>
                                    <option value="Approve">@Localizer["تایید (بدون ایراد)"]</option>
                                    <option value="Comment">@Localizer["تایید با یادداشت"]</option>
                                    <option value="Reject">@Localizer["ایراد جدی دارد"]</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">@Localizer["یافته / توضیح"]</label>
                                <textarea name="findings" class="form-control form-control-sm" rows="3"></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">حالت خرابی (از دید این دیسیپلین - اختیاری)</label>
                                <select name="failureModeCode" class="form-select form-select-sm">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    <option>@Localizer["Leakage"]</option><option>@Localizer["Fracture"]</option><option>@Localizer["Vibration"]</option>
                                    <option>@Localizer["Overheating"]</option><option>@Localizer["Blockage"]</option><option>@Localizer["ElectricalFault"]</option>
                                    <option>@Localizer["Other"]</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">علت خرابی (از دید این دیسیپلین - اختیاری)</label>
                                <select name="failureCauseCode" class="form-select form-select-sm">
                                    <option value="">@Localizer["-- انتخاب --"]</option>
                                    <option>@Localizer["Corrosion"]</option><option>@Localizer["Fatigue"]</option><option>@Localizer["Wear"]</option>
                                    <option>@Localizer["OperatorError"]</option><option>@Localizer["DesignDeficiency"]</option><option>@Localizer["MaterialDefect"]</option>
                                    <option>@Localizer["Other"]</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                            <button type="submit" class="btn btn-pems-solid btn-sm">@Localizer["ثبت"]</button>
                        </div>
                    </form>
                </div></div>
            </div>
        }
        else
        {
            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> در انتظار پاسخ سایر دیسیپلین‌ها</span>
        }
    }

    @if (findings.Any())
    {
        <hr class="my-3" />
        <h6 class="small fw-bold mb-2">@Localizer["یافته‌های ثبت‌شده"]</h6>
        <ul class="list-unstyled mb-0">
            @foreach (var f in findings)
            {
                <li class="border-bottom py-2">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold small">@f.Discipline?.Name</span>
                        <span class="badge @(f.Decision == "Approve" ? "bg-success" : f.Decision == "Comment" ? "bg-warning text-dark" : "bg-danger")">@f.Decision</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(f.Findings)) { <p class="small mb-0">@f.Findings</p> }
                    @if (!string.IsNullOrWhiteSpace(f.FailureModeCode)) { <p class="small text-muted mb-0">@f.FailureModeCode / @f.FailureCauseCode</p> }
                    <span class="text-muted small">@f.RespondedDate.ToString("yyyy-MM-dd HH:mm")</span>
                </li>
            }
        </ul>
    }
</div>

@if (secPage != null && (secPage.Phase is WoPhase.Closed or WoPhase.Cancelled or WoPhase.Rejected))
{
    <div class="alert alert-secondary d-flex align-items-center gap-2 small" role="status">
        <i class="bi bi-lock-fill"></i>
        <span>@Localizer["This Work Order is {0} and immutable; every section is read-only.", fa ? WorkOrderSectionPolicy.PhaseNameFa(secPage.Phase) : WorkOrderSectionPolicy.PhaseNameEn(secPage.Phase)]</span>
    </div>
}

@if (secPage != null && secPage.CanReopen)
{
    <div class="content-card mb-3 border-warning">
        <h6 class="mb-2"><i class="bi bi-unlock"></i> @Localizer["Reopen Work Order"]</h6>
        <p class="text-muted small mb-2">@Localizer["A formal reopen requires a reason and is audited; the Work Order returns to the verification stage."]</p>
        <form asp-action="ReopenWorkOrder" method="post" class="row g-2">
            <input type="hidden" name="id" value="@Model.WorkOrderId" />
            <div class="col-md-9"><input name="reason" class="form-control form-control-sm" maxlength="500" required placeholder="@Localizer["Reason for reopening (required)"]" /></div>
            <div class="col-md-3"><button type="submit" class="btn btn-sm btn-outline-warning w-100"><i class="bi bi-unlock"></i> @Localizer["Reopen"]</button></div>
        </form>
    </div>
}

@if (Acc(WoSection.Labor) == SectionAccess.Hidden)
{
    <div class="content-card mb-3 text-muted small"><i class="bi bi-lock"></i> @Localizer["Actual labor hours are not available until execution starts."]</div>
}
else
{
<div class="content-card mb-3">
    <h6 class="mb-3"><i class="bi bi-person-workspace"></i> @Localizer["Labor (ساعت‌کار واقعی)"]</h6>
    @if (TempData.Peek("LaborRateEmployeeId") is int rateEmployeeId)
    {
        <div class="alert alert-warning small py-2">
            <i class="bi bi-cash-coin"></i> @Localizer["This employee has no hourly rate defined."]
            <a asp-controller="Employee" asp-action="Details" asp-route-id="@rateEmployeeId" class="alert-link">@Localizer["Go to rate setup"]</a>
        </div>
    }
    <p class="text-muted small">
        <strong>Assigned Employee</strong> فقط نشون می‌ده مسئول اجرای این WorkOrder کیه؛ اینجا
        ثبت واقعی می‌شه که کدوم کارمندها، چند ساعت، با چه نرخی واقعاً کار کردن. نرخ موقع ثبت
        Snapshot می‌شه - تغییر نرخ آینده هزینه‌ی این رکورد رو تغییر نمی‌ده.
    </p>

    <div class="table-responsive" style="max-height:50vh; overflow-y:auto;">
        <table class="table table-enterprise">
            <thead><tr><th>@Localizer["Employee"]</th><th>Team</th><th>@Localizer["Date"]</th><th>@Localizer["Regular Hrs"]</th><th>OT Hrs</th><th>Rate</th><th>@Localizer["OT Rate"]</th><th>@Localizer["Cost"]</th></tr></thead>
            <tbody>
                @foreach (var l in laborEntries)
                {
                    <tr>
                        <td>@l.Employee?.FirstName @l.Employee?.LastName</td>
                        <td class="small">@l.Team?.Name</td>
                        <td class="small">@l.WorkDate.ToString("yyyy-MM-dd")</td>
                        <td>@l.RegularHours</td>
                        <td>@l.OvertimeHours</td>
                        <td class="small">@l.Rate.ToString("N0")</td>
                        <td class="small">@l.OvertimeRate.ToString("N0")</td>
                        <td class="fw-bold">@l.LaborCost.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!laborEntries.Any()) { <p class="text-muted small">@Localizer["ساعت‌کاری هنوز ثبت نشده."]</p> }

    @if (Ctl(WoSection.Labor))
    {
    <form asp-action="AddLaborEntry" method="post" class="row g-2 mt-2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        @if (Acc(WoSection.Labor) == SectionAccess.Correctable)
        {
            <div class="col-12"><input name="correctionReason" class="form-control form-control-sm" maxlength="500" required placeholder="@Localizer["Correction reason (required after execution)"]" /></div>
        }
        <div class="col-md-3">
            <select name="employeeId" class="form-select form-select-sm" required>
                @foreach (var e in (IEnumerable<dynamic>)ViewBag.Employees) { <option value="@e.EmployeeId">@e.FullName</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="teamId" class="form-select form-select-sm">
                <option value="">@Localizer["Team (optional)"]</option>
                @foreach (var t in (IEnumerable<dynamic>)ViewBag.Teams) { <option value="@t.TeamId">@t.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="workDate" type="date" class="form-control form-control-sm" required /></div>
        <div class="col-md-1"><input name="regularHours" type="number" step="0.5" min="0" class="form-control form-control-sm" placeholder="Reg" /></div>
        <div class="col-md-1"><input name="overtimeHours" type="number" step="0.5" min="0" class="form-control form-control-sm" placeholder="OT" /></div>
        <div class="col-md-2"><input name="notes" class="form-control form-control-sm" placeholder="@Localizer["Notes (optional)"]" /></div>
        <div class="col-md-1"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i></button></div>
    </form>
    }
    else
    {
        <p class="text-muted small mb-0"><i class="bi bi-lock"></i> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }

    <hr class="my-3" />
    <div class="row g-2 text-center">
        <div class="col-4"><div class="fw-bold">@totalLaborCost.ToString("N0")</div><div class="text-muted small">@Localizer["Labor Cost"]</div></div>
        <div class="col-4"><div class="fw-bold">@spareCost.ToString("N0")</div><div class="text-muted small">@Localizer["Spare Cost"]</div></div>
        <div class="col-4"><div class="fw-bold text-success">@((totalLaborCost + spareCost).ToString("N0"))</div><div class="text-muted small">@Localizer["Total Maintenance Cost"]</div></div>
    </div>
</div>
}

@if (Acc(WoSection.SpareParts) == SectionAccess.Hidden)
{
    <div class="content-card text-muted small"><i class="bi bi-lock"></i> @Localizer["Spare parts usage is not available until execution starts."]</div>
}
else
{
<div class="content-card">
    <h6 class="mb-3">@Localizer["Spare Parts Used"]</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>@Localizer["Material Code"]</th><th>@Localizer["Description"]</th><th>@Localizer["Qty"]</th><th>Returned</th><th>@Localizer["Unit Cost"]</th><th>@Localizer["Total"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in sparesUsed)
            {
                var outstanding = s.Quantity - (s.ReturnedQuantity ?? 0);
                <tr>
                    <td>@s.MaterialItem?.MaterialCode</td>
                    <td>@s.MaterialItem?.Description</td>
                    <td>@s.Quantity</td>
                    <td>@(s.ReturnedQuantity ?? 0)</td>
                    <td>@s.UnitCost</td>
                    <td>@s.TotalCost</td>
                    <td>
                        @if (outstanding > 0 && Ctl(WoSection.SpareParts))
                        {
                            <form asp-action="ReturnSpareUsage" method="post" class="d-flex gap-1">
                                <input type="hidden" name="maintenanceSpareUsageId" value="@s.MaintenanceSpareUsageId" />
                                <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                                @if (Acc(WoSection.SpareParts) == SectionAccess.Correctable)
                                {
                                    <input name="reason" class="form-control form-control-sm" style="width:140px;" maxlength="500" required placeholder="@Localizer["Correction reason"]" />
                                }
                                <input type="number" name="returnQuantity" step="0.01" max="@outstanding" class="form-control form-control-sm" style="width:80px;" placeholder="@Localizer["Qty"]" required />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Return"><i class="bi bi-arrow-return-left"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    @if (!sparesUsed.Any()) { <p class="text-muted small">@Localizer["No spare parts recorded yet."]</p> }

    @if (!Ctl(WoSection.SpareParts))
    {
        <p class="text-muted small mb-0"><i class="bi bi-lock"></i> @Localizer["This section is read-only at the current stage or with your permissions."]</p>
    }
    else if (!hasMaterialItems)
    {
        <div class="alert alert-info small mb-0">
            @Localizer["No materials exist in the Material Master yet; define materials first."]
            @if (!string.IsNullOrEmpty(materialMasterUrl)) { <a href="@materialMasterUrl" class="alert-link">@Localizer["Go to Material Master"]</a> }
        </div>
    }
    else
    {
    <div class="input-group input-group-sm mb-2" style="max-width:420px;">
        <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
        <input type="text" id="spareUsageScanInput" class="form-control" dir="ltr" placeholder="@Localizer["Scan Material barcode..."]" />
        <button type="button" class="btn btn-outline-secondary" id="spareUsageScanBtn">@Localizer["Resolve"]</button>
    </div>
    <form asp-action="AddSpareUsage" method="post" class="row g-2 mt-2">
        <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
        @if (Acc(WoSection.SpareParts) == SectionAccess.Correctable)
        {
            <div class="col-12"><input name="correctionReason" class="form-control form-control-sm" maxlength="500" required placeholder="@Localizer["Correction reason (required after execution)"]" /></div>
        }
        <div class="col-md-4">
            <select name="materialItemId" id="spareUsageMaterialSelect" class="form-select form-select-sm" required>
                @foreach (var p in materialItems) { <option value="@p.MaterialItemId">@p.MaterialCode - @p.Description</option> }
            </select>
        </div>
        <div class="col-md-3"><input name="quantity" type="number" step="0.01" class="form-control form-control-sm" placeholder="@Localizer["Quantity"]" required /></div>
        <div class="col-md-3"><input name="unitCost" type="number" step="0.01" class="form-control form-control-sm" placeholder="@Localizer["Unit cost (optional)"]" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-plus-lg"></i> @Localizer["Add"]</button></div>
    </form>
    }
</div>
}

@if (tasks.Any())
{
    <div class="content-card mt-3">
        <h6 class="mb-3"><i class="bi bi-list-ol"></i> Tasks (@tasks.Count(t => t.IsCompleted)/@tasks.Count completed)</h6>
        <table class="table table-enterprise table-sm mb-0">
            <thead><tr><th style="width:50px;"></th><th style="width:60px;">#</th><th>@Localizer["Title"]</th><th>@Localizer["Description"]</th><th>@Localizer["Completed"]</th></tr></thead>
            <tbody>
                @foreach (var t in tasks)
                {
                    <tr class="@(t.IsCompleted ? "text-muted" : "")">
                        <td>
                            @if (Ctl(WoSection.JobPlanTasks))
                            {
                                <form asp-action="@(t.IsCompleted ? "ReopenTask" : "CompleteTask")" method="post">
                                    <input type="hidden" name="workOrderTaskId" value="@t.WorkOrderTaskId" />
                                    <input type="hidden" name="workOrderId" value="@Model.WorkOrderId" />
                                    <button type="submit" class="btn btn-sm p-0 border-0" title="@(t.IsCompleted ? "Reopen" : "Mark complete")">
                                        <i class="bi @(t.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")" style="font-size:1.1rem;"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <i class="bi @(t.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")" style="font-size:1.1rem;"></i>
                            }
                        </td>
                        <td class="small fw-bold">@t.TaskNumber</td>
                        <td class="small @(t.IsCompleted ? "text-decoration-line-through" : "")">@t.Title</td>
                        <td class="small text-muted">@t.Description</td>
                        <td class="small">@(t.IsCompleted ? $"{t.CompletedBy} @ {t.CompletedDate:yyyy-MM-dd HH:mm}" : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@{
    var totalPlannedHours = requiredSkills.Sum(x => x.PlannedHours ?? 0);
    var totalActualHours = laborEntries.Sum(x => x.RegularHours + x.OvertimeHours);
}

<div class="content-card mt-3">
    <h6 class="mb-3"><i class="bi bi-mortarboard"></i> @Localizer["Required Skills"]</h6>
