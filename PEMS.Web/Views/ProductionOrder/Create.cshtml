@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<div class="content-card" style="max-width:720px;">
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Product / Material</label>
                <select name="materialItemId" class="form-select" required onchange="fillUom(this)">
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var m in ViewBag.MaterialItems)
                    {
                        <option value="@m.MaterialItemId" data-uom="@m.UomId">@m.MaterialCode - @m.Description</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["UOM"]</label>
                <select name="uomId" id="uomSelect" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var u in ViewBag.Uoms)
                    {
                        <option value="@u.MaterialUOMId">@u.Code</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Planned Quantity</label>
                <input type="number" step="0.001" min="0.001" name="plannedQuantity" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Work Center"]</label>
                <select name="productionWorkCenterId" class="form-select" required>
                    <option value="">@Localizer["-- select --"]</option>
                    @foreach (var w in ViewBag.WorkCenters)
                    {
                        <option value="@w.ProductionWorkCenterId">@w.Code - @w.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">@Localizer["Planned Start"]</label>
                <input type="date" name="plannedStartDate" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Planned Finish"]</label>
                <input type="date" name="plannedFinishDate" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Primary Equipment (optional)</label>
                <select name="equipmentId" class="form-select">
                    <option value="">-- none / from work center --</option>
                    @foreach (var e in ViewBag.Equipments)
                    {
                        <option value="@e.EquipmentId">@e.TagNumber - @e.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Responsible Employee (optional)</label>
                <select name="responsibleEmployeeId" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var emp in ViewBag.Employees)
                    {
                        <option value="@emp.EmployeeId">@emp.Name</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">@Localizer["Notes"]</label>
                <textarea name="notes" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-pems-solid"><i class="bi bi-check-lg"></i> Create (Draft)</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function fillUom(select) {
            var opt = select.options[select.selectedIndex];
            var uomId = opt.getAttribute('data-uom');
            if (uomId) document.getElementById('uomSelect').value = uomId;
        }
    </script>
}
