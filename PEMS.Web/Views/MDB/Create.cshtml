@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;
    var equipments = (IEnumerable<dynamic>)ViewBag.Equipments;
    var pos = (IEnumerable<dynamic>)ViewBag.PurchaseOrders;
}

<pems-content-card css="pems-s-bcaa1805">
    <pems-validation-summary css="py-2 px-3 small" asp-validation-summary="All" hidden="@(ViewData.ModelState.IsValid)"></pems-validation-summary>

    <pems-form asp-action="Create" method="post">
        <pems-row gap="3">
            <pems-col md="6">
                <pems-label>@Localizer["Project"]</pems-label>
                <pems-select name="projectId" required>
                    @foreach (var p in projects)
                    {
                        <option value="@p.ProjectId">@p.ProjectName</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Equipment"]</pems-label>
                <pems-select name="equipmentId" required>
                    @foreach (var eq in equipments)
                    {
                        <option value="@eq.EquipmentId">@eq.TagNumber</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Vendor"]</pems-label>
                <pems-select name="vendorId" required>
                    @foreach (var v in vendors)
                    {
                        <option value="@v.VendorId">@v.Name</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["Purchase Order"] <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
                <pems-select name="poId">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var po in pos)
                    {
                        <option value="@po.PoId">@po.PoNumber</option>
                    }
                </pems-select>
            </pems-col>
            <pems-col md="6">
                <pems-label>@Localizer["MDB_PlannedFinalIssueDate"] <span class="text-muted small">@Localizer["MDB_IndexDueHint"]</span></pems-label>
                <pems-date name="plannedFinalIssueDate" />
            </pems-col>
        </pems-row>

        <pems-action-bar css="mt-4">
            <pems-button tone="primary" type="submit">@Localizer["MDB_Create"]</pems-button>
            <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
        </pems-action-bar>
    </pems-form>
</pems-content-card>
