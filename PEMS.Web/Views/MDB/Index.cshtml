@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ManufacturerDataBookDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var vendors = (IEnumerable<dynamic>)ViewBag.Vendors;

    var qsParts = new List<string>();
    if (ViewBag.SelectedProjectId != null) qsParts.Add($"projectId={ViewBag.SelectedProjectId}");
    if (ViewBag.SelectedVendorId != null) qsParts.Add($"vendorId={ViewBag.SelectedVendorId}");
    var existingQueryString = string.Join("&", qsParts);
}

<div class="content-card mb-3">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">@Localizer["Project"]</label>
            <select name="projectId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Projects --</option>
                @foreach (var p in projects)
                {
                    <option value="@p.ProjectId" selected="@(ViewBag.SelectedProjectId == p.ProjectId)">@p.ProjectName</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">@Localizer["Vendor"]</label>
            <select name="vendorId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Vendors --</option>
                @foreach (var v in vendors)
                {
                    <option value="@v.VendorId" selected="@(ViewBag.SelectedVendorId == v.VendorId)">@v.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <a asp-action="Create" class="btn btn-pems-solid"><i class="bi bi-plus-lg"></i> New MDB</a>
        </div>
    </form>
</div>

<div class="content-card">
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="PemsDataGrid.resetColumns('MDB')">
            <i class="bi bi-arrow-counterclockwise"></i> @Localizer["Reset columns"]
        </button>
    </div>
    <div class="table-responsive table-scroll-area pems-grid-scroll" style="max-height:65vh; overflow-y:auto;">
        <table class="table table-enterprise pems-grid-table" data-grid-key="MDB">
            <thead>
                <tr>
                    <th data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Equipment"]</th>
                    <th data-col-key="vendor" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Vendor"]</th>
                    <th data-col-key="po" data-resizable="true" data-min-width="80" data-max-width="160" style="width:110px">PO</th>
                    <th data-col-key="project" data-resizable="true" data-min-width="100" data-max-width="220" style="width:140px">@Localizer["Project"]</th>
                    <th data-col-key="plannedIssue" data-resizable="true" data-min-width="100" data-max-width="180" style="width:140px">Planned Final Issue</th>
                    <th data-col-key="indexDue" data-resizable="true" data-min-width="100" data-max-width="200" style="width:150px">Index Due</th>
                    <th data-col-key="status" data-resizable="true" data-min-width="90" data-max-width="180" style="width:110px">@Localizer["Status"]</th>
                    <th data-col-key="hardCopy" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">Hard Copy</th>
                    <th data-col-key="softCopy" data-resizable="true" data-min-width="80" data-max-width="140" style="width:100px">Soft Copy</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@m.MDBId">@m.EquipmentTagNumber</a></td>
                        <td>@m.VendorName</td>
                        <td>@m.PoNumber</td>
                        <td>@m.ProjectName</td>
                        <td>@(m.PlannedFinalIssueDate?.ToString("yyyy-MM-dd"))</td>
                        <td>
                            @(m.IndexOfContentsDueDate?.ToString("yyyy-MM-dd"))
                            @if (m.IsIndexOverdue)
                            {
                                <span class="badge bg-danger">@Localizer["Overdue"]</span>
                            }
                        </td>
                        <td><span class="badge bg-secondary">@m.Status</span></td>
                        <td>@(m.HardCopyShippedDate.HasValue ? "Shipped" : "-")</td>
                        <td>@(m.SoftCopyDeliveredDate.HasValue ? "Delivered" : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any())
        {
            <p class="text-muted small mb-0">No MDBs yet.</p>
        }
    </div>

    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        TotalCount = Model.TotalCount,
        PageSize = Model.PageSize,
        GridKey = "MDB",
        BaseUrl = Url.Action("Index") ?? "",
        ExistingQueryString = existingQueryString
    })
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            PemsDataGrid.initColumnResize('MDB');
        });
    </script>
}
