@model PEMS.Application.DTOs.EquipmentFunctionalLocationAssignmentBatchDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    string StatusBadge(string status) => status switch
    {
        "Exact" => "bg-success",
        "NoChange" => "bg-secondary",
        "AlreadyAssigned" => "bg-warning text-dark",
        "UnresolvedEquipment" or "UnresolvedFunctionalLocation" => "bg-danger",
        "ConflictEquipment" or "ConflictFunctionalLocation" => "bg-danger",
        "ValidationError" => "bg-danger",
        _ => "bg-light text-dark"
    };

    string StatusLabel(string status) => status switch
    {
        "Exact" => "Exact match",
        "NoChange" => "Already correct",
        "AlreadyAssigned" => "Already assigned (different)",
        "UnresolvedEquipment" => "Equipment not found",
        "UnresolvedFunctionalLocation" => "Functional Location not found",
        "ConflictEquipment" => "Duplicate Equipment match",
        "ConflictFunctionalLocation" => "Duplicate Functional Location match",
        "ValidationError" => "Validation error",
        _ => status
    };

    var statusFilter = (string?)ViewBag.StatusFilter;
    var filterOptions = new[] { "Exact", "AlreadyAssigned", "NoChange", "UnresolvedEquipment", "UnresolvedFunctionalLocation", "ConflictEquipment", "ConflictFunctionalLocation", "ValidationError" };
}

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="3"><strong>@Localizer["File:"]</strong> @Model.FileName</pems-col>
        <pems-col md="2"><strong>@Localizer["Total Rows:"]</strong> @Model.TotalRows</pems-col>
        <pems-col md="2"><strong>Exact / No Change:</strong> @Model.ExactCount / @Model.NoChangeCount</pems-col>
        <pems-col md="2"><strong>Already Assigned:</strong> @Model.AlreadyAssignedCount</pems-col>
        <pems-col md="1"><strong>@Localizer["Unresolved:"]</strong> @(Model.UnresolvedCount)</pems-col>
        <pems-col md="2"><strong>@Localizer["Status:"]</strong> <pems-badge tone="@(Model.Status == "Committed" ? "success" : "neutral")">@Model.Status</pems-badge></pems-col>
    </pems-row>

    @if (Model.Status == "Staging")
    {
        <div class="pems-command-bar">
            <pems-form asp-action="Commit" method="post">
                <input type="hidden" name="batchId" value="@Model.EquipmentFunctionalLocationAssignmentBatchId" />
                <pems-button tone="primary" type="submit" data-pems-confirm="Commit the approved rows? Equipment Functional Location assignments will be updated.">
                    <pems-icon name="bi-check-circle" /> Commit Approved Rows
                </pems-button>
            </pems-form>
            <pems-form asp-action="Discard" method="post">
                <input type="hidden" name="batchId" value="@Model.EquipmentFunctionalLocationAssignmentBatchId" />
                <pems-button tone="danger" outline="true" type="submit" data-pems-confirm="Discard this entire assignment batch?">
                    <pems-icon name="bi-trash" /> Discard Batch
                </pems-button>
            </pems-form>
        </div>
    }
</pems-content-card>

<div class="pems-filter-bar mb-3">
    <span class="pems-filter-label">@Localizer["Filter"]</span>
    @if (!string.IsNullOrEmpty(statusFilter))
    {
        <span class="pems-filter-active-count">1</span>
    }
    <pems-button as="a" tone="none" size="small" css="@(statusFilter == null ? "btn-pems-solid" : "btn-outline-secondary")" asp-action="Review" asp-route-batchId="@Model.EquipmentFunctionalLocationAssignmentBatchId">All</pems-button>
    @foreach (var s in filterOptions)
    {
        <pems-button as="a" tone="none" size="small" css="@(statusFilter == s ? "btn-pems-solid" : "btn-outline-secondary")" asp-action="Review" asp-route-batchId="@Model.EquipmentFunctionalLocationAssignmentBatchId" asp-route-status="@s">@StatusLabel(s)</pems-button>
    }
    @if (!string.IsNullOrEmpty(statusFilter))
    {
        <span class="pems-command-bar-spacer"></span>
        <pems-link asp-action="Review" asp-route-batchId="@Model.EquipmentFunctionalLocationAssignmentBatchId" class="pems-filter-clear-all">Clear All</pems-link>
    }
</div>

<pems-content-card>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
        @{
            var rows_34 = Model.Rows.Items;
            var cell_34_0 = DataCell.Template(rows_34, @<text>@{ var r = item; }
                            @if (Model.Status == "Staging")
                            {
                                var canToggle = r.Status is "Exact" or "AlreadyAssigned";
                                if (canToggle)
                                {
                                    <pems-form asp-action="ToggleRow" method="post">
                                        <input type="hidden" name="rowId" value="@r.EquipmentFunctionalLocationAssignmentRowId" />
                                        <input type="hidden" name="batchId" value="@Model.EquipmentFunctionalLocationAssignmentBatchId" />
                                        <input type="hidden" name="page" value="@Model.Rows.Page" />
                                        <input type="hidden" name="status" value="@statusFilter" />
                                        <input type="hidden" name="include" value="@(!r.IncludeInCommit)" />
                                        <pems-button class="pems-w-36" tone="none" size="small" css="@(r.IncludeInCommit ? "btn-success" : "btn-outline-secondary")" type="submit" title="@(r.IncludeInCommit ? "Approved - click to exclude" : "Excluded - click to approve")">
                                            <pems-icon css="@(r.IncludeInCommit ? "bi-check-lg" : "bi-x-lg")" />
                                        </pems-button>
                                    </pems-form>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }

                                @if (r.Status == "AlreadyAssigned")
                                {
                                    <pems-form asp-action="ReplaceExisting" method="post" class="mt-1">
                                        <input type="hidden" name="rowId" value="@r.EquipmentFunctionalLocationAssignmentRowId" />
                                        <input type="hidden" name="batchId" value="@Model.EquipmentFunctionalLocationAssignmentBatchId" />
                                        <input type="hidden" name="page" value="@Model.Rows.Page" />
                                        <input type="hidden" name="status" value="@statusFilter" />
                                        <input type="hidden" name="replace" value="@(!r.ReplaceExistingAssignment)" />
                                        <pems-button tone="none" size="small" css="@(r.ReplaceExistingAssignment ? "btn-warning" : "btn-outline-warning")" type="submit" data-pems-confirm="Replace the existing Functional Location assignment for this equipment?">
                                            @(r.ReplaceExistingAssignment ? "Replace: Yes" : "Replace existing?")
                                        </pems-button>
                                    </pems-form>
                                }
                            }
                            else
                            {
                                @(r.CommittedAssignment ? "Assigned" : (r.IncludeInCommit ? "Approved" : "No"))
                            }
                        </text>);
            var cell_34_6 = DataCell.Template(rows_34, @<text>@{ var r = item; }<pems-badge tone="none" css="@StatusBadge(r.Status)">@StatusLabel(r.Status)</pems-badge></text>);
        }
        <pems-data-table data="@(DataRows.Of(rows_34, c_ => c_.Add(((Localizer["Approve"])?.ToString() ?? ""), r => (object?)cell_34_0(r)).Add(((Localizer["Src Row"])?.ToString() ?? ""), r => (object?)(r.SourceRowNumber)).Add(((Localizer["Equipment Tag"])?.ToString() ?? ""), r => (object?)(DataCell.Span(null, r.EquipmentTag).WithDir("ltr").WithTag("strong"))).Add(((Localizer["Equipment"])?.ToString() ?? ""), r => (object?)((r.EquipmentDescription ?? "-")), css: "small").Add("Current FL", r => (object?)((r.CurrentFunctionalLocationBreadcrumb ?? "-")), css: "small", dir: "ltr").Add("Proposed FL", r => (object?)((r.ProposedFunctionalLocationBreadcrumb ?? r.FunctionalLocationCode)), css: "small", dir: "ltr").Add(((Localizer["Match Result"])?.ToString() ?? ""), r => (object?)cell_34_6(r)).Add(((Localizer["Note"])?.ToString() ?? ""), r => (object?)((r.ValidationMessage != null ? (object?)DataCell.Span("text-muted pems-s-f8f979be", r.ValidationMessage) : null)), css: "small")))" />
    </pems-table-scroll>
    @if (!Model.Rows.Items.Any()) { <pems-text class="text-muted text-center py-4">@Localizer["No rows match this filter."]</pems-text> }

    @{
        var qsParts = new List<string>();
        if (!string.IsNullOrEmpty(statusFilter)) qsParts.Add($"status={Uri.EscapeDataString(statusFilter)}");
        qsParts.Add($"batchId={Model.EquipmentFunctionalLocationAssignmentBatchId}");
    }
    @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
    {
        Page = Model.Rows.Page,
        TotalPages = Model.Rows.TotalPages,
        TotalCount = Model.Rows.TotalCount,
        PageSize = Model.Rows.PageSize,
        GridKey = "EquipmentFunctionalLocationAssignment",
        BaseUrl = Url.Action("Review") ?? "",
        ExistingQueryString = string.Join("&", qsParts)
    })
</pems-content-card>
