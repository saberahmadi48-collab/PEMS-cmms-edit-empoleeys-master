@model PEMS.Application.DTOs.IntakeDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var modules = (string[])ViewBag.Modules;
}

<div class="content-card mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">@Model.FileName</h5>
            <span class="text-muted small">Project: @Model.ProjectName</span>
        </div>
        <div class="text-end">
            @{
                var lb = Model.ConfidenceLevel switch { "High" => "bg-success", "Medium" => "bg-warning text-dark", _ => "bg-danger" };
            }
            <span class="badge @lb fs-6">Confidence: @Model.ConfidenceLevel (@Model.ConfidenceScore.ToString("P0"))</span>
        </div>
    </div>

    @if (Model.AIStatus == "Failed")
    {
        <div class="alert alert-danger mt-3 mb-0">AI analysis failed: @Model.AIError. You can still classify and route this file manually below.</div>
    }
</div>

<div class="content-card">
    <h6 class="mb-3"><i class="bi bi-robot"></i> AI Suggestion &mdash; confirm or correct, then Route</h6>

    <form asp-action="Route" method="post">
        <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">@Localizer["Target Module"]</label>
                <select name="targetModule" class="form-select">
                    @foreach (var m in modules)
                    { <option value="@m" selected="@(m == Model.SuggestedTargetModule)">@m</option> }
                </select>
                <div class="form-text">AI suggested: <strong>@Model.SuggestedTargetModule</strong></div>
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Category"]</label>
                <input name="category" class="form-control" value="@Model.PredictedCategory" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Document Type"]</label>
                <input name="documentType" class="form-control" value="@Model.PredictedDocumentType" />
            </div>

            <div class="col-md-4">
                <label class="form-label">@Localizer["Project"]</label>
                <select name="projectId" class="form-select">
                    @foreach (var p in projects)
                    { <option value="@p.ProjectId" selected="@(p.ProjectId == Model.ProjectId)">@p.ProjectName</option> }
                </select>
                @if (!string.IsNullOrEmpty(Model.PredictedProjectHint))
                { <div class="form-text">AI hint from document text: "@Model.PredictedProjectHint"</div> }
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Discipline"]</label>
                <select name="disciplineCode" class="form-select">
                    <option value="">@Localizer["-- None --"]</option>
                    @foreach (var d in disciplines)
                    { <option value="@d.Code" selected="@(d.Code == Model.PredictedDisciplineCode)">@d.Name (@d.Code)</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Area"]</label>
                <input name="area" class="form-control" value="@Model.PredictedArea" />
            </div>

            <div class="col-md-3"><label class="form-label small">@Localizer["Unit"]</label><input class="form-control form-control-sm" value="@Model.PredictedUnit" disabled /></div>
            <div class="col-md-3"><label class="form-label small">@Localizer["System"]</label><input class="form-control form-control-sm" value="@Model.PredictedSystem" disabled /></div>
            <div class="col-md-3"><label class="form-label small">Subsystem</label><input class="form-control form-control-sm" value="@Model.PredictedSubsystem" disabled /></div>
            <div class="col-md-3"><label class="form-label small">@Localizer["Equipment Tag"]</label><input class="form-control form-control-sm" value="@Model.PredictedEquipmentTagNumber" disabled /></div>

            <div class="col-md-4">
                <label class="form-label">@Localizer["Revision"]</label>
                <input name="revisionNo" class="form-control" value="@Model.PredictedRevisionNo" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Issue Purpose"]</label>
                <input name="issuePurpose" class="form-control" value="@Model.PredictedIssuePurpose" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Vendor (for VDR routing)</label>
                <input name="vendorName" class="form-control" value="@Model.PredictedVendorName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Related MR Number</label>
                <input name="mrNumber" class="form-control" value="@Model.PredictedMRNumber" />
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-pems-solid"><i class="bi bi-signpost-split"></i> Confirm &amp; Route</button>
        </div>
    </form>

    <form asp-action="Reject" method="post" class="mt-2">
        <input type="hidden" name="attachmentId" value="@Model.AttachmentId" />
        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Reject this file from the intake queue?')">
            <i class="bi bi-x-lg"></i> @Localizer["Reject"]
        </button>
    </form>
</div>
