@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    // طبق «PEMS Dynamic Maintenance Organization — Phase 6A»: این View فقط Shell صفحه است.
    // درخت سازمانی از IOrganizationStructureService.GetOrganizationTreeAsync() از طریق همان
    // اکشن JSON موجود (Team/OrganizationTree) با fetch سمت کلاینت خوانده می‌شود - هیچ EF Core
    // مستقیم این‌جا نیست (بند ۲ سند).
    var selectedDisciplineId = ViewBag.SelectedDisciplineId as int?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-org-chart.css" asp-append-version="true" />
}

<div class="pems-orgchart-page" id="pemsOrgChartRoot"
     data-tree-url="@Url.Action("OrganizationTree", "Team")"
     data-details-url-template="@Url.Action("TeamDetails", "Team")"
     data-empty-text="@Localizer["هیچ ساختار سازمانی تعمیرونگهداری هنوز پیکربندی نشده."]"
     data-error-text="@Localizer["بارگذاری نمودار سازمانی با خطا مواجه شد. دوباره تلاش کنید."]"
     data-loading-text="@Localizer["در حال بارگذاری نمودار سازمانی..."]"
     data-vacant-text="@Localizer["خالی (Vacant)"]"
     data-positions-text="@Localizer["سمت‌ها"]"
     data-members-text="@Localizer["اعضا"]"
     data-view-details-text="@Localizer["مشاهده‌ی جزئیات تیم"]"
     data-filter-empty-text="@Localizer["هیچ سمتی با این فیلتر وجود ندارد."]"
     data-no-discipline-text="@Localizer["هیچ دیسیپلینی یافت نشد"]"
     data-all-disciplines-text="@Localizer["همه‌ی دیسیپلین‌ها"]">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-return-@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "right" : "left")"></i>
                @Localizer["بازگشت به تیم‌ها"]
            </a>
            <input type="search" id="orgChartDisciplineSearch" class="form-control form-control-sm" style="width:170px"
                   placeholder="@Localizer["جستجوی دیسیپلین..."]" aria-label="@Localizer["جستجوی دیسیپلین..."]" autocomplete="off" />
            <select id="orgChartDisciplineFilter" class="form-select form-select-sm" style="min-width:200px"
                    aria-label="@Localizer["دیسیپلین"]">
                <option value="">@Localizer["همه‌ی دیسیپلین‌ها"]</option>
                @foreach (var d in (IEnumerable<dynamic>)ViewBag.Disciplines)
                {
                    <option value="@d.DisciplineId" selected="@(selectedDisciplineId == (int)d.DisciplineId)">@d.Name</option>
                }
            </select>
        </div>

        <div class="d-flex align-items-center gap-1" role="toolbar" aria-label="@Localizer["ابزار نمودار سازمانی"]">
            <button type="button" id="orgChartExpandAll" class="btn btn-outline-secondary btn-sm" title="@Localizer["باز کردن همه"]">
                <i class="bi bi-arrows-expand"></i>
            </button>
            <button type="button" id="orgChartCollapseAll" class="btn btn-outline-secondary btn-sm" title="@Localizer["بستن همه"]">
                <i class="bi bi-arrows-collapse"></i>
            </button>
            <div class="vr mx-1"></div>
            <button type="button" id="orgChartZoomOut" class="btn btn-outline-secondary btn-sm" title="@Localizer["کوچک‌نمایی"]">
                <i class="bi bi-zoom-out"></i>
            </button>
            <button type="button" id="orgChartZoomIn" class="btn btn-outline-secondary btn-sm" title="@Localizer["بزرگ‌نمایی"]">
                <i class="bi bi-zoom-in"></i>
            </button>
            <button type="button" id="orgChartFit" class="btn btn-outline-secondary btn-sm" title="@Localizer["تناسب با صفحه"]">
                <i class="bi bi-aspect-ratio"></i>
            </button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-9">
            <div class="content-card pems-org-summary mb-3" id="orgChartSummary" hidden>
                <div class="pems-org-summary-head">
                    <strong>@Localizer["خلاصه‌ی اشغال سمت‌ها"]</strong>
                    <div class="btn-group btn-group-sm" role="group" aria-label="@Localizer["نمایش سمت‌ها"]" id="orgChartVacancyFilter">
                        <button type="button" class="btn btn-outline-secondary active" data-filter="all" aria-pressed="true">@Localizer["همه"]</button>
                        <button type="button" class="btn btn-outline-secondary" data-filter="filled" aria-pressed="false">@Localizer["تکمیل‌شده"] (<span id="orgChartFilterFilled">0</span>)</button>
                        <button type="button" class="btn btn-outline-secondary" data-filter="vacant" aria-pressed="false">@Localizer["خالی"] (<span id="orgChartFilterVacant">0</span>)</button>
                    </div>
                </div>
                <div class="pems-org-stats">
                    <div class="pems-org-stat"><span class="pems-org-stat-value" id="orgChartStatTotal">0</span><span class="pems-org-stat-label">@Localizer["کل سمت‌ها"]</span></div>
                    <div class="pems-org-stat pems-org-stat-filled"><span class="pems-org-stat-value" id="orgChartStatFilled">0</span><span class="pems-org-stat-label"><i class="bi bi-person-check"></i> @Localizer["تکمیل‌شده"]</span></div>
                    <div class="pems-org-stat pems-org-stat-vacant"><span class="pems-org-stat-value" id="orgChartStatVacant">0</span><span class="pems-org-stat-label"><i class="bi bi-person-dash"></i> @Localizer["خالی"]</span></div>
                    <div class="pems-org-stat"><span class="pems-org-stat-value" id="orgChartStatOccupancy">0%</span><span class="pems-org-stat-label">@Localizer["نرخ اشغال"]</span></div>
                </div>
                <div class="pems-org-progress" role="img" id="orgChartProgress" aria-label="@Localizer["نرخ اشغال"]">
                    <span class="pems-org-progress-filled" id="orgChartProgressFilled"></span>
                    <span class="pems-org-progress-vacant" id="orgChartProgressVacant"></span>
                </div>
                <div class="small text-muted mt-1">@Localizer["سمت‌های غیرفعال در شمارش نیامده‌اند."]</div>
            </div>

            <div class="content-card pems-orgchart-card">
                <div id="orgChartLoading" class="pems-orgchart-state">
                    <div class="spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></div>
                    <span>@Localizer["در حال بارگذاری نمودار سازمانی..."]</span>
                </div>
                <div id="orgChartError" class="pems-orgchart-state text-danger" hidden>
                    <i class="bi bi-exclamation-triangle"></i>
                    <span id="orgChartErrorText"></span>
                    <button type="button" id="orgChartRetry" class="btn btn-sm btn-outline-danger ms-2">@Localizer["تلاش دوباره"]</button>
                </div>
                <div id="orgChartEmpty" class="pems-orgchart-state" hidden>
                    <i class="bi bi-diagram-3"></i>
                    <span id="orgChartEmptyText"></span>
                </div>

                <div id="orgChartViewport" class="pems-orgchart-viewport" hidden tabindex="0"
                     role="tree" aria-label="@Localizer["نمودار سازمانی تعمیرونگهداری"]">
                    <div id="orgChartCanvas" class="pems-orgchart-canvas"></div>
                </div>
            </div>

            <div class="pems-org-legend" aria-label="@Localizer["راهنمای نمودار"]">
                <span class="pems-org-legend-title">@Localizer["راهنمای نمودار"]</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Group"></span>@Localizer["گروه نگهداری"]</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Team"></span>@Localizer["تیم"]</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Shift"></span>@Localizer["شیفت / زیرتیم / واحد"]</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Position-Occupied"></span>@Localizer["سمت تکمیل‌شده"]</span>
                <span class="pems-org-legend-item"><span class="pems-org-swatch" data-kind="Position-Vacant"></span>@Localizer["سمت خالی"]</span>
            </div>
        </div>

        <div class="col-12 col-xl-3">
            <div class="content-card pems-orgchart-detail" id="orgChartDetailPanel">
                <div class="pems-orgchart-state" id="orgChartNoSelection">
                    <i class="bi bi-cursor"></i>
                    <span>@Localizer["روی یک گره کلیک کنید تا جزئیاتش را ببینید."]</span>
                </div>
                <div id="orgChartDetailContent" hidden></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pems-org-chart-logic.js" asp-append-version="true"></script>
    <script src="~/js/pems-org-chart.js" asp-append-version="true"></script>
}
