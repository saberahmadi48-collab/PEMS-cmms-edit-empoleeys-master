@model PEMS.Application.DTOs.ClassificationDashboardDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
}

<pems-content-card css="mb-3">
    <pems-row gap="3">
        <pems-col md="2">
            <pems-kpi-tile compact label="@Localizer["Total Active Equipment"]">@Model.TotalActiveEquipment.ToString("N0")</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact tone="success" label="Classified">@Model.ClassifiedCount.ToString("N0")</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact label="Unclassified">@Model.UnclassifiedCount.ToString("N0")</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact label="Coverage">@Model.CoveragePercent.ToString("0.0")%</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-kpi-tile compact tone="warning" label="@Localizer["Pending Review"]">@Model.PendingReviewCount.ToString("N0")</pems-kpi-tile>
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" size="small" css="mt-2" as="a" asp-action="ReviewQueue">
                <pems-icon name="bi-list-check" /> Review Queue
            </pems-button>
            <pems-button tone="neutral" size="small" outline="true" css="mt-2" as="a" asp-action="Coverage">
                <pems-icon name="bi-grid-3x3-gap" /> Coverage Matrix
            </pems-button>
        </pems-col>
    </pems-row>
</pems-content-card>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Classified — by Confidence</pems-heading>
            @foreach (var item in Model.ByConfidence)
            {
                <pems-flex justify="between" css="small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </pems-flex>
                <pems-progress value="@item.Count" max="@Model.ClassifiedCount" height="6px" css="mb-2"></pems-progress>
            }
            @if (!Model.ByConfidence.Any()) { <pems-text class="text-muted small">@Localizer["داده‌ای موجود نیست."]</pems-text> }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Classified — by Source</pems-heading>
            @foreach (var item in Model.BySource)
            {
                <pems-flex justify="between" css="small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </pems-flex>
                <pems-progress value="@item.Count" max="@Model.ClassifiedCount" tone="info" height="6px" css="mb-2"></pems-progress>
            }
            @if (!Model.BySource.Any()) { <pems-text class="text-muted small">@Localizer["داده‌ای موجود نیست."]</pems-text> }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-row gap="3" css="mb-3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Pending Suggestions — by Confidence</pems-heading>
            @foreach (var item in Model.PendingSuggestionsByConfidence)
            {
                <pems-flex justify="between" css="small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </pems-flex>
            }
            @if (!Model.PendingSuggestionsByConfidence.Any()) { <pems-text class="text-muted small">@Localizer["هیچ پیشنهادی در انتظار بازبینی نیست."]</pems-text> }
        </pems-content-card>
    </pems-col>
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Unclassified — by Discipline</pems-heading>
            @foreach (var item in Model.UnclassifiedByDiscipline)
            {
                <pems-flex justify="between" css="small mb-1">
                    <span>@item.Key</span><span>@item.Count.ToString("N0")</span>
                </pems-flex>
            }
            @if (!Model.UnclassifiedByDiscipline.Any()) { <pems-text class="text-muted small">@Localizer["داده‌ای موجود نیست."]</pems-text> }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mb-3">
    <pems-heading level="6" class="mb-3">Classified — by Equipment Class (Top 20)</pems-heading>
    <pems-table-scroll>
        <pems-data-table data="@(DataRows.Of(Model.ByEquipmentClass, c_ => c_.Add(((Localizer["Equipment Class"])?.ToString() ?? ""), item => (object?)(item.Key)).Add(((Localizer["Count"])?.ToString() ?? ""), item => (object?)(item.Count.ToString("N0")))))" dense="true" />
        @if (!Model.ByEquipmentClass.Any()) { <pems-text class="text-muted small text-center py-3">@Localizer["داده‌ای موجود نیست."]</pems-text> }
    </pems-table-scroll>
</pems-content-card>

<pems-row gap="3">
    <pems-col md="4">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Top Unclassified — EquipmentType</pems-heading>
            <pems-table-scroll css="pems-s-f0787633">
                <pems-data-table data="@(DataRows.Of(Model.TopUnclassifiedEquipmentTypes, c_ => c_.Add("", item => (object?)(item.Key), css: "small").Add("", item => (object?)((item.Count.ToString("N0"))), css: "text-end")))" header="false" dense="true" />
            </pems-table-scroll>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Top Unclassified — Name</pems-heading>
            <pems-table-scroll css="pems-s-f0787633">
                <pems-data-table data="@(DataRows.Of(Model.TopUnclassifiedEquipmentNames, c_ => c_.Add("", item => (object?)(item.Key), css: "small").Add("", item => (object?)((item.Count.ToString("N0"))), css: "text-end")))" header="false" dense="true" />
            </pems-table-scroll>
        </pems-content-card>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3">Top Unclassified — Tag Pattern</pems-heading>
            <pems-table-scroll css="pems-s-f0787633">
                <pems-data-table data="@(DataRows.Of(Model.TopUnclassifiedTagPatterns, c_ => c_.Add("", item => (object?)(DataCell.Code(item.Key)), css: "small").Add("", item => (object?)((item.Count.ToString("N0"))), css: "text-end")))" header="false" dense="true" />
            </pems-table-scroll>
        </pems-content-card>
    </pems-col>
</pems-row>
