@model List<PEMS.Application.DTOs.WorkOrderCalendarItemDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    DateTime day = ViewBag.Day;
    string TypeBadgeClass(string t) => t switch
    {
        "Preventive" => "bg-info text-dark",
        "Corrective" => "bg-warning text-dark",
        "Emergency" => "bg-danger",
        "Predictive" => "bg-purple",
        _ => "bg-secondary"
    };
}

<pems-content-card css="mb-3">
    <pems-flex wrap="true" gap="2" align="center" justify="between" css="mb-3">
        <pems-flex gap="2" align="center">
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="MyWork" asp-route-date="@PemsDates.Date(DateTime.Today)">@Localizer["Today"]</pems-button>
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="MyWork" asp-route-date="@PemsDates.Date(day.AddDays(-1))"><pems-icon name="bi-chevron-left" /></pems-button>
            <pems-button tone="neutral" size="small" outline="true" as="a" asp-action="MyWork" asp-route-date="@PemsDates.Date(day.AddDays(1))"><pems-icon name="bi-chevron-right" /></pems-button>
        </pems-flex>
        <pems-heading level="6" class="mb-0">@Localizer["My Work"] &mdash; @day.ToString("dddd, MMM d")</pems-heading>
    </pems-flex>

    @if (!Model.Any())
    {
        <pems-text class="text-muted text-center py-4">@Localizer["No work scheduled for you on this day."]</pems-text>
    }
    <div class="pems-cal-day-timeline">
        @foreach (var it in Model.OrderBy(x => x.PlannedStart))
        {
            <pems-link class="pems-cal-day-card @TypeBadgeClass(it.WorkOrderType) @(it.HasEmployeeConflict ? "pems-cal-conflict" : "")"
               href="@Url.Action("Details", "WorkOrder", new { id = it.WorkOrderId })">
                <div class="pems-cal-day-time" dir="ltr">@PemsDates.Time(it.PlannedStart) &ndash; @PemsDates.Time(it.PlannedFinish)</div>
                <div class="pems-cal-day-body">
                    <div class="fw-bold">@it.WorkOrderNumber &middot; @it.EquipmentTagNumber</div>
                    <div class="small">@it.EquipmentDescription</div>
                    <div class="small">
                        <pems-badge tone="none" css="@TypeBadgeClass(it.WorkOrderType)">@it.WorkOrderType</pems-badge>
                        <pems-badge tone="neutral">@it.Status</pems-badge>
                        @if (it.HasEmployeeConflict) { <pems-badge tone="danger"><pems-icon name="bi-exclamation-triangle" /> @Localizer["Conflict"]</pems-badge> }
                    </div>
                    <div class="small text-muted">@it.AssignedTeamName</div>
                </div>
            </pems-link>
        }
    </div>
</pems-content-card>

@section Styles {
    <link rel="stylesheet" href="~/css/pems-maintenance-calendar.css" asp-append-version="true" />
}
