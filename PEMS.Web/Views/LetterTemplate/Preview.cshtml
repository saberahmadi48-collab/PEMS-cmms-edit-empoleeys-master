@model PEMS.Application.DTOs.LetterTemplateDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-content-card css="pems-s-3f7efa5f">
    <pems-text class="text-muted small"><pems-icon name="bi-info-circle" aria-hidden="true" /> @Localizer["LtT_PreviewNote"]</pems-text>

    <pems-info-grid layout="rows" class="small mb-3">
    <pems-info-item label="@Localizer["LtT_Name"]">@Model.Name</pems-info-item>
    <pems-info-item label="@Localizer["Type"]">@(Model.LetterType ?? Localizer["LtT_AllTypes"].Value)</pems-info-item>
    <pems-info-item label="@Localizer["Lt_Priority"]">@Localizer["Lt_P_" + Model.Priority]</pems-info-item>
    <pems-info-item label="@Localizer["Lt_Confidentiality"]">@Model.ConfidentialityLevel</pems-info-item>
</pems-info-grid>

    <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Subject"]</pems-heading>
    <pems-text class="fw-semibold">@ViewBag.Subject</pems-text>

    <pems-heading level="2" class="vs-section__title">@Localizer["Lt_Body"]</pems-heading>
    <div class="border rounded p-3 mb-3">@Html.Raw((string?)ViewBag.Body)</div>

    <pems-button tone="neutral" outline="true" as="a" asp-action="Index">@Localizer["Cancel"]</pems-button>
    <pems-button tone="primary" as="a" asp-action="Edit" asp-route-id="@Model.LetterTemplateId"><pems-icon name="bi-pencil" aria-hidden="true" /> @Localizer["Edit"]</pems-button>
</pems-content-card>
