@model List<PEMS.Application.DTOs.EquipmentImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
}

<pems-content-card css="mb-3">
    <pems-text class="text-muted small">
        Upload an Excel file of equipment (Mechanical, Instrument, or any discipline). Column names
        vary between files - the system automatically detects the header row and recognizes common
        variants (Tag No., Item Name, EQ Type, Discipline, Area, P&amp;ID, MR/MRQ No.). Review the
        recognized rows before they are added to the live Equipment register.
    </pems-text>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="5">
            <pems-label css="small">@Localizer["Project"]</pems-label>
            <pems-select name="projectId" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="5">
            <pems-label css="small">Equipment Excel File</pems-label>
            <pems-uploader name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card css="mb-3">
    <pems-text class="text-muted small">
        Or, scan a PDF for tag-number-looking text (best-effort recognition, not a full structured
        extraction - you'll review and pick which tags to add).
    </pems-text>
    <pems-form asp-action="ScanPdf" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="5">
            <pems-label css="small">@Localizer["Project"]</pems-label>
            <pems-select name="projectId" required>
                @foreach (var p in projects) { <option value="@p.ProjectId">@p.ProjectName</option> }
            </pems-select>
        </pems-col>
        <pems-col md="5">
            <pems-label css="small">PDF File</pems-label>
            <pems-uploader name="file" accept=".pdf" required />
        </pems-col>
        <pems-col md="2">
            <pems-button tone="primary" outline="true" css="w-100" type="submit"><pems-icon name="bi-file-earmark-pdf" /> Scan PDF</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-3">@Localizer["Recent Import Batches"]</pems-heading>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["File"])?.ToString() ?? ""), b => (object?)(b.FileName)).Add(((Localizer["Project"])?.ToString() ?? ""), b => (object?)(b.ProjectName)).Add(((Localizer["Date"])?.ToString() ?? ""), b => (object?)((PemsDates.DateTime(b.ImportDate)))).Add("Rows", b => (object?)(b.Rows.Count)).Add(((Localizer["New"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("success", (b.Rows.Count(x => !x.IsUpdate))))).Add("Updates", b => (object?)(DataCell.Badge("info", (b.Rows.Count(x => x.IsUpdate))))).Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)(DataCell.Badge(b.Status == "Committed" ? "success" : "neutral", b.Status))).Add("", b => (object?)((b.Status == "Staging" ? (object?)DataCell.ButtonLink(Url.Action("Review", null, new { batchId = b.EquipmentImportBatchId }), "primary", "small", true, null, "Review") : null)))))" />
    </pems-table-scroll>
    @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">No equipment imports yet.</pems-text> }
</pems-content-card>
