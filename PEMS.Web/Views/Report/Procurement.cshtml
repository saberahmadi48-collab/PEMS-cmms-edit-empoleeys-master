@model PEMS.Application.DTOs.ProcurementReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var pipeline = (PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.ProcurementPipelineRowDto>)ViewBag.Pipeline;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Procurement packages by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Packages", Model.VolumeByMonth.Select(x => x.Count), BkChartSpec.Primary));
    var statusChart = BkChartSpec.Donut("Packages by status", noData, Localizer["Total"].Value, Model.ByStatus.Select(x => (x.Status, (double)x.Count)));
    var disciplineChartRows = BkChartSpec.TopWithOthers(Model.ByDiscipline.Select(x => (x.Discipline, x.Count)), 10, Localizer["Chart_Other"].Value);
    var disciplineChart = BkChartSpec.HBars("Packages by discipline", noData, disciplineChartRows.Select(x => x.Label), false,
        new BkSeries("Packages", disciplineChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-envelope-paper"></i> @Localizer["Correspondence"]</a>
    <a asp-action="Engineering" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-text"></i> @Localizer["Engineering Documents"]</a>
    <a asp-action="Vdr" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-check"></i> @Localizer["VDR"]</a>
    <a asp-action="Procurement" class="btn btn-sm btn-pems-solid"><i class="bi bi-cart-check"></i> @Localizer["Procurement"]</a>
    <a asp-action="Cmms" class="btn btn-sm btn-outline-secondary"><i class="bi bi-tools"></i> CMMS</a>
    <a asp-action="Operations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard-data"></i> @Localizer["Operations"]</a>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> @Localizer["Apply"]</button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-folder2-open"></i></div><div><div class="kpi-value">@Model.TotalPackages</div><div class="kpi-label">Packages</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-blue"><i class="bi bi-cart-check"></i></div><div><div class="kpi-value">@Model.TotalMRs</div><div class="kpi-label">@Localizer["MRs"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-file-earmark-spreadsheet"></i></div><div><div class="kpi-value">@Model.TotalMRQs</div><div class="kpi-label">@Localizer["MRQs"]</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-hourglass-split"></i></div><div><div class="kpi-value">@Model.OpenCount</div><div class="kpi-label">@Localizer["Open"]</div></div></div></div>
    <div class="col-md-3 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-check-circle"></i></div><div><div class="kpi-value">@Model.ClosedCount</div><div class="kpi-label">@Localizer["Closed"]</div></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-blue"><i class="bi bi-clipboard-check"></i></div><div><div class="kpi-value">@Model.TotalTenders</div><div class="kpi-label">@Localizer["Tenders"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-cash-coin"></i></div><div><div class="kpi-value">@Model.TotalBids</div><div class="kpi-label">@Localizer["Bids"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-file-earmark-ruled"></i></div><div><div class="kpi-value">@Model.TotalContracts</div><div class="kpi-label">Contracts</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-receipt"></i></div><div><div class="kpi-value">@Model.TotalPurchaseOrders</div><div class="kpi-label">@Localizer["Purchase Orders"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-flag"></i></div><div><div class="kpi-value">@Model.TotalNTPsIssued</div><div class="kpi-label">@Localizer["Notice to Proceed (NTP)"]</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Packages (last 12 months)</h6>
            <partial name="_BkChart" model="@volumeChart" />
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Status"]</h6>
            <partial name="_BkChart" model="@statusChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Discipline"]</h6>
            <partial name="_BkChart" model="@disciplineChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Vendors (by MRQ count)</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var v in Model.ByVendor)
                {
                    <li class="d-flex justify-content-between border-bottom py-1"><span>@v.Vendor</span><span class="text-muted small">@v.Count</span></li>
                }
            </ul>
            @if (!Model.ByVendor.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </div>
    </div>
</div>

<div class="content-card mt-3">
    <h6 class="mb-3">@Localizer["Tender-to-Contract Pipeline"]</h6>
    <div class="table-responsive">
        <table class="table table-enterprise table-sm">
            <thead><tr>
                <th>@Localizer["Package"]</th><th>@Localizer["Tender No"]</th><th>@Localizer["Status"]</th>
                <th>@Localizer["Vendor"]</th><th>@Localizer["Technical"]</th><th>@Localizer["Commercial"]</th>
                <th>@Localizer["Contract No"]</th><th>@Localizer["Status"]</th><th>@Localizer["Value"]</th>
                <th>PO</th><th>NTP</th><th>@Localizer["Kick-off"]</th>
            </tr></thead>
            <tbody>
                @foreach (var row in pipeline.Items)
                {
                    <tr>
                        <td>@row.PackageNumber</td>
                        <td>@row.TenderNumber</td>
                        <td><span class="badge bg-secondary">@row.TenderStatus</span></td>
                        <td>@row.WinnerVendorName</td>
                        <td>@row.TechnicalEvaluationStatus</td>
                        <td>@row.CommercialEvaluationStatus</td>
                        <td>@row.ContractNo</td>
                        <td>@row.ContractStatus</td>
                        <td>@row.ContractValue?.ToString("N0")</td>
                        <td>@row.PoNumber</td>
                        <td>@row.NtpStatus</td>
                        <td>@row.KickoffStatus</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (pipeline.Items.Count == 0)
    {
        <p class="text-muted small">@Localizer["No data."]</p>
    }
    @if (pipeline.TotalCount > pipeline.PageSize)
    {
        var totalPages = (int)Math.Ceiling(pipeline.TotalCount / (double)pipeline.PageSize);
        <nav class="mt-2"><ul class="pagination pagination-sm mb-0">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == pipeline.Page ? "active" : "")">
                    <a class="page-link" asp-action="Procurement" asp-route-projectId="@ViewBag.SelectedProjectId" asp-route-disciplineId="@ViewBag.SelectedDisciplineId" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate" asp-route-page="@p">@p</a>
                </li>
            }
        </ul></nav>
    }
</div>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
