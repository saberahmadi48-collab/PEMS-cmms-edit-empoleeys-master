@model PEMS.Application.DTOs.CorrespondenceReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Letters by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Incoming", Model.VolumeByMonth.Select(x => x.Incoming), BkChartSpec.Positive),
        BkSeries.Of("Outgoing", Model.VolumeByMonth.Select(x => x.Outgoing), BkChartSpec.Primary));
    var statusChart = BkChartSpec.Donut("Letters by status", noData, Localizer["Total"].Value, Model.ByStatus.Select(x => (x.Status, (double)x.Count)));
    var disciplineChartRows = BkChartSpec.TopWithOthers(Model.ByDiscipline.Select(x => (x.Discipline, x.Count)), 10, Localizer["Chart_Other"].Value);
    var disciplineChart = BkChartSpec.HBars("Letters by discipline", noData, disciplineChartRows.Select(x => x.Label), false,
        new BkSeries("Letters", disciplineChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-pems-solid"><i class="bi bi-envelope-paper"></i> @Localizer["Correspondence"]</a>
    <a asp-action="Engineering" class="btn btn-sm btn-outline-secondary"><i class="bi bi-file-earmark-text"></i> @Localizer["Engineering Documents"]</a>
    <a asp-action="Vdr" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-check"></i> @Localizer["VDR"]</a>
    <a asp-action="Procurement" class="btn btn-sm btn-outline-secondary"><i class="bi bi-cart-check"></i> @Localizer["Procurement"]</a>
    <a asp-action="Cmms" class="btn btn-sm btn-outline-secondary"><i class="bi bi-tools"></i> CMMS</a>
    <a asp-action="Operations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard-data"></i> @Localizer["Operations"]</a>
</div>
<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> @Localizer["Apply"]</button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-envelope"></i></div><div><div class="kpi-value">@Model.TotalLetters</div><div class="kpi-label">@Localizer["Total"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-envelope-arrow-down"></i></div><div><div class="kpi-value">@Model.TotalIncoming</div><div class="kpi-label">@Localizer["Incoming"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-blue"><i class="bi bi-envelope-arrow-up"></i></div><div><div class="kpi-value">@Model.TotalOutgoing</div><div class="kpi-label">@Localizer["Outgoing"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-envelope"></i></div><div><div class="kpi-value">@Model.TotalInternal</div><div class="kpi-label">@Localizer["Internal"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-red"><i class="bi bi-exclamation-triangle"></i></div><div><div class="kpi-value">@Model.OverdueReferrals</div><div class="kpi-label">Overdue Referrals</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-stopwatch"></i></div><div><div class="kpi-value">@(Model.AvgReferralCompletionDays.HasValue ? Model.AvgReferralCompletionDays.Value.ToString("0.0") + "d" : "-")</div><div class="kpi-label">Avg. Referral Time</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Correspondence Volume (last 12 months)</h6>
            <partial name="_BkChart" model="@volumeChart" />
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Status"]</h6>
            <partial name="_BkChart" model="@statusChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Discipline"]</h6>
            <partial name="_BkChart" model="@disciplineChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Tags</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var t in Model.TopTags)
                {
                    <li class="d-flex justify-content-between border-bottom py-1">
                        <span class="badge bg-@t.Color">@t.TagName</span>
                        <span class="text-muted small">@t.Count</span>
                    </li>
                }
            </ul>
            @if (!Model.TopTags.Any()) { <p class="text-muted small">No tags used yet.</p> }
        </div>
    </div>
</div>

<div class="content-card">
    <h6 class="mb-3">Top Senders</h6>
    <div class="table-responsive table-scroll-area" style="max-height:65vh; overflow-y:auto;">
    <table class="table table-enterprise">
        <thead><tr><th>Sender</th><th>@Localizer["Count"]</th></tr></thead>
        <tbody>
            @foreach (var s in Model.TopSenders)
            {
                <tr><td>@s.Sender</td><td>@s.Count</td></tr>
            }
        </tbody>
    </table>
    </div>
    @if (!Model.TopSenders.Any()) { <p class="text-muted text-center py-3">@Localizer["No data."]</p> }
</div>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
