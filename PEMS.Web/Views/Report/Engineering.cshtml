@model PEMS.Application.DTOs.EngineeringReportDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    var projects = (IEnumerable<dynamic>)ViewBag.Projects;
    var disciplines = (IEnumerable<dynamic>)ViewBag.Disciplines;
    var noData = Localizer["Chart_NoData"].Value;
    var volumeChart = BkChartSpec.MonthlyBars("Document volume by month", noData, Model.VolumeByMonth.Select(x => x.Month),
        BkSeries.Of("Created", Model.VolumeByMonth.Select(x => x.Created), BkChartSpec.Primary),
        BkSeries.Of("Issued", Model.VolumeByMonth.Select(x => x.Issued), BkChartSpec.Positive));
    var statusChart = BkChartSpec.Donut("Documents by status", noData, Localizer["Total"].Value, Model.ByStatus.Select(x => (x.Status, (double)x.Count)));
    var disciplineChartRows = BkChartSpec.TopWithOthers(Model.ByDiscipline.Select(x => (x.Discipline, x.Count)), 10, Localizer["Chart_Other"].Value);
    var disciplineChart = BkChartSpec.HBars("Documents by discipline", noData, disciplineChartRows.Select(x => x.Label), false,
        new BkSeries("Documents", disciplineChartRows.Select(x => x.Value).ToList(), BkChartSpec.Accent));
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-envelope-paper"></i> @Localizer["Correspondence"]</a>
    <a asp-action="Engineering" class="btn btn-sm btn-pems-solid"><i class="bi bi-file-earmark-text"></i> @Localizer["Engineering Documents"]</a>
    <a asp-action="Vdr" class="btn btn-sm btn-outline-secondary"><i class="bi bi-journal-check"></i> @Localizer["VDR"]</a>
    <a asp-action="Procurement" class="btn btn-sm btn-outline-secondary"><i class="bi bi-cart-check"></i> @Localizer["Procurement"]</a>
    <a asp-action="Cmms" class="btn btn-sm btn-outline-secondary"><i class="bi bi-tools"></i> CMMS</a>
    <a asp-action="Operations" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard-data"></i> @Localizer["Operations"]</a>
</div>

<div class="content-card mb-3">
    <form method="get" class="row g-2">
        <div class="col-md-3">
            <select name="projectId" class="form-select form-select-sm">
                <option value="">@Localizer["All Projects"]</option>
                @foreach (var p in projects) { <option value="@p.ProjectId" selected="@(p.ProjectId == (int?)ViewBag.SelectedProjectId)">@p.ProjectName</option> }
            </select>
        </div>
        <div class="col-md-3">
            <select name="disciplineId" class="form-select form-select-sm">
                <option value="">@Localizer["All Disciplines"]</option>
                @foreach (var d in disciplines) { <option value="@d.DisciplineId" selected="@(d.DisciplineId == (int?)ViewBag.SelectedDisciplineId)">@d.Name</option> }
            </select>
        </div>
        <div class="col-md-2"><input name="fromDate" type="date" value="@(((DateTime?)ViewBag.FromDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><input name="toDate" type="date" value="@(((DateTime?)ViewBag.ToDate)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></div>
        <div class="col-md-2"><button class="btn btn-sm btn-pems-solid w-100"><i class="bi bi-funnel"></i> @Localizer["Apply"]</button></div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-slate"><i class="bi bi-file-earmark-text"></i></div><div><div class="kpi-value">@Model.TotalDocuments</div><div class="kpi-label">@Localizer["Total"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-green"><i class="bi bi-check-circle"></i></div><div><div class="kpi-value">@Model.ApprovedCount</div><div class="kpi-label">Approved/Issued</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-amber"><i class="bi bi-hourglass-split"></i></div><div><div class="kpi-value">@Model.PendingCount</div><div class="kpi-label">@Localizer["Pending"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-red"><i class="bi bi-x-circle"></i></div><div><div class="kpi-value">@Model.RejectedCount</div><div class="kpi-label">@Localizer["Rejected"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-purple"><i class="bi bi-exclamation-triangle"></i></div><div><div class="kpi-value">@Model.OverdueCount</div><div class="kpi-label">@Localizer["Overdue"]</div></div></div></div>
    <div class="col-md-2 col-sm-6"><div class="kpi-card"><div class="kpi-icon bg-icon-teal"><i class="bi bi-stopwatch"></i></div><div><div class="kpi-value">@(Model.AvgDaysToApprove.HasValue ? Model.AvgDaysToApprove.Value.ToString("0.0") + "d" : "-")</div><div class="kpi-label">Avg. Approval Time</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="content-card mb-3">
            <h6 class="mb-3">Document Volume (last 12 months)</h6>
            <partial name="_BkChart" model="@volumeChart" />
        </div>
    </div>
    <div class="col-lg-4">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Status"]</h6>
            <partial name="_BkChart" model="@statusChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">@Localizer["By Discipline"]</h6>
            <partial name="_BkChart" model="@disciplineChart" />
        </div>
    </div>
    <div class="col-lg-6">
        <div class="content-card mb-3">
            <h6 class="mb-3">Top Projects</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var p in Model.ByProject)
                {
                    <li class="d-flex justify-content-between border-bottom py-1"><span>@p.ProjectName</span><span class="text-muted small">@p.Count</span></li>
                }
            </ul>
            @if (!Model.ByProject.Any()) { <p class="text-muted small">@Localizer["No data."]</p> }
        </div>
    </div>
</div>

@section Styles {
    <partial name="_BkChartStyles" />
}

@section Scripts {
    <partial name="_BkChartScripts" />
}
