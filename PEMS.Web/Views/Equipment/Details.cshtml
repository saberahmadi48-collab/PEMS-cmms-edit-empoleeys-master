                        <pems-row gap="2" css="mb-2">
                            <pems-col span="6"><pems-label css="small">@Localizer["Lower Limit"]</pems-label>
                                <pems-input scale="small" name="lowerLimit" type="number" step="0.01" /></pems-col>
                            <pems-col span="6"><pems-label css="small">@Localizer["Upper Limit"]</pems-label>
                                <pems-input scale="small" name="upperLimit" type="number" step="0.01" /></pems-col>
                        </pems-row>
                        <pems-form-group css="mb-2"><pems-label css="small">@Localizer["Next Inspection Date"]</pems-label>
                            <pems-date name="nextInspectionDate" scale="small" /></pems-form-group>
                        <pems-form-group css="mb-2"><pems-label css="small">@Localizer["Recommendation"]</pems-label>
                            <pems-textarea scale="small" name="recommendation" rows="2"></pems-textarea></pems-form-group>
                        <pems-form-group css="mb-2"><pems-label css="small">@Localizer["Description"]</pems-label>
                            <pems-textarea scale="small" name="description" rows="2"></pems-textarea></pems-form-group>
                    </pems-modal-body>
                    <pems-modal-footer>
                        <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["Cancel"]</pems-button>
                        <pems-button tone="primary" size="small" type="submit">@Localizer["Save"]</pems-button>
                    </pems-modal-footer>
                </pems-form>
            </pems-modal>
    </pems-tab-pane>

    @* ===================== Quality & Change ===================== *@
    <pems-tab-pane fade="true" id="tab-quality" role="tabpanel">
        <pems-row gap="3">
            <pems-col md="4">
                <pems-content-card css="h-100">
                    <pems-heading level="6" class="mb-3"><pems-icon name="bi-exclamation-triangle" /> NCR <pems-badge tone="neutral">@Model.NonConformanceReports.Count</pems-badge></pems-heading>
                    <pems-bullet-list class="list-unstyled mb-0">
                        @foreach (var n in Model.NonConformanceReports)
                        {
                            <pems-flex as="li" justify="between" css="border-bottom py-1">
                                <pems-link asp-controller="QC" asp-action="NcrDetails" asp-route-id="@n.NodeId">@n.Label</pems-link>
                                <pems-badge tone="@(n.Priority == "Urgent" ? "danger" : "neutral")">@n.SubLabel</pems-badge>
                            </pems-flex>
                        }
                    </pems-bullet-list>
                    @if (!Model.NonConformanceReports.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</pems-text> }
                </pems-content-card>
            </pems-col>
            <pems-col md="4">
                <pems-content-card css="h-100">
                    <pems-heading level="6" class="mb-3"><pems-icon name="bi-arrow-repeat" /> MOC <pems-badge tone="neutral">@Model.MOCs.Count</pems-badge></pems-heading>
                    <pems-bullet-list class="list-unstyled mb-0">
                        @foreach (var m in Model.MOCs)
                        {
                            <pems-flex as="li" justify="between" css="border-bottom py-1">
                                <pems-link href="/p/moc-details?id=@m.NodeId">@m.Label</pems-link>
                                <pems-badge tone="@(m.Priority == "Urgent" ? "danger" : "neutral")">@m.SubLabel</pems-badge>
                            </pems-flex>
                        }
                    </pems-bullet-list>
                    @if (!Model.MOCs.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</pems-text> }
                </pems-content-card>
            </pems-col>
            <pems-col md="4">
                <pems-content-card css="h-100">
                    <pems-heading level="6" class="mb-3"><pems-icon name="bi-question-circle" /> TQ / TSR / RFI <pems-badge tone="neutral">@Model.TechnicalQueries.Count</pems-badge></pems-heading>
                    <pems-bullet-list class="list-unstyled mb-0">
                        @foreach (var t in Model.TechnicalQueries)
                        {
                            <pems-flex as="li" justify="between" css="border-bottom py-1">
                                <pems-link href="/p/technical-query-details?id=@t.NodeId">@t.Label</pems-link>
                                <pems-badge tone="@(t.Priority == "Urgent" ? "danger" : "neutral")">@t.SubLabel</pems-badge>
                            </pems-flex>
                        }
                    </pems-bullet-list>
                    @if (!Model.TechnicalQueries.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneRecorded"]</pems-text> }
                </pems-content-card>
            </pems-col>
        </pems-row>
    </pems-tab-pane>

    @* ===================== Classification & Maintenance Intelligence ===================== *@
    <pems-tab-pane fade="true" id="tab-classification" role="tabpanel">
        @{
            var intel = ViewBag.MaintenanceIntelligence as PEMS.Application.DTOs.EquipmentMaintenanceIntelligenceDto;
            var explanation = ViewBag.ClassificationExplanation as PEMS.Application.DTOs.ClassificationExplanationDto;
        }
        <pems-content-card css="mb-3">
            <pems-heading level="6" class="mb-3"><pems-icon name="bi-diagram-3-fill" /> @Localizer["Cm_SecClassification"]</pems-heading>
            @if (intel?.EquipmentClassId != null)
            {
                <pems-row gap="2" css="small">
                    <pems-col md="3"><strong>@Localizer["Equipment Class"]</strong><div>@intel.EquipmentClassName <code>@intel.EquipmentClassCode</code></div></pems-col>
                    <pems-col md="3"><strong>Class Hierarchy</strong><div>@string.Join(" ← ", intel.ResolvedClassHierarchy)</div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Confidence"]</strong><div><pems-badge tone="info">@intel.ClassificationConfidence</pems-badge></div></pems-col>
                    <pems-col md="3"><strong>@Localizer["Source"]</strong><div><pems-badge tone="neutral">@intel.ClassificationSource</pems-badge></div></pems-col>
                </pems-row>
                @if (explanation?.MatchedRuleTier != null)
                {
                    <pems-alert tone="light" css="border small mt-3 mb-0">
                        <strong>@Localizer["چرا این طبقه‌بندی؟"]</strong>
                        Rule tier: <pems-badge tone="light">@explanation.MatchedRuleTier</pems-badge> &middot;
                        Matched on: <code>@explanation.MatchedInput</code> &middot;
                        @explanation.Reason
                    </pems-alert>
                }
            }
            else
            {
                <pems-text class="text-muted small mb-0">این تجهیز هنوز طبقه‌بندی نشده (EquipmentType: <code>@eq.EquipmentType</code>).</pems-text>
            }

            @if (pendingSuggestion != null)
            {
                <pems-alert tone="warning" css="small mt-3 mb-0">
                    <strong>پیشنهاد در انتظار بازبینی:</strong> @pendingSuggestion.SuggestedEquipmentClassName
                    (<pems-badge tone="warning">@pendingSuggestion.Confidence</pems-badge>) &mdash; @pendingSuggestion.Reason
                    <pems-link asp-controller="EquipmentClassification" asp-action="ReviewQueue" class="ms-2">بازبینی در صف →</pems-link>
                </pems-alert>
            }
        </pems-content-card>

        @if (intel?.EquipmentClassId != null)
        {
            <pems-row gap="3">
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <pems-heading level="6" class="mb-3">@Localizer["Cm_ApplicableActivities"] <pems-badge tone="neutral">@intel.ApplicableActivities.Count</pems-badge></pems-heading>
                        <pems-bullet-list class="list-unstyled mb-0 small">
                            @foreach (var a in intel.ApplicableActivities)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@a.Name</span>
                                    <span class="text-muted">@a.Source</span>
                                </pems-flex>
                            }
                        </pems-bullet-list>
                        @if (!intel.ApplicableActivities.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</pems-text> }
                    </pems-content-card>
                </pems-col>
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <pems-heading level="6" class="mb-3">@Localizer["Cm_PmTemplates"] <pems-badge tone="neutral">@intel.CandidatePMTemplates.Count</pems-badge></pems-heading>
                        <pems-bullet-list class="list-unstyled mb-0 small">
                            @foreach (var t in intel.CandidatePMTemplates)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@t.Name (@t.TriggerType@(t.IntervalDays.HasValue ? $" / {t.IntervalDays}d" : ""))</span>
                                    <span class="text-muted">@t.Source</span>
                                </pems-flex>
                            }
                        </pems-bullet-list>
                        @if (!intel.CandidatePMTemplates.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</pems-text> }
                    </pems-content-card>
                </pems-col>
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <pems-heading level="6" class="mb-3">@Localizer["Cm_FailureModes"] <pems-badge tone="neutral">@intel.ApplicableFailureModes.Count</pems-badge></pems-heading>
                        <pems-bullet-list class="list-unstyled mb-0 small">
                            @foreach (var fm in intel.ApplicableFailureModes)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@fm.Name</span>
                                    <span class="text-muted">@fm.Source</span>
                                </pems-flex>
                            }
                        </pems-bullet-list>
                        @if (!intel.ApplicableFailureModes.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</pems-text> }
                    </pems-content-card>
                </pems-col>
                <pems-col md="6">
                    <pems-content-card css="h-100">
                        <pems-heading level="6" class="mb-3">@Localizer["Cm_StdRefs"] <pems-badge tone="neutral">@intel.ApplicableStandardReferences.Count</pems-badge></pems-heading>
                        <pems-bullet-list class="list-unstyled mb-0 small">
                            @foreach (var s in intel.ApplicableStandardReferences)
                            {
                                <pems-flex as="li" justify="between" css="border-bottom py-1">
                                    <span>@s.Name</span>
                                    <code>@s.Code</code>
                                </pems-flex>
                            }
                        </pems-bullet-list>
                        @if (!intel.ApplicableStandardReferences.Any()) { <pems-text class="text-muted small mb-0">@Localizer["Cm_NoneDefined"]</pems-text> }
                    </pems-content-card>
                </pems-col>
            </pems-row>
        }
    </pems-tab-pane>

    @* ===================== Barcode ===================== *@
    <pems-tab-pane fade="true" id="tab-barcode" role="tabpanel">
        <partial name="_BarcodePanel" model="(PEMS.Web.Models.BarcodePanelViewModel)ViewBag.BarcodePanel" />
    </pems-tab-pane>

</pems-tab-content>

</pems-page-shell> @* end .vs-page *@

@section Scripts {
    <script src="~/js/views/equipment-details.js" asp-append-version="true"></script>
}
