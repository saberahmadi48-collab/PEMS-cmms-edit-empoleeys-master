@model List<PEMS.Application.DTOs.FunctionalLocationImportBatchDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer

<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="FunctionalLocation" asp-action="Index">← Functional Locations</pems-button>
</pems-flex>

<pems-content-card css="mb-3">
    <pems-text class="text-muted small">
        Upload an Excel file with <strong>AREA NAME</strong> / <strong>AREA CODE</strong> columns.
        A cell with multiple comma-separated codes (e.g. "85A07, 85A08, 85A10, 85A12") is
        automatically expanded into separate Functional Location records, grouped under an
        Area-level parent node. Nothing is written to the live Functional Locations table until
        you review the parsed rows and click Commit.
    </pems-text>
    <pems-form asp-action="Upload" method="post" enctype="multipart/form-data"><pems-row gap="2" css="align-items-end">
        <pems-col md="8">
            <pems-label css="small">Functional Location Excel File</pems-label>
            <pems-uploader name="file" accept=".xlsx" required />
        </pems-col>
        <pems-col md="4">
            <pems-button tone="primary" css="w-100" type="submit"><pems-icon name="bi-cloud-upload" /> @Localizer["Upload"]</pems-button>
        </pems-col>
    </pems-row></pems-form>
</pems-content-card>

<pems-content-card>
    <pems-heading level="6" class="mb-3">@Localizer["Recent Import Batches"]</pems-heading>
    <pems-table-scroll css="table-scroll-area pems-s-8da1c6e6">
    <pems-data-table data="@(DataRows.Of(Model, c_ => c_.Add(((Localizer["File"])?.ToString() ?? ""), b => (object?)(b.FileName)).Add(((Localizer["Date"])?.ToString() ?? ""), b => (object?)((PemsDates.DateTime(b.ImportDate)))).Add(((Localizer["Imported By"])?.ToString() ?? ""), b => (object?)(b.ImportedByName), css: "small").Add("Source Rows", b => (object?)(b.SourceRowCount), css: "text-end", headerCss: "text-end").Add("Expanded", b => (object?)(b.ExpandedLocationCount), css: "text-end", headerCss: "text-end").Add(((Localizer["New"])?.ToString() ?? ""), b => (object?)(DataCell.Badge("success", b.NewCount)), css: "text-end", headerCss: "text-end").Add("Existing", b => (object?)(DataCell.Badge("neutral", b.ExistingCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Conflicts"])?.ToString() ?? ""), b => (object?)((b.ConflictCount > 0 ? (object?)DataCell.Badge("warning", b.ConflictCount) : b.ConflictCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Invalid"])?.ToString() ?? ""), b => (object?)((b.InvalidCount > 0 ? (object?)DataCell.Badge("danger", b.InvalidCount) : b.InvalidCount)), css: "text-end", headerCss: "text-end").Add(((Localizer["Status"])?.ToString() ?? ""), b => (object?)(DataCell.Badge(b.Status == "Committed" ? "success" : "neutral", b.Status))).Add("", b => (object?)(DataCell.ButtonLink(Url.Action("Review", null, new { batchId = b.FunctionalLocationImportBatchId }), "primary", "small", true, null, "Review")))))" />
    </pems-table-scroll>
    @if (!Model.Any()) { <pems-text class="text-muted text-center py-4">No Functional Location imports yet.</pems-text> }
</pems-content-card>
