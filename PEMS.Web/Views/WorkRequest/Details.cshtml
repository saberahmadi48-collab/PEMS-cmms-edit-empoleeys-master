@model PEMS.Application.DTOs.WorkRequestDetailDto
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Models
@using PEMS.WorkflowPlatform.Interfaces
@inject IStringLocalizer<SharedResource> Localizer
@using PEMS.Web.Helpers
@{
    var nextStatus = (string?)ViewBag.NextStatus;
    var canCreate = (bool?)ViewBag.CanCreate ?? false;
    var employeeNames = (Dictionary<int, string>?)ViewBag.EmployeeNames ?? new Dictionary<int, string>();

    var wf = Model.Workflow;
    var fa = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

    // نمایش‌نام‌ها فقط از داده‌ی پیکربندی گردش‌کار (Stage.Name/NameFa، Transition.Label/LabelFa) می‌آید.
    string StageName(WorkflowStageView s) => fa && !string.IsNullOrWhiteSpace(s.NameFa) ? s.NameFa! : s.Name;
    string ActionLabel(WorkflowAvailableAction a) => (fa && !string.IsNullOrWhiteSpace(a.LabelFa)) ? a.LabelFa! : (!string.IsNullOrWhiteSpace(a.Label) ? a.Label! : a.ActionType);
    string Who(int? id) => id.HasValue && employeeNames.TryGetValue(id.Value, out var n) ? n : (id.HasValue ? "#" + id.Value : "-");
    // نام مرحله/اکشن در جدول تاریخچه و هدف دکمه‌ها هم‌زبان با UI (از داده‌ی پیکربندی، نه ثابت‌نویسی)
    string StageByName(string? n) => string.IsNullOrEmpty(n) ? "-" : (fa ? (wf?.Stages.FirstOrDefault(x => x.Name == n)?.NameFa ?? n) : n);
    string ActionText(string a) { var t = Localizer[a]; return t.ResourceNotFound ? a : t.Value; }
    // شرکت‌کننده‌ی مبتنی بر مجوز: صریحاً «مجوز» نمایش داده می‌شود، نه نام شخص/تیم
    string Participant(WorkflowParticipantView p) => (p.Role ?? "").Contains("Permission:")
        ? Localizer["Permission"] + ": ⁦" + (p.Role ?? "").Replace("Permission:", "").Replace(",", " / ") + "⁩"
        : (p.Role ?? "");

    var badgeClass = Model.Status switch
    {
        "Converted" => "success",
        "Rejected" or "Cancelled" => "neutral",
        "Approved" or "Planned" => "info",
        _ => "primary"
    };

    // تایم‌لاین: هر مرحله‌ی برگشتی از Runtime رندر می‌شود؛ هیچ نام مرحله‌ای در این View ثابت نیست.
    var diagram = new StageDiagramViewModel();
    if (wf != null)
    {
        foreach (var s in wf.Stages.OrderBy(x => x.Order))
        {
            diagram.Stages.Add(new StageDiagramItem
            {
                Label = StageName(s),
                IconCssClass = "bi-circle",
                RoleLabel = s.Status == "Current" ? string.Join(", ", s.Participants.Where(p => p.Status == "Pending").Select(Participant).Distinct()) : null,
                State = s.Status switch
                {
                    "Current" => StageItemState.Current,
                    "Completed" or "Skipped" => StageItemState.Done,
                    "Rejected" or "Cancelled" => StageItemState.Rejected,   // «Cancelled»: مرحله‌ای که درخواست در آن متوقف شد
                    _ => StageItemState.Pending
                }
            });
        }
    }
    var actions = wf?.AvailableActions.Where(a => a.ActionType != "Complete").ToList() ?? new List<WorkflowAvailableAction>();
}

<pems-content-card css="mb-3">
    <pems-flex align="center" gap="3" wrap="true" css="mb-2">
        <div class="kpi-icon bg-icon-blue pems-s-792bd2d6"><pems-icon name="bi-clipboard-plus" /></div>
        <div>
            <pems-heading level="5" class="mb-0">@Model.RequestNumber &mdash; @Model.Title <pems-badge tone="@badgeClass">@VdrUi.Loc(Localizer, "Wr_St_", Model.Status)</pems-badge></pems-heading>
            <span class="text-muted small">@Localizer["Requested By"] @Model.RequestedByName @Localizer["on"] <bdi dir="ltr">@PemsDates.Date(Model.RequestedDate)</bdi></span>
        </div>
    </pems-flex>
    @if (Model.IsEmergency || Model.IsHseRelated || Model.RiskScore.HasValue)
    {
        <pems-flex wrap="true" gap="1" css="small mt-2">
            @if (Model.IsEmergency) { <pems-badge tone="danger">@Localizer["Emergency"]</pems-badge> }
            @if (Model.IsHseRelated) { <pems-badge tone="warning">HSE</pems-badge> }
            @if (Model.RiskScore.HasValue) { <pems-badge tone="light">@Localizer["Risk"]: @Model.RiskLikelihood×@Model.RiskSeverity = @Model.RiskScore (@Model.RiskLevel)</pems-badge> }
        </pems-flex>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PriorityRationale)) { <div class="small text-muted mt-1"><pems-icon name="bi-calculator" aria-hidden="true" /> @Model.PriorityRationale</div> }
    <pems-info-grid class="mt-2">
        <pems-info-item label="@Localizer["Equipment"]" num>@Model.EquipmentTagNumber</pems-info-item>
        <pems-info-item label="@Localizer["Info_Asset"]" num>@Model.AssetNumber</pems-info-item>
        <pems-info-item label="@Localizer["Functional Location"]">@Model.FunctionalLocationBreadcrumb</pems-info-item>
        <pems-info-item label="@Localizer["Priority"]">
            @VdrUi.Loc(Localizer, "Pri_", Model.Priority)
            @if (!string.IsNullOrWhiteSpace(Model.EquipmentCriticalityClass))
            {
                <pems-badge tone="light" title="Equipment Criticality (context only, not auto-applied)">Crit: @Model.EquipmentCriticalityClass</pems-badge>
            }
        </pems-info-item>
        @if (Model.ResponseDueDate.HasValue) { <pems-info-item label="@Localizer["Info_ResponseDue"]" num>@PemsDates.DateTime(Model.ResponseDueDate.Value)</pems-info-item> }
        @if (Model.ResolutionDueDate.HasValue) { <pems-info-item label="@Localizer["Info_ResolutionDue"]" num>@PemsDates.DateTime(Model.ResolutionDueDate.Value)</pems-info-item> }
        @if (!string.IsNullOrWhiteSpace(Model.FailureModeName) || !string.IsNullOrWhiteSpace(Model.FailureEffect) || Model.ReportedDowntimeHours.HasValue)
        {
            <pems-info-item label="@Localizer["Failure Mode"]">@Model.FailureModeName</pems-info-item>
            <pems-info-item label="@Localizer["Failure Effect"]">@Model.FailureEffect</pems-info-item>
            <pems-info-item label="@Localizer["Downtime Hours"]" num>@Model.ReportedDowntimeHours?.ToString("0.##")</pems-info-item>
        }
        <pems-info-item label="@Localizer["Info_ReportedCondition"]">@Model.ReportedCondition</pems-info-item>
        <pems-info-item label="@Localizer["Info_SuggestedDiscipline"]">@Model.SuggestedDisciplineName</pems-info-item>
        <pems-info-item label="@Localizer["Description"]" wide>@Model.Description</pems-info-item>
    </pems-info-grid>

    @if (Model.Status == "Rejected")
    {
        <pems-alert tone="danger" css="py-2 px-3 small mt-2 mb-0"><strong>@Localizer["Rejection Reason:"]</strong> @Model.RejectionReason</pems-alert>
    }
    @if (Model.LinkedWorkOrderId.HasValue)
    {
        <pems-alert tone="success" css="py-2 px-3 small mt-2 mb-0">
            @Localizer["Converted to"] <pems-link asp-controller="WorkOrder" asp-action="Details" asp-route-id="@Model.LinkedWorkOrderId">@Model.LinkedWorkOrderNumber</pems-link>
        </pems-alert>
    }
</pems-content-card>

@if (wf != null)
{
    <pems-content-card css="mb-3">
        <pems-flex justify="between" align="center" wrap="true" gap="2">
            <pems-heading level="6" class="mb-0">@Localizer["Workflow"] <span class="text-muted small">@wf.WorkflowName · @Localizer["Version"] @wf.VersionNumber · @Localizer[wf.Status]</span></pems-heading>
            @foreach (var w in wf.Warnings)
            {
                <span class="small text-warning"><pems-icon name="bi-exclamation-triangle" /> @w</span>
            }
        </pems-flex>
        <pems-stage-diagram steps="@diagram.Steps" />
    </pems-content-card>
}

<pems-content-card css="mb-3">
    <pems-heading level="6" class="mb-3">@Localizer["Actions"]</pems-heading>
    <pems-flex wrap="true" gap="2" align="center">
        @if (wf != null)
        {
            @* اکشن‌های گردش‌کار: کاملاً از مدل خواندنی مرکزی. مجوز واقعی سمت‌سرور اعمال می‌شود؛ دکمه‌ی غیرمجاز فقط برای نمایش است. *@
            @if (actions.Count > 0)
            {
                <pems-workflow-action-bar options="@(new PEMS.UI.Components.WorkflowActionBarOptions
                {
                    Action = "/a/work-request-workflow-action",
                    Fields = new Dictionary<string, string> { ["id"] = Model.WorkRequestId.ToString() },
                    Actions = WorkflowComponents.Actions(actions, fa, Localizer["Are you sure?"].Value, StageByName),
                    CommentLabel = PEMS.UI.Abstractions.TranslatableText.Of(("en", Localizer["Comment"].Value), ("fa", Localizer["Comment"].Value)),
                    CommentHint = PEMS.UI.Abstractions.TranslatableText.Literal(Localizer["Comment (required for Reject / Cancel / Hold / Return)"].Value),
                    None = PEMS.UI.Abstractions.TranslatableText.Literal(Localizer["No further actions available."].Value)
                })" />
            }
            @* اکشن کسب‌وکاری Work Request (نه اکشن عمومی): تبدیل به WorkOrder؛ قواعد خودش را در سرویس Work Request دارد *@
            @if (Model.CanConvert)
            {
                <pems-form action="/a/work-request-convert" method="post"><pems-flex gap="2" align="center">
                    <input type="hidden" name="id" value="@Model.WorkRequestId" />
                    @if (!Model.EquipmentId.HasValue)
                    {
                        <pems-input class="pems-w-240" scale="small" type="text" placeholder="@Localizer["Select the equipment for the Work Order"]" data-pems-search data-search-type="Equipment" data-search-hidden="#wrConvertEquipmentId" autocomplete="off" required />
                        <input type="hidden" name="equipmentId" id="wrConvertEquipmentId" />
                    }
                    <pems-select class="w-auto" scale="small" name="workOrderType">
                        <option value="Corrective">@Localizer["Corrective"]</option>
                        <option value="Preventive">@Localizer["Preventive"]</option>
                        <option value="Emergency">@Localizer["Emergency"]</option>
                        <option value="Predictive">@Localizer["Predictive"]</option>
                    </pems-select>
                    <pems-button tone="success" size="small" type="submit" data-pems-confirm="@Localizer["A real WorkOrder will be created. Continue?"]">
                        <pems-icon name="bi-arrow-right-circle" /> @Localizer["Convert to Work Order"]
                    </pems-button>
                </pems-flex></pems-form>
            }
            @if (actions.Count == 0 && !Model.CanConvert)
            {
                <span class="text-muted small">@Localizer["No further actions available."]</span>
            }
        }
        else if (Model.Status == "Draft")
        {
            @* پیش‌نویس هنوز وارد گردش‌کار نشده؛ «ارسال» همان نقطه‌ی شروع Instance است *@
            @if (canCreate)
            {
                <pems-form action="/a/work-request-submit" method="post">
                    <input type="hidden" name="id" value="@Model.WorkRequestId" />
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Submit to Workflow"]</pems-button>
                </pems-form>
                <pems-form action="/a/work-request-cancel" method="post"><pems-flex gap="2">
                    <input type="hidden" name="id" value="@Model.WorkRequestId" />
                    <pems-input class="pems-w-220" scale="small" type="text" name="reason" required placeholder="@Localizer["Reason (required)"]" />
                    <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="@Localizer["Are you sure?"]">@Localizer["Cancel Request"]</pems-button>
                </pems-flex></pems-form>
            }
        }
        else if (Model.IsLegacyWithoutWorkflow)
        {
            @* رکورد Legacy قبل از مهاجرت (بدون Instance): مسیر قدیمی تا تخلیه‌ی طبیعی این رکوردها باقی می‌ماند *@
            <pems-badge tone="light">@Localizer["Legacy record - no workflow instance"]</pems-badge>
            @if (nextStatus != null)
            {
                <pems-form action="/a/work-request-advance" method="post"><pems-flex gap="2">
                    <input type="hidden" name="id" value="@Model.WorkRequestId" />
                    <pems-button tone="primary" size="small" type="submit">@Localizer["Advance to"] @nextStatus</pems-button>
                </pems-flex></pems-form>
            }
            @if (Model.Status == "Planned")
            {
                <pems-form action="/a/work-request-convert" method="post"><pems-flex gap="2" align="center">
                    <input type="hidden" name="id" value="@Model.WorkRequestId" />
                    <pems-select class="w-auto" scale="small" name="workOrderType">
                        <option value="Corrective">@Localizer["Corrective"]</option>
                        <option value="Preventive">@Localizer["Preventive"]</option>
                        <option value="Emergency">@Localizer["Emergency"]</option>
                        <option value="Predictive">@Localizer["Predictive"]</option>
                    </pems-select>
                    <pems-button tone="success" size="small" type="submit" data-pems-confirm="@Localizer["A real WorkOrder will be created. Continue?"]">
                        <pems-icon name="bi-arrow-right-circle" /> @Localizer["Convert to Work Order"]
                    </pems-button>
                </pems-flex></pems-form>
            }
            @if (Model.Status is "UnderReview" or "Approved")
            {
                <pems-form action="/a/work-request-reject" method="post"><pems-flex gap="2">
                    <input type="hidden" name="id" value="@Model.WorkRequestId" />
                    <pems-input class="pems-w-220" scale="small" type="text" name="reason" required placeholder="@Localizer["Rejection reason (required)"]" />
                    <pems-button tone="danger" size="small" outline="true" type="submit">@Localizer["Reject"]</pems-button>
                </pems-flex></pems-form>
            }
            <pems-form action="/a/work-request-cancel" method="post"><pems-flex gap="2">
                <input type="hidden" name="id" value="@Model.WorkRequestId" />
                <pems-input class="pems-w-220" scale="small" type="text" name="reason" required placeholder="@Localizer["Reason (required)"]" />
                <pems-button tone="neutral" size="small" outline="true" type="submit" data-pems-confirm="@Localizer["Are you sure?"]">@Localizer["Cancel Request"]</pems-button>
            </pems-flex></pems-form>
        }
        else
        {
            <span class="text-muted small">@Localizer["No further actions available."]</span>
        }
    </pems-flex>
</pems-content-card>

@if (wf != null)
{
    <pems-content-card css="mb-3">
        <pems-heading level="6" class="mb-3">@Localizer["Workflow History"]</pems-heading>
        @{
            var history = wf.HistorySummary.OrderByDescending(x => x.ActionDate).ToList();
            var historyColumns = DataColumns.For(history)
                .Add(Localizer["Date"].Value, h => h.ActionDate, DataCellKind.DateTime, "small")
                .Add(Localizer["Action"].Value, h => ActionText(h.ActionType), css: "small")
                .Add(Localizer["From"].Value, h => StageByName(h.FromStageName), css: "small")
                .Add(Localizer["To"].Value, h => StageByName(h.ToStageName), css: "small")
                .Add(Localizer["By"].Value, h => Who(h.UserId), css: "small")
                .Add(Localizer["Reason"].Value, h => h.Comment, DataCellKind.Muted, "small");
        }
        <pems-data-table items="@history" columns="@historyColumns" dense="true" css="mb-0" />
    </pems-content-card>
}

<pems-content-card as="details" open="@(wf == null)">
    <summary class="h6 mb-0">@Localizer["Business Audit"]</summary>
    <pems-data-table data="@(DataRows.Of(Model.StatusHistory, c_ => c_.Add(((Localizer["From"])?.ToString() ?? ""), h => (object?)(h.FromStatus), css: "small").Add(((Localizer["To"])?.ToString() ?? ""), h => (object?)(h.ToStatus), css: "small").Add(((Localizer["By"])?.ToString() ?? ""), h => (object?)(h.ChangedByName ?? "-"), css: "small").Add(((Localizer["Date"])?.ToString() ?? ""), h => (object?)(PemsDates.DateTime(h.ChangedDate)), css: "small", element: new CellElement("bdi", null, "ltr")).Add(((Localizer["Reason"])?.ToString() ?? ""), h => (object?)(h.Reason), css: "small text-muted")))" dense="true" css="mb-0 mt-3" />
    @if (!Model.StatusHistory.Any()) { <pems-text class="text-muted text-center py-3 mb-0">@Localizer["هنوز تغییر وضعیتی ثبت نشده."]</pems-text> }
</pems-content-card>
