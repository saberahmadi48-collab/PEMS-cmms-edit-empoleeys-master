@model PEMS.Application.DTOs.PagedResult<PEMS.Application.DTOs.EquipmentCriticalityListDto>
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@using PEMS.Web.Helpers
@inject IStringLocalizer<SharedResource> Localizer
@{
    var selectedClass = (string?)ViewBag.SelectedClass;
    var classes = new[] { "A", "B", "C" };
    var filterCount = string.IsNullOrEmpty(selectedClass) ? 0 : 1;

    var qsParts = new List<string>();
    if (!string.IsNullOrEmpty(selectedClass)) qsParts.Add($"criticalityClass={Uri.EscapeDataString(selectedClass)}");

    string ClassText(string? c) => VdrUi.Loc(Localizer, "Ec_Class_", c);
    string ClassTone(string? c) => c switch { "A" => "vs-pill--danger", "B" => "vs-pill--warning", _ => "vs-pill--neutral" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/PEMS.UI/pems-list.css" asp-append-version="true" />
}

@* SCRUM-337 W2b: built from the PEMS.UI list-page component. The A / B / C / not-assessed counts are KPI chips (the class
   chips filter the list), the class filter that the controller already took is now in the filters dropdown, and
   "New analysis" still opens the assess modal. *@
<pems-list-page texts="@ListPageTexts.From(Localizer)">
    <pems-list-panel>

        <pems-list-toolbar heading="@Localizer["Ec_Title"]" heading-title="@Localizer["Ec_Hint"]" total="@Model.TotalCount">
            <pems-list-tools>
                <pems-list-filters form-id="ecFilterForm" action="@Url.Action("Index")" count="@filterCount" reset-href="@Url.Action("Index")">
                    <pems-list-filter-select id="ecFilterClass" name="criticalityClass" label="@Localizer["Ec_Class"]" value="@selectedClass"
                                             all-text="@Localizer["Rcm_All"]" items="@classes.Select(c => new SelectListItem(ClassText(c), c))" />
                </pems-list-filters>
                <pems-list-kpi-toggle target="ecKpis" storage-key="pems.equipmentCriticality.kpis" />
                <pems-list-reset-columns grid-key="EquipmentCriticality" />
                <pems-list-new modal="assessModal" text="@Localizer["Ec_New"]" />
            </pems-list-tools>
        </pems-list-toolbar>

        <pems-list-kpis id="ecKpis">
            <pems-link class="vs-chip vs-chip--danger" href="@Url.Action("Index", new { criticalityClass = "A" })">@ClassText("A") <strong>@ViewBag.ClassACount</strong></pems-link>
            <pems-link class="vs-chip" href="@Url.Action("Index", new { criticalityClass = "B" })">@ClassText("B") <strong>@ViewBag.ClassBCount</strong></pems-link>
            <pems-link class="vs-chip" href="@Url.Action("Index", new { criticalityClass = "C" })">@ClassText("C") <strong>@ViewBag.ClassCCount</strong></pems-link>
            <span class="vs-chip"><pems-icon name="bi-question-circle" aria-hidden="true" /> @Localizer["Ec_Unassessed"] <strong>@ViewBag.UnassessedCount</strong></span>
        </pems-list-kpis>

        <pems-list-chips reset-href="@Url.Action("Index")">
            @if (!string.IsNullOrEmpty(selectedClass))
            { <pems-list-chip label="@Localizer["Ec_Class"]" value="@ClassText(selectedClass)" remove-href="@Url.Action("Index")" /> }
        </pems-list-chips>

        <pems-list-grid>
            <pems-list-table grid-key="EquipmentCriticality" empty="@(!Model.Items.Any())" empty-text="@Localizer["Ec_Empty"]"
                             filtered="@(filterCount > 0)" clear-href="@Url.Action("Index")">
                <pems-table-head>
                    <pems-table-row>
                        <pems-table-header class="pems-w-140" data-col-key="equipment" data-resizable="true" data-min-width="100" data-max-width="200">@Localizer["Equipment"]</pems-table-header>
                        <pems-table-header class="pems-w-110" data-col-key="class" data-resizable="true" data-min-width="70" data-max-width="160">@Localizer["Ec_Class"]</pems-table-header>
                        <pems-table-header class="pems-w-100" data-col-key="risk" data-resizable="true" data-min-width="80" data-max-width="140">@Localizer["Ec_Risk"]</pems-table-header>
                        <pems-table-header class="pems-w-180" data-col-key="safety" data-resizable="true" data-min-width="120" data-max-width="280">@Localizer["Ec_Safety"]</pems-table-header>
                        <pems-table-header data-col-key="production" data-resizable="true" data-min-width="120" data-max-width="280" class="vs-hide-md pems-w-180">@Localizer["Ec_Production"]</pems-table-header>
                        <pems-table-header data-col-key="environment" data-resizable="true" data-min-width="120" data-max-width="280" class="vs-hide-md pems-w-180">@Localizer["Ec_Environment"]</pems-table-header>
                    </pems-table-row>
                </pems-table-head>
                <pems-table-body>
                    @foreach (var c in Model.Items)
                    {
                        <pems-table-row class="lp-row">
                            <pems-table-cell class="lp-no"><pems-link asp-controller="Equipment" asp-action="Details" asp-route-id="@c.EquipmentId" class="lp-subject"><span class="vs-num">@c.EquipmentTagNumber</span></pems-link></pems-table-cell>
                            <pems-table-cell><span class="vs-pill @ClassTone(c.CriticalityClass)">@ClassText(c.CriticalityClass)</span></pems-table-cell>
                            <pems-table-cell class="small">@VdrUi.Loc(Localizer, "Pri_", c.RiskLevel)</pems-table-cell>
                            <pems-table-cell class="small"><span class="vs-title-cell" title="@c.SafetyImpact">@c.SafetyImpact</span></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-title-cell" title="@c.ProductionImpact">@c.ProductionImpact</span></pems-table-cell>
                            <pems-table-cell class="small vs-hide-md"><span class="vs-title-cell" title="@c.EnvironmentImpact">@c.EnvironmentImpact</span></pems-table-cell>
                        </pems-table-row>
                    }
                </pems-table-body>
            </pems-list-table>

            <pems-list-footer>
                @await Html.PartialAsync("_Pagination", new PEMS.Web.ViewModels.PaginationViewModel
                {
                    Page = Model.Page,
                    TotalPages = Model.TotalPages,
                    TotalCount = Model.TotalCount,
                    PageSize = Model.PageSize,
                    GridKey = "EquipmentCriticality",
                    BaseUrl = Url.Action("Index") ?? "",
                    ExistingQueryString = string.Join("&", qsParts)
                })
            </pems-list-footer>
        </pems-list-grid>
    </pems-list-panel>
</pems-list-page>

<pems-modal id="assessModal" tabindex="-1">
        <pems-form asp-action="Assess" method="post">
            <pems-modal-header>@Localizer["تحلیل بحرانی‌بودن تجهیز"]</pems-modal-header>
            <pems-modal-body>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["تجهیز"]</pems-label>
                    <pems-input scale="small" type="text" placeholder="@Localizer["جستجوی تگ، نام..."]" data-pems-search data-search-type="Equipment" data-search-hidden="#criticalityEquipmentIdHidden" autocomplete="off" required />
                    <input type="hidden" name="equipmentId" id="criticalityEquipmentIdHidden" />
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["کلاس بحرانی‌بودن"]</pems-label>
                    <pems-select scale="small" name="criticalityClass" required>
                        <option value="A">@Localizer["A - بحرانی"]</option>
                        <option value="B">@Localizer["B - مهم"]</option>
                        <option value="C">@Localizer["C - عادی"]</option>
                    </pems-select>
                </pems-form-group>
                <pems-form-group css="mb-2">
                    <pems-label css="small">@Localizer["سطح ریسک"]</pems-label>
                    <pems-select scale="small" name="riskLevel">
                        <option value="Low">@Localizer["Low"]</option>
                        <option value="Medium">@Localizer["Medium"]</option>
                        <option value="High">@Localizer["High"]</option>
                    </pems-select>
                </pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["اثر ایمنی"]</pems-label><pems-input scale="small" name="safetyImpact" /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["اثر تولید"]</pems-label><pems-input scale="small" name="productionImpact" /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["اثر زیست‌محیطی"]</pems-label><pems-input scale="small" name="environmentImpact" /></pems-form-group>
                <pems-form-group css="mb-2"><pems-label css="small">@Localizer["توضیحات"]</pems-label><pems-textarea scale="small" name="description" rows="2"></pems-textarea></pems-form-group>
            </pems-modal-body>
            <pems-modal-footer>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-bs-dismiss="modal">@Localizer["انصراف"]</pems-button>
                <pems-button tone="primary" size="small" type="submit">@Localizer["ثبت"]</pems-button>
            </pems-modal-footer>
        </pems-form>
    </pems-modal>

@section Scripts {
    <script src="~/_content/PEMS.UI/pems-list.js" asp-append-version="true"></script>
}
