@model PEMS.Web.Definitions.ActionSecret
@using System.Globalization
@using PEMS.Web.Definitions
@* SCRUM-816: a value an action shows once (a temporary password): rendered in the answer of the post itself, never redirected, never in TempData, never cached (the host sets no-store). *@
@{
    var culture = CultureInfo.CurrentUICulture;
}

<pems-page-shell kind="admin">
    <pems-page-hero>
        <pems-flex align="center" gap="3"><div><pems-text>@Model.Title.Resolve(culture)</pems-text></div></pems-flex>
    </pems-page-hero>

    <pems-content-card data-pems-secret-reveal>
        @if (Model.Note is { IsEmpty: false } note)
        {
            <pems-alert tone="warning">@note.Resolve(culture)</pems-alert>
        }
        @foreach (var item in Model.Items)
        {
            <pems-flex align="center" gap="2" css="mb-2">
                <span class="small text-body-secondary">@item.Label.Resolve(culture)</span>
                <code dir="ltr" class="fs-5 px-3 py-2 border rounded user-select-all" data-secret-value>@item.Value</code>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-secret-copy data-copied-text="@SecretTexts.Copied.Resolve(culture)"><pems-icon name="bi-clipboard" css="me-1" /> @SecretTexts.Copy.Resolve(culture)</pems-button>
                <pems-button tone="neutral" size="small" outline="true" type="button" data-secret-print><pems-icon name="bi-printer" css="me-1" /> @SecretTexts.Print.Resolve(culture)</pems-button>
            </pems-flex>
        }
        @if (!string.IsNullOrEmpty(Model.BackUrl))
        {
            <pems-flex gap="2" css="mt-3">
                <pems-button as="a" tone="primary" href="@Model.BackUrl">@Model.BackLabel.Resolve(culture)</pems-button>
            </pems-flex>
        }
    </pems-content-card>
</pems-page-shell>

@section Scripts {
    <script src="~/js/pems-secret-reveal.js" asp-append-version="true"></script>
}
