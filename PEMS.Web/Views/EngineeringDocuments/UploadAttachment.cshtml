@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Upload Attachment";
    var revisions = (IEnumerable<dynamic>)(ViewBag.Revisions ?? Array.Empty<dynamic>());
}


<pems-heading level="2">
Upload Document Attachment
</pems-heading>


<pems-form asp-action="UploadAttachment"
      method="post"
      enctype="multipart/form-data">


    <input type="hidden"
           name="documentId"
           value="@ViewBag.DocumentId" />


    <pems-form-group css="mb-3">

        <label>
            Select File
        </label>


        <pems-uploader name="file" />

    </pems-form-group>

    <pems-form-group css="mb-3">
        <pems-label>Revision <span class="text-muted small">(optional — leave blank for a document-level attachment not tied to a specific revision)</span></pems-label>
        <pems-select name="revisionId">
            <option value="">-- Document-level (no specific revision) --</option>
            @foreach (var rev in revisions)
            {
                <option value="@rev.RevisionId">Rev @rev.RevisionNo (@rev.Status)</option>
            }
        </pems-select>
    </pems-form-group>

    <pems-form-group css="mb-3">
        <pems-label>File Role <span class="text-muted small">@Localizer["(optional)"]</span></pems-label>
        <pems-select name="fileRole">
            <option value="">-- Unspecified --</option>
            <option value="Native">Native / Source File</option>
            <option value="PdfRendition">PDF Rendition</option>
            <option value="MarkedUp">Marked-up File</option>
            <option value="ReviewCopy">Review Copy</option>
            <option value="SupportingAttachment">Supporting Attachment</option>
        </pems-select>
        <pems-help-text>If this revision has no official file yet, the first upload for it becomes official automatically.</pems-help-text>
    </pems-form-group>

    <pems-button tone="none" css="btn-primary" type="submit">

        @Localizer["Upload"]

    </pems-button>


</pems-form>
