        var cell_33_6 = DataCell.Template(rows_33, @<text>@{ var c = item; }
                        @{
                            var eab = c.ActionStatus switch
                            {
                                "Closed" => "success",
                                "Verified" => "info",
                                "VendorResponsePending" => "warning",
