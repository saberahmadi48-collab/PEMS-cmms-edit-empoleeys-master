                <input type="hidden" name="id" value="@Model.DocumentId" />
                <div class="modal-header"><h6 class="modal-title">@Localizer["برگرداندن برای اصلاح"]</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">برخلاف رد قطعی، این یعنی سازنده باید اصلاح کند و دوباره Submit کند - نه رد نهایی.</p>
                    <textarea name="comment" class="form-control form-control-sm" rows="3" placeholder="@Localizer["توضیح اصلاحات لازم"]" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                    <button type="submit" class="btn btn-warning btn-sm">@Localizer["برگردان برای اصلاح"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* طبق بخش ۲۱/۳۸ ممیزی UX: قبلاً Freeze/Hold یک فرم همیشه‌مرئی روی صفحه بودند - حالا برای
   انطباق با بقیه‌ی اکشن‌ها به Modal تبدیل شدند (از منوی More باز می‌شوند). Route/Field/بررسی
   مجوز (ViewBag.CanFreeze/CanHold) کاملاً دست‌نخورده ماندند - فقط محل نمایش تغییر کرده. *@
@if (!Model.IsFrozen && (bool)(ViewBag.CanFreeze ?? false))
{
    <div class="modal fade" id="freezeModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Freeze" asp-route-id="@Model.DocumentId" method="post">
                    <div class="modal-header"><h6 class="modal-title"><i class="bi bi-snow"></i> Freeze Document</h6></div>
                    <div class="modal-body">
                        <p class="text-muted small">این مدرک منجمد (Frozen) شود؟ پس از آن دیگر قابل ویرایش یا رویژن جدید نخواهد بود.</p>
                        <label class="form-label small">Freeze reason (required)</label>
                        <input type="text" name="reason" class="form-control form-control-sm" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-outline-dark btn-sm"><i class="bi bi-snow"></i> @Localizer["Freeze"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@if (!Model.IsOnHold && !Model.IsFrozen && Model.Status != "Issued" && (bool)(ViewBag.CanHold ?? false))
{
    <div class="modal fade" id="holdModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Hold" asp-route-id="@Model.DocumentId" method="post">
                    <div class="modal-header"><h6 class="modal-title"><i class="bi bi-pause-circle"></i> Hold Document</h6></div>
                    <div class="modal-body">
                        <p class="text-muted small">این مدرک در وضعیت Hold قرار بگیرد؟ تا رفع Hold، قابل تأیید (Approve) یا صدور (Issue) نخواهد بود.</p>
                        <label class="form-label small">Hold reason (required)</label>
                        <input type="text" name="reason" class="form-control form-control-sm" required />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-outline-dark btn-sm"><i class="bi bi-pause-circle"></i> @Localizer["Hold"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}


@* ==============================================================================
   پاپ‌آپ Issue: انتخاب واحد تحویل. اگر بیرونی (DCC کارفرما/پیمانکار) باشد، نامه‌ی رسمی
   خروجی اجباری می‌شود؛ برای دو حالت داخلی (DCC خودمان یا واحد دیگر)، ثبت نامه اختیاری است.
   ============================================================================== *@
<div class="modal fade" id="issueModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Issue" method="post" id="issueForm">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <div class="modal-header"><h6 class="modal-title"><i class="bi bi-send-check"></i> @Localizer["صدور مدرک - انتخاب واحد تحویل"]</h6></div>
                <div class="modal-body">
                    @* طبق Phase E-04: هدف واقعی همین صدور (IFC/IFA/IFI/...) - در لحظه‌ی صدور
                       ثبت می‌شود، نه مقدار قدیمی فرم Create/Edit *@
                    <div class="mb-3">
                        <label class="form-label small">Issue Purpose (IFC / IFA / IFI / ...)</label>
                        <input type="text" name="issuePurpose" class="form-control form-control-sm" value="@Model.IssuePurpose" placeholder="e.g. Issued For Construction" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">این مدرک به کدوم واحد تحویل داده می‌شه؟</label>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deliveryUnitType" id="dcc_internal" value="InternalDCC" checked
                                   onclick="pemsToggleIssueFields()">
                            <label class="form-check-label small" for="dcc_internal">DCC داخلی (واحد کنترل مدارک خودمون)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deliveryUnitType" id="dept_internal" value="InternalDepartment"
                                   onclick="pemsToggleIssueFields()">
                            <label class="form-check-label small" for="dept_internal">یک واحد دیگه داخل شرکت</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="deliveryUnitType" id="ext_unit" value="External"
                                   onclick="pemsToggleIssueFields()">
                            <label class="form-check-label small" for="ext_unit">نهاد بیرونی (DCC کارفرما / پیمانکار)</label>
                        </div>
                    </div>

                    <div class="mb-2" id="issueDeptField" style="display:none;">
                        <label class="form-label small">@Localizer["واحد داخلی"]</label>
                        <select name="deliveryDepartmentId" class="form-select form-select-sm">
                            @{
                                var allDepartmentsForIssue = (IEnumerable<PEMS.Domain.Entities.Department>)(ViewBag.AllDepartments ?? new List<PEMS.Domain.Entities.Department>());
                            }
                            @foreach (var dept in allDepartmentsForIssue)
                            {
                                <option value="@dept.DepartmentId">@dept.Name</option>
                            }
                        </select>
                    </div>

                    <div id="issueExternalFields" style="display:none;">
                        <div class="alert alert-warning py-2 px-3 small">
                            برای تحویل بیرونی، ثبت نامه‌ی رسمی خروجی الزامی است.
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">نام گیرنده (مثلاً DCC کارفرما)</label>
                            <input type="text" name="externalReceiverName" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <div class="mb-2" id="issueLetterNumberField" style="display:none;">
                        <label class="form-label small">شماره‌ی نامه (اختیاری - خالی بمونه خودکار ساخته می‌شه)</label>
                        <input type="text" name="letterNumber" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2" id="issueSubjectField" style="display:none;">
                        <label class="form-label small">@Localizer["موضوع نامه"]</label>
                        <input type="text" name="letterSubject" class="form-control form-control-sm" value="صدور مدرک @Model.DocumentNo" />
                    </div>
                    <div class="mb-2" id="issueBodyField" style="display:none;">
                        <label class="form-label small">@Localizer["متن نامه (اختیاری)"]</label>
                        <textarea name="letterBody" class="form-control form-control-sm" rows="2"></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small">توضیح / کامنت صدور (اختیاری)</label>
                        <textarea name="comment" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">@Localizer["انصراف"]</button>
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send-check"></i> تایید و صدور</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function pemsToggleIssueFields() {
        var isExternal = document.getElementById('ext_unit').checked;
        var isDept = document.getElementById('dept_internal').checked;

        document.getElementById('issueDeptField').style.display = isDept ? '' : 'none';
        document.getElementById('issueExternalFields').style.display = isExternal ? '' : 'none';

        // فیلدهای نامه: برای بیرونی همیشه نشون داده بشه (اجباریه)، برای داخلی هم نشون داده
        // بشه ولی اختیاریه (سرویس خودش تشخیص می‌ده اگه موضوع خالی بود نامه نسازه)
        var showLetterFields = isExternal || isDept || document.getElementById('dcc_internal').checked;
        document.getElementById('issueLetterNumberField').style.display = showLetterFields ? '' : 'none';
        document.getElementById('issueSubjectField').style.display = showLetterFields ? '' : 'none';
        document.getElementById('issueBodyField').style.display = showLetterFields ? '' : 'none';

        // اگه بیرونیه، موضوع و گیرنده اجباری بشن
        var subjectInput = document.querySelector('#issueSubjectField input');
        var receiverInput = document.querySelector('#issueExternalFields input');
        if (subjectInput) subjectInput.required = isExternal;
        if (receiverInput) receiverInput.required = isExternal;
    }

    pemsToggleIssueFields();
</script>


<div class="modal fade" id="newRevisionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateRevision" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <div class="modal-header"><h6 class="modal-title">Create New Revision</h6></div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label small">@Localizer["Reason"]</label>
                        <select name="reason" class="form-select form-select-sm">
                            <option>Design Change</option>
                            <option>Client Comment</option>
                            <option>Vendor Update</option>
                            <option>Internal Review</option>
                            <option>Regulatory Requirement</option>
                            <option>@Localizer["Other"]</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Change Description</label>
                        <textarea name="changeDescription" class="form-control form-control-sm" rows="3" placeholder="What changed in this revision?"></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small"><i class="bi bi-building"></i> Vendor Comment</label>
                        <textarea name="vendorComment" class="form-control form-control-sm" rows="3" placeholder="Paste or summarize the vendor's comment that led to this revision (if applicable)"></textarea>
                    </div>
                    @{
                        var openClouded = ((List<PEMS.Application.DTOs.VDRCommentDto>)ViewBag.Comments)
                            .Where(x => x.MarksRevisionRequired && !x.TriggeredRevisionId.HasValue).ToList();
                    }
                    @if (openClouded.Any())
                    {
                        <div class="mb-2">
                            <label class="form-label small"><i class="bi bi-cloud-fill"></i> Closes Marked-for-Revision comment <span class="text-muted">@Localizer["(optional)"]</span></label>
                            <select name="triggeringCommentId" class="form-select form-select-sm">
                                <option value="">@Localizer["-- None --"]</option>
                                @foreach (var oc in openClouded)
                                {
                                    <option value="@oc.VDRCommentId">@oc.CommentNo - @oc.CommentText</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-pems-solid btn-sm">Create Revision</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="clientResponseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RecordClientResponse" method="post">
                <input type="hidden" name="id" value="@Model.DocumentId" />
                <div class="modal-header"><h6 class="modal-title">Record Client Response</h6></div>
                <div class="modal-body">
                    <p class="text-muted small">
                        This is the client's (owner's) response to the issued document, separate from the
                        internal EPC review that already happened.
                    </p>

                    @{
                        var availableIncomingLetters = (IEnumerable<PEMS.Domain.Entities.Letter>)(ViewBag.AvailableIncomingLetters ?? new List<PEMS.Domain.Entities.Letter>());
                    }
                    <div class="mb-2">
                        <label class="form-label small"><i class="bi bi-envelope-open"></i> نامه‌ی وارده (الزامی)</label>
                        @if (availableIncomingLetters.Any())
                        {
                            <select name="incomingLetterId" class="form-select form-select-sm" required>
                                <option value="">@Localizer["-- انتخاب کنید --"]</option>
                                @foreach (var l in availableIncomingLetters)
                                {
                                    <option value="@l.LetterId">@l.LetterNumber &mdash; @l.Subject (@l.LetterDate.ToString("yyyy-MM-dd"))</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 px-3 small mb-0">
                                هیچ نامه‌ی وارده‌ای ثبت نشده. اول باید نامه‌ی رسیده از کارفرما رو توی
                                ماژول «نامه‌نگاری» به‌عنوان Incoming ثبت کنی، بعد این‌جا انتخابش کن.
                            </div>
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-label small">Client Decision</label>
                        <select name="clientStatus" class="form-select form-select-sm">
                            <option value="A">A - Approved</option>
                            <option value="B">B - Approved with Comments</option>
                            <option value="C">C - Revise &amp; Resubmit</option>
                            <option value="D">D - Rejected</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Client Comment (اختیاری - علاوه بر متن نامه)</label>
                        <textarea name="clientComment" class="form-control form-control-sm" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-pems-solid btn-sm" @(availableIncomingLetters.Any() ? "" : "disabled")>Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* طبق درخواست: چرخه‌ی کامنت/ریپلای دقیقاً مثل بخش VDR - همان سرویس مشترک، همان تجربه *@
<div class="modal fade" id="addEngCommentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddComment" method="post" enctype="multipart/form-data">
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
                <input type="hidden" name="pageNumber" id="engPinPageNumber" value="" />
                <input type="hidden" name="pinX" id="engPinX" value="" />
                <input type="hidden" name="pinY" id="engPinY" value="" />
                <div class="modal-header"><h6 class="modal-title">@Localizer["Add Comment"]</h6></div>
                <div class="modal-body">
                    <div id="engPinLocationLabel" class="small text-primary mb-2"></div>
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label small">@Localizer["Raised By"]</label><input name="raisedByName" class="form-control form-control-sm" /></div>
                        <div class="col-md-4">
                            <label class="form-label small">@Localizer["Category"]</label>
                            <select name="category" class="form-select form-select-sm">
                                <option value="">@Localizer["-- select --"]</option>
                                @foreach (var cat in new[] { "Technical", "Safety", "Constructability", "Documentation", "Specification", "Calculation", "Typographical", "Clarification" })
                                { <option value="@cat">@cat</option> }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small">@Localizer["Severity"]</label>
                            <select name="severity" class="form-select form-select-sm">
                                <option value="">@Localizer["-- select --"]</option>
                                @foreach (var sev in new[] { "Low", "Medium", "High", "Critical" })
                                { <option value="@sev">@sev</option> }
                            </select>
                        </div>
                        <div class="col-md-4"><label class="form-label small">@Localizer["Sheet"]</label><input name="sheet" class="form-control form-control-sm" /></div>
                        <div class="col-md-4"><label class="form-label small">@Localizer["Zone"]</label><input name="zone" class="form-control form-control-sm" /></div>
                        <div class="col-md-4"><label class="form-label small">@Localizer["Reference"]</label><input name="reference" class="form-control form-control-sm" /></div>
                        <div class="col-12"><label class="form-label small">@Localizer["Comment"]</label><textarea name="commentText" class="form-control form-control-sm" rows="3" required></textarea></div>
                        <div class="col-md-6"><label class="form-label small">Required Action</label><input name="requiredAction" class="form-control form-control-sm" /></div>
                        <div class="col-md-6"><label class="form-label small">@Localizer["Due Date"]</label><input name="dueDate" type="date" class="form-control form-control-sm" /></div>
                        <div class="col-12"><label class="form-label small">Attachment <span class="text-muted">@Localizer["(optional)"]</span></label><input type="file" name="attachment" class="form-control form-control-sm" /></div>
                        <div class="col-12 form-check">
                            <input type="checkbox" class="form-check-input" name="marksRevisionRequired" value="true" id="marksRevisionRequired" />
                            <label class="form-check-label" for="marksRevisionRequired">
                                Marks this document as needing a new revision (Clouded / Marked-for-Revision)
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-pems-solid">Save Comment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var c in engComments)
{
    <div class="modal fade" id="engReplyModal_@c.VDRCommentId" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="RecordCommentResponse" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="documentId" value="@Model.DocumentId" />
                    <input type="hidden" name="commentId" value="@c.VDRCommentId" />
                    <div class="modal-header"><h6 class="modal-title">Reply to @c.CommentNo</h6></div>
                    <div class="modal-body">
                        <p class="small text-muted">@c.CommentText</p>
                        <div class="mb-2">
                            <label class="form-label small">Reply <span class="text-muted">(optional if attaching a file)</span></label>
                            <textarea name="responseText" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Or attach the Reply Sheet file</label>
                            <input type="file" name="replyAttachment" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                        <button type="submit" class="btn btn-pems-solid btn-sm">Save Reply</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

</div> @* end .vs-page *@

