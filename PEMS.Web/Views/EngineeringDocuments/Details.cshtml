                var rows_31 = relatedLetters;
                var cell_31_5 = DataCell.Template(rows_31, @<text>@{ var l = item; }<pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId" data-bs-toggle="tooltip" title="View letter" aria-label="View letter @l.LetterNumber"><pems-icon name="bi-eye" /></pems-button></text>);
                <pems-data-table data="@(DataRows.Of(rows_31, c_ => c_.Add(((Localizer["Ed_Letters_Type"])?.ToString() ?? ""), l => (object?)(DataCell.Badge("neutral", l.LetterType))).Add(((Localizer["Ed_LetterNo"])?.ToString() ?? ""), l => (object?)(l.LetterNumber)).Add(((Localizer["Ed_Subject"])?.ToString() ?? ""), l => (object?)(l.Subject)).Add(((Localizer["Ed_Date"])?.ToString() ?? ""), l => (object?)((PemsDates.Date(l.LetterDate))), css: "small text-muted").Add(((Localizer["Ed_Status"])?.ToString() ?? ""), l => (object?)(DataCell.Badge("info", l.Status))).Add("", l => (object?)cell_31_5(l))))" />
