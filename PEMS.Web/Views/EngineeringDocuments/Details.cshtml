                var cell_32_5 = DataCell.Template(rows_32, @<text>@{ var t = item; }<pems-button tone="neutral" size="small" outline="true" as="a" asp-controller="Transmittal" asp-action="Details" asp-route-id="@t.TransmittalId" data-bs-toggle="tooltip" title="View transmittal" aria-label="View transmittal @t.TransmittalNo"><pems-icon name="bi-eye" /></pems-button></text>);
                <pems-data-table data="@(DataRows.Of(rows_32, c_ => c_.Add(((Localizer["Ed_TransmittalNo"])?.ToString() ?? ""), t => (object?)(t.TransmittalNo)).Add(((Localizer["Ed_RevSent"])?.ToString() ?? ""), t => (object?)(DataCell.Group(Localizer["Ed_CurrentRev"], " ", DataCell.Span("vs-num", t.RevisionNoAtTransmittal))), css: "small text-muted").Add(((Localizer["Ed_Purpose"])?.ToString() ?? ""), t => (object?)VdrUi.Loc(Localizer, "Transmittal_Purpose_", t.Purpose)).Add(((Localizer["Ed_Date"])?.ToString() ?? ""), t => (object?)((PemsDates.Date(t.SentDate) ?? PemsDates.Date(t.TransmittalDate))), css: "small text-muted").Add(((Localizer["Ed_Status"])?.ToString() ?? ""), t => (object?)cell_32_4(t)).Add("", t => (object?)cell_32_5(t))))" />
            }
