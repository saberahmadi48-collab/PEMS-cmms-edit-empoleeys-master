@model PEMS.Application.DTOs.EngineeringDocumentDto
@using PEMS.Web.Helpers
@using PEMS.Web.Models
@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = "Engineering Document Details";
    // طبق «PEMS — Engineering Documents Upper-Whitespace Correction»: این صفحه از قبل یک
    // Breadcrumb محلی (خط ۶۱ پایین‌تر، شامل لینک به لیست + شماره‌ی واقعی مدرک) و یک کارت هویت
    // مدرک (DocumentNo/Status/Revision) بلافاصله زیرش دارد - H1 عمومی Layout همون متن ثابت بالا
    // را با فونت درشت‌تر و ۴۸px+ فاصله‌ی عمودی اضافه تکرار می‌کرد، بدون اطلاعات جدید.
    ViewData["HidePageTitle"] = true;

    var relatedLetters = (List<PEMS.Application.DTOs.RelatedLetterDto>)(ViewBag.RelatedLetters ?? new List<PEMS.Application.DTOs.RelatedLetterDto>());
    var idcStatusForPage = (IReadOnlyList<PEMS.Application.Interfaces.IdcStatusItemDto>)
        (ViewBag.IdcStatus ?? new List<PEMS.Application.Interfaces.IdcStatusItemDto>());
    var workflowHistoryForPage = (IReadOnlyList<PEMS.Application.Interfaces.DocumentWorkflowHistoryItemDto>)
        (ViewBag.WorkflowHistory ?? new List<PEMS.Application.Interfaces.DocumentWorkflowHistoryItemDto>());
    // طبق «Phase 9 - IDC Summary»: معیار پیشرفت، تعداد دیسیپلین‌هایی است که پاسخ داده‌اند
    // (صرف‌نظر از این‌که Approve/Comment/Reject بوده) - نه فقط تعداد Approve
    var idcApprovedCount = idcStatusForPage.Count(x => x.Status != "Pending");

    // کامنت‌ها و ترنسمیتال‌ها: شمارنده‌ی تب‌ها و کارت‌های خلاصه‌ی Overview به این مقادیر نیاز دارند (قبلاً پایین صفحه تعریف می‌شدند)
    var engComments = (List<PEMS.Application.DTOs.VDRCommentDto>)(ViewBag.Comments ?? new List<PEMS.Application.DTOs.VDRCommentDto>());
    var latestPdfAttachment = Model.Attachments
        .Where(a => a.FileExtension.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(a => a.UploadDate)
        .FirstOrDefault();
    var commentsClosedCount = engComments.Count(c => c.ActionStatus is "Closed" or "Verified" or "NoActionRequired");
    var commentsOpenCount = engComments.Count - commentsClosedCount;
    var relatedTransmittals = (List<PEMS.Application.DTOs.RelatedTransmittalDto>)(ViewBag.RelatedTransmittals ?? new List<PEMS.Application.DTOs.RelatedTransmittalDto>());

    // «مرحله‌ی بعد» زیر نمودار: فقط توضیح است؛ اقدام واقعی همان دکمه‌های بالای صفحه است و سرور خودش مجاز بودن را بررسی می‌کند
    string? wfNextStep = Model.Status switch
    {
        "Draft" => Localizer["Ed_Next_Draft"].Value,
        "Submitted" => Localizer["Ed_Next_Submitted"].Value,
        "IDC Review" => string.Format(Localizer["Ed_Next_Idc"].Value, idcStatusForPage.Count(x => x.Status == "Pending")),
        "Checked" => Localizer["Ed_Next_Checked"].Value,
        "Approved" => Localizer["Ed_Next_Approved"].Value,
        "Issued" => string.IsNullOrEmpty(Model.ClientApprovalStatus) ? Localizer["Ed_Next_Issued"].Value : null,
        "Rejected" or "Revise & Resubmit" => Localizer["Ed_Next_Revise"].Value,
        _ => null
    };
    // لینک «Assign» به صفحه‌ی ویرایش می‌رود (فیلدهای امضا همان‌جا متن آزاد هستند)؛ مدرک منجمد/صادرشده قابل ویرایش نیست
    var canAssignSignoff = !Model.IsFrozen && Model.Status != "Issued";

    // طبق «PEMS Phase 2C-3»: منطق تعیین مرحله عیناً همان منطق قبلی _WorkflowStagesDiagram
    // است - فقط جابه‌جا شده به این‌جا، بدون هیچ تغییر رفتاری. محاسبه یک‌بار انجام می‌شود چون
    // این صفحه دو بار (بالای صفحه + داخل Modal Submit) همین نمودار را نشان می‌دهد.
    var wfCurrentStatus = Model.Status ?? "Draft";
    var wfStageOrder = new[] { "Draft", "Submitted", "IDC Review", "Checked", "Approved", "Issued", "ClientReview" };
    var wfStageLabels = new Dictionary<string, string>
    {
        ["Draft"] = "Draft", ["Submitted"] = "Check", ["IDC Review"] = "IDC", ["Checked"] = "Approval",
        ["Approved"] = "Issue", ["Issued"] = "Issued", ["ClientReview"] = "Client Review"
    };
    var wfStageIcons = new Dictionary<string, string>
    {
        ["Draft"] = "bi-pencil-square", ["Submitted"] = "bi-clipboard-check", ["IDC Review"] = "bi-diagram-3",
        ["Checked"] = "bi-patch-check", ["Approved"] = "bi-send-check", ["Issued"] = "bi-check2-circle", ["ClientReview"] = "bi-building"
    };
    var wfStageRoles = new Dictionary<string, string>
    {
        ["Draft"] = "Engineer", ["Submitted"] = "Eng. Supervisor / Manager", ["IDC Review"] = "دیسیپلین‌های ارجاع‌شده",
        ["Checked"] = "Eng. Manager", ["Approved"] = "Document Controller", ["Issued"] = "—", ["ClientReview"] = "Document Controller"
    };
    // ترجمه‌ی نمایشی وضعیت؛ مقدار ذخیره‌شده هرگز تغییر نمی‌کند
    string StatusText(string? s) { var l = Localizer[DocumentStatusBadge.ResourceKey(s)]; return l.ResourceNotFound ? (s ?? "") : l.Value; }
    var wfIsRejected = wfCurrentStatus == "Rejected" || wfCurrentStatus == "Revise & Resubmit";
    var wfCurrentIndex = Array.IndexOf(wfStageOrder, wfCurrentStatus);
    if (wfCurrentIndex < 0) wfCurrentIndex = wfIsRejected ? 0 : wfStageOrder.Length - 1;

    var wfStageDiagramModel = new StageDiagramViewModel
    {
        Stages = wfStageOrder.Select((key, i) => new StageDiagramItem
        {
            Label = wfStageLabels[key],
            IconCssClass = wfStageIcons[key],
            RoleLabel = wfStageRoles[key],
            State = wfIsRejected && i > wfCurrentIndex ? StageItemState.Rejected
                : i < wfCurrentIndex ? StageItemState.Done
                : i == wfCurrentIndex ? StageItemState.Current
                : StageItemState.Pending
        }).ToList()
    };
}


@* طراحی جدید: به‌جای یک صفحه‌ی بسیار طولانی با اسکرول پیوسته، محتوا در تب‌ها سازمان‌دهی شده -
   الهام‌گرفته از EDMS های رقیب که هر مدرک را به‌صورت Overview / Attachments / IDC / Revisions /
   Workflow / Correspondence نشان می‌دهند. اقدامات اصلی گردش‌کار همیشه بالای صفحه و قابل مشاهده‌اند.
   طبق «PEMS — Engineering Documents UX Transformation»: اکشن‌های کم‌تکرار (Edit/Freeze/Hold
   جدید/تحلیل AI/رویژن جدید) به منوی «More» منتقل شدند تا فقط اکشن مرحله‌ی فعلی گردش‌کار برجسته
   بماند - هیچ Route/Field/مجوز سرور تغییر نکرده، فقط محل نمایش دکمه‌ها. *@

@section Styles {
    <link rel="stylesheet" href="~/css/pems-workspace.css" asp-append-version="true" />
}

<div class="vs-page">

<div class="vs-section">
    <div class="vs-doc-head">
        <div class="vs-doc-identity">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h1 class="vs-doc-number vs-num">@Model.DocumentNo</h1>
                <span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(Model.Status)"><i class="bi @DocumentStatusBadge.Icon(Model.Status)" aria-hidden="true"></i> @StatusText(Model.Status)</span>
                <span class="vs-pill vs-pill--current">@Localizer["Ed_CurrentRev"] <span class="vs-num">@Model.RevisionNo</span></span>
                @if (Model.IsFrozen) { <span class="vs-pill vs-pill--icon vs-pill--info"><i class="bi bi-snow" aria-hidden="true"></i> @Localizer["Ed_Frozen"]</span> }
                @if (Model.IsOnHold) { <span class="vs-pill vs-pill--icon vs-pill--warning"><i class="bi bi-pause-circle" aria-hidden="true"></i> @Localizer["Ed_OnHold"]</span> }
            </div>
            <div class="vs-doc-title" title="@Model.Title">@Model.Title</div>
            <div class="vs-doc-meta">@Model.ProjectName &middot; @Model.DisciplineName@(!string.IsNullOrEmpty(Model.Area) ? " · " + Model.Area : "")</div>
        </div>

        <div class="vs-doc-actions">
            @* طبق بخش ۱۹ ممیزی UX: فقط اکشن(های) مرحله‌ی فعلی گردش‌کار این‌جا برجسته می‌مانند -
               بدون تغییر در Route/Field/بررسی وضعیت سرور. *@
            @if (Model.Status == "Draft")
            {
                <button type="button" class="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#submitWorkflowModal">
                    <i class="bi bi-send"></i> Submit For Review
                </button>
            }
            else if (Model.Status == "Submitted")
            {
                <form asp-action="Check" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <button class="vs-btn vs-btn--primary"><i class="bi bi-clipboard-check"></i> Check</button>
                </form>
                <form asp-action="Reject" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <button class="vs-btn vs-btn--dangerline">@Localizer["Reject"]</button>
                </form>
                <button type="button" class="vs-btn" data-bs-toggle="modal" data-bs-target="#reviseModal">
                    <i class="bi bi-arrow-repeat"></i> Revise &amp; Resubmit
                </button>
            }
            else if (Model.Status == "IDC Review")
            {
                var myDisciplineIdForIdc = ViewBag.MyDisciplineId as int?;
                var myPendingIdc = idcStatusForPage.FirstOrDefault(x => x.DisciplineId == myDisciplineIdForIdc && x.Status == "Pending");

                if (myPendingIdc != null)
                {
                    @* طبق «Phase 11 - UI/UX» ممیزی: این دکمه‌ها فقط نتیجه‌ی بازبینیِ دیسیپلینِ خودِ کاربر
                       (My Review) هستند - نه اقدام تایید/رد رسمیِ کل مدرک (که فقط در مرحله‌ی Approval،
                       با برچسب مشابه ولی جدا، پایین‌تر ظاهر می‌شود). برچسب‌ها عمداً متفاوت نگه داشته
                       شده‌اند تا با دکمه‌های تصمیم رسمی اشتباه گرفته نشوند. *@
                    <span class="text-muted small me-1">@Localizer["My IDC Review:"]</span>
                    <form asp-action="IdcRespond" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.DocumentId" />
                        <input type="hidden" name="decision" value="Approve" />
                        <button class="vs-btn vs-btn--primary"><i class="bi bi-check-lg"></i> No Comment</button>
                    </form>
                    <button type="button" class="vs-btn" data-bs-toggle="modal" data-bs-target="#idcCommentModal">@Localizer["Approve with Comments"]</button>
                    <button type="button" class="vs-btn vs-btn--dangerline" data-bs-toggle="modal" data-bs-target="#idcRejectModal">@Localizer["Revision Required"]</button>
                }
                else
                {
                    <span class="vs-pill vs-pill--icon vs-pill--warning"><i class="bi bi-hourglass-split" aria-hidden="true"></i> منتظر بازبینی دیسیپلین‌های دیگر (IDC)</span>
                }
            }
            else if (Model.Status == "Checked")
            {
                <form asp-action="Approve" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <button class="vs-btn vs-btn--primary">@Localizer["Approve"]</button>
                </form>
                <form asp-action="Reject" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.DocumentId" />
                    <button class="vs-btn vs-btn--dangerline">@Localizer["Reject"]</button>
                </form>
                <button type="button" class="vs-btn" data-bs-toggle="modal" data-bs-target="#reviseModal">
                    <i class="bi bi-arrow-repeat"></i> Revise &amp; Resubmit
                </button>
            }
            else if (Model.Status == "Approved")
            {
                <button type="button" class="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#issueModal">
                    <i class="bi bi-send-check"></i> Issue
                </button>
            }
            else if (Model.Status == "Issued")
            {
                @if (string.IsNullOrEmpty(Model.ClientApprovalStatus))
                {
                    <button type="button" class="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#clientResponseModal">
                        <i class="bi bi-building"></i> Record Client Response
                    </button>
                }
            }
            else if (Model.Status == "Rejected" || Model.Status == "Revise & Resubmit")
            {
                <button type="button" class="vs-btn vs-btn--primary" data-bs-toggle="modal" data-bs-target="#submitWorkflowModal">
                    <i class="bi bi-arrow-repeat"></i> Resubmit
                </button>
            }

            @* طبق بخش ۲۱ ممیزی UX: اکشن‌های کم‌تکرار این‌جا جمع شدند - نمایش هر آیتم دقیقاً همون
               شرط/مجوزی که قبلاً به‌صورت جداگانه روی صفحه داشت را حفظ می‌کند. *@
            <div class="dropdown">
                <button class="vs-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @Localizer["Ed_MoreActions"]
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.DocumentId"><i class="bi bi-pencil"></i> @Localizer["Edit"]</a></li>
                    @if (Model.Status == "Approved" || Model.Status == "Issued")
                    {
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#newRevisionModal"><i class="bi bi-file-earmark-plus"></i> Create New Revision</button></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-action="AnalyzeRelationships" asp-route-id="@Model.DocumentId" method="post">
                            <button type="submit" class="dropdown-item"><i class="bi bi-stars"></i> @Localizer["تحلیل روابط (AI)"]</button>
                        </form>
                    </li>
                    @if (!Model.IsFrozen && (bool)(ViewBag.CanFreeze ?? false))
                    {
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#freezeModal"><i class="bi bi-snow"></i> @Localizer["Freeze"]</button></li>
                    }
                    @if (!Model.IsOnHold && !Model.IsFrozen && Model.Status != "Issued" && (bool)(ViewBag.CanHold ?? false))
                    {
                        <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#holdModal"><i class="bi bi-pause-circle"></i> @Localizer["Hold"]</button></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @* طبق بخش ۲۲ ممیزی UX: بنر وضعیت برجسته برای Frozen/Hold - سرور واقعاً Approve/Issue/Edit را
       مسدود می‌کند (نه فقط این بنر)؛ این‌جا فقط نمایش وضعیت + اکشن رفع آن است. *@
    @if (Model.IsFrozen)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-0 py-2">
            <div class="small">
                <i class="bi bi-snow"></i> <strong>FROZEN</strong> — Revision @Model.RevisionNo is frozen and cannot be modified.
                <div class="text-muted">Frozen by @(Model.FrozenByName ?? "-") on @(Model.FrozenDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")@(!string.IsNullOrWhiteSpace(Model.FreezeReason) ? " — " + Model.FreezeReason : "")</div>
            </div>
            @if ((bool)(ViewBag.CanUnfreeze ?? false))
            {
                <form asp-action="Unfreeze" asp-route-id="@Model.DocumentId" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="text" name="reason" class="form-control form-control-sm" style="max-width:240px;" placeholder="Unfreeze reason (required)" required />
                    <button type="submit" class="btn btn-outline-dark btn-sm" onclick="return confirm('انجماد این مدرک برداشته شود؟');">
                        <i class="bi bi-sun"></i> @Localizer["Unfreeze"]
                    </button>
                </form>
            }
        </div>
    }
    @if (Model.IsOnHold)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-0 py-2">
            <div class="small">
                <i class="bi bi-pause-circle"></i> <strong>ON HOLD</strong> — این مدرک قابل تأیید (Approve) یا صدور (Issue) نیست تا زمانی که Hold رفع شود.
            </div>
            @if ((bool)(ViewBag.CanReleaseHold ?? false))
            {
                <form asp-action="ReleaseHold" asp-route-id="@Model.DocumentId" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                    <input type="text" name="reason" class="form-control form-control-sm" style="max-width:240px;" placeholder="Release reason (required)" required />
                    <button type="submit" class="btn btn-outline-dark btn-sm" onclick="return confirm('Hold این مدرک رفع شود؟');">
                        <i class="bi bi-play-circle"></i> @Localizer["Release Hold"]
                    </button>
                </form>
            }
        </div>
    }

    @{
        var holdHistory = (List<PEMS.Application.DTOs.DocumentHoldDto>)(ViewBag.HoldHistory ?? new List<PEMS.Application.DTOs.DocumentHoldDto>());
    }
    @if (holdHistory.Any())
    {
        <details class="mt-2 small">
            <summary class="text-muted">Hold History (@holdHistory.Count)</summary>
            <table class="table table-sm table-enterprise mt-1">
                <thead><tr><th>@Localizer["Reason"]</th><th>Held</th><th>By</th><th>Released</th><th>By</th><th>Release Reason</th></tr></thead>
                <tbody>
                    @foreach (var h in holdHistory)
                    {
                        <tr>
                            <td>@h.Reason</td>
                            <td>@h.HoldDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@h.HoldByName</td>
                            <td>@(h.ReleaseDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                            <td>@h.ReleaseByName</td>
                            <td>@h.ReleaseReason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </details>
    }

    @{
        var equipmentUsingThisAsPID = (IEnumerable<dynamic>)(ViewBag.EquipmentUsingThisAsPID ?? new List<dynamic>());
    }
    @if (equipmentUsingThisAsPID.Any())
    {
        <div class="mt-2">
            <span class="text-muted small">این مدرک P&amp;ID تجهیزات زیر است:</span>
            @foreach (var e in equipmentUsingThisAsPID)
            {
                <a asp-controller="Equipment" asp-action="Details" asp-route-id="@e.EquipmentId" class="badge bg-info text-dark text-decoration-none">
                    <i class="bi bi-gear"></i> @e.TagNumber
                </a>
            }
        </div>
    }

    @* نمودار گرافیکی همیشه‌مرئی چرخه - همون چیزی که قبلاً فقط توی پاپ‌آپ Submit بود، حالا اینجا
       هم هست تا همیشه معلوم باشه مدرک دقیقاً کجای چرخه‌ست، بدون نیاز به باز کردن مدال. طبق بخش
       ۲۴ ممیزی UX: خلاصه‌ی پیشرفت IDC (بدون نیاز به اسکرول) این‌جا می‌ماند؛ ماتریس کامل هر
       دیسیپلین به تب اختصاصی IDC Review منتقل شد. *@
    @if (!string.IsNullOrEmpty(Model.Status))
    {
        <hr class="my-2" />
        <partial name="_PemsStageDiagram" model="wfStageDiagramModel" />

        @if (wfNextStep != null)
        {
            <div class="alert alert-info py-2 mb-2 mt-2 small" role="note">
                <i class="bi bi-signpost-split" aria-hidden="true"></i> <strong>@Localizer["Ed_NextStep"]</strong> @wfNextStep
            </div>
        }

        @if (Model.Status == "IDC Review" && idcStatusForPage.Any())
        {
            <div class="text-center small text-muted mb-1">
                IDC progress: <strong>@idcApprovedCount / @idcStatusForPage.Count</strong> disciplines completed
                &mdash; <a href="#tab-idc" data-bs-toggle="tab" data-bs-target="#tab-idc">view details</a>
            </div>
        }
    }
</div>

<ul class="nav nav-tabs mb-3" id="docTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button">
            <i class="bi bi-info-circle"></i> @Localizer["Ed_TabOverview"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-attachments" type="button">
            <i class="bi bi-paperclip"></i> @Localizer["Ed_TabFiles"] <span class="badge bg-secondary">@(Model.Attachments?.Count ?? 0)</span>
        </button>
    </li>
    @* طبق بخش ۲۵ ممیزی UX: IDC حالا یک تب اختصاصی است، نه فقط چند Badge کوچک توی هدر -
       فقط وقتی داده‌ی IDC واقعاً وجود دارد نمایش داده می‌شود (سند هیچ‌وقت وارد IDC نشده باشد،
       تب اضافه‌ای نیست). *@
    @if (idcStatusForPage.Any())
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-idc" type="button">
                <i class="bi bi-diagram-3"></i> @Localizer["Ed_TabIdc"] <span class="badge bg-secondary">@idcApprovedCount/@idcStatusForPage.Count</span>
            </button>
        </li>
    }
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-revisions" type="button">
            <i class="bi bi-clock-history"></i> @Localizer["Ed_TabRevisions"] <span class="badge bg-secondary">@(Model.Revisions?.Count ?? 0)</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-transmittals" type="button">
            <i class="bi bi-truck"></i> @Localizer["Ed_TabTransmittals"]
            @if (relatedTransmittals.Any()) { <span class="badge bg-secondary">@relatedTransmittals.Count</span> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comments" type="button">
            <i class="bi bi-chat-square-text"></i> @Localizer["Ed_TabComments"]
            @if (engComments.Any()) { <span class="badge @(commentsOpenCount > 0 ? "bg-danger" : "bg-secondary")">@commentsOpenCount<span class="visually-hidden"> @Localizer["Ed_OpenComments"]</span></span> }
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-workflow" type="button">
            <i class="bi bi-diagram-2"></i> @Localizer["Ed_TabWorkflow"]
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-correspondence" type="button">
            <i class="bi bi-envelope-paper"></i> @Localizer["Ed_TabDistribution"]
            @if (relatedLetters.Any()) { <span class="badge bg-secondary">@relatedLetters.Count</span> }
        </button>
    </li>
</ul>

<div class="tab-content">

    @* ===================== Overview ===================== *@
    <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
        <div class="row g-3">
        <div class="col-lg-8">
        <div class="vs-section">
            <h2 class="vs-section__title"><i class="bi bi-card-list"></i> @Localizer["Ed_SecIdentification"]</h2>
            <div class="vs-info">
                <div><p class="vs-info__label">@Localizer["Ed_DocType"]</p><p class="vs-info__value">@Model.DocumentType</p></div>
                <div><p class="vs-info__label">@Localizer["Ed_Project"]</p><p class="vs-info__value">@Model.ProjectName</p></div>
                <div><p class="vs-info__label">@Localizer["Ed_Discipline"]</p><p class="vs-info__value">@Model.DisciplineName</p></div>
                <div><p class="vs-info__label">@Localizer["Ed_Area"]</p><p class="vs-info__value">@(string.IsNullOrEmpty(Model.Area) ? "—" : Model.Area)</p></div>
                <div><p class="vs-info__label">@Localizer["Ed_Revision"]</p><p class="vs-info__value vs-num">@Model.RevisionNo</p></div>
                <div><p class="vs-info__label">@Localizer["Ed_CreatedDate"]</p><p class="vs-info__value vs-num">@Model.CreatedDate.ToString("yyyy-MM-dd")</p></div>
                <div class="vs-info__wide"><p class="vs-info__label">@Localizer["Ed_Description"]</p><p class="vs-info__value">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</p></div>
            </div>
        </div>

        <div class="vs-section">
            <h2 class="vs-section__title"><i class="bi bi-patch-check"></i> @Localizer["Ed_SecEngineering"]</h2>
            <div class="vs-info">
                <div><p class="vs-info__label">@Localizer["Ed_IssuePurpose"]</p><p class="vs-info__value">@(string.IsNullOrEmpty(Model.IssuePurpose) ? "—" : Model.IssuePurpose)</p></div>
                <div>
                    <p class="vs-info__label">@Localizer["Ed_PreparedBy"]</p>
                    <p class="vs-info__value">
                        @if (string.IsNullOrEmpty(Model.PreparedBy))
                        {
                            <span class="text-muted">@Localizer["Ed_NotSet"]</span>
                            @if (canAssignSignoff) { <text> &middot; <a asp-action="Edit" asp-route-id="@Model.DocumentId">@Localizer["Ed_Assign"]</a></text> }
                        }
                        else { @Model.PreparedBy }
                    </p>
                </div>
                <div>
                    <p class="vs-info__label">@Localizer["Ed_CheckedBy"]</p>
                    <p class="vs-info__value">
                        @if (string.IsNullOrEmpty(Model.CheckedBy))
                        {
                            <span class="text-muted">@Localizer["Ed_NotSet"]</span>
                            @if (canAssignSignoff) { <text> &middot; <a asp-action="Edit" asp-route-id="@Model.DocumentId">@Localizer["Ed_Assign"]</a></text> }
                        }
                        else { @Model.CheckedBy }
                        @(Model.CheckedDate.HasValue ? $"({Model.CheckedDate:yyyy-MM-dd})" : "")
                        @if (!string.IsNullOrEmpty(Model.CheckedBySignaturePath))
                        {
                            <img src="@Model.CheckedBySignaturePath" alt="Signature" style="height:32px; vertical-align:middle; margin-inline-start:8px; background:#fff; border:1px solid #eee; border-radius:3px;" />
                        }
                    </p>
                </div>
                <div>
                    <p class="vs-info__label">@Localizer["Ed_ApprovedBy"]</p>
                    <p class="vs-info__value">
                        @(string.IsNullOrEmpty(Model.ApprovedBy) ? "—" : Model.ApprovedBy) @(Model.ApprovedDate.HasValue ? $"({Model.ApprovedDate:yyyy-MM-dd})" : "")
                        @if (!string.IsNullOrEmpty(Model.ApprovedBySignaturePath))
                        {
                            <img src="@Model.ApprovedBySignaturePath" alt="Signature" style="height:32px; vertical-align:middle; margin-inline-start:8px; background:#fff; border:1px solid #eee; border-radius:3px;" />
                        }
                    </p>
                </div>
                <div><p class="vs-info__label">@Localizer["Ed_CommentStatus"]</p><p class="vs-info__value">@(string.IsNullOrEmpty(Model.CommentStatus) ? "—" : Model.CommentStatus)</p></div>
                @if (!string.IsNullOrEmpty(Model.ClientApprovalStatus))
                {
                    <div>
                        <p class="vs-info__label">@Localizer["Ed_ClientResponse"]</p>
                        <p class="vs-info__value">
                            <span class="vs-pill vs-pill--icon @(Model.ClientApprovalStatus == "Approved" ? "vs-pill--success" : Model.ClientApprovalStatus == "Rejected" ? "vs-pill--danger" : "vs-pill--warning")"><i class="bi @(Model.ClientApprovalStatus == "Approved" ? "bi-check-circle" : Model.ClientApprovalStatus == "Rejected" ? "bi-x-circle" : "bi-exclamation-circle")" aria-hidden="true"></i> @Model.ClientApprovalStatus</span>
                            @if (!string.IsNullOrEmpty(Model.ClientComment)) { <span class="vs-sub">@Model.ClientComment</span> }
                        </p>
                    </div>
                }
                <div>
                    <p class="vs-info__label">@Localizer["Ed_RelatedEquipment"]</p>
                    <p class="vs-info__value">
                        @if (Model.EquipmentId.HasValue)
                        { <a asp-controller="Equipment" asp-action="Details" asp-route-id="@Model.EquipmentId">@Model.EquipmentTagNumber</a> }
                        else { <span class="text-muted">—</span> }
                    </p>
                </div>
                <div>
                    <p class="vs-info__label">@Localizer["Ed_RelatedContract"]</p>
                    <p class="vs-info__value">
                        @if (Model.ContractId.HasValue)
                        { <a asp-controller="Contract" asp-action="Details" asp-route-id="@Model.ContractId">@Model.ContractNo</a> }
                        else { <span class="text-muted">—</span> }
                    </p>
                </div>
            </div>
        </div>
        </div>
        <div class="col-lg-4">
            <div class="vs-section">
                <h2 class="vs-section__title"><i class="bi bi-chat-square-text"></i> @Localizer["Ed_TabComments"]</h2>
                <p class="small text-muted mb-2">@string.Format(Localizer["Ed_OpenClosed"].Value, commentsOpenCount, commentsClosedCount)</p>
                @if (!engComments.Any())
                {
                    <p class="small text-muted border rounded p-2 text-center mb-2">@Localizer["Ed_NoCommentsHint"]</p>
                }
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addEngCommentModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> @Localizer["Add Comment"]</button>
                    @if (engComments.Any())
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tab" data-bs-target="#tab-comments">@Localizer["Ed_ViewAll"]</button>
                    }
                </div>
            </div>
            <div class="vs-section">
                <h2 class="vs-section__title"><i class="bi bi-paperclip"></i> @Localizer["Ed_TabFiles"]</h2>
                <p class="small text-muted mb-2">@((Model.Attachments?.Count ?? 0) == 0 ? Localizer["Ed_NoFilesHint"].Value : string.Format(Localizer["Ed_FilesCount"].Value, Model.Attachments!.Count))</p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="UploadAttachment" asp-route-id="@Model.DocumentId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-upload" aria-hidden="true"></i> @Localizer["Ed_Upload"]</a>
                    @if ((Model.Attachments?.Count ?? 0) > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="tab" data-bs-target="#tab-attachments">@Localizer["Ed_ViewAll"]</button>
                    }
                </div>
            </div>
        </div>
        </div>
    </div>

    @* ===================== Attachments & AI ===================== *@
    <div class="tab-pane fade" id="tab-attachments" role="tabpanel">
        <div class="vs-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0">@Localizer["Ed_SecFiles"]</h6>
                <a asp-action="UploadAttachment" asp-route-id="@Model.DocumentId" class="btn btn-sm btn-pems-solid">
                    <i class="bi bi-upload"></i> @Localizer["Ed_Upload"]
                </a>
            </div>

            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                <table class="table table-enterprise">
                    <thead>
                        <tr><th>@Localizer["Ed_FileName"]</th><th>@Localizer["Ed_Revision"]</th><th>@Localizer["Ed_Ext"]</th><th>@Localizer["Ed_Size"]</th><th>@Localizer["Ed_AiStatus"]</th><th>@Localizer["Ed_Date"]</th><th class="text-end">@Localizer["Ed_Actions"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var file in Model.Attachments)
                        {
                            var badgeClass = file.AIStatus switch
                            {
                                "Completed" => "bg-success",
                                "Processing" => "bg-info text-dark",
                                "Pending" => "bg-secondary",
                                "Failed" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            var fileIsCurrentRev = file.DocumentRevisionId.HasValue && file.RevisionNo == Model.RevisionNo;
                            var fileIsPreviousRev = file.DocumentRevisionId.HasValue && !fileIsCurrentRev;
                            <tr class="@(fileIsPreviousRev ? "vs-rev-superseded" : "")">
                                <td>
                                    @file.FileName
                                    @if (!string.IsNullOrEmpty(file.FileHash))
                                    {
                                        <i class="bi bi-shield-check text-success ms-1" data-bs-toggle="tooltip" title="SHA-256: @file.FileHash"></i>
                                    }
                                </td>
                                <td>
                                    @if (file.DocumentRevisionId.HasValue)
                                    {
                                        <span class="badge bg-secondary">@Localizer["Ed_CurrentRev"] @file.RevisionNo</span>
                                        @if (fileIsCurrentRev) { <span class="vs-pill vs-pill--current">@Localizer["Ed_CurrentRevFile"]</span> }
                                        else { <span class="vs-sub">@Localizer["Ed_PreviousRevFile"]</span> }
                                        @if (file.IsOfficial)
                                        {
                                            <span class="badge bg-success" data-bs-toggle="tooltip" title="Official file for this revision">Official</span>
                                        }
                                        @if (!string.IsNullOrEmpty(file.FileRole))
                                        {
                                            <span class="text-muted small d-block">@file.FileRole</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@Localizer["Ed_DocLevelFile"]</span>
                                    }
                                </td>
                                <td>@file.FileExtension</td>
                                <td>@(file.FileSize / 1024) KB</td>
                                <td><span class="badge @badgeClass">@file.AIStatus</span></td>
                                <td class="small text-muted">@file.UploadDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end flex-wrap">
                                        <a asp-action="DownloadAttachment" asp-route-id="@file.AttachmentId" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" title="Download attachment" aria-label="Download @file.FileName"><i class="bi bi-download"></i></a>
                                        @if (file.AIStatus == "Completed")
                                        {
                                            <a asp-controller="AIExtraction" asp-action="Review" asp-route-attachmentId="@file.AttachmentId" class="btn btn-sm btn-outline-warning">AI Data</a>
                                            <a asp-controller="EngineeringDocumentIntelligence" asp-action="Review" asp-route-id="@Model.DocumentId" class="btn btn-sm btn-outline-secondary">Intelligence</a>
                                        }
                                        <form asp-controller="OCRProcessing" asp-action="Retry" asp-route-id="@file.AttachmentId" method="post" class="d-inline">
                                            <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="tooltip" title="Re-analyze" aria-label="Re-analyze @file.FileName"><i class="bi bi-arrow-repeat"></i></button>
                                        </form>
                                        <form asp-action="DeleteAttachment" asp-route-id="@file.AttachmentId" method="post" class="d-inline" onsubmit="return confirm('Delete file?')">
                                            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="tooltip" title="Delete attachment" aria-label="Delete @file.FileName"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoFiles"]</p>
            }
        </div>
    </div>

    @* ===================== IDC Review ===================== *@
    @* طبق «PEMS Engineering IDC Ownership Correction» (بخش ۹ - Originator Actions): این
       ماتریس اکنون خلاصه‌ی تجمیع‌شده‌ی IDC برای سازنده/تأییدکننده‌ی مدرک است - نه فقط یک
       نشانگر وضعیت. IdcStatusItemDto حالا Comment/RespondedByName/RespondedDate هم دارد
       (از DocumentIdcReferral دائمی، نه جدول گذرای موتور) تا نظرات واقعاً قابل‌مرور باشند.
       مهم: نتیجه‌ی هیچ دیسیپلینی این‌جا (حتی Reject) وضعیت رسمی مدرک را تعیین نمی‌کند -
       این فقط یک خلاصه‌ی اطلاعاتی است؛ تصمیم رسمی در مرحله‌ی Approval گرفته می‌شود. *@
    @if (idcStatusForPage.Any())
    {
        <div class="tab-pane fade" id="tab-idc" role="tabpanel">
            <div class="vs-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0"><i class="bi bi-diagram-3"></i> Inter-Discipline Check (IDC) — Discipline Review Summary</h6>
                    <span class="text-muted small">@idcApprovedCount / @idcStatusForPage.Count disciplines responded</span>
                </div>
                <p class="text-muted small">
                    <i class="bi bi-info-circle"></i> نتایج زیر صرفاً مشورتی هستند و به‌تنهایی وضعیت رسمی مدرک را
                    تعیین نمی‌کنند - حتی اگر یک یا چند دیسیپلین «Reject» بدهند. تصمیم نهایی (Approve/Reject/Revise &amp;
                    Resubmit) همیشه توسط سازنده/تأییدکننده‌ی مدرک، با در نظر گرفتن مجموع این نظرات، گرفته می‌شود.
                </p>
                <div class="progress mb-3" style="height:8px;" role="progressbar" aria-valuenow="@idcApprovedCount" aria-valuemin="0" aria-valuemax="@idcStatusForPage.Count">
                    <div class="progress-bar bg-success" style="width:@(idcStatusForPage.Count > 0 ? idcApprovedCount * 100 / idcStatusForPage.Count : 0)%"></div>
                </div>
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Discipline"]</th><th>@Localizer["Status"]</th><th>@Localizer["Comment"]</th><th>Responded By</th><th>Responded Date</th></tr></thead>
                    <tbody>
                        @foreach (var idc in idcStatusForPage)
                        {
                            var (idcIcon, idcBadge, idcLabel) = idc.Status switch
                            {
                                "Approve" => ("bi-check-circle-fill", "bg-success", "Approved"),
                                "Comment" => ("bi-chat-left-text-fill", "bg-warning text-dark", "Approved with Comments"),
                                "Reject" => ("bi-x-circle-fill", "bg-danger", "Revision Required"),
                                _ => ("bi-hourglass-split", "bg-secondary", "Pending")
                            };
                            <tr>
                                <td>@idc.DisciplineName</td>
                                <td><span class="badge @idcBadge"><i class="bi @idcIcon"></i> @idcLabel</span></td>
                                <td class="small">@(idc.Comment ?? "—")</td>
                                <td class="small">@(idc.RespondedByName ?? "—")</td>
                                <td class="small">@(idc.RespondedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.Status == "IDC Review")
                {
                    var myDisciplineIdForIdcTab = ViewBag.MyDisciplineId as int?;
                    var myPendingIdcTab = idcStatusForPage.FirstOrDefault(x => x.DisciplineId == myDisciplineIdForIdcTab && x.Status == "Pending");
                    @if (myPendingIdcTab != null)
                    {
                        <div class="d-flex align-items-center gap-2 mt-3">
                            <span class="text-muted small">@Localizer["My IDC Review:"]</span>
                            <form asp-action="IdcRespond" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.DocumentId" />
                                <input type="hidden" name="decision" value="Approve" />
                                <button class="vs-btn vs-btn--primary"><i class="bi bi-check-lg"></i> No Comment</button>
                            </form>
                            <button type="button" class="vs-btn" data-bs-toggle="modal" data-bs-target="#idcCommentModal">@Localizer["Approve with Comments"]</button>
                            <button type="button" class="vs-btn vs-btn--dangerline" data-bs-toggle="modal" data-bs-target="#idcRejectModal">@Localizer["Revision Required"]</button>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @* ===================== Revisions ===================== *@
    <div class="tab-pane fade" id="tab-revisions" role="tabpanel">
        <div class="vs-section">
            <h6 class="mb-3">@Localizer["Ed_SecRevisionHistory"]</h6>
            @if (Model.Revisions != null && Model.Revisions.Any())
            {
                <table class="table table-enterprise">
                    <thead><tr><th>@Localizer["Ed_RevisionCol"]</th><th>@Localizer["Ed_Status"]</th><th>@Localizer["Ed_ClientReviewCol"]</th><th>@Localizer["Ed_Reason"]</th><th>@Localizer["Ed_CreatedBy"]</th><th>@Localizer["Ed_Reviewer"]</th><th>@Localizer["Ed_ApprovedCol"]</th>
                        <th>@Localizer["Ed_Created"]</th><th>@Localizer["Ed_IssuedCol"]</th><th>@Localizer["Ed_EffectiveCol"]</th><th>@Localizer["Ed_SupersedesCol"]</th></tr></thead>
                    <tbody>
                        @foreach (var rev in Model.Revisions)
                        {
                            var revIsCurrent = rev.RevisionNo == Model.RevisionNo;
                            <tr class="@(revIsCurrent ? "vs-rev-current" : "vs-rev-superseded")">
                                <td><span class="vs-num vs-num--strong">@rev.RevisionNo</span> @if (revIsCurrent) { <span class="vs-pill vs-pill--current">@Localizer["Ed_CurrentBadge"]</span> }</td>
                                <td><span class="vs-pill vs-pill--icon @DocumentStatusBadge.Tone(rev.Status)"><i class="bi @DocumentStatusBadge.Icon(rev.Status)" aria-hidden="true"></i> @StatusText(rev.Status)</span></td>
                                <td class="small">
                                    @{
                                        var clientBadge = rev.ClientReviewStatus switch
                                        {
                                            "A" => "bg-success",
                                            "B" or "C" or "D" => "bg-danger",
                                            _ => null
                                        };
                                    }
                                    @if (clientBadge != null)
                                    {
                                        <span class="badge @clientBadge" title="@rev.ClientReviewComment">@rev.ClientReviewStatus @(rev.ClientReviewDate.HasValue ? $"({rev.ClientReviewDate:yyyy-MM-dd})" : "")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@Localizer["Ed_NotSubmittedToClient"]</span>
                                    }
                                </td>
                                <td class="small">@rev.Reason</td>
                                <td class="small">@(rev.CreatedByName ?? "—")</td>
                                <td>@rev.ReviewerName</td>
                                <td>@rev.ApprovedBy</td>
                                <td class="small text-muted">@rev.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="small text-muted">@(rev.IssuedDate?.ToString("yyyy-MM-dd"))</td>
                                <td class="small text-muted">@(rev.EffectiveDate?.ToString("yyyy-MM-dd"))</td>
                                <td class="small">@rev.SupersededRevisionNo</td>
                            </tr>
                            @if (!string.IsNullOrEmpty(rev.ChangeDescription) || !string.IsNullOrEmpty(rev.AIRevisionSummary) || !string.IsNullOrEmpty(rev.VendorComment))
                            {
                                <tr class="table-light">
                                    <td colspan="11" class="small">
                                        @if (!string.IsNullOrEmpty(rev.ChangeDescription)) { <div><strong>Change:</strong> @rev.ChangeDescription</div> }
                                        @if (!string.IsNullOrEmpty(rev.VendorComment)) { <div><i class="bi bi-building"></i> <strong>Vendor Comment:</strong> @rev.VendorComment</div> }
                                        @if (!string.IsNullOrEmpty(rev.AIRevisionSummary)) { <div><i class="bi bi-robot"></i> <strong>AI Summary:</strong> @rev.AIRevisionSummary</div> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center py-4">@Localizer["Ed_NoRevisions"]</p>
            }
        </div>
    </div>

    @* ===================== Workflow History ===================== *@
    @* طبق بخش ۳۳ ممیزی UX: جدول خام قبلی به Timeline تبدیل شد؛ خودِ جدول کامل هم برای Audit
       کامل در یک <details> در پایین حفظ شده - هیچ داده‌ای حذف نشده. *@
    @* طبق «PEMS Engineering Workflow History Read-Path Correction»: این تب قبلاً از
       Model.Workflows (جدول قدیمی DocumentWorkflow) می‌خواند - که فقط یک‌بار موقع Create یک
       ردیف می‌گیرد و هیچ‌کدام از Submit/Check/IDC/Approve/Reject/Issue را ثبت نمی‌کند؛ یعنی
       این تب همیشه (نه فقط بعد از اصلاح مالکیت IDC) عملاً خالی/ناقص بود. حالا از
       WorkflowHistory واقعی (روی همه‌ی Instance های این مدرک، نه فقط چرخه‌ی جاری) می‌خواند. *@
    <div class="tab-pane fade" id="tab-workflow" role="tabpanel">
        <div class="vs-section">
            <h6 class="mb-3">@Localizer["Ed_SecWorkflowHistory"]</h6>
            @if (workflowHistoryForPage.Any())
            {
                var orderedWorkflow = workflowHistoryForPage.OrderByDescending(x => x.ActionDate).ToList();
                <div class="pems-workflow-timeline">
                    @foreach (var item in orderedWorkflow)
                    {
                        var wfIcon = item.ActionType switch
                        {
                            "Approve" => "bi-check-circle-fill text-success",
                            "Reject" => "bi-x-circle-fill text-danger",
                            "Comment" => "bi-chat-left-text-fill text-warning",
                            "Start" or "Submit" => "bi-send-fill text-primary",
                            "Issue" => "bi-check2-circle text-primary",
                            "AutoSkip" => "bi-fast-forward-fill text-secondary",
                            _ => "bi-record-circle-fill text-secondary"
                        };
                        <div class="pems-timeline-item">
                            <div class="pems-timeline-marker"><i class="bi @wfIcon"></i></div>
                            <div class="pems-timeline-content">
                                <div class="d-flex justify-content-between flex-wrap gap-2">
                                    <div>
                                        <span class="badge bg-secondary">@item.ActionType</span>
