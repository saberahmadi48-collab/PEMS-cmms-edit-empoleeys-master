@using Microsoft.Extensions.Localization
@using PEMS.Web.Resources
@inject IStringLocalizer<SharedResource> Localizer
<pems-flex justify="end" align="center" css="mb-2">
    <pems-button tone="primary" size="small" as="a" asp-action="RegisterIncoming">
        <pems-icon name="bi-envelope-plus" /> @Localizer["ثبت مکاتبه‌ی وارده"]
    </pems-button>
</pems-flex>

<pems-row gap="3" css="mb-3">
    <pems-col md="4">
        <pems-kpi-tile icon="bi-send-check" color="blue" label="@Localizer["مدارک آماده‌ی صدور (Approved)"]">@ViewBag.PendingIssueCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        <pems-kpi-tile tone="warning" icon="bi-envelope-exclamation" color="amber" label="@Localizer["مکاتبات وارده‌ی وصل‌نشده"]">@ViewBag.UnlinkedIncomingCount</pems-kpi-tile>
    </pems-col>
    <pems-col md="4">
        <pems-content-card css="text-center">
            <pems-link asp-controller="Relationship" asp-action="Index" class="text-decoration-none">
                <div class="fs-3 fw-bold text-info"><pems-icon name="bi-diagram-3" /></div>
                <div class="text-muted small">@Localizer["Relationship Explorer"]</div>
            </pems-link>
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-row gap="3">
    <pems-col md="6">
        <pems-content-card css="h-100">
            <pems-heading level="6" class="mb-3"><pems-icon name="bi-send-check" /> @Localizer["مدارک منتظر صدور"]</pems-heading>
            @{
                var pendingIssueDocs = (IEnumerable<dynamic>)ViewBag.PendingIssueDocs;
            }
            @if (pendingIssueDocs.Any())
            {
                <pems-bullet-list class="list-unstyled mb-0">
                    @foreach (var d in pendingIssueDocs)
                    {
                        <pems-flex as="li" justify="between" css="border-bottom py-1">
                            <pems-link asp-controller="EngineeringDocuments" asp-action="Details" asp-route-id="@d.DocumentId">
                                @d.DocumentNo &mdash; @d.Title
                            </pems-link>
                            <span class="text-muted small">@(PemsDates.Date(((DateTime?)d.ModifiedDate)))</span>
                        </pems-flex>
                    }
                </pems-bullet-list>
            }
            else
            {
                <pems-text class="text-muted small mb-0">@Localizer["مدرکی در انتظار صدور نیست."]</pems-text>
            }
        </pems-content-card>
    </pems-col>

    <pems-col md="6">
        <pems-content-card css="h-100 border-warning">
            <pems-heading level="6" class="mb-3"><pems-icon name="bi-envelope-exclamation" /> @Localizer["مکاتبات وارده‌ی وصل‌نشده"]</pems-heading>
            @{
                var unlinked = (IEnumerable<dynamic>)ViewBag.UnlinkedIncoming;
            }
            @if (unlinked.Any())
            {
                <pems-bullet-list class="list-unstyled mb-0">
                    @foreach (var l in unlinked)
                    {
                        <pems-flex as="li" justify="between" css="border-bottom py-1">
                            <pems-link asp-controller="Letter" asp-action="Details" asp-route-id="@l.LetterId">
                                @l.LetterNumber &mdash; @l.Subject
                            </pems-link>
                            <span class="text-muted small">@l.Sender</span>
                        </pems-flex>
                    }
                </pems-bullet-list>
                <pems-text class="text-muted small mt-2 mb-0">این‌ها هنوز به هیچ مدرک/MR وصل نشده‌اند - روی هرکدام برو و از Relationship Explorer یا ویرایش نامه، لینکش کن.</pems-text>
            }
            else
            {
                <pems-text class="text-muted small mb-0">همه‌ی مکاتبات وارده به یک مدرک/MR وصل شده‌اند.</pems-text>
            }
        </pems-content-card>
    </pems-col>
</pems-row>

<pems-content-card css="mt-3">
    <pems-heading level="6" class="mb-3"><pems-icon name="bi-clock-history" /> @Localizer["آخرین مکاتبات وارده"]</pems-heading>
    @{
        var recentIncoming = (IEnumerable<dynamic>)ViewBag.RecentIncoming;
    }
    @{
        var rows_24 = recentIncoming;
        var cell_24_4 = DataCell.Template(rows_24, @<text>@{ var l = item; }
                        @if (l.RelatedDocumentId != null)
                        {
                            <pems-badge tone="success">@Localizer["مدرک"]</pems-badge>
                        }
                        else if (l.RelatedMRId != null)
                        {
                            <pems-badge tone="success">MR</pems-badge>
                        }
                        else
                        {
                            <pems-badge tone="warning">@Localizer["وصل‌نشده"]</pems-badge>
                        }
                    </text>);
    }
    <pems-data-table data="@(DataRows.Of(rows_24, c_ => c_.Add(((Localizer["شماره"])?.ToString() ?? ""), l => (object?)(DataCell.Link(Url.Action("Details", "Letter", new { id = l.LetterId }), l.LetterNumber))).Add(((Localizer["فرستنده"])?.ToString() ?? ""), l => (object?)(l.Sender), css: "small").Add(((Localizer["موضوع"])?.ToString() ?? ""), l => (object?)(l.Subject), css: "small").Add(((Localizer["تاریخ"])?.ToString() ?? ""), l => (object?)((PemsDates.Date(((DateTime)l.LetterDate)))), css: "small").Add(((Localizer["لینک"])?.ToString() ?? ""), l => (object?)cell_24_4(l))))" css="mb-0" />
</pems-content-card>
